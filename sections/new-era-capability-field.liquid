<section
  class="ned-capabilities{% if section.settings.enable_motion %} has-ned-motion{% endif %}{% if section.settings.enable_ambient_motion %} has-ambient-motion{% endif %}"
  id="NedCapabilities-{{ section.id }}"
  style="--field-bg:{{ section.settings.background }};--field-ink:{{ section.settings.text_color }};--field-accent:{{ section.settings.accent }};--field-min:{{ section.settings.min_height }}px;--field-speed:{{ section.settings.motion_speed }}ms;--field-pointer:{{ section.settings.pointer_strength }}px;--field-heading-tracking:{{ section.settings.heading_tracking }}px;--field-mobile-heading:{{ section.settings.mobile_heading_size }}px"
  data-ned-motion-root="true"
  {% if section.settings.enable_motion %}data-ned-reveal data-ned-pointer-field{% endif %}
>
  <header class="ned-capabilities__header">
    <p>{{ section.settings.eyebrow | escape }}</p>
    <h2 data-ned-text-reveal="word">{{ section.settings.heading | escape }}</h2>
  </header>
  <div class="ned-capabilities__field" aria-label="Capabilities">
    <span class="ned-capabilities__axis" aria-hidden="true"></span>
    {% for block in section.blocks %}
      <a
        class="ned-capability ned-capability--font-{{ block.settings.font_style }}{% if block.settings.outline %} is-outline{% endif %}"
        href="{{ block.settings.link | default: routes.root_url }}"
        style="--x:{{ block.settings.x }}%;--y:{{ block.settings.y }}%;--mobile-x:{{ block.settings.mobile_x }}%;--mobile-y:{{ block.settings.mobile_y }}%;--rotate:{{ block.settings.rotation }}deg;--size:{{ block.settings.size }}px;--mobile-size:{{ block.settings.mobile_size }}px;--color:{{ block.settings.color }};--shape-bg:{{ block.settings.shape_color }};--shape-ink:{{ block.settings.shape_text_color }};--text-size:{{ block.settings.text_size }}px;--mobile-text-size:{{ block.settings.mobile_text_size }}px;--object-tracking:{{ block.settings.tracking }}px;--float-x:{{ block.settings.drift_x }}px;--float-y:{{ block.settings.drift_y }}px;--float-speed:{{ block.settings.float_speed }}s;--float-delay:-{{ block.settings.motion_phase }}s;--order:{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      ><span class="ned-capability__object"><b>{{ block.settings.label | escape }}</b><small>{{ block.settings.annotation | escape }}</small></span></a>
    {% endfor %}
  </div>
  <footer><span>{{ section.settings.footer_left | escape }}</span><span>{{ section.settings.footer_right | escape }}</span></footer>
</section>

{% style %}
  #NedCapabilities-{{ section.id }}{--ned-pointer-x:0;--ned-pointer-y:0;background:var(--field-bg);color:var(--field-ink);min-height:var(--field-min);overflow:hidden;padding:clamp(34px,5vw,76px);position:relative}
  #NedCapabilities-{{ section.id }} *{box-sizing:border-box}#NedCapabilities-{{ section.id }} .ned-capabilities__header{align-items:start;display:grid;grid-template-columns:minmax(150px,.55fr) minmax(0,1.45fr);position:relative;z-index:5}#NedCapabilities-{{ section.id }} .ned-capabilities__header p,#NedCapabilities-{{ section.id }} footer{font:800 10px/1.25 'NED Milo',Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase}#NedCapabilities-{{ section.id }} .ned-capabilities__header p{margin:8px 0}#NedCapabilities-{{ section.id }} h2{color:inherit;font:900 clamp(48px,7vw,112px)/.82 'NED Milo',Arial,sans-serif;letter-spacing:var(--field-heading-tracking);margin:0;max-width:980px;text-wrap:balance}
  #NedCapabilities-{{ section.id }} .ned-capabilities__field{height:clamp(560px,58vw,760px);position:relative}#NedCapabilities-{{ section.id }} .ned-capabilities__axis{border-left:1px solid currentColor;border-top:1px solid currentColor;height:24px;left:50%;opacity:.5;position:absolute;top:50%;width:24px}#NedCapabilities-{{ section.id }} .ned-capabilities__axis::after{content:'DATUM 00';font:700 8px/1 'NED Milo',Arial,sans-serif;left:8px;letter-spacing:.12em;position:absolute;top:8px;white-space:nowrap}
  #NedCapabilities-{{ section.id }} .ned-capability{color:var(--color);left:var(--x);position:absolute;text-decoration:none;top:var(--y);transform:translate(-50%,-50%) rotate(var(--rotate));transition:filter var(--field-speed) ease,transform var(--field-speed) cubic-bezier(.2,1.4,.3,1);width:var(--size);z-index:2}
  #NedCapabilities-{{ section.id }} .ned-capability__object{align-items:center;background:var(--shape-bg);border-radius:51% 49% 57% 43%/46% 56% 44% 54%;color:var(--shape-ink);display:flex;flex-direction:column;justify-content:center;min-height:110px;padding:24px 18px;text-align:center;transition:filter var(--field-speed) ease;width:100%}
  #NedCapabilities-{{ section.id }} .ned-capability b{font:900 var(--text-size)/.95 'NED Milo',Arial,sans-serif;letter-spacing:var(--object-tracking);text-transform:uppercase}#NedCapabilities-{{ section.id }} .ned-capability--font-funk b{font-family:'NED Funk Machine','Arial Black',sans-serif;font-weight:400}#NedCapabilities-{{ section.id }} .ned-capability--font-script b{font-family:'NED Edwardian','Snell Roundhand',cursive;font-size:calc(var(--text-size) + 10px);font-weight:400;text-transform:none}
  #NedCapabilities-{{ section.id }} .ned-capability small{font:800 8px/1.25 'NED Milo',Arial,sans-serif;letter-spacing:.12em;margin-top:10px;text-transform:uppercase}#NedCapabilities-{{ section.id }} .ned-capability.is-outline .ned-capability__object{background:transparent;box-shadow:inset 0 0 0 2px var(--shape-bg);color:var(--shape-bg)}
  #NedCapabilities-{{ section.id }}.has-ambient-motion .ned-capability__object{animation:nedCapabilityBounce-{{ section.id }} var(--float-speed) linear var(--float-delay) infinite;transform-origin:center bottom}
  #NedCapabilities-{{ section.id }} .ned-capability:hover,#NedCapabilities-{{ section.id }} .ned-capability:focus-visible{filter:saturate(1.3) brightness(1.08);transform:translate(-50%,-54%) rotate(calc(var(--rotate) - 2deg)) scale(1.05);z-index:6}#NedCapabilities-{{ section.id }} .ned-capability:hover .ned-capability__object,#NedCapabilities-{{ section.id }} .ned-capability:focus-visible .ned-capability__object{animation-play-state:paused}
  @keyframes nedCapabilityBounce-{{ section.id }}{0%,8%,29%,43%,100%{transform:translate3d(0,0,0) rotate(0) scale(1)}10%{transform:translate3d(0,2px,0) rotate(0) scale(1.04,.94)}18%{transform:translate3d(var(--float-x),calc(0px - var(--float-y)),0) rotate(1deg) scale(.98,1.02)}31%{transform:translate3d(0,1px,0) rotate(0) scale(1.02,.97)}36%{transform:translate3d(calc(var(--float-x) * -.2),calc(var(--float-y) * -.24),0) rotate(-.5deg) scale(.99,1.01)}}
  #NedCapabilities-{{ section.id }} footer{border-top:1px solid currentColor;display:flex;justify-content:space-between;padding-top:18px}#NedCapabilities-{{ section.id }}.has-ned-motion .ned-capability{opacity:0;transition-delay:calc(var(--order) * 55ms)}#NedCapabilities-{{ section.id }}.has-ned-motion.is-visible .ned-capability{opacity:1}
  @media(max-width:989px){#NedCapabilities-{{ section.id }}{min-height:auto;padding:76px clamp(22px,5vw,48px) 34px}#NedCapabilities-{{ section.id }} .ned-capabilities__header{display:block}#NedCapabilities-{{ section.id }} .ned-capabilities__header p{margin-bottom:24px}#NedCapabilities-{{ section.id }} h2{font-size:clamp(var(--field-mobile-heading),13vw,84px);line-height:.9}#NedCapabilities-{{ section.id }} .ned-capabilities__field{height:730px;margin-inline:-8px}#NedCapabilities-{{ section.id }} .ned-capability{left:var(--mobile-x);top:var(--mobile-y);width:var(--mobile-size)}#NedCapabilities-{{ section.id }} .ned-capability__object{min-height:92px;padding:18px 14px}#NedCapabilities-{{ section.id }} .ned-capability b{font-size:var(--mobile-text-size)}#NedCapabilities-{{ section.id }} .ned-capability--font-script b{font-size:calc(var(--mobile-text-size) + 8px)}#NedCapabilities-{{ section.id }} footer{gap:20px}}
  @media(prefers-reduced-motion:reduce){#NedCapabilities-{{ section.id }} *{animation:none!important;opacity:1!important;transition:none!important}#NedCapabilities-{{ section.id }} .ned-capability{transform:translate(-50%,-50%) rotate(var(--rotate))}}
{% endstyle %}

{% schema %}
{
  "name":"NED capability field",
  "settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"What we make move"},{"type":"text","id":"heading","label":"Heading","default":"One studio. Many physical outcomes."},{"type":"color_background","id":"background","label":"Background","default":"#071a3a"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"},{"type":"color","id":"accent","label":"Hover accent","default":"#ff4fa3"},{"type":"range","id":"min_height","label":"Minimum height","min":700,"max":1400,"step":50,"unit":"px","default":1000},{"type":"text","id":"footer_left","label":"Footer left","default":"Systems / spaces / signals"},{"type":"text","id":"footer_right","label":"Move through with confidence"},{"type":"header","content":"Typography"},{"type":"range","id":"heading_tracking","label":"Heading tracking","min":-8,"max":16,"step":0.5,"unit":"px","default":-2},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":38,"max":86,"step":2,"unit":"px","default":54},{"type":"header","content":"Natural movement"},{"type":"checkbox","id":"enable_motion","label":"Enable reveals and pointer response","default":true},{"type":"checkbox","id":"enable_ambient_motion","label":"Enable natural bouncing labels","default":true},{"type":"range","id":"motion_speed","label":"Hover response","min":120,"max":300,"step":10,"unit":"ms","default":180},{"type":"range","id":"pointer_strength","label":"Pointer reaction","min":0,"max":30,"step":2,"unit":"px","default":12}],
  "blocks":[{"type":"capability","name":"Bouncing capability label","settings":[{"type":"text","id":"label","label":"Label","default":"Wayfinding"},{"type":"text","id":"annotation","label":"Annotation","default":"Decision points / sign families"},{"type":"url","id":"link","label":"Link"},{"type":"select","id":"font_style","label":"Label font","options":[{"value":"milo","label":"Milo"},{"value":"funk","label":"Funk Machine"},{"value":"script","label":"Edwardian"}],"default":"milo"},{"type":"color","id":"color","label":"Fallback text color","default":"#ffffff"},{"type":"color","id":"shape_color","label":"Organic shape color","default":"#f7e51d"},{"type":"color","id":"shape_text_color","label":"Shape text color","default":"#071a3a"},{"type":"checkbox","id":"outline","label":"Outline shape","default":false},{"type":"range","id":"size","label":"Desktop object width","min":100,"max":300,"step":10,"unit":"px","default":180},{"type":"range","id":"mobile_size","label":"Mobile object width","min":60,"max":220,"step":10,"unit":"px","default":140},{"type":"range","id":"text_size","label":"Desktop label size","min":12,"max":38,"step":1,"unit":"px","default":20},{"type":"range","id":"mobile_text_size","label":"Mobile label size","min":10,"max":28,"step":1,"unit":"px","default":15},{"type":"range","id":"tracking","label":"Label tracking","min":-4,"max":12,"step":0.5,"unit":"px","default":1},{"type":"range","id":"x","label":"Desktop X","min":5,"max":95,"step":1,"unit":"%","default":50},{"type":"range","id":"y","label":"Desktop Y","min":5,"max":95,"step":1,"unit":"%","default":50},{"type":"range","id":"mobile_x","label":"Mobile X","min":10,"max":90,"step":1,"unit":"%","default":50},{"type":"range","id":"mobile_y","label":"Mobile Y","min":5,"max":95,"step":1,"unit":"%","default":50},{"type":"range","id":"rotation","label":"Rotation","min":-20,"max":20,"step":1,"unit":"deg","default":0},{"type":"range","id":"drift_x","label":"Bounce side arc","min":-30,"max":30,"step":2,"unit":"px","default":8},{"type":"range","id":"drift_y","label":"Bounce height","min":4,"max":40,"step":2,"unit":"px","default":18},{"type":"range","id":"float_speed","label":"Bounce cycle","min":3,"max":8,"step":1,"unit":"s","default":4},{"type":"range","id":"motion_phase","label":"Bounce phase","min":0,"max":6,"step":1,"unit":"s","default":0}]}],"max_blocks":9,
  "presets":[{"name":"NED capability field","blocks":[{"type":"capability"},{"type":"capability"},{"type":"capability"},{"type":"capability"},{"type":"capability"}]}]
}
{% endschema %}
