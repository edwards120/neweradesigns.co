{% liquid
  assign heading_font = "'NED Milo',Arial,sans-serif"
  if section.settings.heading_font == 'funk'
    assign heading_font = "'NED Funk Machine','Arial Black',sans-serif"
  elsif section.settings.heading_font == 'script'
    assign heading_font = "'NED Edwardian','Snell Roundhand',cursive"
  endif
  assign project_font = "'NED Milo',Arial,sans-serif"
  if section.settings.project_font == 'funk'
    assign project_font = "'NED Funk Machine','Arial Black',sans-serif"
  elsif section.settings.project_font == 'script'
    assign project_font = "'NED Edwardian','Snell Roundhand',cursive"
  endif
%}
<section class="ned-work{% if section.settings.enable_motion %} has-ned-motion{% endif %}" id="NedWork-{{ section.id }}" style="--work-bg:{{ section.settings.background }};--work-ink:{{ section.settings.text_color }};--work-accent:{{ section.settings.accent }};--work-speed:{{ section.settings.motion_speed }}ms;--work-heading-font:{{ heading_font }};--work-project-font:{{ project_font }};--work-heading-tracking:{{ section.settings.heading_tracking }}px;--work-project-tracking:{{ section.settings.project_tracking }}px;--work-mobile-heading:{{ section.settings.mobile_heading_size }}px;--work-mobile-project:{{ section.settings.mobile_project_size }}px" data-ned-motion-root="true" {% if section.settings.enable_motion %}data-ned-reveal{% endif %}>
  <header><p>{{ section.settings.eyebrow | escape }}</p><h2 data-ned-text-reveal="word">{{ section.settings.heading | escape }}</h2><span>{{ section.settings.annotation | escape }}</span></header>
  <div class="ned-work__list">
    {% for block in section.blocks %}
      {% assign project_alt = block.settings.image_alt | default: block.settings.title %}
      <article class="ned-work__item{% if block.settings.image == blank %} is-type-only{% endif %}" style="--order:{{ forloop.index0 }};--item-accent:{{ block.settings.accent }}" {{ block.shopify_attributes }}>
        <a href="{{ block.settings.link | default: routes.root_url }}">
          <div class="ned-work__meta"><span>0{{ forloop.index }}</span><span>{{ block.settings.classification | escape }}</span><span>{{ block.settings.year | escape }}</span></div>
          {% if block.settings.image != blank %}
            <div class="ned-work__image ned-work__image--{{ block.settings.image_ratio | default: 'natural' }}" style="--work-image-position:{{ block.settings.image_position | default: 'center' }}">{{ block.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '360, 540, 760, 1100, 1600, 2000, 2400', sizes: '(max-width: 989px) calc(100vw - 44px), (max-width: 1399px) 58vw, 52vw', alt: project_alt }}</div>
          {% endif %}
          <div class="ned-work__title"><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.discipline | escape }}</p></div>
          <p class="ned-work__description">{{ block.settings.description | escape }}</p>
          <div class="ned-work__rule"><span>{{ block.settings.technical_note | escape }}</span><b aria-hidden="true">↗</b></div>
        </a>
      </article>
    {% endfor %}
  </div>
</section>

{% style %}
  #NedWork-{{ section.id }}{background:var(--work-bg);color:var(--work-ink);padding:clamp(70px,9vw,150px) clamp(22px,6vw,100px)}#NedWork-{{ section.id }} *{box-sizing:border-box}#NedWork-{{ section.id }}>header{align-items:end;border-bottom:2px solid currentColor;display:grid;grid-template-columns:.7fr 2fr .7fr;padding-bottom:24px}#NedWork-{{ section.id }}>header p,#NedWork-{{ section.id }}>header span{font:800 10px/1.2 'NED Milo',Arial,sans-serif;letter-spacing:.15em;margin:0;text-transform:uppercase}#NedWork-{{ section.id }}>header span{text-align:right}#NedWork-{{ section.id }}>header h2{font-family:var(--work-heading-font);font-size:clamp(64px,11vw,190px);font-weight:900;letter-spacing:var(--work-heading-tracking);line-height:.78;margin:0;text-wrap:balance}
  #NedWork-{{ section.id }} .ned-work__list{display:flex;flex-direction:column}#NedWork-{{ section.id }} .ned-work__item{border-bottom:1px solid currentColor;margin-left:0;max-width:1600px;width:min(82%,1600px)}#NedWork-{{ section.id }} .ned-work__item:nth-child(even){margin-left:auto;width:min(67%,1320px)}#NedWork-{{ section.id }} .ned-work__item a{color:inherit;display:grid;gap:clamp(18px,2vw,34px);grid-template-columns:minmax(120px,1fr) minmax(0,2.4fr);padding:clamp(48px,7vw,110px) 0;text-decoration:none}#NedWork-{{ section.id }} .ned-work__meta{display:flex;font:800 9px/1.3 'NED Milo',Arial,sans-serif;gap:18px;grid-column:1/-1;letter-spacing:.14em;text-transform:uppercase}#NedWork-{{ section.id }} .ned-work__meta span:first-child{color:var(--item-accent)}#NedWork-{{ section.id }} .ned-work__image{filter:grayscale(1) contrast(1.12);grid-column:2;overflow:hidden;width:100%}#NedWork-{{ section.id }} .ned-work__image img{display:block;height:auto;transition:filter var(--work-speed) ease,transform var(--work-speed) cubic-bezier(.2,1.35,.3,1);width:100%}#NedWork-{{ section.id }} .ned-work__image--square,#NedWork-{{ section.id }} .ned-work__image--portrait,#NedWork-{{ section.id }} .ned-work__image--landscape,#NedWork-{{ section.id }} .ned-work__image--wide{aspect-ratio:var(--work-image-ratio)}#NedWork-{{ section.id }} .ned-work__image--square{--work-image-ratio:1}#NedWork-{{ section.id }} .ned-work__image--portrait{--work-image-ratio:4/5}#NedWork-{{ section.id }} .ned-work__image--landscape{--work-image-ratio:4/3}#NedWork-{{ section.id }} .ned-work__image--wide{--work-image-ratio:16/9}#NedWork-{{ section.id }} .ned-work__image:not(.ned-work__image--natural) img{height:100%;object-fit:cover;object-position:var(--work-image-position);width:100%}#NedWork-{{ section.id }} .ned-work__item:hover .ned-work__image img{filter:saturate(1.2);transform:scale(1.02)}
  #NedWork-{{ section.id }} .ned-work__title{grid-column:1/-1;position:relative}#NedWork-{{ section.id }} .ned-work__title h3{font-family:var(--work-project-font);font-size:clamp(54px,8vw,138px);font-weight:800;letter-spacing:var(--work-project-tracking);line-height:.86;margin:0;transition:color .18s ease,letter-spacing .18s ease;text-wrap:balance}#NedWork-{{ section.id }} .ned-work__title p{font:800 10px/1 'NED Milo',Arial,sans-serif;letter-spacing:.14em;margin:20px 0 0;text-transform:uppercase}#NedWork-{{ section.id }} .ned-work__description{font:500 15px/1.45 'NED Milo',Arial,sans-serif;grid-column:2;margin:0;max-width:580px}#NedWork-{{ section.id }} .ned-work__rule{align-items:center;border-top:1px solid currentColor;display:flex;font:800 9px/1 'NED Milo',Arial,sans-serif;grid-column:1/-1;justify-content:space-between;letter-spacing:.14em;padding-top:14px;text-transform:uppercase}#NedWork-{{ section.id }} .ned-work__rule b{font-size:28px;font-weight:400;transition:color .18s ease,transform .18s cubic-bezier(.2,1.4,.3,1)}#NedWork-{{ section.id }} .ned-work__item:hover h3{color:var(--item-accent);letter-spacing:calc(var(--work-project-tracking) + 1px)}#NedWork-{{ section.id }} .ned-work__item:hover .ned-work__rule b{color:var(--item-accent);transform:translate(4px,-4px)}
  #NedWork-{{ section.id }}.has-ned-motion .ned-work__item{opacity:0;transform:translateY(28px);transition:opacity var(--work-speed) cubic-bezier(.16,1,.3,1),transform var(--work-speed) cubic-bezier(.16,1,.3,1);transition-delay:calc(var(--order) * 75ms)}#NedWork-{{ section.id }}.has-ned-motion.is-visible .ned-work__item{opacity:1;transform:none}
  @media(max-width:989px){#NedWork-{{ section.id }}{padding:clamp(74px,12vw,110px) clamp(20px,5vw,46px)}#NedWork-{{ section.id }}>header{display:block}#NedWork-{{ section.id }}>header p{margin-bottom:30px}#NedWork-{{ section.id }}>header h2{font-size:clamp(var(--work-mobile-heading),13vw,94px);line-height:.88}#NedWork-{{ section.id }}>header span{display:block;margin-top:26px;text-align:left}#NedWork-{{ section.id }} .ned-work__item,#NedWork-{{ section.id }} .ned-work__item:nth-child(even){margin-left:0;max-width:none;width:100%}#NedWork-{{ section.id }} .ned-work__item a{display:block;padding:clamp(58px,10vw,88px) 0}#NedWork-{{ section.id }} .ned-work__meta,#NedWork-{{ section.id }} .ned-work__title,#NedWork-{{ section.id }} .ned-work__description,#NedWork-{{ section.id }} .ned-work__rule{margin-top:24px}#NedWork-{{ section.id }} .ned-work__title h3{font-size:clamp(var(--work-mobile-project),11vw,76px);line-height:.94}#NedWork-{{ section.id }} .ned-work__description{font-size:16px;line-height:1.55}#NedWork-{{ section.id }} .ned-work__image{margin-top:24px}}
  @media(prefers-reduced-motion:reduce){#NedWork-{{ section.id }} *{animation:none!important;opacity:1!important;transform:none!important;transition:none!important}}
{% endstyle %}

{% schema %}
{
  "name":"NED selected work",
  "settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Selected work / concept studies"},{"type":"text","id":"heading","label":"Heading","default":"Built to be read at speed."},{"type":"text","id":"annotation","label":"Header annotation","default":"Sign systems / spatial identity / 3D"},{"type":"color_background","id":"background","label":"Background","default":"#f3efe7"},{"type":"color","id":"text_color","label":"Text","default":"#071a3a"},{"type":"color","id":"accent","label":"Default accent","default":"#ff4fa3"},{"type":"header","content":"Typography"},{"type":"select","id":"heading_font","label":"Section heading font","options":[{"value":"milo","label":"Milo"},{"value":"funk","label":"Funk Machine"},{"value":"script","label":"Edwardian"}],"default":"milo"},{"type":"select","id":"project_font","label":"Project title font","options":[{"value":"milo","label":"Milo"},{"value":"funk","label":"Funk Machine"},{"value":"script","label":"Edwardian"}],"default":"milo"},{"type":"range","id":"heading_tracking","label":"Section heading tracking","min":-8,"max":16,"step":0.5,"unit":"px","default":-3},{"type":"range","id":"project_tracking","label":"Project title tracking","min":-8,"max":16,"step":0.5,"unit":"px","default":-2},{"type":"range","id":"mobile_heading_size","label":"Mobile section heading size","min":40,"max":92,"step":2,"unit":"px","default":58},{"type":"range","id":"mobile_project_size","label":"Mobile project title size","min":32,"max":74,"step":2,"unit":"px","default":44},{"type":"header","content":"Motion"},{"type":"checkbox","id":"enable_motion","label":"Enable fast reveals","default":true},{"type":"range","id":"motion_speed","label":"Motion speed","min":250,"max":600,"step":25,"unit":"ms","default":400}],
  "blocks":[{"type":"project","name":"Project / study","settings":[{"type":"text","id":"title","label":"Title","default":"Wayfinding System Study"},{"type":"text","id":"classification","label":"Classification","default":"Speculative study"},{"type":"text","id":"year","label":"Year","default":"2027"},{"type":"text","id":"discipline","label":"Discipline","default":"Wayfinding / sign family"},{"type":"textarea","id":"description","label":"Description","default":"A fabrication-aware study connecting arrival, orientation, tenant visibility, and repeatable production logic."},{"type":"text","id":"technical_note","label":"Technical note","default":"12'-0\" / ALUMINUM CABINET"},{"type":"image_picker","id":"image","label":"Whole project image (no baked-in text)"},{"type":"text","id":"image_alt","label":"Image description"},{"type":"select","id":"image_ratio","label":"Image crop","options":[{"value":"natural","label":"Natural"},{"value":"wide","label":"Wide 16:9"},{"value":"landscape","label":"Landscape 4:3"},{"value":"square","label":"Square"},{"value":"portrait","label":"Portrait 4:5"}],"default":"landscape"},{"type":"select","id":"image_position","label":"Image focal position","options":[{"value":"center","label":"Center"},{"value":"top","label":"Top"},{"value":"bottom","label":"Bottom"},{"value":"left","label":"Left"},{"value":"right","label":"Right"}],"default":"center"},{"type":"url","id":"link","label":"Project link"},{"type":"color","id":"accent","label":"Project accent","default":"#ff4fa3"}]}],"max_blocks":8,
  "presets":[{"name":"NED selected work","blocks":[{"type":"project"},{"type":"project"},{"type":"project"}]}]
}
{% endschema %}
