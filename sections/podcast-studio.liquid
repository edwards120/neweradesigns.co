{% schema %}
{
  "name": "Podcast studio",
  "tag": "section",
  "class": "section-podcast-studio",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New Era on air" },
    { "type": "text", "id": "title_line_1", "label": "Main title", "default": "NEW ERA" },
    { "type": "text", "id": "title_script", "label": "Script title", "default": "Podcast" },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Unfiltered conversations about fashion, luxury, culture, and whatever else is interesting enough to follow.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Listen to the latest" },
    { "type": "url", "id": "primary_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Browse episodes" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" },
    { "type": "image_picker", "id": "cover_image", "label": "Podcast cover image" },
    { "type": "text", "id": "art_alt", "label": "Cover image alt text", "default": "New Era Podcast cover artwork" },
    { "type": "text", "id": "record_kicker", "label": "Record label kicker", "default": "Ideas in motion" },
    { "type": "text", "id": "record_footer", "label": "Record label footer", "default": "New Era Designs" },
    { "type": "header", "content": "Whimsy and motion" },
    { "type": "checkbox", "id": "show_whimsy", "label": "Show fashion charms and notes", "default": true },
    { "type": "text", "id": "sticker_one", "label": "Sticker one", "default": "Dressed to talk" },
    { "type": "text", "id": "sticker_two", "label": "Sticker two", "default": "Off the record" },
    { "type": "text", "id": "marquee_1", "label": "Marquee topic 1", "default": "FASHION" },
    { "type": "text", "id": "marquee_2", "label": "Marquee topic 2", "default": "LUXURY" },
    { "type": "text", "id": "marquee_3", "label": "Marquee topic 3", "default": "CULTURE" },
    { "type": "text", "id": "marquee_4", "label": "Marquee topic 4", "default": "WHATEVER ELSE" },
    { "type": "range", "id": "record_spin_seconds", "label": "Record spin duration", "min": 8, "max": 36, "step": 1, "unit": "s", "default": 18 },
    { "type": "range", "id": "marquee_seconds", "label": "Marquee duration", "min": 10, "max": 40, "step": 1, "unit": "s", "default": 18 },
    { "type": "header", "content": "Episodes" },
    { "type": "text", "id": "episodes_eyebrow", "label": "Episodes eyebrow", "default": "Now broadcasting" },
    { "type": "text", "id": "episodes_heading", "label": "Episodes heading", "default": "Latest episodes" },
    { "type": "text", "id": "episodes_note", "label": "Episodes note", "default": "Fashion, luxury, taste, culture, and whatever else is worth talking about." },
    { "type": "header", "content": "About the show" },
    { "type": "text", "id": "about_eyebrow", "label": "About eyebrow", "default": "Behind the mic" },
    { "type": "text", "id": "about_heading", "label": "About heading", "default": "Taste is personal. The conversation can go anywhere." },
    { "type": "richtext", "id": "about_text", "label": "About text", "default": "<p>The New Era Podcast moves between fashion, luxury, culture, desire, and the beautifully random thoughts that refuse to stay in one category.</p>" },
    { "type": "text", "id": "about_label", "label": "About link label", "default": "About the show" },
    { "type": "url", "id": "about_url", "label": "About link" },
    { "type": "header", "content": "Closing call to action" },
    { "type": "text", "id": "footer_kicker", "label": "Footer kicker", "default": "A New Era Designs original" },
    { "type": "text", "id": "footer_heading", "label": "Footer heading", "default": "Put your headphones on." },
    { "type": "text", "id": "footer_label", "label": "Footer button label", "default": "Start listening" },
    { "type": "url", "id": "footer_url", "label": "Footer button link" },
    { "type": "header", "content": "Type and color" },
    { "type": "text", "id": "script_font", "label": "Script font family", "default": "At Works Script", "info": "Uses At Works Script when installed, then falls back to Edwardian Script." },
    { "type": "text", "id": "display_font", "label": "Display font family", "default": "Mathew Rohas" },
    { "type": "text", "id": "body_font", "label": "Body font family", "default": "Milo" },
    { "type": "color", "id": "ink_color", "label": "Plum Noir", "default": "#341F28" },
    { "type": "color", "id": "paper_color", "label": "Cool Blue", "default": "#D8EFFD" },
    { "type": "color", "id": "accent_color", "label": "Wasabi", "default": "#EAEF55" },
    { "type": "color", "id": "hot_color", "label": "Persimmon", "default": "#FE5D31" },
    { "type": "color", "id": "blue_color", "label": "Jade", "default": "#ACB8A0" }
  ],
  "blocks": [
    {
      "type": "platform",
      "name": "Listening platform",
      "settings": [
        { "type": "text", "id": "label", "label": "Platform name", "default": "Spotify" },
        { "type": "url", "id": "url", "label": "Platform link" }
      ]
    },
    {
      "type": "episode",
      "name": "Episode",
      "settings": [
        { "type": "text", "id": "title", "label": "Episode title", "default": "What changes when you trust the process?" },
        { "type": "text", "id": "category", "label": "Category", "default": "Creative process" },
        { "type": "text", "id": "duration", "label": "Duration", "default": "42 min" },
        { "type": "richtext", "id": "description", "label": "Description", "default": "<p>A candid conversation about taste, uncertainty, and making a clear decision before you have perfect information.</p>" },
        { "type": "url", "id": "listen_url", "label": "Episode page or platform link" },
        { "type": "url", "id": "audio_url", "label": "Direct audio file URL", "info": "Optional. Paste a direct MP3 or audio file URL to show an on-page player." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Podcast studio",
      "blocks": [
        { "type": "platform", "settings": { "label": "Spotify" } },
        { "type": "platform", "settings": { "label": "Apple Podcasts" } },
        { "type": "platform", "settings": { "label": "YouTube" } },
        { "type": "episode", "settings": { "title": "The beautiful tension between polish and personality", "category": "Design + culture", "duration": "48 min" } },
        { "type": "episode", "settings": { "title": "Building a brand people can actually feel", "category": "Brand systems", "duration": "36 min" } },
        { "type": "episode", "settings": { "title": "Good work, strange paths, and staying curious", "category": "Field notes", "duration": "51 min" } }
      ]
    }
  ]
}
