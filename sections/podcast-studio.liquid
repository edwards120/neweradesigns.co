{% liquid
  assign title_line_1 = section.settings.title_line_1 | default: 'NEW ERA'
  assign title_script = section.settings.title_script | default: 'Podcast'
%}

<section id="PodcastStudio-{{ section.id }}" class="ps" aria-labelledby="PodcastTitle-{{ section.id }}">
  <div class="ps__noise" aria-hidden="true"></div>
  <div class="ps__orb ps__orb--one" aria-hidden="true"></div>
  <div class="ps__orb ps__orb--two" aria-hidden="true"></div>
  <div class="ps__orb ps__orb--three" aria-hidden="true"></div>
  <div class="ps__orb ps__orb--four" aria-hidden="true"></div>

  <div class="ps__shell">
    <header class="ps__hero">
      <div class="ps__hero-copy">
        {% if section.settings.eyebrow != blank %}
          <p class="ps__eyebrow"><span></span>{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        <h1 id="PodcastTitle-{{ section.id }}" class="ps__title">
          <span class="ps__title-main">{{ title_line_1 | escape }}</span>
          <span class="ps__title-script">{{ title_script | escape }}</span>
        </h1>

        {% if section.settings.intro != blank %}
          <div class="ps__intro">{{ section.settings.intro }}</div>
        {% endif %}

        <div class="ps__actions">
          {% if section.settings.primary_url != blank %}
            <a class="ps__button ps__button--primary" href="{{ section.settings.primary_url }}">
              <span>{{ section.settings.primary_label | default: 'Listen to the latest' | escape }}</span>
              <span aria-hidden="true">↗</span>
            </a>
          {% endif %}
          {% if section.settings.secondary_url != blank %}
            <a class="ps__button ps__button--ghost" href="{{ section.settings.secondary_url }}">
              {{ section.settings.secondary_label | default: 'All episodes' | escape }}
            </a>
          {% endif %}
        </div>
      </div>

      <div class="ps__hero-art" aria-label="{{ section.settings.art_alt | default: 'Podcast cover artwork' | escape }}">
        <div class="ps__record">
          <div class="ps__record-ring"></div>
          <div class="ps__record-label">
            {% if section.settings.cover_image != blank %}
              {{ section.settings.cover_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '450, 700, 900', sizes: '(min-width: 990px) 36vw, 78vw', alt: section.settings.art_alt }}
            {% else %}
              <span class="ps__record-kicker">{{ section.settings.record_kicker | default: 'Ideas in motion' | escape }}</span>
              <strong>{{ title_script | escape }}</strong>
              <small>{{ section.settings.record_footer | default: 'New Era Designs' | escape }}</small>
            {% endif %}
          </div>
          <span class="ps__record-hole"></span>
        </div>
        <div class="ps__needle" aria-hidden="true"><span></span></div>
        <div class="ps__scribble" aria-hidden="true">listen →</div>
      </div>
    </header>

    {% assign platform_count = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'platform' %}{% assign platform_count = platform_count | plus: 1 %}{% endif %}
    {% endfor %}
    {% if platform_count > 0 %}
      <nav class="ps__platforms" aria-label="Subscribe to the podcast">
        <span class="ps__platform-label">Find us on</span>
        {% for block in section.blocks %}
          {% if block.type == 'platform' and block.settings.url != blank %}
            <a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
              {{ block.settings.label | escape }} <span aria-hidden="true">↗</span>
            </a>
          {% endif %}
        {% endfor %}
      </nav>
    {% endif %}

    <div class="ps__marquee" aria-hidden="true">
      <div>
        <span>DESIGN</span><i>●</i><span>CULTURE</span><i>●</i><span>BUSINESS</span><i>●</i><span>PROCESS</span><i>●</i>
        <span>DESIGN</span><i>●</i><span>CULTURE</span><i>●</i><span>BUSINESS</span><i>●</i><span>PROCESS</span><i>●</i>
      </div>
    </div>

    <section class="ps__episodes" aria-labelledby="EpisodesTitle-{{ section.id }}">
      <div class="ps__section-head">
        <div>
          <p class="ps__eyebrow"><span></span>{{ section.settings.episodes_eyebrow | default: 'Now broadcasting' | escape }}</p>
          <h2 id="EpisodesTitle-{{ section.id }}">{{ section.settings.episodes_heading | default: 'Latest episodes' | escape }}</h2>
        </div>
        {% if section.settings.episodes_note != blank %}<p>{{ section.settings.episodes_note | escape }}</p>{% endif %}
      </div>

      <div class="ps__episode-list">
        {% assign episode_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'episode' %}
            {% assign episode_index = episode_index | plus: 1 %}
            <article class="ps__episode{% if episode_index == 1 %} ps__episode--featured{% endif %}" {{ block.shopify_attributes }}>
              <div class="ps__episode-number">{% if episode_index < 10 %}0{% endif %}{{ episode_index }}</div>
              <div class="ps__episode-copy">
                <div class="ps__meta">
                  {% if block.settings.category != blank %}<span>{{ block.settings.category | escape }}</span>{% endif %}
                  {% if block.settings.duration != blank %}<span>{{ block.settings.duration | escape }}</span>{% endif %}
                </div>
                <h3>{{ block.settings.title | default: 'Episode title' | escape }}</h3>
                {% if block.settings.description != blank %}<div class="ps__episode-description">{{ block.settings.description }}</div>{% endif %}
                {% if block.settings.audio_url != blank %}
                  <audio class="ps__audio" controls preload="metadata">
                    <source src="{{ block.settings.audio_url }}">
                    Your browser does not support the audio player.
                  </audio>
                {% endif %}
              </div>
              {% if block.settings.listen_url != blank %}
                <a class="ps__play" href="{{ block.settings.listen_url }}" aria-label="Listen to {{ block.settings.title | escape }}">
                  <span aria-hidden="true">▶</span><small>Listen</small>
                </a>
              {% else %}
                <div class="ps__play ps__play--decorative" aria-hidden="true"><span>▶</span><small>Listen</small></div>
              {% endif %}
            </article>
          {% endif %}
        {% else %}
          <p>Add episode blocks in the theme editor to publish your show.</p>
        {% endfor %}
      </div>
    </section>

    <section class="ps__about">
      <div class="ps__about-mark" aria-hidden="true">“</div>
      <div>
        <p class="ps__eyebrow"><span></span>{{ section.settings.about_eyebrow | default: 'Behind the mic' | escape }}</p>
        <h2>{{ section.settings.about_heading | default: 'Conversations for people who make things matter.' | escape }}</h2>
      </div>
      <div class="ps__about-copy">
        {% if section.settings.about_text != blank %}{{ section.settings.about_text }}{% endif %}
        {% if section.settings.about_url != blank %}
          <a href="{{ section.settings.about_url }}">{{ section.settings.about_label | default: 'About the show' | escape }} <span aria-hidden="true">→</span></a>
        {% endif %}
      </div>
    </section>

    <footer class="ps__footer-cta">
      <div class="ps__footer-ball" aria-hidden="true"></div>
      <p>{{ section.settings.footer_kicker | default: 'A New Era Designs original' | escape }}</p>
      <h2>{{ section.settings.footer_heading | default: 'Put your headphones on.' | escape }}</h2>
      {% if section.settings.footer_url != blank %}
        <a class="ps__button ps__button--light" href="{{ section.settings.footer_url }}">{{ section.settings.footer_label | default: 'Start listening' | escape }} <span aria-hidden="true">↗</span></a>
      {% endif %}
    </footer>
  </div>
</section>

{% style %}
  #PodcastStudio-{{ section.id }} {
    --ps-ink: {{ section.settings.ink_color }};
    --ps-paper: {{ section.settings.paper_color }};
    --ps-accent: {{ section.settings.accent_color }};
    --ps-hot: {{ section.settings.hot_color }};
    --ps-blue: {{ section.settings.blue_color }};
    --ps-script: "{{ section.settings.script_font | escape }}", "Edwardian Script ITC", "Snell Roundhand", cursive;
    --ps-display: "{{ section.settings.display_font | escape }}", "Mathew Rohas", Georgia, serif;
    --ps-body: "{{ section.settings.body_font | escape }}", Milo, Arial, sans-serif;
    position: relative;
    overflow: hidden;
    color: var(--ps-paper);
    background: var(--ps-ink);
    font-family: var(--ps-body);
  }
  #PodcastStudio-{{ section.id }} * { box-sizing: border-box; }
  #PodcastStudio-{{ section.id }} a { color: inherit; text-decoration: none; }
  #PodcastStudio-{{ section.id }} .ps__shell { position: relative; z-index: 2; width: min(1500px, 100%); margin: 0 auto; }
  #PodcastStudio-{{ section.id }} .ps__noise { position: absolute; inset: 0; z-index: 1; pointer-events: none; opacity: .1; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.45'/%3E%3C/svg%3E"); }
  #PodcastStudio-{{ section.id }} .ps__hero { min-height: 820px; display: grid; grid-template-columns: minmax(0,1.05fr) minmax(380px,.95fr); align-items: center; gap: clamp(40px,7vw,120px); padding: clamp(90px,10vw,150px) clamp(24px,6vw,90px) 90px; }
  #PodcastStudio-{{ section.id }} .ps__hero-copy { position: relative; z-index: 4; }
  #PodcastStudio-{{ section.id }} .ps__eyebrow { display: flex; align-items: center; gap: 12px; margin: 0 0 28px; font-size: 11px; line-height: 1; letter-spacing: .22em; text-transform: uppercase; font-weight: 700; }
  #PodcastStudio-{{ section.id }} .ps__eyebrow span { width: 38px; height: 2px; background: var(--ps-accent); }
  #PodcastStudio-{{ section.id }} .ps__title { margin: 0; line-height: .74; font-weight: 400; }
  #PodcastStudio-{{ section.id }} .ps__title-main { display: block; max-width: 9ch; font-family: var(--ps-display); font-size: clamp(68px,10vw,166px); letter-spacing: -.07em; text-transform: uppercase; }
  #PodcastStudio-{{ section.id }} .ps__title-script { position: relative; display: inline-block; z-index: 2; margin: -.03em 0 .16em .65em; color: var(--ps-accent); font-family: var(--ps-script); font-size: clamp(78px,11vw,184px); line-height: .72; font-weight: 400; transform: rotate(-5deg); text-shadow: 0 4px 0 rgba(0,0,0,.12); }
  #PodcastStudio-{{ section.id }} .ps__intro { max-width: 610px; font-size: clamp(17px,1.55vw,23px); line-height: 1.55; color: rgba(242,234,218,.78); }
  #PodcastStudio-{{ section.id }} .ps__intro p { margin: 0; }
  #PodcastStudio-{{ section.id }} .ps__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 38px; }
  #PodcastStudio-{{ section.id }} .ps__button { min-height: 54px; display: inline-flex; align-items: center; justify-content: center; gap: 28px; padding: 0 24px; border: 1px solid rgba(242,234,218,.32); border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; transition: transform .25s ease, background .25s ease, color .25s ease; }
  #PodcastStudio-{{ section.id }} .ps__button:hover { transform: translateY(-4px) rotate(-1deg); }
  #PodcastStudio-{{ section.id }} .ps__button--primary { color: var(--ps-ink); background: var(--ps-accent); border-color: var(--ps-accent); }
  #PodcastStudio-{{ section.id }} .ps__button--ghost:hover { color: var(--ps-ink); background: var(--ps-paper); }
  #PodcastStudio-{{ section.id }} .ps__hero-art { position: relative; min-height: 620px; display: grid; place-items: center; }
  #PodcastStudio-{{ section.id }} .ps__record { position: relative; width: min(36vw,520px); aspect-ratio: 1; border-radius: 50%; background: repeating-radial-gradient(circle, #171713 0 4px, #25251f 5px 6px, #11110e 7px 12px); box-shadow: 0 30px 90px rgba(0,0,0,.6); animation: ps-spin-{{ section.id }} 24s linear infinite; }
  #PodcastStudio-{{ section.id }} .ps__record-ring { position: absolute; inset: 8%; border: 1px solid rgba(255,255,255,.09); border-radius: 50%; }
  #PodcastStudio-{{ section.id }} .ps__record-label { position: absolute; inset: 27%; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7px; padding: 22px; border-radius: 50%; text-align: center; color: var(--ps-ink); background: var(--ps-hot); }
  #PodcastStudio-{{ section.id }} .ps__record-label img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #PodcastStudio-{{ section.id }} .ps__record-label strong { font-family: var(--ps-script); font-size: clamp(32px,4vw,62px); font-weight: 400; line-height: .8; transform: rotate(-6deg); }
  #PodcastStudio-{{ section.id }} .ps__record-label span, #PodcastStudio-{{ section.id }} .ps__record-label small { font-size: 9px; letter-spacing: .18em; text-transform: uppercase; font-weight: 800; }
  #PodcastStudio-{{ section.id }} .ps__record-hole { position: absolute; top: 50%; left: 50%; width: 15px; aspect-ratio: 1; border-radius: 50%; background: var(--ps-paper); transform: translate(-50%,-50%); box-shadow: 0 0 0 7px var(--ps-ink); }
  #PodcastStudio-{{ section.id }} .ps__needle { position: absolute; top: 5%; right: 0; width: 36%; height: 58%; border-top: 14px solid var(--ps-paper); transform: rotate(22deg); transform-origin: 100% 0; }
  #PodcastStudio-{{ section.id }} .ps__needle:before { content: ''; position: absolute; top: -28px; right: -18px; width: 54px; aspect-ratio: 1; border: 9px solid var(--ps-paper); border-radius: 50%; background: var(--ps-ink); }
  #PodcastStudio-{{ section.id }} .ps__needle span { position: absolute; left: -4px; top: -25px; width: 30px; height: 48px; border-radius: 3px; background: var(--ps-accent); }
  #PodcastStudio-{{ section.id }} .ps__scribble { position: absolute; left: 0; bottom: 9%; font-family: var(--ps-script); font-size: clamp(32px,4vw,58px); transform: rotate(-12deg); }
  #PodcastStudio-{{ section.id }} .ps__orb { position: absolute; z-index: 3; border-radius: 50%; pointer-events: none; box-shadow: inset -14px -18px 28px rgba(0,0,0,.18), 0 18px 40px rgba(0,0,0,.26); }
  #PodcastStudio-{{ section.id }} .ps__orb--one { width: 92px; height: 92px; top: 7%; left: 46%; background: var(--ps-blue); animation: ps-float-a-{{ section.id }} 7s ease-in-out infinite; }
  #PodcastStudio-{{ section.id }} .ps__orb--two { width: 42px; height: 42px; top: 21%; right: 5%; background: var(--ps-accent); animation: ps-float-b-{{ section.id }} 5.5s ease-in-out infinite; }
  #PodcastStudio-{{ section.id }} .ps__orb--three { width: 128px; height: 128px; top: 650px; left: -40px; background: var(--ps-hot); animation: ps-float-b-{{ section.id }} 9s ease-in-out infinite reverse; }
  #PodcastStudio-{{ section.id }} .ps__orb--four { width: 26px; height: 26px; top: 560px; left: 51%; background: var(--ps-paper); animation: ps-float-a-{{ section.id }} 4.5s ease-in-out infinite; }
  #PodcastStudio-{{ section.id }} .ps__platforms { display: flex; align-items: center; flex-wrap: wrap; gap: 0; margin: 0 clamp(24px,6vw,90px) 80px; border-top: 1px solid rgba(242,234,218,.18); border-bottom: 1px solid rgba(242,234,218,.18); }
  #PodcastStudio-{{ section.id }} .ps__platforms > * { padding: 22px 28px; }
  #PodcastStudio-{{ section.id }} .ps__platform-label { margin-right: auto; padding-left: 0; color: rgba(242,234,218,.55); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; }
  #PodcastStudio-{{ section.id }} .ps__platforms a { border-left: 1px solid rgba(242,234,218,.18); font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; transition: color .2s ease, background .2s ease; }
  #PodcastStudio-{{ section.id }} .ps__platforms a:hover { color: var(--ps-ink); background: var(--ps-accent); }
  #PodcastStudio-{{ section.id }} .ps__marquee { overflow: hidden; padding: 20px 0; color: var(--ps-ink); background: var(--ps-accent); transform: rotate(-1.2deg) scale(1.02); }
  #PodcastStudio-{{ section.id }} .ps__marquee div { display: flex; width: max-content; align-items: center; gap: 28px; animation: ps-marquee-{{ section.id }} 24s linear infinite; }
  #PodcastStudio-{{ section.id }} .ps__marquee span { font-family: var(--ps-display); font-size: clamp(28px,4vw,60px); letter-spacing: -.04em; }
  #PodcastStudio-{{ section.id }} .ps__marquee i { font-size: 17px; font-style: normal; }
  #PodcastStudio-{{ section.id }} .ps__episodes { padding: clamp(100px,11vw,170px) clamp(24px,6vw,90px); }
  #PodcastStudio-{{ section.id }} .ps__section-head { display: grid; grid-template-columns: 1fr minmax(220px,390px); align-items: end; gap: 40px; margin-bottom: 55px; }
  #PodcastStudio-{{ section.id }} .ps__section-head h2, #PodcastStudio-{{ section.id }} .ps__about h2, #PodcastStudio-{{ section.id }} .ps__footer-cta h2 { margin: 0; font-family: var(--ps-display); font-size: clamp(52px,7vw,108px); font-weight: 400; letter-spacing: -.055em; line-height: .9; }
  #PodcastStudio-{{ section.id }} .ps__section-head > p { margin: 0; color: rgba(242,234,218,.58); font-size: 14px; line-height: 1.55; }
  #PodcastStudio-{{ section.id }} .ps__episode-list { border-top: 1px solid rgba(242,234,218,.22); }
  #PodcastStudio-{{ section.id }} .ps__episode { display: grid; grid-template-columns: 90px 1fr 100px; gap: 30px; align-items: center; padding: 36px 0; border-bottom: 1px solid rgba(242,234,218,.22); transition: padding .25s ease, background .25s ease; }
  #PodcastStudio-{{ section.id }} .ps__episode:hover { padding-left: 20px; padding-right: 20px; background: rgba(242,234,218,.045); }
  #PodcastStudio-{{ section.id }} .ps__episode-number { align-self: start; color: var(--ps-accent); font-family: var(--ps-display); font-size: 23px; }
  #PodcastStudio-{{ section.id }} .ps__meta { display: flex; flex-wrap: wrap; gap: 18px; margin-bottom: 10px; color: rgba(242,234,218,.52); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; }
  #PodcastStudio-{{ section.id }} .ps__episode h3 { margin: 0; max-width: 22ch; font-family: var(--ps-display); font-size: clamp(28px,3.2vw,52px); font-weight: 400; letter-spacing: -.035em; line-height: 1; }
  #PodcastStudio-{{ section.id }} .ps__episode-description { max-width: 720px; margin-top: 14px; color: rgba(242,234,218,.64); font-size: 14px; line-height: 1.6; }
  #PodcastStudio-{{ section.id }} .ps__episode-description p { margin: 0; }
  #PodcastStudio-{{ section.id }} .ps__audio { width: min(100%,620px); height: 42px; margin-top: 20px; filter: sepia(.2) saturate(.8); }
  #PodcastStudio-{{ section.id }} .ps__play { width: 82px; aspect-ratio: 1; display: grid; place-items: center; align-content: center; gap: 4px; border: 1px solid rgba(242,234,218,.35); border-radius: 50%; transition: transform .25s ease, color .25s ease, background .25s ease; }
  #PodcastStudio-{{ section.id }} .ps__play span { margin-left: 3px; font-size: 18px; }
  #PodcastStudio-{{ section.id }} .ps__play small { font-size: 8px; letter-spacing: .12em; text-transform: uppercase; }
  #PodcastStudio-{{ section.id }} a.ps__play:hover { color: var(--ps-ink); background: var(--ps-accent); border-color: var(--ps-accent); transform: rotate(8deg) scale(1.07); }
  #PodcastStudio-{{ section.id }} .ps__play--decorative { opacity: .38; }
  #PodcastStudio-{{ section.id }} .ps__about { display: grid; grid-template-columns: .35fr 1fr .9fr; gap: clamp(30px,6vw,90px); align-items: start; padding: clamp(80px,9vw,130px) clamp(24px,6vw,90px); color: var(--ps-ink); background: var(--ps-paper); }
  #PodcastStudio-{{ section.id }} .ps__about .ps__eyebrow span { background: var(--ps-hot); }
  #PodcastStudio-{{ section.id }} .ps__about-mark { margin-top: -.18em; color: var(--ps-hot); font-family: var(--ps-script); font-size: clamp(130px,18vw,290px); line-height: .5; transform: rotate(-8deg); }
  #PodcastStudio-{{ section.id }} .ps__about h2 { font-size: clamp(46px,5.6vw,86px); }
  #PodcastStudio-{{ section.id }} .ps__about-copy { padding-top: 52px; font-size: 17px; line-height: 1.65; }
  #PodcastStudio-{{ section.id }} .ps__about-copy p { margin: 0 0 22px; }
  #PodcastStudio-{{ section.id }} .ps__about-copy a { display: inline-flex; gap: 20px; padding-bottom: 4px; border-bottom: 2px solid var(--ps-hot); font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  #PodcastStudio-{{ section.id }} .ps__footer-cta { position: relative; overflow: hidden; min-height: 560px; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 90px 24px; text-align: center; color: var(--ps-ink); background: var(--ps-blue); }
  #PodcastStudio-{{ section.id }} .ps__footer-cta p { margin: 0 0 20px; font-size: 10px; letter-spacing: .2em; text-transform: uppercase; }
  #PodcastStudio-{{ section.id }} .ps__footer-cta h2 { position: relative; z-index: 2; max-width: 11ch; }
  #PodcastStudio-{{ section.id }} .ps__footer-cta .ps__button { position: relative; z-index: 2; margin-top: 38px; border-color: var(--ps-ink); }
  #PodcastStudio-{{ section.id }} .ps__button--light:hover { background: var(--ps-paper); }
  #PodcastStudio-{{ section.id }} .ps__footer-ball { position: absolute; width: min(46vw,630px); aspect-ratio: 1; border-radius: 50%; background: var(--ps-accent); box-shadow: inset -80px -100px 120px rgba(0,0,0,.12); animation: ps-footer-ball-{{ section.id }} 8s ease-in-out infinite; }
  @keyframes ps-spin-{{ section.id }} { to { transform: rotate(360deg); } }
  @keyframes ps-float-a-{{ section.id }} { 0%,100% { transform: translate3d(0,0,0) rotate(0); } 50% { transform: translate3d(24px,-38px,0) rotate(18deg); } }
  @keyframes ps-float-b-{{ section.id }} { 0%,100% { transform: translate3d(0,0,0) scale(1); } 45% { transform: translate3d(-28px,42px,0) scale(.86); } 70% { transform: translate3d(12px,10px,0) scale(1.08); } }
  @keyframes ps-marquee-{{ section.id }} { to { transform: translateX(-50%); } }
  @keyframes ps-footer-ball-{{ section.id }} { 0%,100% { transform: translate(-42%,-3%) scale(.86); } 50% { transform: translate(42%,6%) scale(1.08); } }
  @media (max-width: 989px) {
    #PodcastStudio-{{ section.id }} .ps__hero { min-height: auto; grid-template-columns: 1fr; padding-top: 100px; }
    #PodcastStudio-{{ section.id }} .ps__title-main { max-width: none; }
    #PodcastStudio-{{ section.id }} .ps__title-script { margin-left: .28em; }
    #PodcastStudio-{{ section.id }} .ps__hero-art { min-height: 500px; }
    #PodcastStudio-{{ section.id }} .ps__record { width: min(78vw,500px); }
    #PodcastStudio-{{ section.id }} .ps__section-head { grid-template-columns: 1fr; }
    #PodcastStudio-{{ section.id }} .ps__about { grid-template-columns: .35fr 1.65fr; }
    #PodcastStudio-{{ section.id }} .ps__about-copy { grid-column: 2; padding-top: 0; }
  }
  @media (max-width: 650px) {
    #PodcastStudio-{{ section.id }} .ps__hero { gap: 10px; padding-left: 20px; padding-right: 20px; }
    #PodcastStudio-{{ section.id }} .ps__title-main { font-size: clamp(58px,20vw,92px); }
    #PodcastStudio-{{ section.id }} .ps__title-script { font-size: clamp(70px,25vw,116px); }
    #PodcastStudio-{{ section.id }} .ps__hero-art { min-height: 390px; }
    #PodcastStudio-{{ section.id }} .ps__needle { right: 4%; }
    #PodcastStudio-{{ section.id }} .ps__platforms { margin-left: 20px; margin-right: 20px; }
    #PodcastStudio-{{ section.id }} .ps__platform-label { width: 100%; border-bottom: 1px solid rgba(242,234,218,.18); }
    #PodcastStudio-{{ section.id }} .ps__platforms a { flex: 1 1 50%; padding: 18px 14px; }
    #PodcastStudio-{{ section.id }} .ps__episodes { padding-left: 20px; padding-right: 20px; }
    #PodcastStudio-{{ section.id }} .ps__episode { grid-template-columns: 42px 1fr; gap: 16px; }
    #PodcastStudio-{{ section.id }} .ps__episode .ps__play { grid-column: 2; width: 66px; margin-top: 8px; }
    #PodcastStudio-{{ section.id }} .ps__about { grid-template-columns: 1fr; padding-left: 20px; padding-right: 20px; }
    #PodcastStudio-{{ section.id }} .ps__about-mark { display: none; }
    #PodcastStudio-{{ section.id }} .ps__about-copy { grid-column: auto; }
    #PodcastStudio-{{ section.id }} .ps__orb--one { left: auto; right: -20px; }
    #PodcastStudio-{{ section.id }} .ps__orb--three { width: 82px; height: 82px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #PodcastStudio-{{ section.id }} .ps__orb,
    #PodcastStudio-{{ section.id }} .ps__record,
    #PodcastStudio-{{ section.id }} .ps__marquee div,
    #PodcastStudio-{{ section.id }} .ps__footer-ball { animation: none !important; }
    #PodcastStudio-{{ section.id }} * { scroll-behavior: auto !important; }
  }
{% endstyle %}

