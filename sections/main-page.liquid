{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{% liquid
  assign section_key = section.id | replace: '_', '' | downcase
  assign portrait_url = section.settings.portrait_url | strip
%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .ned-about-{{ section_key }} {
    --ned-ink: #111111;
    --ned-navy: #111d3a;
    --ned-gold: #d0a83f;
    --ned-highlight-one: rgba(255, 230, 150, 0.8);
    --ned-highlight-two: rgba(255, 210, 120, 0.95);
    --ned-paper: #f7f6f2;
    --ned-line: rgba(17, 17, 17, 0.14);
    color: var(--ned-ink);
  }

  .ned-about-{{ section_key }} * {
    box-sizing: border-box;
  }

  .ned-about-shell-{{ section_key }} {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
  }

  .ned-about-hero-{{ section_key }} {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(520px, 0.95fr);
    gap: 0;
    align-items: start;
    min-height: 0;
    padding: clamp(12px, 2vw, 24px) clamp(20px, 3vw, 44px) 0;
    background: #ffffff;
  }

  .ned-about-eyebrow-{{ section_key }},
  .ned-about-section-label-{{ section_key }} {
    display: block;
    color: var(--ned-gold);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.18em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .ned-about-title-{{ section_key }} {
    position: relative;
    z-index: 4;
    max-width: 800px;
    margin: 10px 0 0;
    color: var(--ned-ink);
    font-size: clamp(42px, 6vw, 78px);
    font-weight: 900;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .ned-about-title-accent-{{ section_key }} {
    display: inline-block;
    margin: 0 -0.05em;
    color: #f0a22e;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 112%;
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.8;
    transform: translateY(0.06em);
  }

  .ned-about-intro-{{ section_key }} {
    max-width: 720px;
    margin: 20px 0 0;
    color: #494949;
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.52;
  }

  .ned-about-highlight-{{ section_key }} {
    background-image: linear-gradient(120deg, var(--ned-highlight-one), var(--ned-highlight-two));
    background-position: 0 90%;
    background-repeat: no-repeat;
    background-size: 0% 55%;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: background-size 0.7s ease-out;
  }

  .ned-about-highlight-{{ section_key }}.active {
    background-size: 100% 55%;
  }

  .ned-about-circle-{{ section_key }} {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  .ned-about-circle-{{ section_key }}::after {
    content: "";
    position: absolute;
    inset: -5px -9px;
    border: 2px solid rgba(208, 168, 63, 0);
    border-radius: 48% 52% 46% 54%;
    opacity: 0;
    pointer-events: none;
    transform: scale(0.88) rotate(-1.5deg);
    transition: transform 0.6s ease-out, opacity 0.5s ease-out, border-color 0.5s ease-out;
  }

  .ned-about-circle-{{ section_key }}.active::after {
    border-color: rgba(208, 168, 63, 0.9);
    opacity: 1;
    transform: scale(1) rotate(-1.5deg);
  }

  .ned-about-{{ section_key }}.ned-highlights-off .ned-about-highlight-{{ section_key }} {
    background-image: none;
  }

  .ned-about-{{ section_key }}.ned-circles-off .ned-about-circle-{{ section_key }}::after {
    display: none;
  }

  .ned-about-portrait-wrap-{{ section_key }} {
    position: relative;
    z-index: 1;
    justify-self: end;
    width: {{ section.settings.portrait_max_width }}px;
    max-width: min(1000px, 82vw);
    margin-left: auto;
    transform: translateX({{ section.settings.portrait_horizontal_offset }}px);
  }

  @media (min-width: 901px) {
    .ned-about-hero-{{ section_key }} > div:first-child {
      position: relative;
      z-index: 3;
    }

    .ned-about-title-{{ section_key }} {
      width: calc(100% + clamp(150px, 17vw, 250px));
      max-width: none;
      text-shadow: none;
    }

    .ned-about-portrait-wrap-{{ section_key }} {
      margin-left: 0;
    }
  }

  .about-image-system-frame {
    position: relative;
    isolation: isolate;
    width: 100%;
    padding: 0;
    transition: transform 0.24s ease;
  }

  .about-image-system-frame:hover {
    transform: translateY(-2px);
  }

  .ned-about-image-route-{{ section_key }} {
    position: absolute;
    inset: -28px -34px;
    z-index: 0;
    opacity: 0.28;
    pointer-events: none;
    transition: opacity 0.24s ease;
  }

  .ned-about-image-route-{{ section_key }}::before,
  .ned-about-image-route-{{ section_key }}::after {
    content: "";
    position: absolute;
    border-color: var(--ned-gold);
    border-style: solid;
  }

  .ned-about-image-route-{{ section_key }}::before {
    top: 15%;
    left: 0;
    width: 82%;
    height: 38%;
    border-width: 1px 1px 0 0;
    transform: skewY(-4deg);
  }

  .ned-about-image-route-{{ section_key }}::after {
    right: 0;
    bottom: 12%;
    width: 68%;
    height: 32%;
    border-width: 0 0 1px 1px;
    transform: skewY(5deg);
  }

  .about-image-system-frame:hover .ned-about-image-route-{{ section_key }} {
    opacity: 0.48;
  }

  .ned-about-image-viewport-{{ section_key }} {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: visible;
    border: 0;
    background: #ffffff;
  }

  .ned-about-portrait-{{ section_key }} {
    display: block;
    width: min({{ section.settings.portrait_image_width }}px, 100%);
    max-width: none;
    height: auto;
    aspect-ratio: auto;
    border-radius: 0;
    object-fit: contain;
    object-position: center center;
    margin: 0 auto;
    padding: 0;
    background: #ffffff;
    filter: saturate(0.92) contrast(1.02);
    transform: scale(1);
    transition: filter 0.35s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-image-system-frame:hover .ned-about-portrait-{{ section_key }} {
    filter: saturate(1) contrast(1.035);
    transform: scale(1.025);
  }

  .ned-about-image-corner-{{ section_key }} {
    position: absolute;
    z-index: 4;
    width: 34px;
    height: 34px;
    opacity: 0.58;
    pointer-events: none;
    transition: opacity 0.24s ease, transform 0.24s ease;
  }

  .ned-about-image-corner-{{ section_key }}--tl {
    top: 0;
    left: 0;
    border-top: 1px solid var(--ned-gold);
    border-left: 1px solid var(--ned-gold);
  }

  .ned-about-image-corner-{{ section_key }}--tr {
    top: 0;
    right: 0;
    border-top: 1px solid var(--ned-gold);
    border-right: 1px solid var(--ned-gold);
  }

  .ned-about-image-corner-{{ section_key }}--bl {
    bottom: 0;
    left: 0;
    border-bottom: 1px solid var(--ned-gold);
    border-left: 1px solid var(--ned-gold);
  }

  .ned-about-image-corner-{{ section_key }}--br {
    right: 0;
    bottom: 0;
    border-right: 1px solid var(--ned-gold);
    border-bottom: 1px solid var(--ned-gold);
  }

  .about-image-system-frame:hover .ned-about-image-corner-{{ section_key }} {
    opacity: 0.95;
    transform: scale(1.04);
  }

  .ned-about-image-coordinate-{{ section_key }} {
    position: absolute;
    z-index: 5;
    color: var(--ned-navy);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ned-about-image-coordinate-{{ section_key }}--top {
    top: -25px;
    left: 12px;
  }

  .ned-about-image-coordinate-{{ section_key }}--bottom {
    right: 12px;
    bottom: -29px;
    text-align: right;
  }

  .ned-about-portrait-caption-{{ section_key }} {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin: 44px 12px 0;
    border-top: 1px solid rgba(208, 168, 63, 0.52);
    background: transparent;
    color: var(--ned-navy);
    padding: 13px 0 0;
  }

  .ned-about-portrait-caption-{{ section_key }} strong {
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  .ned-about-portrait-caption-{{ section_key }} span {
    color: #e2c365;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-align: right;
    text-transform: uppercase;
  }

  .ned-about-story-{{ section_key }} {
    display: grid;
    grid-template-columns: minmax(220px, 0.36fr) minmax(0, 0.64fr);
    gap: clamp(38px, 8vw, 110px);
    padding: clamp(42px, 6vw, 76px) 0;
  }

  .ned-about-story-{{ section_key }} h2,
  .ned-about-capabilities-{{ section_key }} h2,
  .ned-about-process-{{ section_key }} h2 {
    margin: 14px 0 0;
    font-size: clamp(34px, 4.8vw, 62px);
    font-weight: 850;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .ned-about-story-copy-{{ section_key }} p {
    margin: 0 0 22px;
    color: #4b4b4b;
    font-size: clamp(16px, 1.7vw, 20px);
    line-height: 1.75;
  }

  .ned-about-story-copy-{{ section_key }} p:last-child {
    margin-bottom: 0;
  }

  .ned-about-capabilities-{{ section_key }} {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(44px, 6vw, 72px);
    background: var(--ned-navy);
    color: #ffffff;
  }

  /* NED spatial motion layer: route grid, path nodes, and card response */
  .ned-about-capabilities-{{ section_key }}::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, {{ section.settings.guide_opacity | divided_by: 100.0 }}) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, {{ section.settings.guide_opacity | divided_by: 100.0 }}) 1px, transparent 1px);
    background-size: 72px 72px;
    pointer-events: none;
  }

  .ned-about-capabilities-{{ section_key }} > * {
    position: relative;
    z-index: 2;
  }

  .ned-about-capabilities-{{ section_key }} h2 {
    max-width: 760px;
    color: #ffffff;
  }

  .ned-about-capability-grid-{{ section_key }} {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 44px;
  }

  .ned-about-capability-{{ section_key }} {
    position: relative;
    min-height: 250px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    padding: 28px;
    background: rgba(17, 29, 58, 0.9);
    box-shadow: 0 12px 34px rgba(0, 0, 0, 0);
    transition: transform 0.24s ease, border-color 0.24s ease, box-shadow 0.24s ease;
  }

  .ned-about-capability-{{ section_key }}::after {
    content: "";
    position: absolute;
    left: 28px;
    bottom: 22px;
    width: 0;
    height: 2px;
    background: var(--ned-gold);
    transition: width 0.28s ease;
  }

  .ned-about-capability-{{ section_key }}:hover,
  .ned-about-capability-{{ section_key }}:focus-within {
    border-color: rgba(226, 195, 101, 0.75);
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.16);
    transform: translateY(-3px);
  }

  .ned-about-capability-{{ section_key }}:hover::after,
  .ned-about-capability-{{ section_key }}:focus-within::after {
    width: 54px;
  }

  .ned-about-capability-{{ section_key }} span {
    color: #e2c365;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  .ned-about-capability-{{ section_key }} h3 {
    margin: 38px 0 14px;
    color: #ffffff;
    font-size: clamp(22px, 2.4vw, 31px);
    font-weight: 800;
    line-height: 1.08;
  }

  .ned-about-capability-{{ section_key }} p {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 15px;
    line-height: 1.65;
  }

  .ned-about-process-{{ section_key }} {
    padding: clamp(44px, 6vw, 76px) 0;
  }

  .ned-about-process-grid-{{ section_key }} {
    display: grid;
    grid-template-columns: minmax(320px, 0.52fr) minmax(0, 0.48fr);
    gap: clamp(40px, 8vw, 100px);
    margin-top: 44px;
  }

  .ned-about-deliverables-{{ section_key }} {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ned-about-deliverables-{{ section_key }} li {
    position: relative;
    border-top: 1px solid var(--ned-line);
    padding: 17px 12px 17px 22px;
    color: #292929;
    font-size: 20px;
    font-weight: 650;
    line-height: 1.42;
    transition: background-color 0.2s ease, color 0.2s ease, padding-left 0.2s ease;
  }

  .ned-about-deliverables-{{ section_key }} li::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 4px;
    width: 10px;
    height: 1px;
    background: var(--ned-gold);
    transform: translateY(-50%);
    transition: transform 0.2s ease, width 0.2s ease;
  }

  .ned-about-deliverables-{{ section_key }} li:hover {
    padding-left: 27px;
    background: rgba(208, 168, 63, 0.08);
    color: #111111;
  }

  .ned-about-deliverables-{{ section_key }} li:hover::before {
    width: 15px;
    transform: translateY(-50%);
  }

  .ned-about-value-{{ section_key }} {
    display: flex;
    align-items: center;
    border-left: 4px solid var(--ned-gold);
    background: var(--ned-paper);
    padding: clamp(28px, 4vw, 48px);
  }

  .ned-about-value-{{ section_key }} p {
    margin: 0;
    color: #292929;
    font-size: clamp(20px, 2.3vw, 29px);
    font-weight: 650;
    line-height: 1.42;
  }

  .ned-about-cta-{{ section_key }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    border-top: 1px solid var(--ned-line);
    padding: 28px 0 6px;
  }

  .ned-about-cta-{{ section_key }} p {
    margin: 0;
    font-size: clamp(22px, 3vw, 38px);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .ned-about-cta-{{ section_key }} a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border: 1px solid var(--ned-navy);
    background: var(--ned-navy);
    color: #ffffff;
    padding: 12px 20px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .ned-about-cta-{{ section_key }} a:hover {
    background: transparent;
    color: var(--ned-navy);
  }

  .ned-about-original-{{ section_key }} {
    margin-top: 64px;
  }

  @media (max-width: 900px) {
    .ned-about-hero-{{ section_key }},
    .ned-about-story-{{ section_key }},
    .ned-about-process-grid-{{ section_key }} {
      grid-template-columns: 1fr;
    }

    .ned-about-portrait-wrap-{{ section_key }} {
      width: min(calc(100vw - 48px), {{ section.settings.portrait_mobile_width }}px);
      max-width: calc(100vw - 48px);
      justify-self: center;
      margin: 10px auto 0;
      transform: none;
    }

    .ned-about-hero-{{ section_key }} {
      padding: 14px 16px 0;
    }

    .ned-about-title-{{ section_key }} {
      margin-top: 9px;
    }

    .ned-about-intro-{{ section_key }} {
      margin-top: 18px;
      line-height: 1.5;
    }

    .ned-about-image-viewport-{{ section_key }} {
      width: 100%;
      aspect-ratio: auto;
    }

    .ned-about-portrait-{{ section_key }} {
      width: min({{ section.settings.portrait_mobile_image_width }}px, 100%);
      max-width: none;
      height: auto;
      aspect-ratio: auto;
      object-fit: contain;
      object-position: center center;
    }

    .ned-about-capabilities-{{ section_key }} {
      padding: 36px 20px;
    }

    .ned-about-capability-grid-{{ section_key }} {
      grid-template-columns: 1fr;
    }

    .ned-about-capability-{{ section_key }} {
      min-height: 0;
    }

    .ned-about-deliverables-{{ section_key }} {
      grid-template-columns: 1fr;
    }

    .ned-about-cta-{{ section_key }} {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ned-about-highlight-{{ section_key }} {
      background-size: 100% 55%;
      transition: none;
    }

    .ned-about-circle-{{ section_key }}::after {
      border-color: rgba(208, 168, 63, 0.9);
      opacity: 1;
      transform: none;
      transition: none;
    }

    .about-image-system-frame,
    .ned-about-image-route-{{ section_key }},
    .ned-about-image-corner-{{ section_key }},
    .ned-about-portrait-{{ section_key }} {
      transition: none;
    }

    .about-image-system-frame:hover,
    .about-image-system-frame:hover .ned-about-portrait-{{ section_key }} {
      transform: none;
    }

    .ned-about-capability-{{ section_key }},
    .ned-about-capability-{{ section_key }}::after,
    .ned-about-deliverables-{{ section_key }} li,
    .ned-about-deliverables-{{ section_key }} li::before {
      transition: none;
    }
  }
{%- endstyle -%}

{% if page.handle == 'info' and section.settings.enable_about_layout %}
  <section class="ned-about-{{ section_key }} section-{{ section.id }}-padding{% unless section.settings.show_highlights %} ned-highlights-off{% endunless %}{% unless section.settings.show_paragraph_circle %} ned-circles-off{% endunless %}">
    <div class="ned-about-shell-{{ section_key }}">
      <div class="ned-about-hero-{{ section_key }}">
        <div>
          <span class="ned-about-eyebrow-{{ section_key }}">{{ section.settings.eyebrow }}</span>
          {% liquid
            assign title_accent_word = section.settings.title_accent_word | default: 'places'
            assign title_accent_replacement = title_accent_word
          %}
          {% if section.settings.show_title_accent %}
            {% capture title_accent_replacement %}<span class="ned-about-title-accent-{{ section_key }}">{{ title_accent_word }}</span>{% endcapture %}
          {% endif %}
          <h1 class="ned-about-title-{{ section_key }}">{{ section.settings.main_heading | replace: title_accent_word, title_accent_replacement }}</h1>
          <p class="ned-about-intro-{{ section_key }}">
            {{ section.settings.intro_lead }}
            <span class="ned-about-highlight-{{ section_key }}">{{ section.settings.intro_highlight }}</span>
            {{ section.settings.intro_tail }}
          </p>
        </div>

        {% if portrait_url != blank %}
          <figure class="ned-about-portrait-wrap-{{ section_key }}">
            <div class="about-image-system-frame">
              <div class="ned-about-image-viewport-{{ section_key }}">
                <img
                  class="ned-about-portrait-{{ section_key }}"
                  src="{{ portrait_url | escape }}"
                  alt="{{ section.settings.portrait_alt | escape }}"
                  width="900"
                  height="900"
                  loading="eager">
              </div>
            </div>
          </figure>
        {% endif %}
      </div>

      <div class="ned-about-story-{{ section_key }}">
        <div>
          <span class="ned-about-section-label-{{ section_key }}">What I do</span>
          <h2>Design thinking grounded in how places actually work.</h2>
        </div>
        <div class="ned-about-story-copy-{{ section_key }}">
          <p>I help commercial properties, retail environments, and design partners turn operational and brand requirements into <span class="ned-about-highlight-{{ section_key }}">organized visual systems</span>.</p>
          <p>The work sits between <span class="ned-about-highlight-{{ section_key }}">creative direction and technical production</span>: shaping the visual language, mapping visitor decisions, preparing <span class="ned-about-highlight-{{ section_key }}">fabrication-aware layouts</span>, and coordinating the details that carry an idea from concept toward installation.</p>
          <p>That means the design is not only attractive. It is built to support <span class="ned-about-highlight-{{ section_key }}">navigation, consistency, decision-making, and real-world execution</span>.</p>
        </div>
      </div>

      <div class="ned-about-capabilities-{{ section_key }}">
        <span class="ned-about-section-label-{{ section_key }}">Core capabilities</span>
        <h2>One connected system—from identity to installation.</h2>
        <div class="ned-about-capability-grid-{{ section_key }}">
          <article class="ned-about-capability-{{ section_key }} capability-card">
            <span>01</span>
            <h3>Brand systems and environments</h3>
            <p>Visual language, hierarchy, environmental graphics, channel letters, window graphics, and branded installation concepts.</p>
          </article>
          <article class="ned-about-capability-{{ section_key }} capability-card">
            <span>02</span>
            <h3>Wayfinding and signage</h3>
            <p>Directional logic, sign families, tenant visibility, landlord templates, and 2D or 3D design reviews.</p>
          </article>
          <article class="ned-about-capability-{{ section_key }} capability-card">
            <span>03</span>
            <h3>Project coordination</h3>
            <p>Client and fabricator layouts, permit coordination, installer communication, production preparation, and concept-to-install support.</p>
          </article>
        </div>
      </div>

      <div class="ned-about-process-{{ section_key }}">
        <span class="ned-about-section-label-{{ section_key }}">The working layer</span>
        <h2>What the work can include</h2>
        <div class="ned-about-process-grid-{{ section_key }}">
          <ul class="ned-about-deliverables-{{ section_key }} work-list" aria-label="Design deliverables">
            <li class="work-list-item">Channel-letter and sign layouts</li>
            <li class="work-list-item">Yard signs and window graphics</li>
            <li class="work-list-item">Landlord and repeat-client templates</li>
            <li class="work-list-item">Advertising and marketing materials</li>
            <li class="work-list-item">Fabricator-ready presentation layouts</li>
            <li class="work-list-item">Permit tracking and coordination</li>
            <li class="work-list-item">CNC preparation, nesting, and scaling</li>
            <li class="work-list-item">Third-party installer coordination</li>
          </ul>
          <div class="ned-about-value-{{ section_key }}">
            <p>Better visual planning helps people <span class="ned-about-highlight-{{ section_key }}">find entrances, understand circulation, and notice tenants</span> so they move through a property with <span class="ned-about-circle-{{ section_key }}">less friction</span>—without asking the front desk for directions.</p>
          </div>
        </div>
      </div>

      <div class="ned-about-cta-{{ section_key }}">
        <p>{{ section.settings.cta_heading }}</p>
        {% if section.settings.cta_link != blank %}
          <a href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }} &rarr;</a>
        {% endif %}
      </div>

      {% if section.settings.show_page_content and page.content != blank %}
        <div class="ned-about-original-{{ section_key }} rte">
          {{ page.content }}
        </div>
      {% endif %}
    </div>
  </section>
{% else %}
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {{ page.content }}
    </div>
  </div>
{% endif %}

<script>
  (function() {
    function initMotionField(canvas) {
      if (!canvas || canvas.dataset.nedMotionReady === 'true') return;
      canvas.dataset.nedMotionReady = 'true';

      var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) return;

      var context = canvas.getContext('2d');
      var nodes = [];
      var animationFrame = null;
      var isVisible = true;
      var width = 0;
      var height = 0;
      var count = Math.max(2, parseInt(canvas.dataset.nodeCount || '4', 10));
      var minRadius = Math.max(3, parseInt(canvas.dataset.nodeMin || '6', 10));
      var maxRadius = Math.max(minRadius, parseInt(canvas.dataset.nodeMax || '12', 10));
      var speed = Math.max(0.04, parseFloat(canvas.dataset.nodeSpeed || '2') * 0.055);
      var nodeOpacity = Math.max(0.04, parseInt(canvas.dataset.nodeOpacity || '16', 10) / 100);
      var routeOpacity = Math.max(0.02, parseInt(canvas.dataset.routeOpacity || '8', 10) / 100);
      var colors = [canvas.dataset.colorOne || '#D0A83F', canvas.dataset.colorTwo || '#FFFFFF'];

      function resizeCanvas() {
        var rectangle = canvas.getBoundingClientRect();
        var ratio = Math.min(window.devicePixelRatio || 1, 2);
        width = Math.max(1, rectangle.width);
        height = Math.max(1, rectangle.height);
        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
        context.setTransform(ratio, 0, 0, ratio, 0, 0);

        nodes.forEach(function(node) {
          node.x = Math.min(width - node.radius, Math.max(node.radius, node.x));
          node.y = Math.min(height - node.radius, Math.max(node.radius, node.y));
        });
      }

      function createNodes() {
        nodes = [];
        for (var index = 0; index < count; index += 1) {
          var radius = minRadius + Math.random() * (maxRadius - minRadius);
          nodes.push({
            x: radius + Math.random() * Math.max(1, width - radius * 2),
            y: radius + Math.random() * Math.max(1, height - radius * 2),
            radius: radius,
            color: colors[index % colors.length],
            vx: (Math.random() > 0.5 ? 1 : -1) * speed * (0.65 + Math.random() * 0.7),
            vy: (Math.random() > 0.5 ? 1 : -1) * speed * (0.65 + Math.random() * 0.7)
          });
        }
      }

      function drawField() {
        context.clearRect(0, 0, width, height);

        context.save();
        context.globalAlpha = routeOpacity;
        context.strokeStyle = colors[0];
        context.lineWidth = 1;
        context.setLineDash([7, 12]);
        context.beginPath();
        nodes.forEach(function(node, index) {
          if (index === 0) context.moveTo(node.x, node.y);
          else context.lineTo(node.x, node.y);
        });
        context.stroke();
        context.restore();

        nodes.forEach(function(node) {
          context.save();
          context.globalAlpha = nodeOpacity;
          context.fillStyle = node.color;
          context.beginPath();
          context.arc(node.x, node.y, node.radius, 0, Math.PI * 2);
          context.fill();

          context.globalAlpha = Math.min(0.55, nodeOpacity * 2.2);
          context.strokeStyle = node.color;
          context.lineWidth = 1;
          context.beginPath();
          context.arc(node.x, node.y, node.radius + 5, 0, Math.PI * 2);
          context.stroke();
          context.restore();
        });
      }

      function animate() {
        animationFrame = null;
        if (!canvas.isConnected || !isVisible) return;

        nodes.forEach(function(node) {
          node.x += node.vx;
          node.y += node.vy;

          if (node.x <= node.radius || node.x >= width - node.radius) {
            node.vx *= -1;
            node.x = Math.min(width - node.radius, Math.max(node.radius, node.x));
          }
          if (node.y <= node.radius || node.y >= height - node.radius) {
            node.vy *= -1;
            node.y = Math.min(height - node.radius, Math.max(node.radius, node.y));
          }
        });

        drawField();
        animationFrame = requestAnimationFrame(animate);
      }

      function startAnimation() {
        if (!animationFrame && isVisible) animationFrame = requestAnimationFrame(animate);
      }

      resizeCanvas();
      createNodes();
      drawField();
      startAnimation();

      if ('ResizeObserver' in window) {
        new ResizeObserver(function() {
          resizeCanvas();
          drawField();
        }).observe(canvas);
      } else {
        window.addEventListener('resize', function() {
          resizeCanvas();
          drawField();
        });
      }

      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            isVisible = entry.isIntersecting;
            if (isVisible) startAnimation();
            else if (animationFrame) {
              cancelAnimationFrame(animationFrame);
              animationFrame = null;
            }
          });
        }, { threshold: 0.08 }).observe(canvas);
      }
    }

    function initNedAbout() {
      var section = document.querySelector('.ned-about-{{ section_key }}');
      if (!section) return;

      var highlights = section.querySelectorAll('.ned-about-highlight-{{ section_key }}:not([data-ned-ready]), .ned-about-circle-{{ section_key }}:not([data-ned-ready])');

      if (!('IntersectionObserver' in window)) {
        highlights.forEach(function(item) {
          item.dataset.nedReady = 'true';
          item.classList.add('active');
        });
      } else {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('active');
            } else {
              entry.target.classList.remove('active');
            }
          });
        }, { threshold: 0.5 });

        highlights.forEach(function(item) {
          item.dataset.nedReady = 'true';
          observer.observe(item);
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNedAbout);
    } else {
      initNedAbout();
    }

    document.addEventListener('shopify:section:load', initNedAbout);
  })();
</script>

