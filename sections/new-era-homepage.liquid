{% comment %}
  New Era Designs — Editable Homepage System
  ------------------------------------------------------------
  Purpose:
  - Rebuild the image-slide homepage as searchable, semantic HTML.
  - Preserve the New Era visual language: navy, orange, halftone,
    route lines, editorial grids, bold display type, and thin body type.
  - Keep all copy, images, colors, typography, spacing, and cards
    editable in Shopify's Visual Editor.

  Editing guide:
  - Global typography and colors live in the section settings.
  - Hero, positioning, audience image, CTA, and spacing are section settings.
  - Capabilities, audiences, services, metrics, process steps, cases,
    testimonials, and FAQs are repeatable blocks.
  - Decorative elements are CSS only and hidden from assistive technology.
  - Do not replace live headings with text baked into images.
{% endcomment %}

{% liquid
  assign display_font = section.settings.display_font
  assign body_font = section.settings.body_font
%}

{% style %}
  {{ display_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  /* ==========================================================
     SECTION TOKENS — controlled from the Shopify Visual Editor
     ========================================================== */
  #NewEraHome-{{ section.id }} {
    --ne-navy: {{ section.settings.navy }};
    --ne-orange: {{ section.settings.orange }};
    --ne-paper: {{ section.settings.paper }};
    --ne-ink: {{ section.settings.ink }};
    --ne-muted: {{ section.settings.muted }};
    --ne-radius: {{ section.settings.card_radius }}px;
    --ne-max: {{ section.settings.max_width }}px;
    --ne-display: {{ display_font.family }}, {{ display_font.fallback_families }};
    --ne-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    background-color: var(--ne-navy);
    {% if section.settings.site_background != blank %}
      background-image: url('{{ section.settings.site_background | image_url: width: 2400 }}');
    {% else %}
      background-image: none;
    {% endif %}
    background-position:center top;
    background-repeat:repeat-y;
    background-size:100% auto;
    color: #fff;
    font-family: var(--ne-body);
    font-style: {{ body_font.style }};
    font-weight: 300;
    overflow: clip;
  }

  #NewEraHome-{{ section.id }} *,
  #NewEraHome-{{ section.id }} *::before,
  #NewEraHome-{{ section.id }} *::after { box-sizing: border-box; }

  #NewEraHome-{{ section.id }} a { color: inherit; }
  #NewEraHome-{{ section.id }} img { display: block; max-width: 100%; }
  #NewEraHome-{{ section.id }} p { margin: 0; }

  #NewEraHome-{{ section.id }} .ne-shell {
    width: min(calc(100% - 40px), var(--ne-max));
    margin-inline: auto;
  }

  #NewEraHome-{{ section.id }} .ne-section {
    position: relative;
    padding-block: clamp(72px, 9vw, 148px);
  }

  #NewEraHome-{{ section.id }} .ne-kicker {
    margin: 0 0 18px;
    color: var(--ne-orange);
    font-family: var(--ne-display);
    font-size: clamp(.72rem, .9vw, .88rem);
    font-weight: 800;
    letter-spacing: .18em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #NewEraHome-{{ section.id }} .ne-display,
  #NewEraHome-{{ section.id }} h1,
  #NewEraHome-{{ section.id }} h2,
  #NewEraHome-{{ section.id }} h3 {
    font-family: var(--ne-display);
    font-style: {{ display_font.style }};
    font-weight: 900;
    letter-spacing: -.045em;
    margin: 0;
    text-wrap: balance;
  }

  #NewEraHome-{{ section.id }} .ne-heading {
    font-size: clamp(2.5rem, 6vw, 6.8rem);
    line-height: .91;
    text-transform: uppercase;
  }

  #NewEraHome-{{ section.id }} .ne-subheading {
    font-size: clamp(2rem, 4.1vw, 4.8rem);
    line-height: .96;
    text-transform: uppercase;
  }

  #NewEraHome-{{ section.id }} .ne-body {
    font-size: clamp(1rem, 1.28vw, 1.28rem);
    font-weight: 300;
    line-height: 1.62;
    max-width: 68ch;
  }

  #NewEraHome-{{ section.id }} .ne-btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  #NewEraHome-{{ section.id }} .ne-btn {
    align-items: center;
    border: 2px solid currentColor;
    border-radius: 999px;
    display: inline-flex;
    font-family: var(--ne-display);
    font-size: .9rem;
    font-weight: 800;
    gap: 16px;
    justify-content: center;
    letter-spacing: .08em;
    min-height: 48px;
    padding: 13px 24px;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform .2s ease, background-color .2s ease, color .2s ease;
  }

  #NewEraHome-{{ section.id }} .ne-btn::after { content: '↗'; font-size: 1.15em; }
  #NewEraHome-{{ section.id }} .ne-btn:hover { transform: translateY(-2px); }
  #NewEraHome-{{ section.id }} .ne-btn--primary { background: var(--ne-orange); border-color: var(--ne-orange); color: var(--ne-navy); }
  #NewEraHome-{{ section.id }} .ne-btn--secondary { background: transparent; color: currentColor; }

  /* The uploaded texture SVG is the only texture source. */
  #NewEraHome-{{ section.id }} .ne-dots::before {
    content: none;
  }

  /* ==========================================================
     HERO — mixed-weight typography with optional archer artwork
     ========================================================== */
  #NewEraHome-{{ section.id }} .ne-hero {
    align-items: center;
    background: var(--ne-paper);
    border-top: 7px solid var(--ne-navy);
    display: grid;
    min-height: {{ section.settings.hero_min_height }}vh;
    overflow: hidden;
    padding-block: clamp(86px, 12vw, 180px);
    position: relative;
  }

  #NewEraHome-{{ section.id }} .ne-hero-grid {
    align-items: center;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    position: relative;
    text-align: center;
    z-index: 1;
  }

  #NewEraHome-{{ section.id }} .ne-hero-content { max-width: 920px; position: relative; z-index: 2; }
  #NewEraHome-{{ section.id }} .ne-hero .ne-kicker { color: var(--ne-navy); margin-bottom: 8px; opacity: .76; }

  #NewEraHome-{{ section.id }} .ne-hero h1 {
    color: var(--ne-navy);
    font-size: clamp(3.1rem, 7.2vw, 8.8rem);
    line-height: .82;
    max-width: 12ch;
    text-transform: uppercase;
  }

  #NewEraHome-{{ section.id }} .ne-hero h1 em {
    color: var(--ne-orange);
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: .78em;
    font-weight: 400;
    letter-spacing: -.07em;
    line-height: .92;
    text-transform: none;
  }

  #NewEraHome-{{ section.id }} .ne-hero-copy { color: var(--ne-navy); margin: 24px auto 0; max-width: 58ch; }
  #NewEraHome-{{ section.id }} .ne-hero .ne-btn-row { justify-content: center; }
  /* Quiet mythic layer: the archer supports the identity without competing with the wordmark. */
  #NewEraHome-{{ section.id }} .ne-hero-art { inset: 2% 0 0; pointer-events: none; position: absolute; z-index: 0; }
  #NewEraHome-{{ section.id }} .ne-hero-art img { filter: grayscale(1) sepia(.25); height: 100%; inset: 0; mix-blend-mode: multiply; object-fit: contain; object-position: center; opacity: .075; position: absolute; width: 100%; }

  /* Animated logo is the visual title; the adjacent H1 stays live for SEO and accessibility. */
  #NewEraHome-{{ section.id }} .ne-logo-title { margin: 12px auto 22px; max-width: min(520px, 72vw); position: relative; width: 100%; }
  #NewEraHome-{{ section.id }} .ne-logo-title img { display: block; height: auto; transform-origin: 50% 60%; width: 100%; }
  #NewEraHome-{{ section.id }}.is-high-energy .ne-logo-title img { animation: neLogoArrive-{{ section.id }} 1.15s cubic-bezier(.16,1,.3,1) both; }
  #NewEraHome-{{ section.id }}.is-high-energy .ne-logo-title:hover img { transform: rotate(-1deg) scale(1.018); transition: transform .35s cubic-bezier(.2,.8,.2,1); }
  #NewEraHome-{{ section.id }} .ne-logo-title + h1 { clip:rect(0 0 0 0); clip-path:inset(50%); height:1px; margin:-1px; overflow:hidden; position:absolute; white-space:nowrap; width:1px; }
  @keyframes neLogoArrive-{{ section.id }} { from { clip-path:inset(0 100% 0 0); opacity:.15; transform:translateY(18px) scale(.97); } to { clip-path:inset(0); opacity:1; transform:none; } }

  /* Contact-page inspired directional hint: subtle, decorative, and safely behind content. */
  #NewEraHome-{{ section.id }} .ne-hero-hint { border-top:3px dashed var(--ne-orange); height:80px; left:50%; opacity:.72; pointer-events:none; position:absolute; top:4%; transform:translateX(-50%) rotate(-7deg); width:clamp(120px,18vw,260px); }
  #NewEraHome-{{ section.id }} .ne-hero-hint::after { border:solid var(--ne-orange); border-width:0 3px 3px 0; content:''; height:11px; position:absolute; right:-1px; top:-7px; transform:rotate(-45deg); width:11px; }

  #NewEraHome-{{ section.id }} .ne-art-placeholder {
    align-items: center;
    border: 1px solid color-mix(in srgb, var(--ne-navy) 20%, transparent);
    border-radius: var(--ne-radius);
    color: var(--ne-navy);
    display: flex;
    height: 100%;
    justify-content: center;
    min-height: 420px;
    overflow: hidden;
    position: relative;
  }

  #NewEraHome-{{ section.id }} .ne-art-placeholder svg { height: 100%; width: 100%; }

  #NewEraHome-{{ section.id }} .ne-route {
    border: 4px dashed var(--ne-orange);
    border-bottom-color: transparent;
    border-left-color: transparent;
    border-radius: 50%;
    height: clamp(220px, 30vw, 520px);
    opacity: .75;
    pointer-events: none;
    position: absolute;
    right: -9%;
    top: 12%;
    transform: rotate(22deg);
    width: clamp(220px, 32vw, 560px);
  }

  /* Page-wide physics playground. JS supplies gravity and collisions; CSS keeps it responsive. */
  #NewEraHome-{{ section.id }} { position: relative; }
  #NewEraHome-{{ section.id }} .ne-balls {
    inset: 0;
    overflow: clip;
    pointer-events: none;
    position: absolute;
    z-index: 8;
  }

  #NewEraHome-{{ section.id }} .ne-ball {
    background: var(--ball-color, var(--ne-orange));
    border-radius: 50%;
    box-shadow: inset -10px -12px 20px rgba(12,29,67,.16), 0 12px 24px rgba(12,29,67,.16);
    cursor: pointer;
    height: clamp(24px, var(--ball-size, 4vw), 82px);
    left: 0;
    opacity: {{ section.settings.ball_opacity | divided_by: 100.0 }};
    pointer-events: auto;
    position: absolute;
    touch-action: pan-y;
    top: 0;
    transform: translate3d(0, 0, 0);
    user-select: none;
    width: clamp(24px, var(--ball-size, 4vw), 82px);
    will-change: transform;
  }
  /* Balls remain solid brand colors; the SVG supplies all site texture. */
  /* PHYSICS PLATFORMS: invisible DOM guides mirrored as thin Matter.js bodies. */
  #NewEraHome-{{ section.id }} .physics-platform { height: 2px; pointer-events: none; position: absolute; }
  #NewEraHome-{{ section.id }} .hero { position: relative; }
  #NewEraHome-{{ section.id }} .hero-platform-left { bottom: 0; left: 0; width: 51%; }
  #NewEraHome-{{ section.id }} .hero-platform-right { bottom: 0; right: 0; width: 39%; }
  #NewEraHome-{{ section.id }} [data-physics-debug='true'] .physics-platform { background: #ff2a2a; z-index: 50; }
  #NewEraHome-{{ section.id }} .ne-ball:active { cursor: pointer; }
  #NewEraHome-{{ section.id }} .ne-ball:focus-visible { outline: 4px solid #fff; outline-offset: 4px; }

  /* ==========================================================
     POSITIONING — high-contrast navy editorial panel
     ========================================================== */
  #NewEraHome-{{ section.id }} .ne-positioning { background: var(--ne-navy); color: #fff; }
  /* Dark-panel titles need an explicit override because the shared title style is navy. */
  #NewEraHome-{{ section.id }} .ne-positioning .ne-title,
  #NewEraHome-{{ section.id }} .ne-audience .ne-title,
  #NewEraHome-{{ section.id }} .ne-cases .ne-title { color: #fff; }
  #NewEraHome-{{ section.id }} .ne-positioning-grid { display: grid; gap: 44px; grid-template-columns: .9fr 1.1fr; }
  #NewEraHome-{{ section.id }} .ne-script-accent { color: var(--ne-orange); font-family: Georgia, 'Times New Roman', serif; font-size: clamp(3rem, 7vw, 8rem); font-style: italic; font-weight: 400; line-height: .82; }
  #NewEraHome-{{ section.id }} .ne-positioning .ne-body { color: rgba(255,255,255,.82); }

  /* ==========================================================
     CARD GRIDS — capabilities, audiences, services, and cases
     ========================================================== */
  #NewEraHome-{{ section.id }} .ne-grid-head { align-items: end; display: grid; gap: 28px; grid-template-columns: 1.25fr .75fr; margin-bottom: clamp(42px, 6vw, 80px); }
  #NewEraHome-{{ section.id }} .ne-grid-head .ne-body { justify-self: end; }
  #NewEraHome-{{ section.id }} .ne-card-grid { display: grid; gap: 22px; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  #NewEraHome-{{ section.id }} .ne-card {
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--ne-navy) 16%, transparent);
    border-radius: var(--ne-radius);
    display: flex;
    flex-direction: column;
    min-height: 100%;
    overflow: hidden;
    position: relative;
  }

  #NewEraHome-{{ section.id }} .ne-card-media { aspect-ratio: 4 / 3; background: color-mix(in srgb, var(--ne-navy) 7%, var(--ne-paper)); overflow: hidden; }
  #NewEraHome-{{ section.id }} .ne-card-media img { height: 100%; object-fit: cover; transition: transform .45s ease; width: 100%; }
  #NewEraHome-{{ section.id }} .ne-card:hover .ne-card-media img { transform: scale(1.025); }
  #NewEraHome-{{ section.id }} .ne-card-content { display: flex; flex: 1; flex-direction: column; gap: 14px; padding: clamp(22px, 2.5vw, 34px); }
  #NewEraHome-{{ section.id }} .ne-card h3 { color: var(--ne-navy); font-size: clamp(1.25rem, 2vw, 2rem); line-height: .98; text-transform: uppercase; }
  #NewEraHome-{{ section.id }} .ne-card p { font-size: .98rem; font-weight: 300; line-height: 1.55; }
  #NewEraHome-{{ section.id }} .ne-card-link { color: var(--ne-navy); font-family: var(--ne-display); font-size: .78rem; font-weight: 800; letter-spacing: .1em; margin-top: auto; padding-top: 12px; text-decoration: none; text-transform: uppercase; }
  #NewEraHome-{{ section.id }} .ne-card-link::after { color: var(--ne-orange); content: '  ↗'; }

  #NewEraHome-{{ section.id }} .ne-capabilities { background: var(--ne-paper); }
  #NewEraHome-{{ section.id }} .ne-capabilities .ne-card:nth-child(even) { transform: translateY(28px); }

  /* Audience section adapts the supplied split-image Clients Served layout. */
  #NewEraHome-{{ section.id }} .ne-audience { background: var(--ne-navy); color: #fff; }
  #NewEraHome-{{ section.id }} .ne-audience-grid { display: grid; grid-template-columns: 1fr 1fr; }
  #NewEraHome-{{ section.id }} .ne-audience-media { min-height: 720px; position: relative; }
  #NewEraHome-{{ section.id }} .ne-audience-media img { height: 100%; inset: 0; object-fit: cover; position: absolute; width: 100%; }
  #NewEraHome-{{ section.id }} .ne-audience-panel { padding: clamp(52px, 7vw, 110px); position: relative; }
  #NewEraHome-{{ section.id }} .ne-audience-list { display: grid; gap: 28px; margin-top: 48px; }
  #NewEraHome-{{ section.id }} .ne-audience-item { border-top: 1px solid rgba(255,255,255,.2); padding-top: 22px; }
  #NewEraHome-{{ section.id }} .ne-audience-item h3 { color: #fff; font-size: clamp(1.15rem, 1.65vw, 1.65rem); letter-spacing: -.02em; text-transform: uppercase; }
  #NewEraHome-{{ section.id }} .ne-audience-item p { color: rgba(255,255,255,.78); font-size: 1rem; line-height: 1.55; margin-top: 8px; }

  #NewEraHome-{{ section.id }} .ne-services-grid { display: grid; gap: 0; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 60px; }
  #NewEraHome-{{ section.id }} .ne-service { border: 1px solid color-mix(in srgb, var(--ne-navy) 22%, transparent); margin-right: -1px; padding: clamp(28px, 4vw, 54px); position: relative; }
  #NewEraHome-{{ section.id }} .ne-service-index { color: var(--ne-orange); font-family: var(--ne-display); font-size: 3rem; font-weight: 900; line-height: 1; }
  #NewEraHome-{{ section.id }} .ne-service h3 { color: var(--ne-navy); font-size: clamp(1.55rem, 2.4vw, 2.8rem); line-height: .95; margin-top: 54px; text-transform: uppercase; }
  #NewEraHome-{{ section.id }} .ne-service p { font-size: 1rem; line-height: 1.6; margin-top: 20px; }
  #NewEraHome-{{ section.id }} .ne-service ul { margin: 26px 0 0; padding-left: 1.2em; }
  #NewEraHome-{{ section.id }} .ne-service li { margin-block: 9px; }

  /* ==========================================================
     METRICS — large proof points with concise context
     ========================================================== */
  #NewEraHome-{{ section.id }} .ne-metrics { background: var(--ne-paper); padding-block: 28px clamp(72px, 9vw, 140px); }
  #NewEraHome-{{ section.id }} .ne-metrics-grid { border: 1px solid color-mix(in srgb, var(--ne-navy) 24%, transparent); display: grid; grid-template-columns: repeat(4, 1fr); }
  #NewEraHome-{{ section.id }} .ne-metric { border-right: 1px solid color-mix(in srgb, var(--ne-navy) 24%, transparent); padding: clamp(28px, 4vw, 52px); }
  #NewEraHome-{{ section.id }} .ne-metric:last-child { border-right: 0; }
  #NewEraHome-{{ section.id }} .ne-metric strong { color: var(--ne-navy); display: block; font-family: var(--ne-display); font-size: clamp(2.6rem, 5vw, 6rem); font-weight: 900; letter-spacing: -.06em; line-height: .9; }
  #NewEraHome-{{ section.id }} .ne-metric span { display: block; font-size: .9rem; font-weight: 300; line-height: 1.45; margin-top: 14px; }
  /* Animated proof bars: a true DOM element, accessible and editable—not baked into an image. */
  #NewEraHome-{{ section.id }} .ne-metric-bar { background: color-mix(in srgb, var(--ne-navy) 12%, transparent); border-radius: 999px; height: 9px; margin-top: 28px; overflow: hidden; }
  #NewEraHome-{{ section.id }} .ne-metric-bar i { background: var(--ne-orange); border-radius: inherit; display: block; height: 100%; transform: scaleX(0); transform-origin: left center; transition: transform 1.15s cubic-bezier(.2,.8,.2,1); width: var(--metric-fill, 72%); }
  #NewEraHome-{{ section.id }} .ne-metric.is-visible .ne-metric-bar i { transform: scaleX(1); }

  /* Responsive block letters gain depth from browsing energy but never drift or float. */
  #NewEraHome-{{ section.id }} .ne-block-letter { display: inline-block; transform: translate3d(var(--letter-x,0),var(--letter-y,0),0) skewX(var(--letter-skew,0deg)); transition: transform .22s ease-out, letter-spacing .3s ease; will-change: transform; }
  #NewEraHome-{{ section.id }}.is-focus .ne-block-letter { transform: none !important; }

  /* ==========================================================
     PROCESS — orange numbered markers with progressive route
     ========================================================== */
  #NewEraHome-{{ section.id }} .ne-process { background: #fff; }
  #NewEraHome-{{ section.id }} .ne-process-grid { display: grid; gap: 26px; grid-template-columns: repeat(4, 1fr); margin-top: 58px; position: relative; }
  #NewEraHome-{{ section.id }} .ne-process-grid::before { border-top: 3px dashed var(--ne-orange); content: ''; left: 8%; opacity: .75; position: absolute; right: 8%; top: 38px; }
  #NewEraHome-{{ section.id }} .ne-step { position: relative; z-index: 1; }
  #NewEraHome-{{ section.id }} .ne-step-number { align-items: center; background: var(--ne-orange); border-radius: 50%; color: var(--ne-navy); display: flex; font-family: var(--ne-display); font-size: 1.65rem; font-weight: 900; height: 78px; justify-content: center; width: 78px; }
  #NewEraHome-{{ section.id }} .ne-step h3 { color: var(--ne-navy); font-size: 1.4rem; line-height: 1; margin-top: 30px; text-transform: uppercase; }
  #NewEraHome-{{ section.id }} .ne-step p { font-size: .98rem; line-height: 1.55; margin-top: 12px; }

  /* Case cards are wider and include category labels. */
  #NewEraHome-{{ section.id }} .ne-cases { background: var(--ne-navy); color: #fff; }
  #NewEraHome-{{ section.id }} .ne-cases .ne-kicker { color: var(--ne-orange); }
  #NewEraHome-{{ section.id }} .ne-case-grid { display: grid; gap: 22px; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 58px; }
  #NewEraHome-{{ section.id }} .ne-case { color: var(--ne-navy); }
  #NewEraHome-{{ section.id }} .ne-case .ne-card-media { aspect-ratio: 16 / 10; }
  #NewEraHome-{{ section.id }} .ne-case-label { color: var(--ne-orange); font-family: var(--ne-display); font-size: .72rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }

  /* Social proof follows the Sidekicks-style conversion sequence: proof directly before the CTA. */
  #NewEraHome-{{ section.id }} .ne-proof { background: #fff; }
  #NewEraHome-{{ section.id }} .ne-proof-grid { display: grid; gap: 22px; grid-template-columns: repeat(3,minmax(0,1fr)); margin-top: 54px; }
  #NewEraHome-{{ section.id }} .ne-quote { border: 1px solid color-mix(in srgb,var(--ne-navy) 22%,transparent); border-radius: var(--ne-radius); display: flex; flex-direction: column; min-height: 310px; padding: clamp(28px,4vw,48px); }
  #NewEraHome-{{ section.id }} .ne-quote blockquote { color: var(--ne-navy); font-size: clamp(1.2rem,1.7vw,1.65rem); font-weight: 300; line-height: 1.42; margin: 0; }
  #NewEraHome-{{ section.id }} .ne-quote footer { border-top: 1px solid color-mix(in srgb,var(--ne-navy) 18%,transparent); margin-top: auto; padding-top: 24px; }
  #NewEraHome-{{ section.id }} .ne-quote strong { color: var(--ne-navy); display: block; font-family: var(--ne-display); font-weight: 900; text-transform: uppercase; }
  #NewEraHome-{{ section.id }} .ne-quote span { color: var(--ne-muted); font-size: .9rem; }

  /* ==========================================================
     CLOSING CTA + FAQ
     ========================================================== */
  #NewEraHome-{{ section.id }} .ne-cta { background: var(--ne-paper); }
  #NewEraHome-{{ section.id }} .ne-cta-grid { align-items: center; display: grid; gap: 54px; grid-template-columns: 1.1fr .9fr; }
  #NewEraHome-{{ section.id }} .ne-cta-art { min-height: 390px; position: relative; }
  #NewEraHome-{{ section.id }} .ne-cta-art img { height: 100%; inset: 0; object-fit: contain; position: absolute; width: 100%; }

  #NewEraHome-{{ section.id }} .ne-faq { background: #fff; }
  #NewEraHome-{{ section.id }} .ne-faq-grid { display: grid; gap: clamp(44px, 7vw, 100px); grid-template-columns: .8fr 1.2fr; }
  #NewEraHome-{{ section.id }} .ne-faq-list { border-top: 1px solid color-mix(in srgb, var(--ne-navy) 28%, transparent); }
  #NewEraHome-{{ section.id }} details { border-bottom: 1px solid color-mix(in srgb, var(--ne-navy) 28%, transparent); }
  #NewEraHome-{{ section.id }} summary { color: var(--ne-navy); cursor: pointer; font-family: var(--ne-display); font-size: clamp(1.05rem, 1.6vw, 1.35rem); font-weight: 800; list-style: none; padding: 25px 46px 25px 0; position: relative; }
  #NewEraHome-{{ section.id }} summary::-webkit-details-marker { display: none; }
  #NewEraHome-{{ section.id }} summary::after { color: var(--ne-orange); content: '+'; font-size: 1.7rem; position: absolute; right: 8px; top: 18px; }
  #NewEraHome-{{ section.id }} details[open] summary::after { content: '−'; }
  #NewEraHome-{{ section.id }} .ne-faq-answer { line-height: 1.65; padding: 0 46px 28px 0; }

  /* ==========================================================
     RESPONSIVE RULES — preserve hierarchy, remove fragile overlap
     ========================================================== */
  /* ADAPTIVE UX LAB: energy switcher, behavioral hero, archetype quiz, and UX-law demos. */
  #NewEraHome-{{ section.id }} .ne-energy{align-items:center;background:var(--ne-navy);color:#fff;display:flex;gap:16px;justify-content:center;padding:12px 5%;position:sticky;top:0;z-index:45}
  #NewEraHome-{{ section.id }} .ne-energy strong{font-size:.76rem;letter-spacing:.12em;text-transform:uppercase}
  #NewEraHome-{{ section.id }} .ne-energy-toggle{background:#fff;border:0;border-radius:999px;display:grid;grid-template-columns:1fr 1fr;padding:4px}
  #NewEraHome-{{ section.id }} .ne-energy-toggle button{background:transparent;border:0;border-radius:999px;color:var(--ne-navy);cursor:pointer;font:700 .75rem/1 var(--ne-body);padding:10px 14px}
  #NewEraHome-{{ section.id }} .ne-energy-toggle button[aria-pressed='true']{background:var(--ne-orange)}
  #NewEraHome-{{ section.id }} .ne-behavior-canvas{height:100%;inset:0;pointer-events:none;position:absolute;width:100%;z-index:0}
  #NewEraHome-{{ section.id }} .ne-hero-grid{position:relative;z-index:2}
  #NewEraHome-{{ section.id }} .ne-archetype{background:var(--ne-navy);color:#fff;overflow:hidden}
  #NewEraHome-{{ section.id }} .ne-choice-grid{display:grid;gap:22px;grid-template-columns:repeat(3,1fr);margin-top:42px}
  #NewEraHome-{{ section.id }} .ne-shape{aspect-ratio:1;background:transparent;border:1px solid #ffffff55;cursor:pointer;display:grid;place-items:center;transition:transform .25s,border-color .25s}
  #NewEraHome-{{ section.id }} .ne-shape:hover,#NewEraHome-{{ section.id }} .ne-shape:focus-visible{border-color:var(--ne-orange);transform:scale(1.035)}
  #NewEraHome-{{ section.id }} .ne-shape i{background:var(--ne-orange);display:block;height:38%;transition:transform .45s;width:38%}
  #NewEraHome-{{ section.id }} .ne-shape[data-choice='visionary'] i{border-radius:50%}
  #NewEraHome-{{ section.id }} .ne-shape[data-choice='builder'] i{clip-path:polygon(50% 0,100% 100%,0 100%)}
  #NewEraHome-{{ section.id }} .ne-quiz-status{color:#fff;margin-top:26px;min-height:1.5em}
  #NewEraHome-{{ section.id }} .ne-sandbox-grid{display:grid;gap:24px;grid-template-columns:1fr 1fr;margin-top:48px}
  #NewEraHome-{{ section.id }} .ne-law{border:1px solid #0c1d4340;border-radius:var(--ne-radius);min-height:430px;padding:clamp(28px,4vw,54px);position:relative}
  #NewEraHome-{{ section.id }} .ne-fitts-stage{height:250px;position:relative}
  #NewEraHome-{{ section.id }} .ne-fitts-target{background:var(--ne-orange);border:0;border-radius:999px;color:var(--ne-navy);font-weight:900;left:50%;padding:16px 22px;position:absolute;top:50%;transform:translate(-50%,-50%) scale(var(--target-scale,1));transition:transform .12s}
  #NewEraHome-{{ section.id }} .ne-hick-options{display:grid;gap:8px;grid-template-columns:repeat(4,1fr);margin-top:24px}
  #NewEraHome-{{ section.id }} .ne-hick-options span{background:var(--ne-navy);color:#fff;padding:10px;text-align:center}
  #NewEraHome-{{ section.id }} .ne-hick-result{filter:blur(var(--choice-blur,0));margin-top:22px;transition:filter var(--choice-delay,.1s)}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-heading,#NewEraHome-{{ section.id }}.is-high-energy .ne-hero h1{transition:transform .4s}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-heading:hover,#NewEraHome-{{ section.id }}.is-high-energy .ne-hero h1:hover{transform:translateX(8px) skewX(-2deg)}
  #NewEraHome-{{ section.id }}.is-high-energy :is(.ne-hero,.ne-positioning,.ne-capabilities,.ne-services,.ne-process,.ne-cases,.ne-proof,.ne-sandbox,.ne-faq){background-color:transparent;color:#fff}
  #NewEraHome-{{ section.id }}.is-high-energy :is(h1,.ne-heading,.ne-subheading,.ne-body,.ne-card h3,.ne-service h3,.ne-step h3,.ne-case h3,.ne-law h3,.ne-faq summary){color:#fff}
  #NewEraHome-{{ section.id }}.is-high-energy :is(.ne-card,.ne-service,.ne-step,.ne-case,.ne-law,.ne-faq details){background:rgba(255,255,255,.055);border-color:rgba(255,255,255,.22)}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-audience-panel{background:rgba(7,19,45,.9)}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-hero-grid{grid-template-columns:1fr;min-height:calc({{ section.settings.hero_min_height }}vh - 64px);place-items:center;text-align:center}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-hero-grid>div:first-child{max-width:980px;position:relative;z-index:3}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-hero-art{filter:grayscale(.25) sepia(.08);inset:2% 4% 0;opacity:.14;position:absolute;z-index:1}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-hero-art img{height:100%;margin:auto;mix-blend-mode:multiply;object-fit:contain;width:100%}
  #NewEraHome-{{ section.id }}.is-focus .ne-hero-art{opacity:.07}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-hero h1{font-size:clamp(4rem,10vw,10.5rem);max-width:11ch}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-hero-copy{font-size:clamp(1rem,1.45vw,1.35rem);margin-inline:auto;max-width:760px}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-btn-row{justify-content:center}
  /* PRESTIGE EDITORIAL MODULES: oversized hero + clean alternating presentation cards. */
  #NewEraHome-{{ section.id }}.is-high-energy :is(.ne-positioning,.ne-capabilities,.ne-audience,.ne-services,.ne-metrics,.ne-process,.ne-cases,.ne-proof,.ne-archetype,.ne-sandbox,.ne-cta,.ne-faq){border-radius:clamp(24px,3vw,44px);margin:clamp(20px,3vw,46px) auto;max-width:min(calc(100% - 40px),var(--ne-max));overflow:hidden}
  #NewEraHome-{{ section.id }}.is-high-energy :is(.ne-positioning,.ne-cases,.ne-proof,.ne-faq){background:#fff;color:var(--ne-navy)}
  #NewEraHome-{{ section.id }}.is-high-energy :is(.ne-positioning,.ne-cases,.ne-proof,.ne-faq) :is(h2,h3,p,li,summary,.ne-body,.ne-heading,.ne-subheading){color:var(--ne-navy)}
  #NewEraHome-{{ section.id }}.is-high-energy :is(.ne-capabilities,.ne-process,.ne-sandbox){background:var(--ne-orange);color:var(--ne-navy)}
  #NewEraHome-{{ section.id }}.is-high-energy :is(.ne-capabilities,.ne-process,.ne-sandbox) :is(h2,h3,p,li,.ne-body,.ne-heading,.ne-subheading){color:var(--ne-navy)}
  #NewEraHome-{{ section.id }}.is-high-energy :is(.ne-archetype,.ne-services){background:rgba(5,16,39,.96)}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-audience{background:#fff}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-metrics{background:#fff;color:var(--ne-navy);padding:0 3%}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-metric :is(strong,span){color:var(--ne-navy)}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-cta{background:var(--ne-orange);color:var(--ne-navy)}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-cta :is(h2,p,.ne-body){color:var(--ne-navy)}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-card-grid{gap:clamp(18px,2vw,30px)}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-card{border-radius:clamp(20px,2vw,34px);overflow:hidden}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-capabilities .ne-card{background:var(--ne-navy)}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-capabilities .ne-card :is(h3,p){color:#fff}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-hero{border:1px solid rgba(255,255,255,.18);border-radius:clamp(26px,4vw,54px);margin:clamp(18px,2.5vw,38px) auto;max-width:min(calc(100% - 40px),var(--ne-max));overflow:hidden}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-kicker{letter-spacing:.18em}
  #NewEraHome-{{ section.id }}.is-high-energy .ne-btn{min-width:210px}
  #NewEraHome-{{ section.id }}.is-focus{--ne-orange:#111;--ne-navy:#000;--ne-paper:#fff;--ne-muted:#333}
  #NewEraHome-{{ section.id }}.is-focus *{animation:none!important;transition:none!important}
  #NewEraHome-{{ section.id }}.is-focus .ne-balls,#NewEraHome-{{ section.id }}.is-focus .ne-behavior-canvas,#NewEraHome-{{ section.id }}.is-focus .ne-route,#NewEraHome-{{ section.id }}.is-focus .ne-script-accent{display:none!important}
  #NewEraHome-{{ section.id }}.is-focus :is(.ne-hero-grid,.ne-positioning-grid,.ne-grid-head,.ne-card-grid,.ne-audience-grid,.ne-services-grid,.ne-metrics-grid,.ne-process-grid,.ne-case-grid,.ne-proof-grid,.ne-cta-grid,.ne-faq-grid,.ne-choice-grid,.ne-sandbox-grid){grid-template-columns:minmax(0,780px)!important;justify-content:center}
  #NewEraHome-{{ section.id }}.is-focus p,#NewEraHome-{{ section.id }}.is-focus li{line-height:1.85}

  @media (max-width: 1100px) {
    #NewEraHome-{{ section.id }} .ne-card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #NewEraHome-{{ section.id }} .ne-services-grid { grid-template-columns: 1fr; }
    #NewEraHome-{{ section.id }} .ne-service { margin-bottom: -1px; margin-right: 0; }
    #NewEraHome-{{ section.id }} .ne-metrics-grid { grid-template-columns: repeat(2, 1fr); }
    #NewEraHome-{{ section.id }} .ne-metric:nth-child(2) { border-right: 0; }
    #NewEraHome-{{ section.id }} .ne-metric:nth-child(-n+2) { border-bottom: 1px solid color-mix(in srgb, var(--ne-navy) 24%, transparent); }
    #NewEraHome-{{ section.id }} .ne-process-grid { grid-template-columns: repeat(2, 1fr); row-gap: 54px; }
    #NewEraHome-{{ section.id }} .ne-process-grid::before { display: none; }
  }

  @media (max-width: 820px) {
    #NewEraHome-{{ section.id }} .ne-shell { width: min(calc(100% - 32px), var(--ne-max)); }
    #NewEraHome-{{ section.id }} .ne-hero-grid,
    #NewEraHome-{{ section.id }} .ne-positioning-grid,
    #NewEraHome-{{ section.id }} .ne-grid-head,
    #NewEraHome-{{ section.id }} .ne-audience-grid,
    #NewEraHome-{{ section.id }} .ne-cta-grid,
    #NewEraHome-{{ section.id }} .ne-faq-grid { grid-template-columns: 1fr; }
    #NewEraHome-{{ section.id }} .ne-grid-head .ne-body { justify-self: start; }
    #NewEraHome-{{ section.id }} .ne-hero { min-height: auto; }
    #NewEraHome-{{ section.id }} .ne-hero-art { min-height: 360px; order: -1; }
    #NewEraHome-{{ section.id }} .ne-audience-media { min-height: 520px; }
    #NewEraHome-{{ section.id }} .ne-audience-panel { padding: 58px 24px 72px; }
    #NewEraHome-{{ section.id }} .ne-capabilities .ne-card:nth-child(even) { transform: none; }
    #NewEraHome-{{ section.id }} .ne-cta-art { min-height: 320px; order: -1; }
  }

  @media (max-width: 580px) {
    #NewEraHome-{{ section.id }} .ne-energy{align-items:stretch;flex-direction:column}
    #NewEraHome-{{ section.id }} .ne-choice-grid,#NewEraHome-{{ section.id }} .ne-sandbox-grid{grid-template-columns:1fr}
    #NewEraHome-{{ section.id }} .ne-ball:nth-child(n+7) { display:none; }
    #NewEraHome-{{ section.id }} .hero-platform-left { width: 50%; }
    #NewEraHome-{{ section.id }} .hero-platform-right { width: 32%; }
    #NewEraHome-{{ section.id }} .ne-section { padding-block: 68px; }
    #NewEraHome-{{ section.id }} .ne-card-grid,
    #NewEraHome-{{ section.id }} .ne-case-grid,
    #NewEraHome-{{ section.id }} .ne-proof-grid,
    #NewEraHome-{{ section.id }} .ne-metrics-grid,
    #NewEraHome-{{ section.id }} .ne-process-grid { grid-template-columns: 1fr; }
    #NewEraHome-{{ section.id }} .ne-metric { border-bottom: 1px solid color-mix(in srgb, var(--ne-navy) 24%, transparent); border-right: 0; }
    #NewEraHome-{{ section.id }} .ne-metric:last-child { border-bottom: 0; }
    #NewEraHome-{{ section.id }} .ne-hero h1 { font-size: clamp(3rem, 18vw, 5.2rem); }
    #NewEraHome-{{ section.id }} .ne-heading { font-size: clamp(2.45rem, 14vw, 4.3rem); }
    #NewEraHome-{{ section.id }} .ne-hero-art { min-height: 300px; }
    #NewEraHome-{{ section.id }} .ne-audience-media { min-height: 420px; }
    #NewEraHome-{{ section.id }} .ne-btn { width: 100%; }
    #NewEraHome-{{ section.id }} .ne-ball:nth-child(n+5) { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    #NewEraHome-{{ section.id }} *,
    #NewEraHome-{{ section.id }} *::before,
    #NewEraHome-{{ section.id }} *::after { scroll-behavior: auto !important; transition: none !important; }
    #NewEraHome-{{ section.id }} .ne-balls { display: none; }
  }
{% endstyle %}

{% style %}
  /* ==========================================================
     PHASE 1 EDITORIAL ART-DIRECTION LAYER
     ----------------------------------------------------------
     This layer intentionally preserves the section schema,
     editor settings, content blocks, and interaction scripts.
     It replaces the prior futuristic treatment with a modular
     publication system inspired by brand books, portfolio boards,
     tactile print, cutout imagery, and disciplined asymmetry.
     ========================================================== */

  @font-face {
    font-family: 'NED Milo';
    src: url("{{ 'MiloOT.otf' | file_url }}") format('opentype');
    font-style: normal;
    font-weight: 300 600;
    font-display: swap;
  }
  @font-face {
    font-family: 'NED Milo';
    src: url("{{ 'MiloOT-Bold.otf' | file_url }}") format('opentype');
    font-style: normal;
    font-weight: 700;
    font-display: swap;
  }
  @font-face {
    font-family: 'NED Milo';
    src: url("{{ 'MiloOT-Black.otf' | file_url }}") format('opentype');
    font-style: normal;
    font-weight: 900;
    font-display: swap;
  }
  @font-face {
    font-family: 'NED Mathew Rohas';
    src: url("{{ 'Mathew_Rohas_Free.ttf' | file_url }}") format('truetype');
    font-style: normal;
    font-weight: 400 900;
    font-display: swap;
  }
  @font-face {
    font-family: 'NED Edwardian';
    src: url("{{ 'edwardianscriptitc.ttf' | file_url }}") format('truetype');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: 'NED Funk Machine';
    src: url("{{ 'funkmachine.ttf' | file_url }}") format('truetype');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  #NewEraHome-{{ section.id }} {
    --ned-gold: #FCA311;
    --ned-deep-navy: #16213A;
    --ned-inky-navy: #020E40;
    --ned-electric-blue: #0018C5;
    --ned-carbon: #111111;
    --ned-soft-white: #F5F7FA;
    --ned-wasabi: #EAEF55;
    --ned-cool-blue: #D8EFFD;
    --ned-plum: #341F28;
    --ned-persimmon: #FF5D31;
    --ned-jade: #ACB8A0;
    --ne-navy: var(--ned-deep-navy);
    --ne-orange: var(--ned-gold);
    --ne-paper: var(--ned-soft-white);
    --ne-ink: var(--ned-carbon);
    --ne-muted: #4B5361;
    --ne-radius: 6px;
    --ne-display: 'NED Mathew Rohas', 'Arial Black', sans-serif;
    --ne-body: 'NED Milo', Arial, sans-serif;
    background-color: var(--ned-deep-navy);
    background-attachment: scroll;
    background-image: none;
    color: var(--ned-carbon);
    font-family: var(--ne-body);
    font-weight: 400;
  }

  #NewEraHome-{{ section.id }}::before {
    animation: nePaperDrift-{{ section.id }} 34s linear infinite alternate;
    {% if section.settings.site_background != blank %}
      background-image: url('{{ section.settings.site_background | image_url: width: 2400 }}');
    {% else %}
      background-image: url("{{ 'website_Background.svg' | file_url }}");
    {% endif %}
    background-position: center top;
    background-repeat: repeat-y;
    background-size: 100% auto;
    content: '';
    inset: 0;
    opacity: .16;
    pointer-events: none;
    position: absolute;
    z-index: 0;
  }

  #NewEraHome-{{ section.id }} > * { position: relative; z-index: 1; }
  #NewEraHome-{{ section.id }} .ne-shell { width: min(calc(100% - clamp(32px, 7vw, 112px)), 1480px); }
  #NewEraHome-{{ section.id }} .ne-section { padding-block: clamp(80px, 10vw, 156px); }
  #NewEraHome-{{ section.id }} .ne-body,
  #NewEraHome-{{ section.id }} p,
  #NewEraHome-{{ section.id }} li { font-family: var(--ne-body); line-height: 1.58; }

  #NewEraHome-{{ section.id }} .ne-kicker {
    color: currentColor;
    font-family: var(--ne-body);
    font-size: clamp(.68rem, .72vw, .78rem);
    font-weight: 700;
    letter-spacing: .16em;
    margin-bottom: 22px;
    text-transform: uppercase;
  }

  #NewEraHome-{{ section.id }} .ne-heading,
  #NewEraHome-{{ section.id }} .ne-subheading,
  #NewEraHome-{{ section.id }} h1,
  #NewEraHome-{{ section.id }} h2,
  #NewEraHome-{{ section.id }} h3 {
    font-family: var(--ne-display);
    font-style: normal;
    font-weight: 900;
    letter-spacing: -.035em;
  }

  #NewEraHome-{{ section.id }} .ne-heading {
    font-size: clamp(3rem, 7vw, 7.4rem);
    line-height: .84;
    max-width: 13ch;
  }

  #NewEraHome-{{ section.id }} .ne-subheading {
    font-size: clamp(2.4rem, 5vw, 5.8rem);
    line-height: .88;
  }

  #NewEraHome-{{ section.id }} .ne-btn-row { gap: 10px; margin-top: 38px; }
  #NewEraHome-{{ section.id }} .ne-btn {
    border: 1px solid currentColor;
    border-radius: 2px;
    font-family: var(--ne-body);
    font-size: .76rem;
    font-weight: 900;
    letter-spacing: .12em;
    min-height: 52px;
    padding: 15px 22px;
    transition: background-color .18s ease, color .18s ease, transform .18s ease;
  }
  #NewEraHome-{{ section.id }} .ne-btn:hover { transform: translate(3px, -3px); }
  #NewEraHome-{{ section.id }} .ne-btn--primary { background: var(--ned-gold); border-color: var(--ned-gold); color: var(--ned-carbon); }
  #NewEraHome-{{ section.id }} .ne-btn--secondary { background: transparent; }

  /* A compact editorial control, kept because it changes the experience. */
  #NewEraHome-{{ section.id }} .ne-energy {
    background: var(--ned-deep-navy);
    border-bottom: 1px solid rgba(245,247,250,.35);
    color: var(--ned-soft-white);
    gap: 22px;
    justify-content: flex-end;
    padding: 10px clamp(20px, 5vw, 76px);
    position: relative;
    top: auto;
  }
  #NewEraHome-{{ section.id }} .ne-energy strong { font-family: var(--ne-body); font-size: .62rem; }
  #NewEraHome-{{ section.id }} .ne-energy-toggle {
    background: transparent;
    border: 1px solid rgba(245,247,250,.55);
    border-radius: 2px;
    gap: 0;
    padding: 0;
  }
  #NewEraHome-{{ section.id }} .ne-energy-toggle button {
    border-radius: 0;
    color: var(--ned-soft-white);
    font-family: var(--ne-body);
    padding: 9px 13px;
  }
  #NewEraHome-{{ section.id }} .ne-energy-toggle button[aria-pressed='true'] {
    background: var(--ned-gold);
    color: var(--ned-carbon);
  }

  /* Hero: editorial front cover with an asymmetric live-type column. */
  #NewEraHome-{{ section.id }} .ne-hero {
    background: var(--ned-soft-white);
    border: 0;
    min-height: max(760px, {{ section.settings.hero_min_height }}vh);
    padding-block: clamp(96px, 13vw, 190px);
  }
  #NewEraHome-{{ section.id }} .ne-hero::after {
    background: var(--ned-gold);
    bottom: 0;
    content: '';
    height: 12px;
    left: 0;
    position: absolute;
    width: 38%;
  }
  #NewEraHome-{{ section.id }} .ne-hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    justify-items: stretch;
    text-align: left;
  }
  #NewEraHome-{{ section.id }} .ne-hero-content {
    grid-column: 1 / span 8;
    max-width: none;
    padding-right: clamp(0px, 3vw, 44px);
  }
  #NewEraHome-{{ section.id }} .ne-hero .ne-kicker { color: var(--ned-deep-navy); margin-bottom: 26px; opacity: 1; }
  #NewEraHome-{{ section.id }} .ne-hero h1,
  #NewEraHome-{{ section.id }} .ne-logo-title + h1 {
    clip: auto;
    clip-path: none;
    color: var(--ned-carbon);
    font-size: clamp(4.6rem, 9.6vw, 11.2rem);
    height: auto;
    line-height: .77;
    margin: 0;
    max-width: 9ch;
