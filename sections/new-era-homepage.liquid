{% comment %}
  PHYSICS PLAYGROUND
  - Gravity is calculated in page coordinates, not a looping CSS animation.
  - Balls bounce from cards, service lanes, process steps, cases, FAQ rows, and section edges.
  - Click/tap gives a ball a playful impulse; normal page scrolling always remains available.
  - Balls live in document coordinates and continue between sections without resetting on scroll.
{% endcomment %}
<script>
(() => {
  /* MAIN PHYSICS SETTINGS — tune gravity, bounce, drag, speed cap, or debug here. */
  const PHYSICS_DEBUG = false;
  /* Values mirror the original 2024.2 Bouncy Balls block's Moderate mode:
     gravity .25, damping/bounce .75, random start velocity +/-1.5, and click force up to 8. */
  const SETTINGS = { gravity:.25, restitution:.75, friction:.035, frictionAir:.01, density:.0015, platformFriction:.09, maxSpeed:22, clickRadius:150, clickForce:8 };
  const root = document.getElementById('NewEraHome-{{ section.id }}');
  const layer = root && root.querySelector('.ne-balls');
  if (!root || !layer || root.dataset.physicsReady === 'true') return;
  root.dataset.physicsReady = 'true';
  root.dataset.physicsDebug = String(PHYSICS_DEBUG);

  const loadMatter = window.Matter ? Promise.resolve(window.Matter) : new Promise((resolve,reject) => {
    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/matter-js@0.20.0/build/matter.min.js';
    script.onload = () => resolve(window.Matter); script.onerror = reject;
    document.head.appendChild(script);
  });

  loadMatter.then(Matter => {
    if (!Matter || !document.contains(root)) return;
    const { Engine, Bodies, Body, Composite, Sleeping } = Matter;
    const engine = Engine.create({ enableSleeping:true });
    engine.gravity.y = SETTINGS.gravity;
    const nodes = [...layer.querySelectorAll('.ne-ball')].filter(el => getComputedStyle(el).display !== 'none');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let balls = [], platforms = [], frame = 0, last = performance.now(), resizeTimer, destroyed = false;

    function metrics(){ const r=root.getBoundingClientRect(); return { rect:r, width:root.clientWidth, height:root.scrollHeight }; }
    function platform(x,y,w,h=8,angle=0){ return Bodies.rectangle(x+w/2,y+h/2,w,h,{isStatic:true,angle:angle*Math.PI/180,friction:SETTINGS.platformFriction,restitution:.25,label:'platform'}); }
    function clearPlatforms(){ platforms.forEach(body=>Composite.remove(engine.world,body)); platforms=[]; root.querySelectorAll('.ne-debug-body').forEach(el=>el.remove()); }
    function addPlatform(x,y,w,h=8,angle=0){ if(w<12)return; const b=platform(x,y,w,h,angle); platforms.push(b); Composite.add(engine.world,b); if(PHYSICS_DEBUG){const d=document.createElement('i');d.className='ne-debug-body';Object.assign(d.style,{position:'absolute',left:x+'px',top:y+'px',width:w+'px',height:h+'px',background:'#ff2a2a99',zIndex:99,pointerEvents:'none'});layer.appendChild(d);} }

    function rebuildPlatforms(){
      const old=balls.map(({body})=>({x:body.position.x,y:body.position.y,vx:body.velocity.x,vy:body.velocity.y}));
      clearPlatforms(); const m=metrics(), t=10;
      addPlatform(-t,0,t,m.height); addPlatform(m.width,0,t,m.height); addPlatform(0,m.height-10,m.width,12);
      root.querySelectorAll('[data-physics-platform]').forEach(el=>{
        const r=el.getBoundingClientRect(), mode=el.dataset.physicsPlatform||'full';
        const x=r.left-m.rect.left, y=r.top-m.rect.top, angle=Number(el.dataset.angle||0);
        if(mode==='bottom') addPlatform(x,y+r.height-5,r.width,8,angle);
        else if(mode==='top') addPlatform(x,y,r.width,8,angle);
        else addPlatform(x,y,Math.max(r.width,2),Math.max(r.height,8),angle);
      });
      /* Cards, charts, templates, and UX demos become irregular obstacle boxes.
         Thin edge bodies preserve clickable content while giving the balls real corners to strike. */
      root.querySelectorAll('.ne-card,.ne-service,.ne-step,.ne-case,.ne-metric,.ne-law,.ne-faq details').forEach((el,index)=>{
        const r=el.getBoundingClientRect(),x=r.left-m.rect.left,y=r.top-m.rect.top;
        if(r.width<40||r.height<30)return;
        const tilt=((index%5)-2)*.35;
        addPlatform(x,y,r.width,7,tilt);
        addPlatform(x,y,7,Math.min(r.height,96));
        addPlatform(x+r.width-7,y,7,Math.min(r.height,96));
      });
      const sections=[...root.querySelectorAll('.ne-positioning,.ne-capabilities,.ne-audience,.ne-services,.ne-process,.ne-cases,.ne-cta,.ne-faq')];
      sections.forEach((el,i)=>{ const r=el.getBoundingClientRect(), y=r.top-m.rect.top, gap=Math.max(70,Math.min(150,m.width*.1)), center=i%2?m.width*.28:m.width*.72; addPlatform(0,y,Math.max(0,center-gap/2),7,i%2?2:-2); addPlatform(center+gap/2,y,Math.max(0,m.width-center-gap/2),7,i%2?2:-2); });
      old.forEach((p,i)=>{if(!balls[i])return;Body.setPosition(balls[i].body,{x:Math.min(m.width-balls[i].r,Math.max(balls[i].r,p.x)),y:Math.min(m.height-balls[i].r,Math.max(balls[i].r,p.y))});Body.setVelocity(balls[i].body,{x:p.vx,y:p.vy});});
    }

    const starts=[.09,.24,.39,.55,.69,.82,.16,.75];
    nodes.forEach((el,i)=>{
      const r=Math.max(14,el.offsetWidth/2), body=Bodies.circle(root.clientWidth*starts[i],40+(i%4)*58,r,{restitution:SETTINGS.restitution,friction:SETTINGS.friction,frictionAir:SETTINGS.frictionAir,density:SETTINGS.density,label:'branded-ball'});
      Body.setStatic(body,true); Body.setAngle(body,(Math.random()-.5)*.5); balls.push({el,body,r,stillSince:0}); Composite.add(engine.world,body);
      setTimeout(()=>{if(!destroyed&&!reduced){Body.setStatic(body,false);Body.setVelocity(body,{x:(Math.random()-.5)*3,y:(Math.random()-.5)*3});}},i*(120+Math.random()*230));
    });

    balls.forEach(item=>{
      const kick=()=>{Body.setStatic(item.body,false);Sleeping.set(item.body,false);Body.setVelocity(item.body,{x:(Math.random()-.5)*14,y:-14-Math.random()*5});Body.setAngularVelocity(item.body,(Math.random()-.5)*.35);item.stillSince=0;};
      item.el.addEventListener('click',kick);
      item.el.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();kick();}});
    });

    /* Exact original interaction model: a pointer press affects every ball within
       a 150px field, with force tapering linearly from 8 to 0. No dragging. */
    root.addEventListener('pointerdown',event=>{
      if(root.classList.contains('is-focus'))return;
      const rootRect=root.getBoundingClientRect(), clickX=event.clientX-rootRect.left, clickY=event.clientY-rootRect.top;
      balls.forEach(item=>{const dx=item.body.position.x-clickX,dy=item.body.position.y-clickY,distance=Math.hypot(dx,dy);if(distance>=SETTINGS.clickRadius||distance===0)return;const force=((SETTINGS.clickRadius-distance)/SETTINGS.clickRadius)*SETTINGS.clickForce,angle=Math.atan2(dy,dx);Sleeping.set(item.body,false);Body.setVelocity(item.body,{x:item.body.velocity.x+Math.cos(angle)*force,y:item.body.velocity.y+Math.sin(angle)*force});});
    },{passive:true});

    function tick(now){if(destroyed)return;const dt=Math.min(16.666,now-last);last=now;if(!document.hidden&&!reduced&&!root.classList.contains('is-focus'))Engine.update(engine,dt);balls.forEach(item=>{const {el,body,r}=item,speed=Body.getSpeed(body);if(speed>SETTINGS.maxSpeed)Body.setSpeed(body,SETTINGS.maxSpeed);if(!reduced&&speed<.16){item.stillSince=item.stillSince||now;if(now-item.stillSince>4200){Sleeping.set(body,false);Body.setVelocity(body,{x:(Math.random()-.5)*4,y:-3.5});item.stillSince=now;}}else item.stillSince=0;el.style.transform=`translate3d(${body.position.x-r}px,${body.position.y-r}px,0) rotate(${body.angle}rad)`;});frame=requestAnimationFrame(tick);}
    function scheduleRebuild(){clearTimeout(resizeTimer);resizeTimer=setTimeout(rebuildPlatforms,180);}
    const observer=new ResizeObserver(scheduleRebuild);observer.observe(root);root.querySelectorAll('img').forEach(img=>{if(!img.complete)img.addEventListener('load',scheduleRebuild,{once:true});});document.fonts&&document.fonts.ready.then(scheduleRebuild);addEventListener('resize',scheduleRebuild,{passive:true});
    rebuildPlatforms();frame=requestAnimationFrame(tick);
    document.addEventListener('shopify:section:unload',e=>{if(e.detail.sectionId!=='{{ section.id }}')return;destroyed=true;cancelAnimationFrame(frame);clearTimeout(resizeTimer);observer.disconnect();Composite.clear(engine.world,false);Engine.clear(engine);delete root.dataset.physicsReady;},{once:true});
  }).catch(error=>console.warn('New Era physics unavailable',error));
})();
</script>

{% comment %} ADAPTIVE UX CONTROLLER: global energy state, behavioral canvas, quiz state machine, and UX-law demos. {% endcomment %}
<script>
(() => {
  const root=document.getElementById('NewEraHome-{{ section.id }}');if(!root||root.dataset.adaptiveReady)return;root.dataset.adaptiveReady='true';
  const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const energyButtons=[...root.querySelectorAll('[data-energy]')];
  function setEnergy(level){const focus=level==='focus';root.classList.toggle('is-focus',focus);root.classList.toggle('is-high-energy',!focus);energyButtons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.energy===level)));try{localStorage.setItem('new-era-energy',level)}catch(_){}}
  energyButtons.forEach(b=>b.addEventListener('click',()=>setEnergy(b.dataset.energy)));let savedEnergy='high';try{savedEnergy=localStorage.getItem('new-era-energy')||'high'}catch(_){}setEnergy(reduced?'focus':savedEnergy);

  /* Reveal metrics once and give block typography a restrained, input-driven response. */
  const metricCards=[...root.querySelectorAll('.ne-metric')];
  if(reduced){metricCards.forEach(card=>card.classList.add('is-visible'));}
  else {
    const metricObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');metricObserver.unobserve(entry.target)}}),{threshold:.35});
    metricCards.forEach(card=>metricObserver.observe(card));
    const letters=[...root.querySelectorAll('.ne-block-letter,.ne-hero h1,.ne-heading')];
    root.addEventListener('pointermove',event=>{if(root.classList.contains('is-focus'))return;const x=(event.clientX/innerWidth-.5)*5,y=(event.clientY/innerHeight-.5)*3;letters.forEach((letter,index)=>{const depth=(index%3+1)/3;letter.style.setProperty('--letter-x',`${(x*depth).toFixed(2)}px`);letter.style.setProperty('--letter-y',`${(y*depth).toFixed(2)}px`);letter.style.setProperty('--letter-skew',`${(x*.12*depth).toFixed(2)}deg`)})},{passive:true});
  }

  const canvas=root.querySelector('.ne-behavior-canvas'),hero=root.querySelector('.ne-hero');
  const archer=root.querySelector('[data-archer-emblem]');
  if(archer&&!reduced&&matchMedia('(pointer:fine)').matches){
    root.addEventListener('pointermove',event=>{const r=archer.getBoundingClientRect();const x=Math.max(-1,Math.min(1,(event.clientX-(r.left+r.width/2))/(r.width||1)));const y=Math.max(-1,Math.min(1,(event.clientY-(r.top+r.height/2))/(r.height||1)));archer.style.setProperty('--archer-x',`${(x*7).toFixed(2)}px`);archer.style.setProperty('--archer-y',`${(y*5).toFixed(2)}px`)},{passive:true});
    root.addEventListener('pointerleave',()=>{archer.style.setProperty('--archer-x','0px');archer.style.setProperty('--archer-y','0px')},{passive:true});
  }
  if(canvas&&hero&&!reduced){const ctx=canvas.getContext('2d'),particles=Array.from({length:26},()=>({x:Math.random(),y:Math.random(),s:1+Math.random()*3,p:Math.random()*6.28}));let mx=.5,my=.5,mouseSpeed=0,scrollSpeed=0,lastX=0,lastY=0,lastScroll=scrollY,lastTime=performance.now(),raf;
    addEventListener('pointermove',e=>{const d=Math.hypot(e.clientX-lastX,e.clientY-lastY);mouseSpeed=Math.min(1,d/80);lastX=e.clientX;lastY=e.clientY;const r=hero.getBoundingClientRect();mx=(e.clientX-r.left)/Math.max(1,r.width);my=(e.clientY-r.top)/Math.max(1,r.height)},{passive:true});
    addEventListener('scroll',()=>{scrollSpeed=Math.min(1,Math.abs(scrollY-lastScroll)/110);lastScroll=scrollY},{passive:true});
    function draw(now){const r=hero.getBoundingClientRect(),dpr=Math.min(2,devicePixelRatio||1),w=Math.max(1,r.width),h=Math.max(1,r.height);if(canvas.width!==w*dpr||canvas.height!==h*dpr){canvas.width=w*dpr;canvas.height=h*dpr;ctx.setTransform(dpr,0,0,dpr,0,0)}const agitation=Math.max(mouseSpeed,scrollSpeed),calm=agitation>.48;ctx.clearRect(0,0,w,h);particles.forEach(q=>{q.p+=(calm?.002:.006);const attraction=(1-agitation)*.0015;q.x+=(mx-q.x)*attraction+Math.cos(q.p)*.00025;q.y+=(my-q.y)*attraction+Math.sin(q.p)*.00025;ctx.beginPath();ctx.arc(q.x*w,q.y*h,q.s+(1-agitation)*1.5,0,6.28);ctx.fillStyle=calm?'rgba(12,29,67,.34)':'rgba(252,163,17,.34)';ctx.fill()});mouseSpeed*=.91;scrollSpeed*=.9;lastTime=now;raf=requestAnimationFrame(draw)}raf=requestAnimationFrame(draw);document.addEventListener('shopify:section:unload',e=>{if(e.detail.sectionId==='{{ section.id }}')cancelAnimationFrame(raf)},{once:true});}

  const scores={strategist:0,visionary:0,builder:0},status=root.querySelector('.ne-quiz-status');let step=0;
  root.querySelectorAll('.ne-shape').forEach(btn=>btn.addEventListener('click',()=>{if(step>=3){scores.strategist=scores.visionary=scores.builder=0;step=0}scores[btn.dataset.choice]+=2;step++;btn.querySelector('i').style.transform=`rotate(${step*45}deg) scale(1.15)`;if(step<3){status.textContent=`Selection ${step+1} of 3`;return}const archetype=Object.keys(scores).sort((a,b)=>scores[b]-scores[a])[0];const names={strategist:'The Analytical Strategist',visionary:'The Avant-Garde Visionary',builder:'The Pragmatic Builder'};status.textContent=`Your path: ${names[archetype]}. Portfolio reordered for you.`;root.dataset.archetype=archetype;const cases=[...root.querySelectorAll('.ne-case')];const orders={strategist:[1,2,0,3],visionary:[2,0,3,1],builder:[1,0,2,3]};orders[archetype].forEach((sourceIndex,order)=>{if(cases[sourceIndex])cases[sourceIndex].style.order=order});}));

  const fitts=root.querySelector('.ne-fitts-stage'),target=root.querySelector('.ne-fitts-target');if(fitts&&target)fitts.addEventListener('pointermove',e=>{const r=target.getBoundingClientRect(),distance=Math.hypot(e.clientX-(r.left+r.width/2),e.clientY-(r.top+r.height/2));target.style.setProperty('--target-scale',String(1+Math.min(1,distance/320)*.8))},{passive:true});
  const range=root.querySelector('.ne-hick input'),options=root.querySelector('.ne-hick-options'),output=root.querySelector('.ne-hick output'),result=root.querySelector('.ne-hick-result');function renderChoices(){if(!range)return;const n=Number(range.value);output.textContent=n;options.innerHTML=Array.from({length:n},(_,i)=>`<span>${i+1}</span>`).join('');result.style.setProperty('--choice-blur',`${Math.max(0,(n-4)*.08)}px`);result.style.setProperty('--choice-delay',`${Math.min(.9,.08+n*.035)}s`)}if(range){range.addEventListener('input',renderChoices);renderChoices()}
})();
</script>

