<style>
  .ned-password-gate {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0d0d0d;
    padding: 40px 20px;
  }

  .ned-password-gate__box {
    background: #1a1a1a;
    border: 1px solid #fca311;
    border-radius: 4px;
    padding: 60px 50px;
    max-width: 480px;
    width: 100%;
    text-align: center;
    box-sizing: border-box;
  }

  .ned-password-gate__logo {
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: #fca311;
    margin: 0 0 8px;
  }

  .ned-password-gate__title {
    font-size: 28px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 12px;
    letter-spacing: 1px;
  }

  .ned-password-gate__subtitle {
    font-size: 14px;
    color: #999999;
    margin: 0 0 40px;
    line-height: 1.6;
  }

  .ned-password-gate__input {
    width: 100%;
    background: #0d0d0d;
    border: 1px solid #333333;
    border-radius: 3px;
    color: #ffffff;
    font-size: 15px;
    padding: 14px 18px;
    margin-bottom: 16px;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
    letter-spacing: 2px;
  }

  .ned-password-gate__input:focus {
    border-color: #fca311;
  }

  .ned-password-gate__btn {
    width: 100%;
    background: #fca311;
    color: #0d0d0d;
    border: none;
    border-radius: 3px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    padding: 16px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .ned-password-gate__btn:hover {
    background: #e5920a;
  }

  .ned-password-gate__error {
    display: none;
    color: #ff4444;
    font-size: 13px;
    margin: 12px 0 0;
    letter-spacing: 1px;
  }

  .ned-password-gate__error.visible {
    display: block;
  }

  @media screen and (max-width: 600px) {
    .ned-password-gate__box {
      padding: 44px 28px;
    }

    .ned-password-gate__title {
      font-size: 24px;
    }
  }
</style>

<section class="ned-password-gate" id="ned-password-gate">
  <div class="ned-password-gate__box">
    <p class="ned-password-gate__logo">New Era Designs</p>

    <h2 class="ned-password-gate__title">Protected Projects</h2>

    <p class="ned-password-gate__subtitle">
      This area is for clients &amp; collaborators only.<br>
      Enter your access password to continue.
    </p>

    <form id="ned-pw-form">
      <input
        type="password"
        id="ned-pw-input"
        class="ned-password-gate__input"
        placeholder="Enter password"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        required
      >

      <button type="submit" class="ned-password-gate__btn">Enter</button>

      <p class="ned-password-gate__error" id="ned-pw-error">
        Incorrect password. Please try again.
      </p>
    </form>
  </div>
</section>

<script>
  (function () {
    function initPasswordGate() {
      var COOKIE_NAME = 'ned_projects_access';
      var CORRECT_PW = 'neweradesigns_2026';
      var REDIRECT_URL = '/pages/client-files';

      function setCookie(name, value, days) {
        var expires = '';

        if (days) {
          var date = new Date();
          date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);
          expires = '; expires=' + date.toUTCString();
        }

        document.cookie =
          name + '=' + encodeURIComponent(value) + expires + '; path=/; SameSite=Lax';
      }

      function getCookie(name) {
        var nameEQ = name + '=';
        var cookies = document.cookie.split(';');

        for (var i = 0; i < cookies.length; i++) {
          var cookie = cookies[i].trim();

          if (cookie.indexOf(nameEQ) === 0) {
            return decodeURIComponent(cookie.substring(nameEQ.length));
          }
        }

        return null;
      }

      var form = document.getElementById('ned-pw-form');
      var input = document.getElementById('ned-pw-input');
      var error = document.getElementById('ned-pw-error');

      if (!form || !input || !error) {
        return;
      }

      if (getCookie(COOKIE_NAME) === 'granted') {
        window.location.href = REDIRECT_URL;
        return;
      }

      form.addEventListener('submit', function (event) {
        event.preventDefault();

        var enteredPassword = input.value.trim();

        if (enteredPassword === CORRECT_PW) {
          setCookie(COOKIE_NAME, 'granted', 7);
          window.location.href = REDIRECT_URL;
        } else {
          error.classList.add('visible');
          input.value = '';
          input.focus();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPasswordGate);
    } else {
      initPasswordGate();
    }
  })();
</script>