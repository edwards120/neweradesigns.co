<style>
  .ned-client-access {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0d0d0d;
    padding: 40px 20px;
  }

  .ned-client-access__box {
    width: min(100%, 520px);
    padding: 56px 44px;
    box-sizing: border-box;
    text-align: center;
    background: #1a1a1a;
    border: 1px solid #fca311;
    border-radius: 4px;
  }

  .ned-client-access__eyebrow {
    margin: 0 0 10px;
    color: #fca311;
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .ned-client-access__title {
    margin: 0 0 16px;
    color: #ffffff;
    font-size: clamp(28px, 5vw, 42px);
    line-height: 1.05;
  }

  .ned-client-access__body {
    margin: 0 auto 30px;
    max-width: 420px;
    color: #b8b8b8;
    font-size: 15px;
    line-height: 1.65;
  }

  .ned-client-access__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 12px 24px;
    color: #0d0d0d;
    background: #fca311;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .ned-client-access__button:hover {
    background: #e5920a;
  }

  @media screen and (max-width: 600px) {
    .ned-client-access__box {
      padding: 42px 26px;
    }
  }
</style>

<section class="ned-client-access">
  <div class="ned-client-access__box">
    <p class="ned-client-access__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1 class="ned-client-access__title">{{ section.settings.heading | escape }}</h1>
    <div class="ned-client-access__body rte">{{ section.settings.body }}</div>

    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <a class="ned-client-access__button" href="{{ section.settings.button_link }}">
        {{ section.settings.button_label | escape }}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Secure client access notice",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New Era Designs"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Client access is invitation-only."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Message",
      "default": "<p>Project files should be shared through an authenticated client account or a private delivery link. This page no longer uses a password stored in public website code.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Request access"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Secure client access notice"
    }
  ]
}
{% endschema %}
