<script>
  (()=>{
    const section=document.getElementById('NedEditorialHero-{{ section.id }}');
    if(!section||section.dataset.nedGravity!=='true'||matchMedia('(prefers-reduced-motion: reduce)').matches)return;
    const objects=[...section.querySelectorAll('[data-ned-gravity-object]')];
    if(!objects.length)return;
    const gravity=Number(section.dataset.nedGravityStrength)||.25;
    const damping=Number(section.dataset.nedGravityDamping)||.75;
    let bounds=section.getBoundingClientRect();
    let states=[];
    let previousTime=performance.now();

    const reset=()=>{
      const oldBounds=bounds;
      bounds=section.getBoundingClientRect();
      const mobile=innerWidth<=989;
      states=objects.map((element,index)=>{
        const hidden=getComputedStyle(element).display==='none';
        const objectBounds=element.getBoundingClientRect();
        const prior=states[index];
        const startX=Number(element.dataset[mobile?'mobileX':'desktopX'])||50;
        const startY=Number(element.dataset[mobile?'mobileY':'desktopY'])||50;
        const x=prior&&oldBounds.width?prior.x*(bounds.width/oldBounds.width):bounds.width*(startX/100);
        const y=prior&&oldBounds.height?prior.y*(bounds.height/oldBounds.height):bounds.height*(startY/100);
        return{element,hidden,width:objectBounds.width,height:objectBounds.height,radius:Math.max(8,Math.min(objectBounds.width,objectBounds.height)/2),x,y,vx:prior?.vx??((index%2?-1.15:1.15)+(index*.1)),vy:prior?.vy??(-3.8-(index%3)*.9),rotation:prior?.rotation??(Number(element.dataset.rotation)||0)};
      });
    };

    const collide=()=>{
      for(let first=0;first<states.length;first++)for(let second=first+1;second<states.length;second++){
        const a=states[first],b=states[second];
        if(a.hidden||b.hidden)continue;
        const dx=b.x-a.x,dy=b.y-a.y,distance=Math.hypot(dx,dy)||1,minimum=a.radius+b.radius;
        if(distance>=minimum)continue;
        const nx=dx/distance,ny=dy/distance,overlap=(minimum-distance)/2;
        a.x-=nx*overlap;a.y-=ny*overlap;b.x+=nx*overlap;b.y+=ny*overlap;
        const relative=(b.vx-a.vx)*nx+(b.vy-a.vy)*ny;
        if(relative<0){const impulse=relative*.82;a.vx+=impulse*nx;a.vy+=impulse*ny;b.vx-=impulse*nx;b.vy-=impulse*ny}
      }
    };

    const frame=time=>{
      const step=Math.min(2,(time-previousTime)/16.667||1);previousTime=time;
      states.forEach(state=>{
        if(state.hidden)return;
        state.vy+=gravity*step;state.x+=state.vx*step;state.y+=state.vy*step;state.vx*=.998;state.rotation+=state.vx*.08*step;
        const halfWidth=state.width/2,halfHeight=state.height/2;
        if(state.x-halfWidth<0){state.x=halfWidth;state.vx=Math.abs(state.vx)*damping}
        if(state.x+halfWidth>bounds.width){state.x=bounds.width-halfWidth;state.vx=-Math.abs(state.vx)*damping}
        if(state.y-halfHeight<0){state.y=halfHeight;state.vy=Math.abs(state.vy)*damping}
        if(state.y+halfHeight>bounds.height){state.y=bounds.height-halfHeight;state.vy=-Math.abs(state.vy)*damping}
      });
      collide();
      states.forEach(state=>{if(!state.hidden)state.element.style.transform=`translate3d(${state.x-state.width/2}px,${state.y-state.height/2}px,0) rotate(${state.rotation}deg)`});
      requestAnimationFrame(frame);
    };

    section.classList.add('is-gravity-active');
    reset();
    new ResizeObserver(reset).observe(section);
    requestAnimationFrame(frame);
  })();
</script>

