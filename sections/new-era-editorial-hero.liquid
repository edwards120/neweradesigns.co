{% liquid
  assign line_1_font = "'NED Funk Machine','Arial Black',sans-serif"
  case section.settings.line_1_font
    when 'edwardian'
      assign line_1_font = "'NED Edwardian','Snell Roundhand',cursive"
    when 'mathew'
      assign line_1_font = "'NED Mathew Rohas','Arial Black',sans-serif"
    when 'milo'
      assign line_1_font = "'NED Milo',Arial,sans-serif"
    when 'system'
      assign line_1_font = "Arial,sans-serif"
  endcase

  assign line_2_font = "'NED Edwardian','Snell Roundhand',cursive"
  case section.settings.line_2_font
    when 'funk'
      assign line_2_font = "'NED Funk Machine','Arial Black',sans-serif"
    when 'mathew'
      assign line_2_font = "'NED Mathew Rohas','Arial Black',sans-serif"
    when 'milo'
      assign line_2_font = "'NED Milo',Arial,sans-serif"
    when 'system'
      assign line_2_font = "Arial,sans-serif"
  endcase

  assign highlight_a_font = 'inherit'
  if section.settings.highlight_a_font == 'script'
    assign highlight_a_font = "'NED Edwardian','Snell Roundhand',cursive"
  elsif section.settings.highlight_a_font == 'display'
    assign highlight_a_font = "'NED Funk Machine','Arial Black',sans-serif"
  endif

  assign highlight_b_font = 'inherit'
  if section.settings.highlight_b_font == 'script'
    assign highlight_b_font = "'NED Edwardian','Snell Roundhand',cursive"
  elsif section.settings.highlight_b_font == 'display'
    assign highlight_b_font = "'NED Funk Machine','Arial Black',sans-serif"
  endif

  assign halftone_shift = section.settings.halftone_intensity | times: 0.4
%}

<section
  class="ned-editorial-hero ned-editorial-hero--{{ section.settings.desktop_layout }} ned-editorial-hero--frame-{{ section.settings.frame_position }}{% if section.settings.animate_content %} has-entry-motion{% endif %}{% if section.settings.animate_halftone %} has-halftone-motion{% endif %}{% if section.settings.animate_kinetic_labels and section.settings.enable_gravity == false %} has-kinetic-motion{% endif %}"
  id="NedEditorialHero-{{ section.id }}"
  style="
    --ned-hero-bg: {{ section.settings.background_color }};
    --ned-hero-text: {{ section.settings.text_color }};
    --ned-hero-accent: {{ section.settings.accent_color }};
    --ned-hero-pink: {{ section.settings.pink_accent }};
    --ned-hero-min-height: {{ section.settings.desktop_min_height }}px;
    --ned-hero-mobile-height: {{ section.settings.mobile_min_height }}px;
    --ned-hero-padding: {{ section.settings.desktop_padding }}px;
    --ned-hero-mobile-padding: {{ section.settings.mobile_padding }}px;
    --ned-hero-content-width: {{ section.settings.content_max_width }}px;
    --ned-frame-width: {{ section.settings.frame_width }}px;
    --ned-frame-color: {{ section.settings.frame_color }};
    --ned-halftone-opacity: {{ section.settings.halftone_opacity | divided_by: 100.0 }};
    --ned-halftone-size: {{ section.settings.halftone_size }}%;
    --ned-halftone-speed: {{ section.settings.halftone_speed }}s;
    --ned-halftone-shift: {{ halftone_shift }}px;
    --ned-line-1-font: {{ line_1_font }};
    --ned-line-1-color: {{ section.settings.line_1_color }};
    --ned-line-1-min: {{ section.settings.line_1_mobile_size }}px;
    --ned-line-1-fluid: {{ section.settings.line_1_fluid_scale }}vw;
    --ned-line-1-max: {{ section.settings.line_1_desktop_size }}px;
    --ned-line-1-weight: {{ section.settings.line_1_weight }};
    --ned-line-1-tracking: {{ section.settings.line_1_tracking }}px;
    --ned-line-1-mobile-tracking: {{ section.settings.line_1_mobile_tracking }}px;
    --ned-line-1-word-spacing: {{ section.settings.line_1_word_spacing }}px;
    --ned-line-1-leading: {{ section.settings.line_1_line_height }};
    --ned-line-1-width: {{ section.settings.line_1_max_width }}px;
    --ned-line-1-x: {{ section.settings.line_1_x }}px;
    --ned-line-1-y: {{ section.settings.line_1_y }}px;
    --ned-line-1-mobile-x: {{ section.settings.line_1_mobile_x }}px;
    --ned-line-1-mobile-y: {{ section.settings.line_1_mobile_y }}px;
    --ned-line-1-rotation: {{ section.settings.line_1_rotation }}deg;
    --ned-line-1-z: {{ section.settings.line_1_layer }};
    --ned-line-1-stroke-width: {% if section.settings.line_1_stroke %}{{ section.settings.line_1_stroke_width }}px{% else %}0px{% endif %};
    --ned-line-1-stroke-color: {{ section.settings.line_1_stroke_color }};
    --ned-line-1-shadow: {% if section.settings.line_1_shadow %}{{ section.settings.line_1_shadow_x }}px {{ section.settings.line_1_shadow_y }}px {{ section.settings.line_1_shadow_blur }}px {{ section.settings.line_1_shadow_color }}{% else %}none{% endif %};
    --ned-line-2-font: {{ line_2_font }};
    --ned-line-2-color: {{ section.settings.line_2_color }};
    --ned-line-2-min: {{ section.settings.line_2_mobile_size }}px;
    --ned-line-2-fluid: {{ section.settings.line_2_fluid_scale }}vw;
    --ned-line-2-max: {{ section.settings.line_2_desktop_size }}px;
    --ned-line-2-weight: {{ section.settings.line_2_weight }};
    --ned-line-2-tracking: {{ section.settings.line_2_tracking }}px;
    --ned-line-2-mobile-tracking: {{ section.settings.line_2_mobile_tracking }}px;
    --ned-line-2-word-spacing: {{ section.settings.line_2_word_spacing }}px;
    --ned-line-2-leading: {{ section.settings.line_2_line_height }};
    --ned-line-2-width: {{ section.settings.line_2_max_width }}px;
    --ned-line-2-x: {{ section.settings.line_2_x }}px;
    --ned-line-2-y: {{ section.settings.line_2_y }}px;
    --ned-line-2-mobile-x: {{ section.settings.line_2_mobile_x }}px;
    --ned-line-2-mobile-y: {{ section.settings.line_2_mobile_y }}px;
    --ned-line-2-rotation: {{ section.settings.line_2_rotation }}deg;
    --ned-line-2-z: {{ section.settings.line_2_layer }};
    --ned-line-2-stroke-width: {% if section.settings.line_2_stroke %}{{ section.settings.line_2_stroke_width }}px{% else %}0px{% endif %};
    --ned-line-2-stroke-color: {{ section.settings.line_2_stroke_color }};
    --ned-line-2-shadow: {% if section.settings.line_2_shadow %}{{ section.settings.line_2_shadow_x }}px {{ section.settings.line_2_shadow_y }}px {{ section.settings.line_2_shadow_blur }}px {{ section.settings.line_2_shadow_color }}{% else %}none{% endif %};
    --ned-body-size: {{ section.settings.body_size }}px;
    --ned-body-mobile-size: {{ section.settings.body_mobile_size }}px;
    --ned-body-tracking: {{ section.settings.body_tracking }}px;
    --ned-body-leading: {{ section.settings.body_line_height }};
    --ned-body-width: {{ section.settings.body_max_width }}px;
    --ned-highlight-a-text: {{ section.settings.highlight_a_text_color }};
    --ned-highlight-a-bg: {{ section.settings.highlight_a_background }};
    --ned-highlight-a-font: {{ highlight_a_font }};
    --ned-highlight-a-tracking: {{ section.settings.highlight_a_tracking }}px;
    --ned-highlight-b-text: {{ section.settings.highlight_b_text_color }};
    --ned-highlight-b-bg: {{ section.settings.highlight_b_background }};
    --ned-highlight-b-font: {{ highlight_b_font }};
    --ned-highlight-b-tracking: {{ section.settings.highlight_b_tracking }}px;
    --ned-entry-speed: {{ section.settings.animation_speed }}s;
    --ned-entry-delay: {{ section.settings.animation_delay }}s;
  "
  data-ned-motion-root="true"
  data-ned-reveal
  {% if section.settings.enable_gravity %}data-ned-kinetic-field{% endif %}
  data-ned-gravity="{{ section.settings.enable_gravity }}"
  data-ned-gravity-strength="{{ section.settings.gravity_strength | divided_by: 100.0 }}"
  data-ned-gravity-damping="{{ section.settings.gravity_damping | divided_by: 100.0 }}"
>
  {% if section.settings.show_frame %}<span class="ned-editorial-hero__frame" aria-hidden="true"></span>{% endif %}
  <div
    class="ned-editorial-hero__halftone"
    aria-hidden="true"
    style="background-image:url('{% if section.settings.halftone_image != blank %}{{ section.settings.halftone_image | image_url: width: 4000 }}{% else %}https://cdn.shopify.com/s/files/1/0914/0138/8337/files/website_Background.svg?v=1784631913{% endif %}')"
  ></div>

  {% if section.blocks.size > 0 %}
    <div class="ned-editorial-hero__kinetics" aria-label="Explore our capabilities">
      {% for block in section.blocks %}
        {% if block.type == 'kinetic_label' and section.settings.show_kinetic_labels %}
          <a
            class="ned-editorial-hero__kinetic{% if block.settings.hide_mobile %} is-mobile-hidden{% endif %}"
            href="{{ block.settings.link | default: routes.root_url }}"
            data-ned-gravity-object
            data-desktop-x="{{ block.settings.x }}"
            data-desktop-y="{{ block.settings.y }}"
            data-mobile-x="{{ block.settings.mobile_x }}"
            data-mobile-y="{{ block.settings.mobile_y }}"
            data-rotation="{{ block.settings.rotation }}"
            style="--node-x:{{ block.settings.x }}%;--node-y:{{ block.settings.y }}%;--node-mobile-x:{{ block.settings.mobile_x }}%;--node-mobile-y:{{ block.settings.mobile_y }}%;--node-width:{{ block.settings.width }}px;--node-mobile-width:{{ block.settings.mobile_width }}px;--node-bg:{{ block.settings.background }};--node-ink:{{ block.settings.text_color }};--node-speed:{{ block.settings.speed }}s;--node-delay:-{{ block.settings.delay }}s;--node-drift-x:{{ block.settings.drift_x }}px;--node-drift-y:{{ block.settings.drift_y }}px;--node-rotate:{{ block.settings.rotation }}deg"
            {{ block.shopify_attributes }}
          ><span>{{ block.settings.label | escape }}</span></a>
        {% elsif block.type == 'hero_icon' and section.settings.show_hero_icons %}
          {% liquid
            assign icon_asset = block.settings.icon | default: 'icon-star.svg'
            case block.settings.icon
              when 'spark'
                assign icon_asset = 'icon-star.svg'
              when 'crosshair'
                assign icon_asset = 'icon-plus.svg'
              when 'arrow'
                assign icon_asset = 'icon-arrow.svg'
              when 'plus'
                assign icon_asset = 'icon-plus.svg'
              when 'ring'
                assign icon_asset = 'icon-map-pin.svg'
              when 'asterisk'
                assign icon_asset = 'icon-star.svg'
            endcase
            unless icon_asset contains '.svg'
              assign icon_asset = 'icon-star.svg'
            endunless
          %}
          <a
            class="ned-editorial-hero__icon{% if block.settings.hide_mobile %} is-mobile-hidden{% endif %}"
            href="{{ block.settings.link | default: routes.root_url }}"
            aria-label="{{ block.settings.label | default: block.settings.icon | escape }}"
            data-ned-gravity-object
            data-desktop-x="{{ block.settings.x }}"
            data-desktop-y="{{ block.settings.y }}"
            data-mobile-x="{{ block.settings.mobile_x }}"
            data-mobile-y="{{ block.settings.mobile_y }}"
            data-rotation="{{ block.settings.rotation }}"
            style="--icon-x:{{ block.settings.x }}%;--icon-y:{{ block.settings.y }}%;--icon-mobile-x:{{ block.settings.mobile_x }}%;--icon-mobile-y:{{ block.settings.mobile_y }}%;--icon-size:{{ block.settings.size }}px;--icon-mobile-size:{{ block.settings.mobile_size }}px;--icon-color:{{ block.settings.color }};--icon-rotate:{{ block.settings.rotation }}deg;--icon-bounce:{{ block.settings.bounce_height }}px;--icon-speed:{{ block.settings.speed }}s;--icon-delay:-{{ block.settings.delay }}s"
            {{ block.shopify_attributes }}
          ><span class="ned-editorial-hero__icon-svg" aria-hidden="true">{{ icon_asset | inline_asset_content }}</span></a>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  <div class="ned-editorial-hero__content">
    {% if section.settings.eyebrow != blank %}<p class="ned-editorial-hero__eyebrow{% unless section.settings.show_mobile_eyebrow %} is-mobile-hidden{% endunless %}">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <span class="ned-editorial-hero__crosshair" aria-hidden="true"></span>

    <h1 class="ned-editorial-hero__title" data-ned-collision-obstacle>
      <span class="ned-editorial-hero__line ned-editorial-hero__line--1 ned-case-{{ section.settings.line_1_case }} ned-align-{{ section.settings.line_1_alignment }}"><span>{{ section.settings.line_1_text | escape }}</span></span>
      <span class="ned-editorial-hero__line ned-editorial-hero__line--2 ned-case-{{ section.settings.line_2_case }} ned-align-{{ section.settings.line_2_alignment }}"><span>{{ section.settings.line_2_text | escape }}</span></span>
    </h1>

    {% if section.settings.body != blank %}<div class="ned-editorial-hero__body" data-ned-collision-obstacle>{{ section.settings.body }}</div>{% endif %}
    {% if section.settings.button_label != blank %}<a class="ned-editorial-hero__button" data-ned-collision-obstacle href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">+</span></a>{% endif %}
  </div>

  {% if section.settings.show_social_links %}
    <div class="ned-editorial-hero__social ned-editorial-hero__social--left">
      {% if settings.social_instagram_link != blank %}<a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">{{ 'icon-instagram.svg' | inline_asset_content }}</a>{% endif %}
    </div>
    <div class="ned-editorial-hero__social ned-editorial-hero__social--right">
      {% if settings.social_linkedin_link != blank %}<a href="{{ settings.social_linkedin_link }}" target="_blank" rel="noopener" aria-label="LinkedIn">{{ 'icon-linkedin.svg' | inline_asset_content }}</a>{% endif %}
    </div>
  {% endif %}

  <div class="ned-editorial-hero__rail">
    <span>{{ section.settings.rail_left | escape }}</span>
    <a href="{{ section.settings.rail_link | default: '#MainContent' }}">{{ section.settings.rail_center | escape }} <b aria-hidden="true">↓</b></a>
    <span>{{ section.settings.rail_right | escape }}</span>
  </div>
</section>

{% style %}
  @font-face{font-display:swap;font-family:'NED Milo';font-style:normal;font-weight:300 600;src:url("{{ 'MiloOT.otf' | file_url }}") format('opentype')}
  @font-face{font-display:swap;font-family:'NED Milo';font-style:normal;font-weight:700;src:url("{{ 'MiloOT-Bold.otf' | file_url }}") format('opentype')}
  @font-face{font-display:swap;font-family:'NED Milo';font-style:normal;font-weight:900;src:url("{{ 'MiloOT-Black.otf' | file_url }}") format('opentype')}
  @font-face{font-display:swap;font-family:'NED Mathew Rohas';font-style:normal;font-weight:400 900;src:url("{{ 'Mathew_Rohas_Free.ttf' | file_url }}") format('truetype')}
  @font-face{font-display:swap;font-family:'NED Edwardian';font-style:normal;font-weight:400;src:url("{{ 'edwardianscriptitc.ttf' | file_url }}") format('truetype')}
  @font-face{font-display:swap;font-family:'NED Funk Machine';font-style:normal;font-weight:400;src:url("{{ 'funkmachine.ttf' | file_url }}") format('truetype')}
  #NedEditorialHero-{{ section.id }}{align-items:center;background:var(--ned-hero-bg);color:var(--ned-hero-text);display:flex;isolation:isolate;justify-content:center;min-height:var(--ned-hero-min-height);overflow:hidden;padding:calc(var(--ned-hero-padding) + 90px) var(--ned-hero-padding) var(--ned-hero-padding);position:relative}
  #NedEditorialHero-{{ section.id }} *{box-sizing:border-box}
  #NedEditorialHero-{{ section.id }} .ned-editorial-hero__frame{border:var(--ned-frame-width) solid var(--ned-frame-color);inset:18px;pointer-events:none;position:absolute;z-index:12}
  #NedEditorialHero-{{ section.id }}.ned-editorial-hero--frame-outside .ned-editorial-hero__frame{inset:0}
  #NedEditorialHero-{{ section.id }} .ned-editorial-hero__halftone{animation-duration:var(--ned-halftone-speed);animation-iteration-count:infinite;animation-timing-function:ease-in-out;background-position:center;background-repeat:repeat;background-size:var(--ned-halftone-size) auto;filter:invert(1) sepia(.35) saturate(2.3) hue-rotate(178deg);inset:-4%;mix-blend-mode:normal;opacity:var(--ned-halftone-opacity);pointer-events:none;position:absolute;z-index:0}
  #NedEditorialHero-{{ section.id }}.has-halftone-motion .ned-editorial-hero__halftone{animation-name:nedHeroHalftone-{{ section.id }}}
  @keyframes nedHeroHalftone-{{ section.id }}{0%,100%{background-position:50% 50%;transform:scale(1)}50%{background-position:calc(50% + var(--ned-halftone-shift)) calc(50% - var(--ned-halftone-shift));transform:scale(1.018)}}
  #NedEditorialHero-{{ section.id }} .ned-editorial-hero__kinetics{inset:0;pointer-events:none;position:absolute;z-index:2}
  #NedEditorialHero-{{ section.id }} .ned-editorial-hero__kinetic{align-items:center;aspect-ratio:1;background:var(--node-bg);border-radius:50%;box-shadow:inset -10px -12px 20px rgba(12,29,67,.16),0 12px 24px rgba(12,29,67,.16);clip-path:none;color:var(--node-ink);display:flex;font:900 clamp(9px,1vw,13px)/1 'NED Milo',Arial,sans-serif;justify-content:center;left:var(--node-x);letter-spacing:.08em;padding:18px;pointer-events:auto;position:absolute;text-align:center;text-decoration:none;text-transform:uppercase;top:var(--node-y);transform:translate(-50%,-50%) rotate(var(--node-rotate));transition:filter .18s ease;white-space:nowrap;width:var(--node-width)}
  #NedEditorialHero-{{ section.id }} .ned-editorial-hero__kinetic:nth-child(2),#NedEditorialHero-{{ section.id }} .ned-editorial-hero__kinetic:nth-child(3){aspect-ratio:1;border-radius:50%;clip-path:none}
  #NedEditorialHero-{{ section.id }} .ned-editorial-hero__kinetic span{transition:letter-spacing .18s ease,transform .18s cubic-bezier(.2,1.4,.3,1)}
  #NedEditorialHero-{{ section.id }}.has-kinetic-motion .ned-editorial-hero__kinetic{animation:nedHeroBounce-{{ section.id }} var(--node-speed) linear var(--node-delay) infinite;transform-origin:center bottom}
  #NedEditorialHero-{{ section.id }} .ned-editorial-hero__kinetic:hover,#NedEditorialHero-{{ section.id }} .ned-editorial-hero__kinetic:focus-visible{animation-play-state:paused;filter:saturate(1.3) brightness(1.08);z-index:6}
  #NedEditorialHero-{{ section.id }} .ned-editorial-hero__kinetic:hover span,#NedEditorialHero-{{ section.id }} .ned-editorial-hero__kinetic:focus-visible span{letter-spacing:.2em;transform:scale(1.04)}
  @keyframes nedHeroBounce-{{ section.id }}{0%,8%,28%,42%,100%{transform:translate(-50%,-50%) translate3d(0,0,0) rotate(var(--node-rotate)) scale(1)}10%{transform:translate(-50%,-50%) translate3d(0,2px,0) rotate(var(--node-rotate)) scale(1.04,.94)}18%{transform:translate(-50%,-50%) translate3d(var(--node-drift-x),calc(0px - var(--node-drift-y)),0) rotate(calc(var(--node-rotate) + 1deg)) scale(.98,1.02)}30%{transform:translate(-50%,-50%) translate3d(0,1px,0) rotate(var(--node-rotate)) scale(1.02,.97)}35%{transform:translate(-50%,-50%) translate3d(calc(var(--node-drift-x) * -.25),calc(var(--node-drift-y) * -.25),0) rotate(var(--node-rotate)) scale(.99,1.01)}}
  #NedEditorialHero-{{ section.id }} .ned-editorial-hero__icon{align-items:center;background:none;border-radius:0;box-shadow:none;color:var(--icon-color);display:flex;height:var(--icon-size);justify-content:center;left:var(--icon-x);pointer-events:auto;position:absolute;text-decoration:none;top:var(--icon-y);transform:translate(-50%,-50%) rotate(var(--icon-rotate));width:var(--icon-size);z-index:4}
  #NedEditorialHero-{{ section.id }} .ned-editorial-hero__icon-svg{display:flex;filter:drop-shadow(0 1px 0 rgba(7,26,58,.35));height:100%;width:100%}
  #NedEditorialHero-{{ section.id }} .ned-editorial-hero__icon-svg svg{display:block;height:100%;width:100%}
  #NedEditorialHero-{{ section.id }} .ned-editorial-hero__icon-svg svg,#NedEditorialHero-{{ section.id }} .ned-editorial-hero__icon-svg svg *{fill:currentColor;stroke:currentColor;stroke-width:.8}
  #NedEditorialHero-{{ section.id }}.has-kinetic-motion .ned-editorial-hero__icon{animation:nedHeroIconBounce-{{ section.id }} var(--icon-speed) linear var(--icon-delay) infinite;transform-origin:center bottom}
  #NedEditorialHero-{{ section.id }}.is-gravity-active [data-ned-gravity-object]{animation:none!important;left:0;top:0;will-change:transform}
  @keyframes nedHeroIconBounce-{{ section.id }}{0%,10%,30%,43%,100%{transform:translate(-50%,-50%) translateY(0) rotate(var(--icon-rotate)) scale(1)}12%{transform:translate(-50%,-50%) translateY(2px) rotate(var(--icon-rotate)) scale(1.08,.9)}20%{transform:translate(-50%,-50%) translateY(calc(0px - var(--icon-bounce))) rotate(calc(var(--icon-rotate) + 5deg)) scale(.96,1.04)}32%{transform:translate(-50%,-50%) translateY(1px) rotate(var(--icon-rotate)) scale(1.04,.96)}37%{transform:translate(-50%,-50%) translateY(calc(var(--icon-bounce) * -.24)) rotate(calc(var(--icon-rotate) - 2deg))}}
  #NedEditorialHero-{{ section.id }} .ned-editorial-hero__content{align-items:center;display:flex;flex-direction:column;max-width:var(--ned-hero-content-width);position:relative;text-align:center;width:100%;z-index:3}
  #NedEditorialHero-{{ section.id }}.ned-editorial-hero--asymmetric-left .ned-editorial-hero__content{align-items:flex-start;text-align:left}
  #NedEditorialHero-{{ section.id }}.ned-editorial-hero--asymmetric-right .ned-editorial-hero__content{align-items:flex-end;text-align:right}
  #NedEditorialHero-{{ section.id }} .ned-editorial-hero__eyebrow{font:800 10px/1 'NED Milo',Arial,sans-serif;letter-spacing:.18em;margin:0 0 44px;text-transform:uppercase}
  #NedEditorialHero-{{ section.id }} .ned-editorial-hero__crosshair{height:34px;margin-bottom:42px;position:relative;width:34px}
  #NedEditorialHero-{{ section.id }} .ned-editorial-hero__crosshair::before,#NedEditorialHero-{{ section.id }} .ned-editorial-hero__crosshair::after{background:currentColor;content:'';left:50%;position:absolute;top:50%;transform:translate(-50%,-50%)}
  #NedEditorialHero-{{ section.id }} .ned-editorial-hero__crosshair::before{height:34px;width:1px}#NedEditorialHero-{{ section.id }} .ned-editorial-hero__crosshair::after{height:1px;width:34px}
  #NedEditorialHero-{{ section.id }} .ned-editorial-hero__title{align-items:inherit;display:flex;flex-direction:column;margin:0;max-width:100%;width:100%}
