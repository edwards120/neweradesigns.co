{% comment %}
Template: page.retainer.liquid
Add to: Templates folder in Shopify Theme Editor
URL will be: yourstore.com/pages/[page-handle]
{% endcomment %}

<style>
@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap');

.ned-wrap *, .ned-wrap *::before, .ned-wrap *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.ned-wrap {
  --amber: #E8932A;
  --amber-lt:#FDF0DC;
  --ink: #111111;
  --ink-2: #3a3a3a;
  --mid: #777777;
  --rule: #E2DDD6;
  --bg: #F7F4EF;
  --white: #FFFFFF;
  --ai-blue: #2D3F7A;
  --radius: 8px;
  font-family: 'Montserrat', sans-serif;
  background: var(--bg);
  color: var(--ink);
  font-size: 14px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* PAGE LAYOUT */
.ned-page {
  display: grid;
  grid-template-columns: 260px 1fr;
  min-height: 100vh;
}

/* SIDEBAR */
.ned-sidebar {
  background: var(--amber);
  padding: 56px 32px 48px;
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}

.ned-wordmark {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.6);
  margin-bottom: 6px;
}

.ned-sidebar-title {
  font-size: 18px;
  font-weight: 800;
  color: #fff;
  line-height: 1.25;
  letter-spacing: -0.01em;
  margin-bottom: 24px;
}

.ned-rule {
  width: 32px;
  height: 1.5px;
  background: rgba(255,255,255,0.35);
  margin-bottom: 24px;
}

.ned-sidebar-body {
  font-size: 11.5px;
  color: rgba(255,255,255,0.82);
  line-height: 1.8;
  font-weight: 400;
  margin-bottom: 40px;
}

.ned-sidebar-section {
  margin-bottom: 36px;
}

.ned-sidebar-section-label {
  font-size: 8.5px;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.5);
  margin-bottom: 10px;
}

.ned-sidebar-section p {
  font-size: 11px;
  color: rgba(255,255,255,0.8);
  line-height: 1.75;
}

.ned-sidebar-callout {
  margin-top: auto;
  border-top: 1px solid rgba(255,255,255,0.2);
  padding-top: 28px;
}

.ned-sidebar-callout-title {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.5);
  margin-bottom: 8px;
}

.ned-sidebar-callout p {
  font-size: 11px;
  color: rgba(255,255,255,0.85);
  line-height: 1.75;
}

/* MAIN */
.ned-main {
  padding: 64px 56px 80px 52px;
  display: flex;
  flex-direction: column;
  gap: 64px;
  max-width: 960px;
    margin: 0 auto;
}

.ned-page-header {
  border-bottom: 1px solid var(--rule);
  padding-bottom: 32px;
}

.ned-eyebrow {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: var(--amber);
  margin-bottom: 12px;
}

.ned-page-title {
  font-size: 30px;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.15;
  letter-spacing: -0.025em;
  margin-bottom: 14px;
}

.ned-page-subtitle {
  font-size: 13px;
  color: var(--mid);
  line-height: 1.8;
  max-width: 620px;
  font-weight: 400;
}

.ned-section-label {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--mid);
  margin-bottom: 20px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--rule);
}

/* TABLE */
.ned-table-outer {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.ned-table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
  min-width: 680px;
  font-size: 11.5px;
}

.ned-table thead th {
  background: var(--ink);
  color: #fff;
  padding: 16px 18px;
  text-align: left;
  vertical-align: middle;
  line-height: 1.4;
}

.ned-th-inner {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.ned-th-icon {
  font-size: 15px;
}

.ned-th-label {
  font-size: 8.5px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  line-height: 1.4;
}

.ned-table tbody td {
  padding: 12px 18px;
  vertical-align: top;
  line-height: 1.6;
  color: var(--ink-2);
  border-bottom: 1px solid rgba(0,0,0,0.04);
  border-right: 1px solid rgba(0,0,0,0.04);
  background: var(--white);
  transition: background 0.12s ease;
  cursor: default;
}

.ned-table tbody td:hover {
  background: var(--amber-lt);
}

.ned-table tbody td:last-child {
  border-right: none;
}

.ned-table tbody tr:nth-child(even) td {
  background: #F9F6F2;
}

.ned-table tbody tr:nth-child(even) td:hover {
  background: var(--amber-lt);
}

.ned-badge {
  display: inline-flex;
  align-items: center;
  font-size: 7.5px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 2px 7px;
  border-radius: 3px;
  margin-top: 5px;
}

.ned-badge-time {
  background: var(--ink);
  color: #fff;
}

.ned-badge-ai {
  background: var(--ai-blue);
  color: #fff;
}

/* MOBILE LANES */
.ned-mobile-lanes {
  display: none;
  flex-direction: column;
  gap: 16px;
}

.ned-lane {
  background: var(--white);
  border-radius: var(--radius);
  overflow: hidden;
  border: 1px solid var(--rule);
}

.ned-lane-head {
  background: var(--ink);
  color: #fff;
  padding: 14px 20px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.ned-lane-icon {
  font-size: 18px;
}

.ned-lane-label {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  line-height: 1.4;
}

.ned-lane-list {
  list-style: none;
}

.ned-lane-list li {
  padding: 12px 20px;
  font-size: 12.5px;
  line-height: 1.6;
  color: var(--ink-2);
  border-bottom: 1px solid rgba(0,0,0,0.05);
  background: var(--white);
  display: flex;
  flex-direction: column;
  gap: 5px;
  transition: background 0.12s ease;
  cursor: default;
}

.ned-lane-list li:nth-child(even) {
  background: #F9F6F2;
}

.ned-lane-list li:last-child {
  border-bottom: none;
}

.ned-lane-list li:active {
  background: var(--amber-lt) !important;
}

/* TURNAROUND */
.ned-tat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.ned-tat-card {
  background: var(--white);
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  padding: 22px 20px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  transition: border-color 0.15s ease;
}

.ned-tat-card:hover {
  border-color: var(--amber);
}

.ned-tat-label {
  font-size: 8.5px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--mid);
}

.ned-tat-time {
  font-size: 21px;
  font-weight: 800;
  color: var(--amber);
  letter-spacing: -0.03em;
  line-height: 1.1;
}

.ned-tat-scope {
  font-size: 10.5px;
  color: var(--mid);
  line-height: 1.6;
  margin-top: 2px;
}

.ned-tat-note {
  font-size: 9.5px;
  color: var(--mid);
  font-style: italic;
  margin-top: 4px;
  padding-top: 8px;
  border-top: 1px solid var(--rule);
}

/* REVISIONS */
.ned-rev-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.ned-rev-item {
  background: var(--white);
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  padding: 10px 16px;
  font-size: 11px;
  color: var(--ink-2);
  font-weight: 500;
  transition: border-color 0.15s ease;
}

.ned-rev-item:hover {
  border-color: var(--amber);
}

.ned-rev-item strong {
  color: var(--amber);
  font-weight: 700;
}

.ned-rev-note {
  background: transparent;
  border-color: transparent;
  color: var(--mid);
  font-size: 10.5px;
  font-style: italic;
  padding-left: 0;
}

/* RESPONSIVE */
@media (max-width: 1024px) {
  .ned-page {
    grid-template-columns: 220px 1fr;
  }
  .ned-main {
    padding: 48px 36px 64px 32px;
    gap: 52px;
  }
  .ned-tat-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .ned-page {
    grid-template-columns: 1fr;
  }
  .ned-sidebar {
    position: static;
    height: auto;
    padding: 36px 28px 32px;
  }
  .ned-sidebar-body {
    margin-bottom: 0;
  }
  .ned-sidebar-section,
  .ned-sidebar-callout {
    display: none;
  }
  .ned-sidebar-title {
    font-size: 20px;
    margin-bottom: 12px;
  }
  .ned-main {
    padding: 40px 24px 64px;
    gap: 48px;
    max-width: 100%;
  }
  .ned-page-title {
    font-size: 24px;
  }
  .ned-desktop-section {
    display: none;
  }
  .ned-mobile-lanes {
    display: flex;
  }
  .ned-tat-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .ned-tat-time {
    font-size: 18px;
  }
}

@media (max-width: 520px) {
  .ned-sidebar {
    padding: 28px 20px 24px;
  }
  .ned-sidebar-title {
    font-size: 18px;
  }
  .ned-main {
    padding: 32px 16px 56px;
    gap: 40px;
  }
  .ned-page-title {
    font-size: 20px;
  }
  .ned-page-subtitle {
    font-size: 12px;
  }
  .ned-tat-grid {
    grid-template-columns: 1fr;
  }
  .ned-tat-card {
    flex-direction: row;
    align-items: center;
    gap: 16px;
    padding: 16px 18px;
  }
  .ned-tat-note {
    display: none;
  }
  .ned-rev-grid {
    gap: 8px;
  }
  .ned-rev-item {
    font-size: 10.5px;
    padding: 9px 14px;
  }
}
</style>

