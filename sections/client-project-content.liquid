client-project-content<div class="cf-page">
  <!-- HEADER -->
  <div class="cf-header">
    <div class="cf-header-left">
      <span class="cf-brand">NEW ERA DESIGNS</span>
      <span class="cf-subtitle">Client Project Files</span>
    </div>
    <a href="/pages/protected-projects" class="cf-back-btn">&larr; BACK TO GATE</a>
  </div>

  <!-- PAGE TITLE -->
  <div class="cf-title-block">
    <h1 class="cf-title">Client Files</h1>
    <div class="cf-meta">
      <span>&mdash; Confidential</span>
      <span>&mdash; New Era Designs</span>
      <span>&mdash; 2026</span>
    </div>
  </div>

  <!-- SECTION LABEL -->
  <div class="cf-section-label">
    <span class="cf-section-title">PROJECT PROPOSALS</span>
    <span class="cf-section-sub">2D Design Presentations</span>
  </div>
  <div class="cf-divider"></div>

  <!-- FILE: Rice Box -->
  <div class="cf-file-card">
    <div class="cf-file-header">
      <span class="cf-file-title">Rice Box &mdash; Wayfinding Proposal</span>
      <span class="cf-tag">PDF</span>
    </div>
    <object
      data="https://cdn.shopify.com/s/files/1/0914/0138/8337/files/00_2D_PROJECT_PROPSAL_Rice_Box.pdf?v=1779689421"
      type="application/pdf"
      class="cf-embed">
      <div class="cf-embed-fallback">
        <p>PDF preview not available in your browser.</p>
      </div>
    </object>
  </div>

  <!-- FILE: Marathon Fitness -->
  <div class="cf-file-card">
    <div class="cf-file-header">
      <span class="cf-file-title">Marathon Fitness &mdash; Cut Sheets</span>
      <span class="cf-tag">PDF</span>
    </div>
    <object
      data="https://cdn.shopify.com/s/files/1/0914/0138/8337/files/Marathon_Fitness_Cut_Sheets.pdf?v=1779689420"
      type="application/pdf"
      class="cf-embed">
      <div class="cf-embed-fallback">
        <p>PDF preview not available in your browser.</p>
      </div>
    </object>
  </div>

  <!-- FILE: Burger Joint -->
  <div class="cf-file-card">
    <div class="cf-file-header">
      <span class="cf-file-title">Burger Joint &mdash; Wayfinding Proposal</span>
      <span class="cf-tag">PDF</span>
    </div>
    <object
      data="https://cdn.shopify.com/s/files/1/0914/0138/8337/files/00_2D_PROJECT_PROPSAL_Burger_Joint.pdf?v=1779689421"
      type="application/pdf"
      class="cf-embed">
      <div class="cf-embed-fallback">
        <p>PDF preview not available in your browser.</p>
        <a class="cf-download-btn" href="https://cdn.shopify.com/s/files/1/0914/0138/8337/files/00_2D_PROJECT_PROPSAL_Burger_Joint.pdf?v=1779689421" target="_blank">DOWNLOAD PDF</a>
      </div>
    </object>
  </div>

  <!-- FOOTER -->
  <div class="cf-footer-bar">
    <p>Confidential &mdash; New Era Designs &copy; {{ 'now' | date: '%Y' }}</p>
    <a href="/pages/protected-projects">Exit Secure Area</a>
  </div>

</div>

<style>
  .cf-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 32px 24px 60px;
    font-family: inherit;
  }
  .cf-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 32px;
    padding-bottom: 16px;
    border-bottom: 1px solid #e5e5e5;
  }
  .cf-brand {
    display: block;
    font-size: 10px;
    letter-spacing: 0.15em;
    color: #e8a000;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .cf-subtitle {
    font-size: 12px;
    color: #888;
    letter-spacing: 0.05em;
  }
  .cf-back-btn {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: #333;
    text-decoration: none;
    border: 1px solid #ccc;
    padding: 6px 12px;
    border-radius: 3px;
    transition: all 0.2s;
  }
  .cf-back-btn:hover { background: #f5f5f5; }
  .cf-title-block { margin-bottom: 24px; }
  .cf-title {
    font-size: 36px;
    font-weight: 700;
    color: #111;
    margin: 0 0 8px;
  }
  .cf-meta {
    font-size: 12px;
    color: #e8a000;
    display: flex;
    gap: 16px;
  }
  .cf-section-label {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 8px;
  }
  .cf-section-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #111;
    text-transform: uppercase;
  }
  .cf-section-sub {
    font-size: 11px;
    color: #999;
    letter-spacing: 0.05em;
  }
  .cf-divider {
    height: 1px;
    background: #111;
    margin-bottom: 28px;
  }
  .cf-file-card {
    background: #f8f8f8;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 32px;
  }
  .cf-file-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 20px;
    background: #fff;
    border-bottom: 1px solid #e5e5e5;
  }
  .cf-file-title {
    font-size: 14px;
    font-weight: 500;
    color: #111;
  }
  .cf-tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    background: #111;
    color: #fff;
    padding: 3px 8px;
    border-radius: 2px;
  }
  .cf-embed {
    display: block;
    width: 100%;
    height: 700px;
    border: none;
  }
  .cf-embed-fallback {
    padding: 60px 20px;
    text-align: center;
    background: #f8f8f8;
  }
  .cf-embed-fallback p {
    font-size: 14px;
    color: #888;
    margin-bottom: 16px;
  }
  .cf-download-btn {
    display: inline-block;
    background: #111;
    color: #fff;
    padding: 12px 28px;
    font-size: 12px;
    letter-spacing: 0.1em;
    font-weight: 600;
    text-decoration: none;
    border-radius: 3px;
  }
  .cf-download-btn:hover { background: #333; }
  .cf-footer-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid #e5e5e5;
    font-size: 12px;
    color: #999;
    margin-top: 40px;
  }
  .cf-footer-bar a {
    color: #111;
    text-decoration: none;
    font-size: 12px;
  }
</style>

