<section class="ned-feature{% if section.settings.enable_motion %} has-ned-motion{% endif %}" id="NedFeature-{{ section.id }}" style="--feature-bg:{{ section.settings.background }};--feature-ink:{{ section.settings.text_color }};--feature-accent:{{ section.settings.accent }};--feature-speed:{{ section.settings.motion_speed }}ms;--feature-rotate:{{ section.settings.title_rotation }}deg;--feature-line-1-tracking:{{ section.settings.line_1_tracking }}px;--feature-line-2-tracking:{{ section.settings.line_2_tracking }}px;--feature-mobile-line-1:{{ section.settings.mobile_line_1_size }}px;--feature-mobile-line-2:{{ section.settings.mobile_line_2_size }}px" {% if section.settings.enable_motion %}data-ned-reveal data-ned-pointer-field{% endif %}>
  <div class="ned-feature__blueprint" aria-hidden="true"><span>F-001</span><i></i><span>{{ section.settings.dimension | escape }}</span></div>
  <header><p>{{ section.settings.eyebrow | escape }}</p><span>{{ section.settings.classification | escape }}</span></header>
  <div class="ned-feature__stage">
    <p class="ned-feature__overline">{{ section.settings.overline | escape }}</p>
    <h2><span>{{ section.settings.title_line_1 | escape }}</span><span>{{ section.settings.title_line_2 | escape }}</span></h2>
    <div class="ned-feature__copy">{{ section.settings.body }}</div>
    {% if section.settings.button_label != blank %}<a href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }} <b aria-hidden="true">＋</b></a>{% endif %}
  </div>
  <footer>{% for block in section.blocks %}<span {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>{% endfor %}</footer>
</section>

{% style %}
  #NedFeature-{{ section.id }}{--ned-pointer-x:0;--ned-pointer-y:0;background:var(--feature-bg);color:var(--feature-ink);isolation:isolate;min-height:920px;overflow:hidden;padding:clamp(28px,5vw,80px);position:relative}#NedFeature-{{ section.id }} *{box-sizing:border-box}#NedFeature-{{ section.id }}>header,#NedFeature-{{ section.id }}>footer{display:flex;font:800 10px/1 'NED Milo',Arial,sans-serif;justify-content:space-between;letter-spacing:.16em;position:relative;text-transform:uppercase;z-index:5}#NedFeature-{{ section.id }}>header p{margin:0}#NedFeature-{{ section.id }}>footer{border-top:1px solid currentColor;bottom:clamp(28px,5vw,80px);left:clamp(28px,5vw,80px);padding-top:18px;position:absolute;right:clamp(28px,5vw,80px)}
  #NedFeature-{{ section.id }} .ned-feature__stage{align-items:center;display:flex;flex-direction:column;justify-content:center;min-height:760px;position:relative;text-align:center}#NedFeature-{{ section.id }} .ned-feature__overline{font:800 11px/1 'NED Milo',Arial,sans-serif;letter-spacing:.24em;margin:0 0 20px;text-transform:uppercase}#NedFeature-{{ section.id }} h2{display:flex;flex-direction:column;font-weight:400;line-height:.58;margin:0;position:relative;transform:rotate(var(--feature-rotate));z-index:2}#NedFeature-{{ section.id }} h2 span:first-child{font:400 clamp(90px,17vw,270px)/.55 'NED Funk Machine','Arial Black',sans-serif;letter-spacing:var(--feature-line-1-tracking);text-transform:uppercase}#NedFeature-{{ section.id }} h2 span:last-child{color:var(--feature-accent);font:400 clamp(100px,19vw,310px)/.58 'NED Edwardian','Snell Roundhand',cursive;letter-spacing:var(--feature-line-2-tracking);margin-top:-.04em;transform:translate(calc(var(--ned-pointer-x) * 18px),calc(var(--ned-pointer-y) * 12px)) rotate(-4deg)}#NedFeature-{{ section.id }} .ned-feature__copy{font:500 17px/1.45 'NED Milo',Arial,sans-serif;margin:clamp(44px,7vw,90px) auto 0;max-width:620px}#NedFeature-{{ section.id }} .ned-feature__copy p{margin:0}#NedFeature-{{ section.id }} .ned-feature__stage>a{align-items:center;background:var(--feature-accent);border:1px solid currentColor;border-radius:0;color:var(--feature-bg);display:flex;font:900 11px/1 'NED Milo',Arial,sans-serif;gap:44px;letter-spacing:.14em;margin-top:28px;padding:20px 24px;text-decoration:none;text-transform:uppercase;transition:background .18s ease,color .18s ease,transform .18s cubic-bezier(.2,1.4,.3,1)}#NedFeature-{{ section.id }} .ned-feature__stage>a b{animation:nedFeatureButtonBounce-{{ section.id }} 1.8s linear infinite;display:inline-block;transform-origin:center bottom}#NedFeature-{{ section.id }} .ned-feature__stage>a:hover,#NedFeature-{{ section.id }} .ned-feature__stage>a:focus-visible{background:var(--feature-ink);color:var(--feature-bg);transform:translateY(-4px) rotate(-1deg)}#NedFeature-{{ section.id }} .ned-feature__stage>a:hover b,#NedFeature-{{ section.id }} .ned-feature__stage>a:focus-visible b{animation-duration:.72s}@keyframes nedFeatureButtonBounce-{{ section.id }}{0%,12%,42%,100%{transform:translateY(0) scale(1)}15%{transform:translateY(2px) scale(1.12,.88)}24%{transform:translateY(-7px) scale(.96,1.04)}34%{transform:translateY(0) scale(1.05,.95)}}
  #NedFeature-{{ section.id }} .ned-feature__blueprint{inset:12% 8%;opacity:.28;pointer-events:none;position:absolute}#NedFeature-{{ section.id }} .ned-feature__blueprint i{border-left:1px solid currentColor;border-top:1px solid currentColor;display:block;height:100%;position:absolute;width:100%}#NedFeature-{{ section.id }} .ned-feature__blueprint i::before,#NedFeature-{{ section.id }} .ned-feature__blueprint i::after{background:currentColor;content:'';height:12px;position:absolute;top:-6px;width:1px}#NedFeature-{{ section.id }} .ned-feature__blueprint i::before{left:0}#NedFeature-{{ section.id }} .ned-feature__blueprint i::after{right:0}#NedFeature-{{ section.id }} .ned-feature__blueprint span{font:800 8px/1 'NED Milo',Arial,sans-serif;letter-spacing:.13em;position:absolute;text-transform:uppercase}#NedFeature-{{ section.id }} .ned-feature__blueprint span:first-child{left:8px;top:8px}#NedFeature-{{ section.id }} .ned-feature__blueprint span:last-child{right:8px;top:8px}
  #NedFeature-{{ section.id }}.has-ned-motion .ned-feature__stage>*{opacity:0;transform:translateY(28px);transition:opacity var(--feature-speed) cubic-bezier(.16,1,.3,1),transform var(--feature-speed) cubic-bezier(.16,1,.3,1)}#NedFeature-{{ section.id }}.has-ned-motion.is-visible .ned-feature__stage>*{opacity:1}#NedFeature-{{ section.id }}.has-ned-motion.is-visible .ned-feature__stage>h2{transform:rotate(var(--feature-rotate))}#NedFeature-{{ section.id }}.has-ned-motion.is-visible .ned-feature__stage>*:nth-child(2){transition-delay:75ms}#NedFeature-{{ section.id }}.has-ned-motion.is-visible .ned-feature__stage>*:nth-child(3){transition-delay:150ms}#NedFeature-{{ section.id }}.has-ned-motion.is-visible .ned-feature__stage>*:nth-child(4){transition-delay:225ms}
  @media(max-width:989px){#NedFeature-{{ section.id }}{min-height:820px;padding:34px clamp(22px,5vw,48px)}#NedFeature-{{ section.id }} .ned-feature__stage{min-height:680px;padding:74px 0 110px}#NedFeature-{{ section.id }} h2 span:first-child{font-size:clamp(var(--feature-mobile-line-1),22vw,150px);line-height:.64}#NedFeature-{{ section.id }} h2 span:last-child{font-size:clamp(var(--feature-mobile-line-2),27vw,180px);line-height:.62}#NedFeature-{{ section.id }} .ned-feature__copy{font-size:16px;line-height:1.55;margin-top:58px;max-width:84vw}#NedFeature-{{ section.id }}>footer{bottom:28px;left:20px;right:20px}#NedFeature-{{ section.id }}>footer span:nth-child(n+3){display:none}}
  @media(prefers-reduced-motion:reduce){#NedFeature-{{ section.id }} *{animation:none!important;opacity:1!important;transition:none!important}#NedFeature-{{ section.id }} h2 span:last-child{transform:rotate(-4deg)}}
{% endstyle %}

{% schema %}
{
  "name":"NED featured experience",
  "settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Featured experience / 01"},{"type":"text","id":"classification","label":"Classification","default":"Interactive identity study"},{"type":"text","id":"overline","label":"Overline","default":"Step inside the"},{"type":"text","id":"title_line_1","label":"Title line 1","default":"FUNK"},{"type":"text","id":"title_line_2","label":"Title line 2","default":"Machine"},{"type":"richtext","id":"body","label":"Body","default":"<p>A playful identity system where typography, motion, and spatial behavior react immediately to the visitor.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Enter the experience"},{"type":"url","id":"button_link","label":"Button link"},{"type":"text","id":"dimension","label":"Blueprint dimension","default":"24'-0\" TYPE FIELD"},{"type":"color_background","id":"background","label":"Background","default":"#ef3e23"},{"type":"color","id":"text_color","label":"Text","default":"#071a3a"},{"type":"color","id":"accent","label":"Accent","default":"#f7e51d"},{"type":"header","content":"Typography"},{"type":"range","id":"line_1_tracking","label":"FUNK tracking","min":-12,"max":16,"step":0.5,"unit":"px","default":-7},{"type":"range","id":"line_2_tracking","label":"Machine tracking","min":-12,"max":16,"step":0.5,"unit":"px","default":-4},{"type":"range","id":"mobile_line_1_size","label":"Mobile FUNK size","min":64,"max":140,"step":4,"unit":"px","default":84},{"type":"range","id":"mobile_line_2_size","label":"Mobile Machine size","min":80,"max":180,"step":4,"unit":"px","default":104},{"type":"range","id":"title_rotation","label":"Title rotation","min":-10,"max":10,"step":1,"unit":"deg","default":-2},{"type":"header","content":"Motion"},{"type":"checkbox","id":"enable_motion","label":"Enable fast motion","default":true},{"type":"range","id":"motion_speed","label":"Reveal speed","min":250,"max":600,"step":25,"unit":"ms","default":400}],
  "blocks":[{"type":"detail","name":"Footer detail","settings":[{"type":"text","id":"text","label":"Text","default":"Typography / motion / play"}]}],"max_blocks":4,
  "presets":[{"name":"NED featured experience","blocks":[{"type":"detail"},{"type":"detail"},{"type":"detail"}]}]
}
{% endschema %}
