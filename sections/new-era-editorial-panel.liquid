{% liquid
  assign heading_font = "'NED Funk Machine','Arial Black',sans-serif"
  if section.settings.heading_font == 'script'
    assign heading_font = "'NED Edwardian','Snell Roundhand',cursive"
  elsif section.settings.heading_font == 'milo'
    assign heading_font = "'NED Milo',Arial,sans-serif"
  endif
%}

<section
  class="ned-panel ned-panel--{{ section.settings.layout }}{% if section.settings.enable_motion %} has-ned-motion{% endif %}"
  id="NedPanel-{{ section.id }}"
  style="--panel-bg:{{ section.settings.background }};--panel-ink:{{ section.settings.text_color }};--panel-accent:{{ section.settings.accent }};--panel-pad:{{ section.settings.padding }}px;--panel-mobile-pad:{{ section.settings.mobile_padding }}px;--panel-min:{{ section.settings.min_height }}px;--panel-heading:{{ heading_font }};--panel-heading-min:{{ section.settings.mobile_heading_size }}px;--panel-heading-fluid:{{ section.settings.fluid_heading_size }}vw;--panel-heading-max:{{ section.settings.heading_size }}px;--panel-tracking:{{ section.settings.heading_tracking }}px;--panel-mobile-tracking:{{ section.settings.mobile_heading_tracking }}px;--panel-leading:{{ section.settings.heading_line_height }};--panel-heading-x:{{ section.settings.heading_x }}px;--panel-heading-y:{{ section.settings.heading_y }}px;--panel-body-size:{{ section.settings.body_size }}px;--panel-mobile-body-size:{{ section.settings.mobile_body_size }}px;--panel-body-width:{{ section.settings.body_width }}px;--panel-rule:{{ section.settings.rule_width }}px;--panel-motion:{{ section.settings.motion_speed }}ms;--panel-shift:{{ section.settings.motion_distance }}px"
  {% if section.settings.enable_motion %}data-ned-reveal{% endif %}
>
  <span class="ned-panel__frame" aria-hidden="true"></span>
  <div class="ned-panel__index" aria-hidden="true">{{ section.settings.index | escape }}</div>
  <div class="ned-panel__copy">
    {% if section.settings.eyebrow != blank %}<p class="ned-panel__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h2>{{ section.settings.heading | escape }}</h2>
    {% if section.settings.body != blank %}<div class="ned-panel__body">{{ section.settings.body }}</div>{% endif %}
    {% if section.settings.button_label != blank %}<a href="{{ section.settings.button_link | default: routes.root_url }}" class="ned-panel__link">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
  </div>
  <div class="ned-panel__annotations" aria-label="Technical annotations">
    {% for block in section.blocks %}<span {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>{% endfor %}
  </div>
  {% if section.settings.show_spinning_disc %}
    <a class="ned-panel__disc" href="{{ section.settings.disc_link | default: section.settings.button_link | default: routes.root_url }}" aria-label="{{ section.settings.disc_label | default: 'Open the podcast' | escape }}">
      <span>{{ section.settings.disc_label | default: 'NEW ERA / ON AIR' | escape }}</span><i aria-hidden="true"></i>
    </a>
  {% endif %}
</section>

{% style %}
  #NedPanel-{{ section.id }}{background:var(--panel-bg);color:var(--panel-ink);display:grid;grid-template-columns:minmax(0,1.5fr) minmax(230px,.5fr);isolation:isolate;min-height:var(--panel-min);overflow:hidden;padding:var(--panel-pad);position:relative}
  #NedPanel-{{ section.id }} *{box-sizing:border-box}#NedPanel-{{ section.id }} .ned-panel__frame{border:var(--panel-rule) solid currentColor;inset:18px;pointer-events:none;position:absolute}
  #NedPanel-{{ section.id }} .ned-panel__index{color:var(--panel-accent);font:400 clamp(150px,30vw,520px)/.65 'NED Edwardian','Snell Roundhand',cursive;opacity:.16;position:absolute;right:-.04em;top:.04em;z-index:-1}
  #NedPanel-{{ section.id }} .ned-panel__copy{align-self:center;max-width:1280px;position:relative;transform:translate(var(--panel-heading-x),var(--panel-heading-y))}
  #NedPanel-{{ section.id }} .ned-panel__eyebrow{font:800 11px/1 'NED Milo',Arial,sans-serif;letter-spacing:.2em;margin:0 0 clamp(30px,5vw,74px);text-transform:uppercase}
  #NedPanel-{{ section.id }} h2{color:inherit;font-family:var(--panel-heading);font-size:clamp(var(--panel-heading-min),var(--panel-heading-fluid),var(--panel-heading-max));font-weight:400;letter-spacing:var(--panel-tracking);line-height:var(--panel-leading);margin:0;max-width:1200px;text-wrap:balance}
  #NedPanel-{{ section.id }} .ned-panel__body{font:500 var(--panel-body-size)/1.45 'NED Milo',Arial,sans-serif;margin:clamp(34px,5vw,72px) 0 0;max-width:var(--panel-body-width)}#NedPanel-{{ section.id }} .ned-panel__body p{margin:0 0 1em}#NedPanel-{{ section.id }} .ned-panel__body strong{background:var(--panel-accent);color:var(--panel-bg);padding:0 .14em}#NedPanel-{{ section.id }} .ned-panel__body em{color:var(--panel-accent);font-family:'NED Edwardian','Snell Roundhand',cursive;font-size:1.55em;font-style:normal;line-height:.6}
  #NedPanel-{{ section.id }} .ned-panel__link{align-items:center;border-bottom:2px solid currentColor;color:inherit;display:inline-flex;font:900 12px/1 'NED Milo',Arial,sans-serif;gap:36px;letter-spacing:.12em;margin-top:30px;padding:12px 0;text-decoration:none;text-transform:uppercase;transition:color .18s ease,gap .18s cubic-bezier(.2,1.4,.3,1),letter-spacing .18s ease}#NedPanel-{{ section.id }} .ned-panel__link span{animation:nedPanelButtonBounce-{{ section.id }} 1.9s linear infinite;display:inline-block;transform-origin:center bottom}#NedPanel-{{ section.id }} .ned-panel__link:hover,#NedPanel-{{ section.id }} .ned-panel__link:focus-visible{color:var(--panel-accent);gap:52px;letter-spacing:.17em}#NedPanel-{{ section.id }} .ned-panel__link:hover span,#NedPanel-{{ section.id }} .ned-panel__link:focus-visible span{animation-duration:.72s}@keyframes nedPanelButtonBounce-{{ section.id }}{0%,12%,42%,100%{transform:translateY(0) scale(1)}15%{transform:translateY(2px) scale(1.12,.88)}24%{transform:translateY(-6px) scale(.96,1.04)}34%{transform:translateY(0) scale(1.05,.95)}}
  #NedPanel-{{ section.id }} .ned-panel__annotations{align-self:end;border-left:var(--panel-rule) solid currentColor;display:flex;flex-direction:column;font:800 9px/1.3 'NED Milo',Arial,sans-serif;gap:18px;letter-spacing:.13em;padding:18px;text-transform:uppercase}#NedPanel-{{ section.id }} .ned-panel__annotations span::before{color:var(--panel-accent);content:'＋';margin-right:10px}
  #NedPanel-{{ section.id }}.ned-panel--right{grid-template-columns:minmax(230px,.5fr) minmax(0,1.5fr)}#NedPanel-{{ section.id }}.ned-panel--right .ned-panel__copy{grid-column:2;text-align:right}#NedPanel-{{ section.id }}.ned-panel--right .ned-panel__annotations{border-left:0;border-right:var(--panel-rule) solid currentColor;grid-column:1;grid-row:1}
  #NedPanel-{{ section.id }} .ned-panel__disc{align-items:center;aspect-ratio:1;background:repeating-radial-gradient(circle,#111 0 4px,#252525 5px 6px,#0c0c0c 7px 12px);border:1px solid currentColor;border-radius:50%;bottom:clamp(62px,7vw,110px);color:#fff;display:flex;font:800 9px/1.25 'NED Milo',Arial,sans-serif;justify-content:center;letter-spacing:.16em;position:absolute;right:clamp(54px,8vw,130px);text-align:center;text-decoration:none;text-transform:uppercase;transition:filter .18s ease,transform .18s cubic-bezier(.2,1.4,.3,1);width:clamp(128px,15vw,220px);z-index:2}#NedPanel-{{ section.id }} .ned-panel__disc span{max-width:7ch}#NedPanel-{{ section.id }} .ned-panel__disc i{background:var(--panel-accent);border:5px solid var(--panel-bg);border-radius:50%;height:20px;left:50%;position:absolute;top:50%;transform:translate(-50%,-50%);width:20px}#NedPanel-{{ section.id }} .ned-panel__disc{animation:nedPanelDisc-{{ section.id }} 10s linear infinite}#NedPanel-{{ section.id }} .ned-panel__disc:hover,#NedPanel-{{ section.id }} .ned-panel__disc:focus-visible{animation-duration:2.4s;filter:saturate(1.25);transform:scale(1.05)}@keyframes nedPanelDisc-{{ section.id }}{to{rotate:360deg}}
  #NedPanel-{{ section.id }}.has-ned-motion .ned-panel__copy>*{opacity:0;transform:translateY(var(--panel-shift));transition:opacity var(--panel-motion) cubic-bezier(.16,1,.3,1),transform var(--panel-motion) cubic-bezier(.16,1,.3,1)}#NedPanel-{{ section.id }}.has-ned-motion.is-visible .ned-panel__copy>*{opacity:1;transform:none}#NedPanel-{{ section.id }}.has-ned-motion .ned-panel__copy>*:nth-child(2){transition-delay:75ms}#NedPanel-{{ section.id }}.has-ned-motion .ned-panel__copy>*:nth-child(3){transition-delay:150ms}#NedPanel-{{ section.id }}.has-ned-motion .ned-panel__copy>*:nth-child(4){transition-delay:225ms}
  @media(max-width:989px){#NedPanel-{{ section.id }}{display:block;min-height:auto;padding:calc(var(--panel-mobile-pad) + 64px) var(--panel-mobile-pad) calc(var(--panel-mobile-pad) + 48px)}#NedPanel-{{ section.id }} .ned-panel__frame{inset:8px}#NedPanel-{{ section.id }} .ned-panel__copy{transform:none}#NedPanel-{{ section.id }} .ned-panel__eyebrow{font-size:9px;letter-spacing:.22em;margin-bottom:42px}#NedPanel-{{ section.id }} h2{font-size:clamp(var(--panel-heading-min),12vw,min(var(--panel-heading-max),92px));letter-spacing:var(--panel-mobile-tracking);line-height:max(var(--panel-leading),.84);max-width:15ch;text-wrap:pretty}#NedPanel-{{ section.id }} .ned-panel__body{font-size:var(--panel-mobile-body-size);line-height:1.55;margin-top:42px;max-width:38rem}#NedPanel-{{ section.id }} .ned-panel__annotations{border-left:0;border-right:0;border-top:var(--panel-rule) solid currentColor;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin-top:58px;padding:18px 0 0;text-align:left}#NedPanel-{{ section.id }} .ned-panel__index{font-size:62vw;right:-.12em;top:.12em}#NedPanel-{{ section.id }} .ned-panel__disc{bottom:auto;margin:54px 0 14px;position:relative;right:auto;width:clamp(118px,38vw,180px)}}
  @media(prefers-reduced-motion:reduce){#NedPanel-{{ section.id }} *{animation:none!important;opacity:1!important;transform:none!important;transition:none!important}}
{% endstyle %}

{% schema %}
{
  "name":"NED editorial panel",
  "settings":[
    {"type":"text","id":"index","label":"Large index","default":"02"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Digital blueprint / physical impact"},{"type":"text","id":"heading","label":"Heading","default":"We build systems that make space make sense."},{"type":"richtext","id":"body","label":"Body","default":"<p><strong>Brand architecture</strong>, environmental graphics, and <em>wayfinding logic</em> developed as one connected physical system.</p>"},{"type":"text","id":"button_label","label":"Link label","default":"Explore services"},{"type":"url","id":"button_link","label":"Link"},
    {"type":"select","id":"layout","label":"Composition","options":[{"value":"left","label":"Copy left"},{"value":"right","label":"Copy right"}],"default":"left"},{"type":"color_background","id":"background","label":"Background","default":"#f3efe7"},{"type":"color","id":"text_color","label":"Text","default":"#071a3a"},{"type":"color","id":"accent","label":"Accent / highlights","default":"#ff4fa3"},{"type":"range","id":"padding","label":"Desktop padding","min":40,"max":180,"step":10,"unit":"px","default":90},{"type":"range","id":"mobile_padding","label":"Mobile padding","min":18,"max":60,"step":2,"unit":"px","default":24},{"type":"range","id":"min_height","label":"Minimum height","min":500,"max":1200,"step":50,"unit":"px","default":750},{"type":"range","id":"rule_width","label":"Blueprint rule thickness","min":0,"max":6,"step":1,"unit":"px","default":1},
    {"type":"header","content":"Advanced typography"},{"type":"select","id":"heading_font","label":"Heading font","options":[{"value":"funk","label":"Funk Machine"},{"value":"script","label":"Edwardian"},{"value":"milo","label":"Milo"}],"default":"milo"},{"type":"range","id":"heading_size","label":"Maximum heading size","min":60,"max":240,"step":5,"unit":"px","default":140},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":34,"max":100,"step":2,"unit":"px","default":54},{"type":"range","id":"fluid_heading_size","label":"Fluid scale","min":5,"max":18,"step":0.5,"unit":"vw","default":9},{"type":"range","id":"heading_tracking","label":"Desktop heading tracking","min":-10,"max":20,"step":0.5,"unit":"px","default":-3},{"type":"range","id":"mobile_heading_tracking","label":"Mobile heading tracking","min":-8,"max":16,"step":0.5,"unit":"px","default":-1},{"type":"range","id":"heading_line_height","label":"Heading line height","min":0.5,"max":1.4,"step":0.1,"default":0.8},{"type":"range","id":"heading_x","label":"Horizontal offset","min":-200,"max":200,"step":10,"unit":"px","default":0},{"type":"range","id":"heading_y","label":"Vertical offset","min":-160,"max":160,"step":10,"unit":"px","default":0},{"type":"range","id":"body_size","label":"Desktop body size","min":14,"max":32,"step":1,"unit":"px","default":19},{"type":"range","id":"mobile_body_size","label":"Mobile body size","min":13,"max":24,"step":1,"unit":"px","default":17},{"type":"range","id":"body_width","label":"Body width","min":320,"max":900,"step":20,"unit":"px","default":620},
    {"type":"header","content":"Podcast disc"},{"type":"checkbox","id":"show_spinning_disc","label":"Show spinning podcast disc","default":false},{"type":"text","id":"disc_label","label":"Disc label","default":"NEW ERA / ON AIR"},{"type":"url","id":"disc_link","label":"Disc link"},
    {"type":"header","content":"Fast motion"},{"type":"checkbox","id":"enable_motion","label":"Enable scroll response","default":true},{"type":"range","id":"motion_speed","label":"Reveal speed","min":250,"max":600,"step":25,"unit":"ms","default":400},{"type":"range","id":"motion_distance","label":"Reveal distance","min":0,"max":60,"step":5,"unit":"px","default":25}
  ],
  "blocks":[{"type":"annotation","name":"Technical annotation","settings":[{"type":"text","id":"text","label":"Text","default":"12'-0\" / ALUMINUM CABINET"}]}],"max_blocks":5,
  "presets":[{"name":"NED editorial panel","blocks":[{"type":"annotation"},{"type":"annotation"}]}]
}
{% endschema %}
