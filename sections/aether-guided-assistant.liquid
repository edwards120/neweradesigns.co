<style>
  /* ============================================
     COMPLETE STYLES - FIXED BOUNDARIES
     ============================================ */

  #AetherAssistant-{{ section.id }} {
    position: fixed;
    right: auto;
    bottom: auto;
    left: 0;
    top: 0;
    z-index: 60;
    margin: 0;
    padding: 0;
    isolation: isolate;
    pointer-events: none;
    width: 0;
    height: 0;
    overflow: visible;
    font-family: system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif;
  }

  /* ===== LAUNCHER ===== */
  #AetherAssistant-{{ section.id }} .aether-assistant__launcher {
    position: absolute;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    min-width: 0 !important;
    min-height: 0 !important;
    width: auto !important;
    height: auto !important;
    display: inline-block !important;
    cursor: pointer !important;
    border-radius: 50% !important;
    pointer-events: auto !important;
    left: 0;
    top: 0;
    transform: none;
    transition: none !important;
    will-change: transform, left, top;
    z-index: 10;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__launcher:focus-visible {
    outline: 2px solid var(--aether-blue);
    outline-offset: 4px;
    border-radius: 50%;
  }

  /* ===== CHARACTER - SHADOW REMOVED ===== */
  #AetherAssistant-{{ section.id }} .aether-assistant__pet-stage {
    display: block;
    width: var(--aether-character-size, 110px);
    height: var(--aether-character-size, 110px);
    transform-origin: 50% 50%;
    /* filter: drop-shadow(0 4px 12px rgba(3, 10, 24, 0.15)); */  /* <-- SHADOW REMOVED */
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    animation: aether-float-breathe 3.6s ease-in-out infinite;
    will-change: transform;
    border-radius: 50%;
    background: transparent !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__pet-stage:hover {
    transform: scale(1.08) !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__pet {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    border-radius: 50%;
    image-rendering: auto;
    -webkit-user-drag: none;
    user-drag: none;
  }

  /* ===== DRAGGING ===== */
  #AetherAssistant-{{ section.id }}.is-dragging .aether-assistant__pet-stage {
    animation: none !important;
    transform: scale(1.06) !important;
    cursor: grabbing !important;
  }

  #AetherAssistant-{{ section.id }}.is-dragging {
    cursor: grabbing !important;
  }

  /* ===== FLYING ===== */
  #AetherAssistant-{{ section.id }}.is-flying .aether-assistant__pet-stage {
    animation: aether-flying-bounce 1.8s ease-in-out infinite;
  }

  /* ===== STATUS BADGE ===== */
  #AetherAssistant-{{ section.id }} .aether-assistant__status-badge {
    position: absolute;
    top: -10px;
    right: -6px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 10px;
    background: var(--aether-ink);
    color: #55f396;
    font: 800 7px/1 'Helvetica Neue', Arial, sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid var(--aether-ivory);
    box-shadow: 2px 2px 0 rgba(3, 10, 24, 0.2);
    pointer-events: none;
    z-index: 5;
    white-space: nowrap;
    border-radius: 4px;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #55f396;
    box-shadow: 0 0 6px #55f396;
    animation: aether-dot-pulse 1.8s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes aether-dot-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(0.7); }
  }

  /* ===== SPEECH BUBBLE ===== */
  #AetherAssistant-{{ section.id }} .aether-assistant__bubble {
    position: absolute;
    bottom: calc(100% + 14px);
    right: -6px;
    background: var(--aether-bubble-bg-color, var(--aether-ink));
    color: var(--aether-bubble-text-color, var(--aether-ivory));
    padding: 0.6rem 1rem;
    border-radius: 14px 14px 4px 14px;
    max-width: min(18rem, calc(100vw - 2rem));
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.3;
    box-shadow: 0 4px 16px rgba(3, 10, 24, 0.2);
    border: 1.5px solid var(--aether-ivory);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform: translateY(-0.5rem) scale(0.92);
    pointer-events: none;
    text-wrap: balance;
    z-index: 10;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__bubble::after {
    content: '';
    position: absolute;
    bottom: -8px;
    right: 24px;
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-top: 8px solid var(--aether-bubble-bg-color, var(--aether-ink));
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__bubble.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

