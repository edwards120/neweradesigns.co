{{ 'aether-guided-assistant.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enabled -%}
  <aside
    id="AetherAssistant-{{ section.id }}"
    class="aether-assistant"
    data-aether-assistant
    data-enable-drag="{{ section.settings.enable_drag }}"
  >
    <script type="application/json" data-aether-knowledge>
      {
        "greeting": {{ section.settings.greeting | json }},
        "bubbleMessages": {{ section.settings.bubble_messages | split: '\n' | json }},
        "bubbleEnabled": {{ section.settings.bubble_enabled | json }},
        "bubbleDelay": {{ section.settings.bubble_delay | times: 1000 | json }},
        "bubbleDuration": {{ section.settings.bubble_duration | times: 1000 | json }},
        "fallback": {{ section.settings.fallback | json }},
        "contact": {
          "url": {{ section.settings.contact_url | default: '/pages/contact' | json }},
          "linkLabel": {{ section.settings.contact_label | json }}
        },
        "items": [
          {%- capture aether_core_knowledge -%}
            {%- render 'aether-knowledge-items' -%}
          {%- endcapture -%}
          {{- aether_core_knowledge -}}
          {%- for block in section.blocks -%}
            {%- unless forloop.first -%},{%- endunless -%}
            {
              "question": {{ block.settings.question | json }},
              "answer": {{ block.settings.answer | json }},
              "keywords": {{ block.settings.keywords | json }},
              "url": {{ block.settings.url | json }},
              "linkLabel": {{ block.settings.link_label | json }}
            }
          {%- endfor -%}
        ]
      }
    </script>

    <!-- Launcher Button -->
    <button
      class="aether-assistant__launcher"
      type="button"
      data-aether-launcher
      aria-controls="AetherPanel-{{ section.id }}"
      aria-expanded="false"
      aria-label="{{ section.settings.launcher_label | escape }}"
    >
      <span class="aether-assistant__pet-stage" aria-hidden="true">
        {%- if section.settings.character_image -%}
          <img 
            src="{{ section.settings.character_image | img_url: '200x200' }}" 
            alt="Pegasus assistant" 
            class="aether-assistant__pet" 
            loading="eager"
            width="{{ section.settings.character_size }}"
            height="{{ section.settings.character_size }}"
          >
        {%- else -%}
          <img 
            src="{{ 'aether-assistant-animated.webp' | asset_url }}" 
            alt="Pegasus assistant" 
            class="aether-assistant__pet" 
            loading="eager"
            width="{{ section.settings.character_size }}"
            height="{{ section.settings.character_size }}"
          >
        {%- endif -%}
      </span>
    </button>

    <!-- Panel -->
    <div class="aether-assistant__panel" data-aether-panel hidden>
      <header class="aether-assistant__header">
        <div class="aether-assistant__header-pet">
          {%- if section.settings.character_image -%}
            <img 
              src="{{ section.settings.character_image | img_url: '100x100' }}" 
              alt="Pegasus" 
              width="50" 
              height="50"
            >
          {%- else -%}
            <img 
              src="{{ 'aether-assistant.png' | asset_url }}" 
              alt="Pegasus" 
              width="50" 
              height="50"
            >
          {%- endif -%}
        </div>
        <div>
          <p class="aether-assistant__eyebrow">{{ section.settings.eyebrow }}</p>
          <h2 class="aether-assistant__title">{{ section.settings.title }}</h2>
        </div>
        <button class="aether-assistant__close" data-aether-close aria-label="Close assistant">
          <span aria-hidden="true">&times;</span>
        </button>
      </header>

      <div class="aether-assistant__messages" data-aether-messages></div>

      <div class="aether-assistant__questions" data-aether-questions></div>

      <form class="aether-assistant__form" data-aether-form>
        <input 
          class="aether-assistant__input" 
          type="text" 
          data-aether-input 
          placeholder="{{ section.settings.placeholder }}" 
          autocomplete="off"
          aria-label="Ask a question"
        >
        <button class="aether-assistant__submit" type="submit" data-aether-submit>
          <span class="aether-assistant__submit-text">Ask</span>
          <svg class="aether-assistant__submit-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </form>
      
      <div class="aether-assistant__footer">
        <span class="aether-assistant__footer-text">{{ section.settings.footer_text }}</span>
      </div>
    </div>
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "Pegasus AI Assistant",
  "tag": "section",
  "class": "aether-assistant-section",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "⚙️ General Settings"
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show assistant",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_drag",
      "label": "Enable dragging",
      "default": true
    },
    {
      "type": "header",
      "content": "🧚 Character Settings"
    },
    {
      "type": "image_picker",
      "id": "character_image",
      "label": "Custom character image"
    },
    {
      "type": "range",
      "id": "character_size",
      "min": 60,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Character size",
      "default": 110
    },
    {
      "type": "text",
      "id": "launcher_label",
      "label": "Launcher label",
      "default": "Ask Pegasus"
    },
    {
      "type": "header",
      "content": "💬 Chat Panel"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Panel eyebrow",
      "default": "New Era studio guide"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Panel title",
      "default": "What can we build?"
    },
    {
      "type": "textarea",
      "id": "greeting",
      "label": "Greeting message",
      "default": "Hey — I'm Pegasus. Ask me about Chris, New Era Designs, services, process, project fit, or what you're trying to build."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Branding, signs, wayfinding..."
    },
    {
      "type": "textarea",
      "id": "fallback",
      "label": "No-match answer",
      "default": "That needs a human answer. Send the studio a short note and Chris will point you in the right direction."
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact page URL"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact link label",
      "default": "Start a project"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Powered by New Era Designs"
    },
    {
      "type": "range",
      "id": "panel_width",
      "min": 330,
      "max": 520,
      "step": 10,
      "unit": "px",
      "label": "Panel width",
      "default": 390
    },
    {
      "type": "header",
      "content": "💬 Speech Bubbles"
    },
    {
      "type": "checkbox",
      "id": "bubble_enabled",
      "label": "Show random speech bubbles",
      "default": true
    },
    {
      "type": "textarea",
      "id": "bubble_messages",
      "label": "Bubble messages",
      "default": "👋 HEY - NEED A HAND?\n✨ TALK TO ME.\n🦄 TELL ME WHAT YOU'RE BUILDING."
    },
    {
      "type": "range",
      "id": "bubble_delay",
      "min": 3,
      "max": 30,
      "step": 1,
      "unit": "s",
      "label": "Bubble interval",
      "default": 8
    },
    {
      "type": "range",
      "id": "bubble_duration",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Bubble display duration",
      "default": 5
    },
    {
      "type": "header",
      "content": "🎨 Colors"
    },
    {
      "type": "color",
      "id": "navy",
      "label": "Navy",
      "default": "#071c3f"
    },
    {
      "type": "color",
      "id": "ink",
      "label": "Ink",
      "default": "#030a18"
    },
    {
      "type": "color",
      "id": "ivory",
      "label": "Ivory",
      "default": "#f6f0df"
    },
    {
      "type": "color",
      "id": "blue",
      "label": "Electric blue",
      "default": "#265dff"
    },
    {
      "type": "color",
      "id": "yellow",
      "label": "Signal yellow",
      "default": "#ffe711"
    },
    {
      "type": "color",
      "id": "coral",
      "label": "Coral",
      "default": "#ff7064"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Q&A",
      "limit": 20,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What can New Era Designs do for me?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "We create brand, wayfinding, signage, environmental graphics, and visual systems that connect identity to physical space."
        },
        {
          "type": "textarea",
          "id": "keywords",
          "label": "Matching keywords",
          "default": "services branding signs signage wayfinding"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Optional answer link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Explore services"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pegasus AI Assistant"
    }
  ]
}
{% endschema %}

<style>
  /* ============================================
     FIXED POSITIONING - PEGASUS STARTS AT TOP
     ============================================ */

  #AetherAssistant-{{ section.id }} {
    position: fixed !important;
    right: auto !important;
    bottom: auto !important;
    left: 50% !important;
    top: 80px !important;
    z-index: 9999 !important;
    margin: 0 !important;
    padding: 0 !important;
    isolation: isolate !important;
    pointer-events: none !important;
    width: 0 !important;
    height: 0 !important;
    overflow: visible !important;
    font-family: system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif;
    transform: translateX(-50%) !important;
  }

  /* ===== LAUNCHER ===== */
  #AetherAssistant-{{ section.id }} .aether-assistant__launcher {
    position: absolute !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    min-width: 0 !important;
    min-height: 0 !important;
    width: auto !important;
    height: auto !important;
    display: inline-block !important;
    cursor: grab !important;
    border-radius: 50% !important;
    pointer-events: auto !important;
    left: 0 !important;
    top: 0 !important;
    transform: translateX(-50%) !important;
    transition: none !important;
    z-index: 10 !important;
    touch-action: none !important;
    user-select: none !important;
    -webkit-user-select: none !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__launcher:active {
    cursor: grabbing !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__pet-stage {
    display: block !important;
    width: {{ section.settings.character_size }}px !important;
    height: {{ section.settings.character_size }}px !important;
    transform-origin: 50% 50% !important;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
    animation: aether-float-breathe 3.6s ease-in-out infinite !important;
    border-radius: 50% !important;
    background: transparent !important;
    pointer-events: none !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__pet {
    width: 100% !important;
    height: 100% !important;
    display: block !important;
    object-fit: contain !important;
    border-radius: 50% !important;
    pointer-events: none !important;
  }

  /* ===== PANEL ===== */
  #AetherAssistant-{{ section.id }} .aether-assistant__panel {
    position: fixed !important;
    right: auto !important;
    bottom: auto !important;
    left: 50% !important;
    top: 50% !important;
    width: min({{ section.settings.panel_width }}px, calc(100vw - 40px)) !important;
    max-height: min(600px, calc(100dvh - 120px)) !important;
    background: var(--aether-navy, #071c3f) !important;
    border: 2px solid var(--aether-ivory, #f6f0df) !important;
    border-radius: 12px !important;
    box-shadow: 12px 12px 0 var(--aether-ink, #030a18), 0 12px 40px rgba(0,0,0,0.25) !important;
    display: none !important;
    grid-template-rows: auto 1fr auto auto auto !important;
    overflow: hidden !important;
    transform: translate(-50%, -50%) scale(0.92) !important;
    opacity: 0 !important;
    visibility: hidden !important;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), 
                opacity 0.3s ease, 
                visibility 0.3s ease !important;
    pointer-events: none !important;
    z-index: 100 !important;
  }

  #AetherAssistant-{{ section.id }}.is-open .aether-assistant__panel {
    transform: translate(-50%, -50%) scale(1) !important;
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
    display: grid !important;
  }

  /* ===== PANEL HEADER ===== */
  #AetherAssistant-{{ section.id }} .aether-assistant__header {
    display: grid !important;
    grid-template-columns: 42px 1fr auto !important;
    gap: 10px !important;
    align-items: center !important;
    padding: 14px 16px !important;
    background: rgba(3,10,24,0.85) !important;
    border-bottom: 1px solid rgba(246,240,223,0.2) !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__header-pet {
    width: 42px !important;
    height: 42px !important;
    border-radius: 50% !important;
    overflow: hidden !important;
    border: 2px solid var(--aether-yellow, #ffe711) !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__header-pet img {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__eyebrow {
    margin: 0 0 2px !important;
    color: var(--aether-yellow, #ffe711) !important;
    font-size: 8px !important;
    font-weight: 900 !important;
    letter-spacing: 0.15em !important;
    text-transform: uppercase !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__title {
    margin: 0 !important;
    color: var(--aether-ivory, #f6f0df) !important;
    font-size: 20px !important;
    font-weight: 950 !important;
    letter-spacing: -0.03em !important;
    line-height: 1 !important;
    text-transform: uppercase !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__close {
    display: grid !important;
    width: 32px !important;
    height: 32px !important;
    place-items: center !important;
    border: 1.5px solid var(--aether-ivory, #f6f0df) !important;
    border-radius: 8px !important;
    background: transparent !important;
    color: var(--aether-ivory, #f6f0df) !important;
    cursor: pointer !important;
    font-size: 18px !important;
    transition: background 0.2s, color 0.2s, transform 0.2s !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__close:hover {
    background: var(--aether-coral, #ff7064) !important;
    color: var(--aether-ink, #030a18) !important;
    transform: rotate(90deg) !important;
  }

  /* ===== MESSAGES ===== */
  #AetherAssistant-{{ section.id }} .aether-assistant__messages {
    padding: 12px 14px !important;
    overflow-y: auto !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
    min-height: 100px !important;
    max-height: 300px !important;
    background: radial-gradient(circle at center, rgba(246,240,223,0.03) 0 1px, transparent 1.4px) 0 0 / 12px 12px, var(--aether-navy, #071c3f) !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__messages::-webkit-scrollbar {
    width: 3px !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__messages::-webkit-scrollbar-thumb {
    background: var(--aether-yellow, #ffe711) !important;
    border-radius: 4px !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__message {
    max-width: 88% !important;
    padding: 8px 12px !important;
    background: rgba(3,10,24,0.85) !important;
    border: 1px solid rgba(246,240,223,0.3) !important;
    border-radius: 10px !important;
    color: var(--aether-ivory, #f6f0df) !important;
    font-size: 12.5px !important;
    line-height: 1.45 !important;
    animation: aether-message-in 0.25s cubic-bezier(0.2,0.85,0.3,1.15) both !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__message--visitor {
    align-self: flex-end !important;
    background: var(--aether-yellow, #ffe711) !important;
    border-color: var(--aether-yellow, #ffe711) !important;
    color: var(--aether-ink, #030a18) !important;
    font-weight: 700 !important;
    border-radius: 10px 10px 4px 10px !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__message--assistant {
    border-radius: 10px 10px 10px 4px !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__message a {
    display: inline-block !important;
    margin-top: 4px !important;
    color: var(--aether-yellow, #ffe711) !important;
    font-size: 10px !important;
    font-weight: 900 !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
    border-bottom: 2px solid currentColor !important;
  }

  @keyframes aether-message-in {
    from { opacity:0; transform:translateY(6px) scale(0.96); }
    to { opacity:1; transform:translateY(0) scale(1); }
  }

  /* ===== QUICK QUESTIONS ===== */
  #AetherAssistant-{{ section.id }} .aether-assistant__questions {
    display: flex !important;
    gap: 5px !important;
    overflow-x: auto !important;
    padding: 8px 12px !important;
    border-top: 1px solid rgba(246,240,223,0.08) !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__questions::-webkit-scrollbar {
    display: none !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__question {
    flex: 0 0 auto !important;
    max-width: 180px !important;
    padding: 5px 10px !important;
    background: rgba(7,28,63,0.9) !important;
    border: 1px solid var(--aether-ivory, #f6f0df) !important;
    border-radius: 16px !important;
    color: var(--aether-ivory, #f6f0df) !important;
    font: 700 9px/1.2 Arial, sans-serif !important;
    cursor: pointer !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    transition: background 0.2s, color 0.2s, transform 0.2s !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__question:hover {
    background: var(--aether-yellow, #ffe711) !important;
    color: var(--aether-ink, #030a18) !important;
    transform: translateY(-2px) scale(1.02) !important;
  }

  /* ===== FORM ===== */
  #AetherAssistant-{{ section.id }} .aether-assistant__form {
    display: grid !important;
    grid-template-columns: 1fr auto !important;
    border-top: 1px solid var(--aether-ivory, #f6f0df) !important;
    background: rgba(3,10,24,0.3) !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__input {
    padding: 10px 14px !important;
    background: transparent !important;
    border: 0 !important;
    color: var(--aether-ivory, #f6f0df) !important;
    font: 600 12px/1.2 Arial, sans-serif !important;
    outline: none !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__input::placeholder {
    color: rgba(246,240,223,0.4) !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__input:focus {
    box-shadow: inset 0 -2px 0 var(--aether-blue, #265dff) !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__submit {
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    padding: 10px 14px !important;
    background: var(--aether-yellow, #ffe711) !important;
    border: 0 !important;
    border-left: 1px solid var(--aether-ivory, #f6f0df) !important;
    color: var(--aether-ink, #030a18) !important;
    font: 900 9px/1 Arial, sans-serif !important;
    text-transform: uppercase !important;
    cursor: pointer !important;
    transition: background 0.2s, color 0.2s !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__submit:hover {
    background: var(--aether-blue, #265dff) !important;
    color: var(--aether-ivory, #f6f0df) !important;
  }

  /* ===== FOOTER ===== */
  #AetherAssistant-{{ section.id }} .aether-assistant__footer {
    padding: 6px 14px !important;
    text-align: center !important;
    border-top: 1px solid rgba(246,240,223,0.05) !important;
    background: rgba(3,10,24,0.15) !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__footer-text {
    font-size: 7px !important;
    font-weight: 500 !important;
    letter-spacing: 0.15em !important;
    text-transform: uppercase !important;
    color: rgba(246,240,223,0.25) !important;
  }

  /* ===== BUBBLE ===== */
  #AetherAssistant-{{ section.id }} .aether-assistant__bubble {
    position: absolute !important;
    bottom: calc(100% + 14px) !important;
    left: 50% !important;
    background: var(--aether-ink, #030a18) !important;
    color: var(--aether-ivory, #f6f0df) !important;
    padding: 0.6rem 1rem !important;
    border-radius: 14px 14px 4px 14px !important;
    max-width: 18rem !important;
    font-size: 0.8rem !important;
    font-weight: 700 !important;
    line-height: 1.3 !important;
    border: 1.5px solid var(--aether-ivory, #f6f0df) !important;
    opacity: 0 !important;
    visibility: hidden !important;
    transition: opacity 0.4s ease, visibility 0.4s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
    transform: translateX(-50%) translateY(-0.5rem) scale(0.92) !important;
    pointer-events: none !important;
    z-index: 10 !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__bubble.is-visible {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateX(-50%) translateY(0) scale(1) !important;
  }

  #AetherAssistant-{{ section.id }} .aether-assistant__bubble::after {
    content: '' !important;
    position: absolute !important;
    bottom: -8px !important;
    left: calc(50% - 8px) !important;
    border-left: 8px solid transparent !important;
    border-right: 8px solid transparent !important;
    border-top: 8px solid var(--aether-ink, #030a18) !important;
  }

  /* ===== ANIMATIONS ===== */
  @keyframes aether-float-breathe {
    0%,100% { transform: translate3d(0,0,0) rotate(-0.5deg) scale(1); }
    25% { transform: translate3d(2px,-6px,0) rotate(1deg) scale(1.01); }
    50% { transform: translate3d(-2px,-10px,0) rotate(-1deg) scale(0.99); }
    75% { transform: translate3d(1px,-5px,0) rotate(0.5deg) scale(1.01); }
  }

  /* ===== MOBILE ===== */
  @media (max-width: 560px) {
    #AetherAssistant-{{ section.id }} {
      top: 40px !important;
    }

    #AetherAssistant-{{ section.id }} .aether-assistant__pet-stage {
      width: 70px !important;
      height: 70px !important;
    }
    
    #AetherAssistant-{{ section.id }} .aether-assistant__panel {
      left: 50% !important;
      top: 50% !important;
      width: calc(100vw - 20px) !important;
      max-height: calc(100dvh - 100px) !important;
      transform: translate(-50%, -50%) scale(0.92) !important;
    }
    
    #AetherAssistant-{{ section.id }}.is-open .aether-assistant__panel {
      transform: translate(-50%, -50%) scale(1) !important;
    }
  }
</style>

<script>
  (() => {
    const sectionId = {{ section.id | json }};

    class PegasusAssistant {
      constructor(assistant) {
        this.assistant = assistant;
        this.launcher = assistant.querySelector('[data-aether-launcher]');
        this.panel = assistant.querySelector('[data-aether-panel]');
        this.closeBtn = assistant.querySelector('[data-aether-close]');
        this.messages = assistant.querySelector('[data-aether-messages]');
        this.questions = assistant.querySelector('[data-aether-questions]');
        this.form = assistant.querySelector('[data-aether-form]');
        this.input = assistant.querySelector('[data-aether-input]');
        this.bubble = assistant.querySelector('[data-aether-bubble]');
        
        this.isOpen = false;
        this.isDragging = false;
        this.dragOffsetX = 0;
        this.dragOffsetY = 0;
        this.wasDragged = false;
        this.dragStartX = 0;
        this.dragStartY = 0;
        this.launcherStartX = 0;
        this.launcherStartY = 0;
        
        this.knowledge = this.readKnowledge();
        
        if (!this.launcher || !this.panel) return;
        
        this.init();
      }

      readKnowledge() {
        const source = this.assistant.querySelector('[data-aether-knowledge]');
        if (!source) return null;
        try {
          return JSON.parse(source.textContent);
        } catch (error) {
          console.warn('Could not read knowledge', error);
          return null;
        }
      }

      init() {
        // Setup drag
        if (this.assistant.dataset.enableDrag !== 'false') {
          this.setupDrag();
        }

        // Setup launcher click
        this.launcher.addEventListener('click', (e) => {
          if (this.wasDragged) {
            this.wasDragged = false;
            return;
          }
          this.togglePanel();
        });

        // Setup close button
        if (this.closeBtn) {
          this.closeBtn.addEventListener('click', () => this.togglePanel(false));
        }

        // Setup form
        if (this.form) {
          this.form.addEventListener('submit', (e) => {
            e.preventDefault();
            this.handleSubmit();
          });
        }

        // Setup questions
        if (this.questions) {
          this.questions.addEventListener('click', (e) => {
            const btn = e.target.closest('[data-aether-question]');
            if (!btn) return;
            const index = parseInt(btn.dataset.index);
            const items = this.knowledge?.items || [];
            if (items[index]) {
              this.askQuestion(items[index].question);
            }
          });
        }

        // Keyboard shortcuts
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.isOpen) {
            this.togglePanel(false);
          }
        });

        // Seed conversation
        this.seedConversation();

        // Show initial bubble
        this.showBubble();
      }

      setupDrag() {
        let isDragging = false;

        this.launcher.addEventListener('pointerdown', (e) => {
          if (e.target.closest('[data-aether-close]')) return;
          
          isDragging = true;
          this.wasDragged = false;
          
          // Store initial positions
          this.dragStartX = e.clientX;
          this.dragStartY = e.clientY;
          
          // Get current launcher position
          const rect = this.launcher.getBoundingClientRect();
          this.launcherStartX = rect.left;
          this.launcherStartY = rect.top;
          
          this.launcher.style.cursor = 'grabbing';
          this.launcher.setPointerCapture(e.pointerId);
          e.preventDefault();
        });

        this.launcher.addEventListener('pointermove', (e) => {
          if (!isDragging) return;
          
          const dx = e.clientX - this.dragStartX;
          const dy = e.clientY - this.dragStartY;
          
          // Check if actual drag happened (more than 5px movement)
          if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
            this.wasDragged = true;
          }
          
          // Calculate new position
          let newX = this.launcherStartX + dx;
          let newY = this.launcherStartY + dy;
          
          // Keep within viewport
          const size = this.launcher.offsetWidth || 100;
          const halfSize = size / 2;
          const maxX = window.innerWidth - size;
          const maxY = window.innerHeight - size;
          
          newX = Math.max(0, Math.min(maxX, newX));
          newY = Math.max(0, Math.min(maxY, newY));
          
          // Position the launcher
          this.launcher.style.left = newX + 'px';
          this.launcher.style.top = newY + 'px';
          
          // Update the container position to match
          this.assistant.style.left = 'auto';
          this.assistant.style.right = 'auto';
          this.assistant.style.top = 'auto';
          this.assistant.style.bottom = 'auto';
          this.assistant.style.transform = 'none';
          
          e.preventDefault();
        });

        this.launcher.addEventListener('pointerup', (e) => {
          isDragging = false;
          this.launcher.style.cursor = 'grab';
          this.launcher.releasePointerCapture(e.pointerId);
        });

        this.launcher.addEventListener('pointercancel', (e) => {
          isDragging = false;
          this.launcher.style.cursor = 'grab';
        });
      }

      togglePanel(forceState) {
        const shouldOpen = forceState !== undefined ? forceState : !this.isOpen;
        this.isOpen = shouldOpen;
        
        this.assistant.classList.toggle('is-open', shouldOpen);
        this.launcher.setAttribute('aria-expanded', String(shouldOpen));
        
        if (shouldOpen) {
          this.panel.hidden = false;
          setTimeout(() => this.input?.focus(), 300);
        } else {
          this.panel.hidden = true;
        }
      }

      askQuestion(question) {
        if (!question) return;
        this.addMessage(question, 'visitor');
        
        const entry = this.findBestMatch(question);
        
        setTimeout(() => {
          if (entry) {
            this.addMessage(entry.answer, 'assistant', entry);
            this.renderQuestions(this.getRelatedQuestions(entry));
          } else {
            const fallback = this.knowledge?.fallback || "That needs a human answer. Contact the studio and Chris will point you in the right direction.";
            this.addMessage(fallback, 'assistant', this.knowledge?.contact);
            this.renderQuestions(this.getContextualQuestions());
          }
        }, 400);
      }

      handleSubmit() {
        const question = this.input?.value.trim();
        if (!question) return;
        this.input.value = '';
        this.askQuestion(question);
      }

      findBestMatch(question) {
        if (!this.knowledge?.items) return null;
        
        const q = question.toLowerCase().trim();
        const words = q.split(/\s+/).filter(w => w.length > 2);
        let best = null;
        let bestScore = 0;
        
        this.knowledge.items.forEach(entry => {
          const text = (entry.question + ' ' + (entry.keywords || '')).toLowerCase();
          let score = 0;
          words.forEach(word => {
            if (text.includes(word)) score += 2;
            if (entry.question.toLowerCase().includes(word)) score += 3;
          });
          if (q.includes(entry.question.toLowerCase())) score += 10;
          if (score > bestScore) {
            bestScore = score;
            best = entry;
          }
        });
        
        return bestScore > 2 ? best : null;
      }

      getContextualQuestions() {
        return this.knowledge?.items?.slice(0, 4) || [];
      }

      getRelatedQuestions(entry) {
        if (!this.knowledge?.items) return [];
        const keywords = (entry.keywords || '').toLowerCase().split(/\s+/);
        return this.knowledge.items
          .filter(e => e !== entry)
          .map(e => ({
            ...e,
            score: keywords.filter(k => (e.keywords || '').toLowerCase().includes(k)).length
          }))
          .sort((a, b) => b.score - a.score)
          .slice(0, 3);
      }

      addMessage(text, speaker, entry = null) {
        if (!this.messages) return;
        
        const message = document.createElement('div');
        message.className = `aether-assistant__message aether-assistant__message--${speaker}`;
        message.textContent = text;
        
        if (entry?.url && entry?.linkLabel) {
          const link = document.createElement('a');
          link.href = entry.url;
          link.textContent = entry.linkLabel;
          if (/^https?:\/\//.test(entry.url)) link.rel = 'noopener noreferrer';
          message.appendChild(document.createElement('br'));
          message.appendChild(link);
        }
        
        this.messages.appendChild(message);
        this.messages.scrollTop = this.messages.scrollHeight;
      }

      renderQuestions(entries) {
        if (!this.questions) return;
        
        this.questions.replaceChildren();
        const items = this.knowledge?.items || [];
        entries.forEach(entry => {
          const index = items.indexOf(entry);
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'aether-assistant__question';
          button.dataset.aetherQuestion = '';
          button.dataset.index = String(index);
          button.textContent = entry.question;
          this.questions.appendChild(button);
        });
      }

      seedConversation() {
        if (this.knowledge?.greeting) {
          this.addMessage(this.knowledge.greeting, 'assistant');
        }
        this.renderQuestions(this.getContextualQuestions());
      }

      showBubble() {
        if (!this.bubble || !this.knowledge?.bubbleMessages?.length) return;
        
        let bubbleTimer = null;
        let bubbleTimeout = null;
        let lastMessage = '';

        const showNextBubble = () => {
          if (this.isOpen) {
            scheduleNext();
            return;
          }
          
          const messages = this.knowledge.bubbleMessages;
          const available = messages.filter(m => m !== lastMessage);
          const pool = available.length ? available : messages;
          const message = pool[Math.floor(Math.random() * pool.length)];
          lastMessage = message;
          
          const textEl = this.bubble.querySelector('.aether-assistant__bubble-text');
          if (textEl) textEl.textContent = message;
          
          this.bubble.classList.add('is-visible');
          
          const duration = Number(this.knowledge.bubbleDuration) * 1000 || 5000;
          clearTimeout(bubbleTimeout);
          bubbleTimeout = setTimeout(() => {
            this.bubble.classList.remove('is-visible');
            scheduleNext();
          }, duration);
        };

        const scheduleNext = () => {
          const delay = Number(this.knowledge.bubbleDelay) * 1000 || 8000;
          clearTimeout(bubbleTimer);
          bubbleTimer = setTimeout(showNextBubble, delay + Math.random() * 3000);
        };

        // Start after a delay
        setTimeout(showNextBubble, 2000);
      }
    }

    // Initialize
    function initAssistant(sectionRoot = document) {
      const assistant = sectionRoot.querySelector
        ? sectionRoot.querySelector(`#AetherAssistant-${CSS.escape(String(sectionId))}`)
        : null;

      if (!assistant || assistant.dataset.initialized === 'true') return;

      assistant.dataset.initialized = 'true';
      
      // Wait for DOM
      if (document.readyState === 'complete') {
        setTimeout(() => new PegasusAssistant(assistant), 100);
      } else {
        window.addEventListener('load', () => {
          setTimeout(() => new PegasusAssistant(assistant), 100);
        }, { once: true });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initAssistant(), { once: true });
    } else {
      initAssistant();
    }

    document.addEventListener('shopify:section:load', (event) => {
      initAssistant(event.target);
    });
  })();
</script>