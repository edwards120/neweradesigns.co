{{ 'aether-guided-assistant.css' | asset_url | stylesheet_tag }}
<script src="{{ 'aether-guided-assistant.js' | asset_url }}" defer="defer"></script>

{%- if section.settings.enabled -%}
  <aside
    id="AetherAssistant-{{ section.id }}"
    class="aether-assistant{% if request.page_type == 'index' %} is-homepage{% endif %}{% if section.settings.enable_drag %} is-draggable{% endif %}"
    data-aether-assistant
    data-enable-drag="{{ section.settings.enable_drag }}"
    data-enable-flying="{{ section.settings.enable_flying_scroll }}"
    data-start-mode="{{ section.settings.start_position_mode }}"
    data-start-desktop-x="{{ section.settings.start_desktop_x }}"
    data-start-desktop-y="{{ section.settings.start_desktop_y }}"
    data-start-mobile-x="{{ section.settings.start_mobile_x }}"
    data-start-mobile-y="{{ section.settings.start_mobile_y }}"
    style="
      --aether-navy: {{ section.settings.navy }};
      --aether-ink: {{ section.settings.ink }};
      --aether-ivory: {{ section.settings.ivory }};
      --aether-blue: {{ section.settings.blue }};
      --aether-yellow: {{ section.settings.yellow }};
      --aether-coral: {{ section.settings.coral }};
      --aether-panel-width: {{ section.settings.panel_width }}px;
      --aether-speed: {{ section.settings.motion_speed }}ms;
      --aether-character-size: {{ section.settings.character_size }}px;
      --aether-character-size-mobile: {{ section.settings.character_size_mobile }}px;
      --aether-fly-speed: {{ section.settings.fly_speed }};
      --aether-scroll-sensitivity: {{ section.settings.scroll_sensitivity }};
      --aether-bubble-color: {{ section.settings.bubble_bg_color }};
      --aether-bubble-text-color: {{ section.settings.bubble_text_color }};
      --aether-panel-radius: {{ section.settings.panel_border_radius }}px;
    "
  >
    <script type="application/json" data-aether-knowledge>
      {
        "greeting": {{ section.settings.greeting | json }},
        "bubbleMessages": {{ section.settings.bubble_messages | split: '\n' | json }},
        "bubbleEnabled": {{ section.settings.bubble_enabled | json }},
        "bubbleDelay": {{ section.settings.bubble_delay | times: 1000 | json }},
        "bubbleDuration": {{ section.settings.bubble_duration | times: 1000 | json }},
        "fallback": {{ section.settings.fallback | json }},
        "contact": {
          "url": {{ section.settings.contact_url | default: '/pages/contact' | json }},
          "linkLabel": {{ section.settings.contact_label | json }}
        },
        "items": [
          {%- capture aether_core_knowledge -%}
            {%- render 'aether-knowledge-items' -%}
          {%- endcapture -%}
          {{- aether_core_knowledge -}}
          {%- for block in section.blocks -%}
            {%- unless forloop.first -%},{%- endunless -%}
            {
              "question": {{ block.settings.question | json }},
              "answer": {{ block.settings.answer | json }},
              "keywords": {{ block.settings.keywords | json }},
              "url": {{ block.settings.url | json }},
              "linkLabel": {{ block.settings.link_label | json }}
            }
          {%- endfor -%}
        ]
      }
    </script>

    <!-- Status Badge -->
    {%- if section.settings.show_status_badge and section.settings.status_badge_text != blank -%}
      <span class="aether-assistant__status-badge">
        <span class="aether-assistant__status-dot"></span>
        {{ section.settings.status_badge_text | escape }}
      </span>
    {%- endif -%}

    <!-- Speech Bubble -->
    <div class="aether-assistant__bubble" data-aether-bubble aria-hidden="true">
      <span class="aether-assistant__bubble-text">{{ section.settings.launcher_label | escape }}</span>
    </div>

    <!-- Launcher Button -->
    <button
      class="aether-assistant__launcher"
      type="button"
      data-aether-launcher
      aria-controls="AetherPanel-{{ section.id }}"
      aria-expanded="false"
      aria-haspopup="dialog"
      aria-label="{{ section.settings.launcher_label | escape }}"
    >
      <span class="aether-assistant__pet-stage" aria-hidden="true">
        {%- if section.settings.character_image -%}
          <img 
            src="{{ section.settings.character_image | img_url: '200x200' }}" 
            alt="Pegasus assistant" 
            class="aether-assistant__pet" 
            loading="eager"
            width="{{ section.settings.character_size }}"
            height="{{ section.settings.character_size }}"
          >
        {%- else -%}
          <img 
            src="{{ 'aether-assistant-animated.webp' | asset_url }}" 
            alt="Pegasus assistant" 
            class="aether-assistant__pet" 
            loading="eager"
            width="{{ section.settings.character_size }}"
            height="{{ section.settings.character_size }}"
          >
        {%- endif -%}
      </span>
    </button>

    <!-- Panel -->
    <div class="aether-assistant__panel" data-aether-panel hidden>
      <header class="aether-assistant__header">
        <div class="aether-assistant__header-pet">
          {%- if section.settings.character_image -%}
            <img 
              src="{{ section.settings.character_image | img_url: '100x100' }}" 
              alt="Pegasus" 
              width="50" 
              height="50"
            >
          {%- else -%}
            <img 
              src="{{ 'aether-assistant.png' | asset_url }}" 
              alt="Pegasus" 
              width="50" 
              height="50"
            >
          {%- endif -%}
        </div>
        <div>
          <p class="aether-assistant__eyebrow">{{ section.settings.eyebrow }}</p>
          <h2 class="aether-assistant__title">{{ section.settings.title }}</h2>
        </div>
        <button class="aether-assistant__close" data-aether-close aria-label="Close assistant">
          <span aria-hidden="true">&times;</span>
        </button>
      </header>

      <div class="aether-assistant__messages" data-aether-messages></div>

      <div class="aether-assistant__questions" data-aether-questions></div>

      <form class="aether-assistant__form" data-aether-form>
        <input 
          class="aether-assistant__input" 
          type="text" 
          data-aether-input 
          placeholder="{{ section.settings.placeholder }}" 
          autocomplete="off"
          aria-label="Ask a question"
        >
        <button class="aether-assistant__submit" type="submit" data-aether-submit>
          <span class="aether-assistant__submit-text">Ask</span>
          <svg class="aether-assistant__submit-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </form>
      
      <div class="aether-assistant__footer">
        <span class="aether-assistant__footer-text">{{ section.settings.footer_text }}</span>
      </div>
    </div>
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "Pegasus AI Assistant",
  "tag": "section",
  "class": "aether-assistant-section",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "⚙️ General Settings"
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show assistant",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_drag",
      "label": "Enable dragging",
      "info": "Users can click and drag Pegasus anywhere",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_flying_scroll",
      "label": "Enable flying animation",
      "info": "Pegasus will gently float and follow scroll",
      "default": true
    },
    {
      "type": "header",
      "content": "🧚 Character Settings"
    },
    {
      "type": "image_picker",
      "id": "character_image",
      "label": "Custom character image",
      "info": "Upload your own Pegasus image (PNG or animated WebP)"
    },
    {
      "type": "range",
      "id": "character_size",
      "min": 60,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Character size (desktop)",
      "default": 110
    },
    {
      "type": "range",
      "id": "character_size_mobile",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Character size (mobile)",
      "default": 75
    },
    {
      "type": "range",
      "id": "fly_speed",
      "min": 0.1,
      "max": 1.5,
      "step": 0.1,
      "label": "Flight speed",
      "default": 0.5,
      "info": "How fast Pegasus moves around"
    },
    {
      "type": "range",
      "id": "scroll_sensitivity",
      "min": 0.1,
      "max": 1.0,
      "step": 0.1,
      "label": "Scroll follow sensitivity",
      "default": 0.4,
      "info": "How much Pegasus follows your scroll"
    },
    {
      "type": "header",
      "content": "📍 Pegasus Screen Controls"
    },
    {
      "type": "select",
      "id": "start_position_mode",
      "label": "Start position source",
      "options": [
        { "value": "auto", "label": "Auto (near hero heading)" },
        { "value": "manual", "label": "Manual (use values below)" }
      ],
      "default": "manual"
    },
    {
      "type": "range",
      "id": "start_desktop_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Desktop start X",
      "default": 50
    },
    {
      "type": "range",
      "id": "start_desktop_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Desktop start Y",
      "default": 8
    },
    {
      "type": "range",
      "id": "start_mobile_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Mobile start X",
      "default": 50
    },
    {
      "type": "range",
      "id": "start_mobile_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Mobile start Y",
      "default": 10
    },
    {
      "type": "text",
      "id": "launcher_label",
      "label": "Speech bubble text",
      "default": "Ask Pegasus"
    },
    {
      "type": "header",
      "content": "🟢 Status Badge"
    },
    {
      "type": "checkbox",
      "id": "show_status_badge",
      "label": "Show status badge",
      "default": true
    },
    {
      "type": "text",
      "id": "status_badge_text",
