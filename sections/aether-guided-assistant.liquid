      "default": 390
    },
    {
      "type": "range",
      "id": "panel_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Panel border radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "motion_speed",
      "min": 100,
      "max": 320,
      "step": 20,
      "unit": "ms",
      "label": "Animation speed",
      "default": 180
    },
    {
      "type": "header",
      "content": "🎨 Colors"
    },
    {
      "type": "color",
      "id": "navy",
      "label": "Navy",
      "default": "#071c3f"
    },
    {
      "type": "color",
      "id": "ink",
      "label": "Ink",
      "default": "#030a18"
    },
    {
      "type": "color",
      "id": "ivory",
      "label": "Ivory",
      "default": "#f6f0df"
    },
    {
      "type": "color",
      "id": "blue",
      "label": "Electric blue",
      "default": "#265dff"
    },
    {
      "type": "color",
      "id": "yellow",
      "label": "Signal yellow",
      "default": "#ffe711"
    },
    {
      "type": "color",
      "id": "coral",
      "label": "Coral",
      "default": "#ff7064"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Q&A",
      "limit": 20,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What can New Era Designs do for me?"
        },
        {
          "type": "textarea",
          "id": "answer",
