    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact page URL"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact link label",
      "default": "Start a project"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
