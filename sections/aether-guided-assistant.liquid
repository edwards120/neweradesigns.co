</style>

<script>
  (() => {
    const sectionId = {{ section.id | json }};

    class PegasusFlyingAssistant {
      constructor(assistant) {
        this.assistant = assistant;
        this.launcher = assistant.querySelector('[data-aether-launcher]');
        this.petStage = assistant.querySelector('.aether-assistant__pet-stage');
        this.panel = assistant.querySelector('[data-aether-panel]');
        this.isPanelOpen = false;
        this.isPositionedNearPanel = false;
        
        // Get settings
        const styles = getComputedStyle(assistant);
        this.charSize = parseInt(styles.getPropertyValue('--aether-character-size')) || 110;
        this.flySpeed = parseFloat(styles.getPropertyValue('--aether-fly-speed')) || 0.5;
        this.scrollSensitivity = parseFloat(styles.getPropertyValue('--aether-scroll-sensitivity')) || 0.4;
        
        // State
        this.isFlying = false;
        this.isDragging = false;
        this.flyX = 0;
        this.flyY = 0;
        this.targetX = 0;
        this.targetY = 0;
        this.flyTime = 0;
        this.flyFrame = null;
        this.scrollOffset = 0;
        this.targetScrollOffset = 0;
        this.bubbleTimer = null;
        this.lastBubbleMessage = '';
        this.messageCount = 0;
        this.initialized = false;
        this.startMode = assistant.dataset.startMode || 'auto';
        this.startDesktopX = Number(assistant.dataset.startDesktopX || 50);
        this.startDesktopY = Number(assistant.dataset.startDesktopY || 8);
        this.startMobileX = Number(assistant.dataset.startMobileX || 50);
        this.startMobileY = Number(assistant.dataset.startMobileY || 10);
        
        // Bounds
        this.padding = 25;
        this.bounds = { minX: 0, maxX: 0, minY: 0, maxY: 0 };
        
        // Start position - center-right area, NOT at bottom
        this.initialX = window.innerWidth * 0.72;
        this.initialY = window.innerHeight * 0.5;
        
        // Knowledge
        this.knowledge = this.readKnowledge();
        
        this.init();
      }

      readKnowledge() {
        const source = this.assistant.querySelector('[data-aether-knowledge]');
        if (!source) return null;
        try {
          return JSON.parse(source.textContent);
        } catch (error) {
          console.warn('Pegasus: Could not read knowledge', error);
          return null;
        }
      }

      init() {
        if (!this.launcher || !this.petStage) return;
        
        this.updateBounds();
        this.resolveStartPosition();
        
        // Clamp to bounds
        this.initialX = Math.max(this.padding, Math.min(this.bounds.maxX, this.initialX));
        this.initialY = Math.max(this.padding + 6, Math.min(this.bounds.maxY, this.initialY));
        
        this.setInitialPosition();
        this.setupDrag();
        this.setupPanelToggle();
        this.setupScrollFollow();
        this.setupBubbleRotation();
        
        this.initialized = true;
        
        setTimeout(() => {
          this.startFlying();
        }, 600);
        
        window.addEventListener('resize', () => {
          this.updateBounds();
          if (!this.isPanelOpen && !this.isDragging) {
            this.constrainToBounds();
          }

          resolveStartPosition() {
            const isMobile = window.innerWidth <= 989;
            if (this.startMode === 'manual') {
              const startX = isMobile ? this.startMobileX : this.startDesktopX;
              const startY = isMobile ? this.startMobileY : this.startDesktopY;
              this.initialX = (window.innerWidth - this.charSize) * (startX / 100);
              this.initialY = (window.innerHeight - this.charSize) * (startY / 100);
              return;
            }

            const heroAnchor = document.querySelector(
              '#MainContent .ned-hero-title-top, [id^="NedEditorialHero-"] .ned-editorial-hero__line--1 > span'
            );

            if (heroAnchor) {
              const rect = heroAnchor.getBoundingClientRect();
              const header = document.querySelector('#shopify-section-sections--header, .shopify-section-group-header-group, header');
              const headerRect = header ? header.getBoundingClientRect() : null;
              const headerBottom = headerRect ? Math.max(0, headerRect.bottom) : 0;
              this.initialX = rect.left + (rect.width * 0.5) - (this.charSize * 0.5);
              this.initialY = Math.max(this.padding + 8, headerBottom + 6, rect.top - (this.charSize * 0.18));
              return;
            }

            const panelWidth = parseInt(getComputedStyle(this.assistant).getPropertyValue('--aether-panel-width')) || 390;
            const panelRight = 20;
            const panelBottom = 20;
            const panelLeft = window.innerWidth - panelWidth - panelRight - 20;
            const panelTop = window.innerHeight - 400 - panelBottom;
            this.initialX = Math.min(panelLeft - this.charSize - 20, window.innerWidth * 0.7);
            this.initialY = Math.min(panelTop + 150, window.innerHeight * 0.5);
          }
        }, { passive: true });
        
        window.addEventListener('orientationchange', () => {
          setTimeout(() => {
            this.updateBounds();
            if (!this.isPanelOpen && !this.isDragging) {
              this.constrainToBounds();
            }
          }, 400);
        });
      }

      updateBounds() {
        const size = this.charSize;
        this.padding = Math.max(20, Math.min(35, window.innerWidth * 0.025));
        this.bounds.minX = this.padding;
        this.bounds.maxX = window.innerWidth - size - this.padding;
        this.bounds.minY = this.padding;
        this.bounds.maxY = window.innerHeight - size - this.padding;
      }

      setInitialPosition() {
        const x = Math.min(this.initialX, this.bounds.maxX);
        const y = Math.min(this.initialY, this.bounds.maxY);
        this.flyX = x;
        this.flyY = y;
        this.launcher.style.left = x + 'px';
        this.launcher.style.top = y + 'px';
        this.targetX = x;
        this.targetY = y;
        this.scrollOffset = 0;
        this.targetScrollOffset = 0;
        this.isPositionedNearPanel = false;
      }

      constrainToBounds() {
        const x = Math.max(this.bounds.minX, Math.min(this.bounds.maxX, this.flyX));
        const y = Math.max(this.bounds.minY, Math.min(this.bounds.maxY, this.flyY));
        if (x !== this.flyX || y !== this.flyY) {
          this.flyX = x;
          this.flyY = y;
          this.launcher.style.left = x + 'px';
          this.launcher.style.top = y + 'px';
          this.targetX = x;
          this.targetY = y;
        }
      }

      startFlying() {
        if (this.isDragging || this.isPanelOpen || this.isPositionedNearPanel) return;
        
        if (!this.launcher.style.left || this.launcher.style.left === '0px') {
          this.setInitialPosition();
        }
        
        this.isFlying = true;
        this.flyTime = 0;
        this.pickNewTarget();
        this.animateFly();
      }

      pickNewTarget() {
        const pad = this.padding + 40;
        const rangeX = this.bounds.maxX - pad;
        const rangeY = this.bounds.maxY - pad;
        const minX = this.bounds.minX + pad;
        const minY = this.bounds.minY + pad;
        
        const maxMove = Math.min(300, Math.max(100, window.innerWidth * 0.2));
        const currentX = this.flyX;
        const currentY = this.flyY;
        
        let newX = currentX + (Math.random() - 0.5) * maxMove * 2;
        let newY = currentY + (Math.random() - 0.5) * maxMove * 1.6;
        
        newX = Math.max(minX, Math.min(rangeX, newX));
        newY = Math.max(minY, Math.min(rangeY, newY));
        
        if (Math.abs(newX - currentX) < 50 && Math.abs(newY - currentY) < 50) {
          newX = currentX + (Math.random() > 0.5 ? 1 : -1) * (70 + Math.random() * 100);
          newY = currentY + (Math.random() > 0.5 ? 1 : -1) * (70 + Math.random() * 100);
          newX = Math.max(minX, Math.min(rangeX, newX));
          newY = Math.max(minY, Math.min(rangeY, newY));
        }
        
        this.targetX = newX;
        this.targetY = newY;
      }

      animateFly() {
        if (this.isDragging || this.isPanelOpen || this.isPositionedNearPanel) {
          this.isFlying = false;
          if (this.flyFrame) {
            cancelAnimationFrame(this.flyFrame);
            this.flyFrame = null;
          }
          return;
        }

        this.flyTime += 0.025;
        
        const dx = this.targetX - this.flyX;
        const dy = (this.targetY + this.scrollOffset) - this.flyY;
        const dist = Math.hypot(dx, dy);
        
        if (dist < 3) {
          setTimeout(() => {
            if (!this.isDragging && !this.isPanelOpen && !this.isPositionedNearPanel) {
              this.pickNewTarget();
            }
          }, 400 + Math.random() * 800);
        } else {
          const speed = Math.min(this.flySpeed, dist * 0.04);
          const angle = Math.atan2(dy, dx) + Math.sin(this.flyTime * 0.5) * 0.1;
          
          const waveX = Math.sin(this.flyTime * 1.1) * 0.5;
          const waveY = Math.cos(this.flyTime * 0.7) * 0.5;
          
          this.flyX += Math.cos(angle) * speed + waveX * 0.25;
          this.flyY += Math.sin(angle) * speed + waveY * 0.25;
          
          this.scrollOffset += (this.targetScrollOffset - this.scrollOffset) * 0.08;
          this.flyY += this.scrollOffset * 0.02;
          
          this.flyX = Math.max(this.bounds.minX, Math.min(this.bounds.maxX, this.flyX));
          this.flyY = Math.max(this.bounds.minY, Math.min(this.bounds.maxY, this.flyY));
        }

        this.launcher.style.left = this.flyX + 'px';
        this.launcher.style.top = this.flyY + 'px';
        
        const tiltAngle = Math.atan2(
          (this.targetY + this.scrollOffset) - this.flyY,
          this.targetX - this.flyX
        ) * (180 / Math.PI);
        const tiltAmount = Math.max(-5, Math.min(5, tiltAngle * 0.1));
        
        if (!this.petStage.matches(':hover')) {
          this.petStage.style.transform = `rotate(${tiltAmount}deg) scale(1)`;
        }

        this.flyFrame = requestAnimationFrame(() => this.animateFly());
      }

      setupScrollFollow() {
        let lastScrollY = window.scrollY;
        
        window.addEventListener('scroll', () => {
          const currentScrollY = window.scrollY;
          const delta = currentScrollY - lastScrollY;
          const velocity = delta * 0.3 * this.scrollSensitivity;
          this.targetScrollOffset += velocity * 0.5;
          
          const maxOffset = window.innerHeight * 0.35;
          this.targetScrollOffset = Math.max(-maxOffset, Math.min(maxOffset, this.targetScrollOffset));
          
          if (Math.abs(delta) > 5 && !this.isPanelOpen && !this.isDragging) {
            this.assistant.classList.add('is-flying');
            clearTimeout(this._scrollTimeout);
            this._scrollTimeout = setTimeout(() => {
              this.assistant.classList.remove('is-flying');
            }, 300);
          }
          
          lastScrollY = currentScrollY;
        }, { passive: true });
      }

      setupBubbleRotation() {
        if (!this.knowledge?.bubbleEnabled) return;
        
        const messages = this.knowledge.bubbleMessages || [];
        if (!messages.length) return;
        
        const showBubble = () => {
          if (this.isPanelOpen) {
            this.scheduleNextBubble();
            return;
          }
          
          const available = messages.filter(m => m !== this.lastBubbleMessage);
          const pool = available.length ? available : messages;
          const message = pool[Math.floor(Math.random() * pool.length)];
          this.lastBubbleMessage = message;
          
          const bubble = this.assistant.querySelector('[data-aether-bubble]');
          if (bubble) {
            const textEl = bubble.querySelector('.aether-assistant__bubble-text');
            if (textEl) textEl.textContent = message;
            bubble.classList.add('is-visible');
            
            const duration = Number(this.knowledge.bubbleDuration) * 1000 || 5000;
            setTimeout(() => {
              bubble.classList.remove('is-visible');
              this.scheduleNextBubble();
            }, duration);
          }
        };
        
        const scheduleNextBubble = () => {
          const delay = Number(this.knowledge.bubbleDelay) * 1000 || 8000;
          const extra = Math.random() * 3000;
          clearTimeout(this.bubbleTimer);
          this.bubbleTimer = setTimeout(showBubble, delay + extra);
        };
        
        this.scheduleNextBubble = scheduleNextBubble;
        setTimeout(showBubble, 2000);
      }

      setupDrag() {
        const launcher = this.launcher;
        const dragEnabled = this.assistant.dataset.enableDrag === 'true';

        if (!launcher || !dragEnabled) return;

        let activePointerId = null;
        let originPointerX = 0;
        let originPointerY = 0;
        let originLeft = 0;
        let originTop = 0;
        let didDrag = false;
        const dragThreshold = 5;

        const placeWithinViewport = (left, top) => {
          const pad = this.padding;
          const maxX = this.bounds.maxX;
          const maxY = this.bounds.maxY;
          
          left = Math.max(pad, Math.min(maxX, left));
          top = Math.max(pad, Math.min(maxY, top));
          
          this.launcher.style.left = left + 'px';
          this.launcher.style.top = top + 'px';
          this.flyX = left;
          this.flyY = top;
          this.targetX = left;
          this.targetY = top;
        };

        const finishDrag = (event) => {
          if (activePointerId === null || event.pointerId !== activePointerId) return;
          
          if (launcher.hasPointerCapture?.(activePointerId)) {
            launcher.releasePointerCapture(activePointerId);
          }
          
          activePointerId = null;
          this.isDragging = false;
          this.assistant.classList.remove('is-dragging');
          
          if (!this.isPanelOpen && !this.isPositionedNearPanel) {
            setTimeout(() => this.startFlying(), 300);
          }
        };

        launcher.addEventListener('pointerdown', (event) => {
          if (event.button !== 0) return;

          if (this.flyFrame) {
            cancelAnimationFrame(this.flyFrame);
            this.flyFrame = null;
          }
          
          this.isDragging = true;
          this.assistant.classList.add('is-dragging');
          
          const launcherBounds = launcher.getBoundingClientRect();
          
          activePointerId = event.pointerId;
          originPointerX = event.clientX;
          originPointerY = event.clientY;
          originLeft = launcherBounds.left;
          originTop = launcherBounds.top;
          didDrag = false;

          launcher.setPointerCapture?.(event.pointerId);
        });

        launcher.addEventListener('pointermove', (event) => {
          if (activePointerId === null || event.pointerId !== activePointerId) return;

          const deltaX = event.clientX - originPointerX;
          const deltaY = event.clientY - originPointerY;

          if (!didDrag && Math.hypot(deltaX, deltaY) < dragThreshold) return;

          didDrag = true;
          event.preventDefault();
          placeWithinViewport(originLeft + deltaX, originTop + deltaY);
        });

        launcher.addEventListener('pointerup', finishDrag);
        launcher.addEventListener('pointercancel', finishDrag);
        launcher.addEventListener('lostpointercapture', () => {
          activePointerId = null;
          this.isDragging = false;
          this.assistant.classList.remove('is-dragging');
          if (!this.isPanelOpen && !this.isPositionedNearPanel) {
            setTimeout(() => this.startFlying(), 300);
          }
        });

        launcher.addEventListener('click', (event) => {
          if (didDrag) {
            event.preventDefault();
            event.stopImmediatePropagation();
            didDrag = false;
          }
        }, true);
      }

      setupPanelToggle() {
        const launcher = this.launcher;
        const closeBtn = this.assistant.querySelector('[data-aether-close]');
        const panel = this.panel;
        const input = this.assistant.querySelector('[data-aether-input]');

        if (!launcher || !panel) return;

        // OPEN PANEL
        launcher.addEventListener('click', (event) => {
          if (this.isDragging) return;

          // Reposition Pegasus: on mobile, move to top-left; on desktop, left of panel
          const isMobile = window.innerWidth < 560;
          let targetX, targetY;
          if (isMobile) {
            targetX = this.padding + 10;
            targetY = this.padding + 30;
          } else {
            const panelWidth = parseInt(getComputedStyle(this.assistant).getPropertyValue('--aether-panel-width')) || 390;
            const panelRight = 20;
            const panelLeft = window.innerWidth - panelWidth - panelRight;
            targetX = Math.max(this.padding, panelLeft - this.charSize - 20);
            targetY = window.innerHeight * 0.35;
          }

          this.flyX = targetX;
          this.flyY = targetY;
          this.launcher.style.left = targetX + 'px';
          this.launcher.style.top = targetY + 'px';

          this.togglePanel(true);
        });

        // CLOSE PANEL - close button
        if (closeBtn) {
          closeBtn.addEventListener('click', (event) => {
            event.stopPropagation();
            this.togglePanel(false);
            setTimeout(() => {
              this.isPositionedNearPanel = false;
              this.startFlying();
            }, 400);
          });
        }

        // CLOSE PANEL - Escape key
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && this.isPanelOpen) {
            this.togglePanel(false);
            setTimeout(() => {
              this.isPositionedNearPanel = false;
              this.startFlying();
            }, 400);
          }
        });

        // ─── CLICK OUTSIDE: NO CLOSE (removed) ───

        // FORM SUBMISSION
        const form = this.assistant.querySelector('[data-aether-form]');
        if (form) {
          form.addEventListener('submit', (event) => {
            event.preventDefault();
            this.handleSubmit();
          });
        }
      }

      positionNearPanel() {
        // (No longer called; leaving empty to avoid errors if referenced elsewhere)
      }

      handleSubmit() {
        const input = this.assistant.querySelector('[data-aether-input]');
        const question = input?.value.trim();
        if (!question) return;
        
        const entry = this.findBestMatch(question);
        input.value = '';
        this.addMessage(question, 'visitor');
        this.assistant.classList.add('is-thinking');
        
        setTimeout(() => {
          this.assistant.classList.remove('is-thinking');
          if (entry) {
            this.addMessage(entry.answer, 'assistant', entry);
            this.renderQuestions(this.getRelatedQuestions(entry));
          } else {
            const fallback = this.knowledge?.fallback || "That needs a human answer. Send the studio a short note and Chris will point you in the right direction.";
            this.addMessage(fallback, 'assistant', this.knowledge?.contact);
            this.renderQuestions(this.getContextualQuestions());
          }
        }, 400 + Math.random() * 200);
      }

      findBestMatch(question) {
        if (!this.knowledge?.items) return null;
        
        const q = question.toLowerCase().trim();
        const words = q.split(/\s+/).filter(w => w.length > 2);
        let best = null;
        let bestScore = 0;
        
        this.knowledge.items.forEach(entry => {
          const text = (entry.question + ' ' + (entry.keywords || '')).toLowerCase();
          let score = 0;
          words.forEach(word => {
            if (text.includes(word)) score += 2;
            if (entry.question.toLowerCase().includes(word)) score += 3;
          });
          if (q.includes(entry.question.toLowerCase())) score += 10;
          if (score > bestScore) {
            bestScore = score;
            best = entry;
          }
        });
        
        return bestScore > 2 ? best : null;
      }

      getContextualQuestions() {
        if (!this.knowledge?.items) return [];
        return this.knowledge.items.slice(0, 4);
      }

      getRelatedQuestions(entry) {
        if (!this.knowledge?.items) return [];
        const keywords = (entry.keywords || '').toLowerCase().split(/\s+/);
        return this.knowledge.items
          .filter(e => e !== entry)
          .map(e => ({
            ...e,
            score: keywords.filter(k => (e.keywords || '').toLowerCase().includes(k)).length
          }))
          .sort((a, b) => b.score - a.score)
          .slice(0, 3);
      }

      addMessage(text, speaker, entry = null) {
        const container = this.assistant.querySelector('[data-aether-messages]');
        if (!container) return;
        
        const message = document.createElement('div');
        message.className = `aether-assistant__message aether-assistant__message--${speaker}`;
        message.textContent = text;
        
        if (entry?.url && entry?.linkLabel) {
          const link = document.createElement('a');
          link.href = entry.url;
          link.textContent = entry.linkLabel;
          if (/^https?:\/\//.test(entry.url)) link.rel = 'noopener noreferrer';
          message.appendChild(document.createElement('br'));
          message.appendChild(link);
        }
        
        container.appendChild(message);
        container.scrollTop = container.scrollHeight;
        this.messageCount++;
      }

      renderQuestions(entries) {
        const container = this.assistant.querySelector('[data-aether-questions]');
        if (!container) return;
        
        container.replaceChildren();
        entries.forEach(entry => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'aether-assistant__question';
          button.dataset.aetherQuestion = '';
          button.textContent = entry.question;
          button.addEventListener('click', () => {
            const input = this.assistant.querySelector('[data-aether-input]');
            if (input) {
              input.value = entry.question;
              this.handleSubmit();
            }
          });
          container.appendChild(button);
        });
      }

      togglePanel(open) {
        this.isPanelOpen = open;
        this.assistant.classList.toggle('is-open', open);
        
        if (open) {
          // Stop flying
          if (this.flyFrame) {
            cancelAnimationFrame(this.flyFrame);
            this.flyFrame = null;
          }
          this.isFlying = false;
          this.panel.hidden = false;
          
          // Show greeting if first time
          const messages = this.assistant.querySelector('[data-aether-messages]');
          if (messages && messages.children.length === 0) {
            this.addMessage(this.knowledge?.greeting || "Hey — I'm Pegasus. Ask me about anything!", 'assistant');
            this.renderQuestions(this.getContextualQuestions());
          }
          
          // Focus input without scrolling
          const input = this.assistant.querySelector('[data-aether-input]');
          if (input) {
            setTimeout(() => input.focus({ preventScroll: true }), 350);
          }
        } else {
          this.panel.hidden = true;
        }
      }
    }

    function initializePegasus(sectionRoot = document) {
      const assistant = sectionRoot.querySelector
        ? sectionRoot.querySelector(`#AetherAssistant-${CSS.escape(String(sectionId))}`)
        : null;

      if (!assistant || assistant.dataset.flyReady === 'true') return;

      assistant.dataset.flyReady = 'true';
      
      requestAnimationFrame(() => {
        new PegasusFlyingAssistant(assistant);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initializePegasus(), { once: true });
    } else {
      initializePegasus();
    }

    document.addEventListener('shopify:section:load', (event) => {
      initializePegasus(event.target);
    });
  })();
</script>