{% schema %}
{
  "name": "New Era page system",
  "tag": "section",
  "class": "section-new-era",
  "settings": [
    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "assistant_n4" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "assistant_n4" },
    { "type": "select", "id": "display_font_mode", "label": "Hero display fonts", "default": "theme", "options": [{ "value": "theme", "label": "Use heading font" }, { "value": "uploaded", "label": "Use uploaded New Era fonts" }] },
    { "type": "range", "id": "title_size", "label": "Large title size", "min": 80, "max": 180, "step": 5, "unit": "px", "default": 150 },
    { "type": "range", "id": "body_size", "label": "Body text size", "min": 14, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "micro_label_size", "label": "Small label size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 13 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "shell_background", "label": "Outer container", "default": "#071a3a" },
    { "type": "color", "id": "panel_color", "label": "Light panels", "default": "#f2eee5" },
    { "type": "color", "id": "text_color", "label": "Main text and titles", "default": "#070707" },
    { "type": "color", "id": "accent_primary", "label": "Primary accent", "default": "#143cff" },
    { "type": "color", "id": "accent_secondary", "label": "Secondary accent", "default": "#ff271c" },
    { "type": "color", "id": "hero_background", "label": "Hero background", "default": "#071a3a" },
    { "type": "color", "id": "hero_text", "label": "Hero text", "default": "#ffffff" },
