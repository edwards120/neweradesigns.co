{% liquid
  assign is_home = false
  assign is_services = false
  assign is_contact = false
  if request.page_type == 'index'
    assign is_home = true
  elsif page.handle == 'marketing-materials'
    assign is_services = true
  elsif page.handle == 'contact'
    assign is_contact = true
  endif
  assign hero_title_line_1 = section.settings.hero_title_line_1 | default: 'YOU NEED A'
  assign hero_title_line_2 = section.settings.hero_title_line_2 | default: 'NEW ERA'
  assign hero_body = section.settings.hero_body | default: 'We develop brand, wayfinding, and environmental systems that reduce friction and make the physical environment perform.'
  assign hero_button_label = section.settings.hero_button_label | default: 'START A PROJECT'
  assign hero_button_link = section.settings.hero_button_link | default: '/pages/contact'
  assign panel_alpha = section.settings.panel_opacity | divided_by: 100.0
  assign media_overlay_alpha = section.settings.media_overlay_opacity | divided_by: 100.0
  assign right_container_alpha = section.settings.right_container_opacity | divided_by: 100.0
  assign service_title_size = section.settings.title_size | times: 0.75 | round
  assign hero_script_size = section.settings.title_size | times: 1.65 | round
%}

<section class="ned-shell ned-{{ request.page_type }} ned-{{ page.handle }}" id="NewEra-{{ section.id }}">
  <div class="ned-orb ned-orb--1"></div><div class="ned-orb ned-orb--2"></div><div class="ned-orb ned-orb--3"></div>

  {% if is_home %}
    <div class="ned-panel ned-hero">
      <nav class="ned-hero-nav" aria-label="Homepage navigation">
        <a href="/pages/info">ABOUT US</a>
        <a href="#Services-{{ section.id }}">WHAT WE DO</a>
        <a class="ned-hero-brand" href="{{ routes.root_url }}">NEW ERA DESIGNS <small>SPATIAL SYSTEMS STUDIO</small></a>
        <a href="#SelectedWork-{{ section.id }}">SELECTED WORK</a>
        <a href="{{ hero_button_link }}">LET'S TALK</a>
      </nav>

      {% if section.settings.hero_video != blank or section.settings.hero_image != blank %}
        <div class="ned-hero-media" aria-hidden="true">
          {% if section.settings.hero_video != blank %}
            {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
          {% else %}
            {{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '750, 1200, 1600, 2000, 2400', sizes: '100vw', alt: '' }}
          {% endif %}
        </div>
      {% endif %}

      <div class="ned-hero-core">
        <span class="ned-hero-star" aria-hidden="true"></span>
        <h1><span class="ned-hero-title-top">{{ hero_title_line_1 }}</span><span class="ned-hero-title-script">{{ hero_title_line_2 }}</span></h1>
        <p>{{ hero_body }}</p>
        <a class="ned-hero-cta" href="{{ hero_button_link }}">{{ hero_button_label }} <span aria-hidden="true">+</span></a>
      </div>

      <div class="ned-hero-social ned-hero-social--left" aria-label="Social media">
        {% if settings.social_instagram_link != blank %}<a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">IG</a>{% endif %}
      </div>
      <div class="ned-hero-social ned-hero-social--right">
        {% if settings.social_linkedin_link != blank %}<a href="{{ settings.social_linkedin_link }}" target="_blank" rel="noopener" aria-label="LinkedIn">IN</a>{% endif %}
      </div>

      <div class="ned-hero-foot">
        <span>CLEAR THE NOISE</span>
        <a href="#Services-{{ section.id }}">SCROLL DOWN <b aria-hidden="true">↓</b></a>
        <span>MAKE YOUR MOVE</span>
      </div>
    </div>

    <div class="ned-panel ned-services" id="Services-{{ section.id }}">
      <div class="ned-eyebrow">[ WHAT WE DO ]</div>
      <h2>ALL YOUR <span class="ned-script">design needs</span></h2>
      <p>One studio. Every creative essential. Built with clarity, personality, and serious intention.</p>
      <div class="ned-pills"><span>Brand Strategy</span><span>Websites</span><span>Content Design</span><span>Marketing Materials</span><span>Social Media</span><span>Digital Products</span><span>Creative Direction</span><span>Retainers</span></div>
      <a class="ned-btn ned-btn--light" href="/pages/marketing-materials">EXPLORE SERVICES <span>↗</span></a>
    </div>

    {% comment %} SIGN PORTFOLIO: red-on-cream editorial sequence with layered cutout imagery. {% endcomment %}
    <div class="ned-panel ned-portfolio" id="SelectedWork-{{ section.id }}">
      <header class="ned-portfolio-head">
        <div class="ned-portfolio-rail">
          <span>GRAPHIC + ENVIRONMENTAL DESIGN</span>
          <span>SELECTED WORK / 01</span>
        </div>
        <div class="ned-portfolio-intro">
          <h2>SELECTED WORK <span>+ CONCEPT STUDIES</span></h2>
          <p>Sign systems, spatial studies, and fabrication-aware ideas documented from first decision to physical impact.</p>
        </div>
      </header>

      <div class="ned-portfolio-list">
        {% for block in section.blocks %}
          {% if block.type == 'portfolio_item' %}
            {% liquid
              assign project_link = block.settings.project_link | default: '/pages/cases'
              assign project_alt = block.settings.image_alt | default: block.settings.title
            %}
            <article class="ned-project" {{ block.shopify_attributes }}>
              <a class="ned-project-link" href="{{ project_link }}" aria-label="View {{ block.settings.title | escape }}">
                <div class="ned-project-stage">
                  <span class="ned-project-word" aria-hidden="true">{{ block.settings.title }}</span>
                  <div class="ned-project-media">
                    {% if block.settings.video != blank %}
                      {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
                    {% elsif block.settings.image != blank %}
                      {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 990px) 58vw, 92vw', alt: project_alt }}
                    {% else %}
                      <div class="ned-sign-placeholder" aria-hidden="true"><span></span><i></i><i></i></div>
                    {% endif %}
                  </div>
                  <div class="ned-crosshair ned-crosshair--a" aria-hidden="true"></div>
                  <div class="ned-crosshair ned-crosshair--b" aria-hidden="true"></div>
                  <div class="ned-dimension" aria-hidden="true"><span>{{ block.settings.annotation }}</span></div>
                </div>

                <div class="ned-project-copy">
                  <div class="ned-project-index">PROJECT / {% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</div>
                  <p class="ned-project-meta"><span>{{ block.settings.classification }}</span>{{ block.settings.discipline }}</p>
                  <h3>{{ block.settings.title }}</h3>
                  <p>{{ block.settings.description }}</p>
                  <span class="ned-project-cta">VIEW PROJECT <b aria-hidden="true">↗</b></span>
                </div>
              </a>
            </article>
          {% endif %}
        {% endfor %}
      </div>

      <footer class="ned-portfolio-foot">
        <span>DOCUMENTED / MODELED / PRODUCTION-AWARE</span>
        <a href="/pages/cases">VIEW ALL CASES <b aria-hidden="true">↗</b></a>
      </footer>
    </div>

    <div class="ned-panel ned-funk">
      <div class="ned-eyebrow">[ FEATURED EXPERIENCE ]</div>
      <h2 class="ned-funk-title">
        {% if section.settings.mask_video != blank %}
          <svg viewBox="0 0 1200 420" aria-label="Funk Machine"><defs><mask id="funk-mask-{{ section.id }}"><rect width="1200" height="420" fill="black"/><text x="600" y="176" text-anchor="middle" fill="white">FUNK</text><text x="600" y="370" text-anchor="middle" fill="white">MACHINE</text></mask></defs><foreignObject width="1200" height="420" mask="url(#funk-mask-{{ section.id }})"><div xmlns="http://www.w3.org/1999/xhtml" class="ned-mask-video">{{ section.settings.mask_video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}</div></foreignObject></svg>
        {% elsif section.settings.mask_image != blank %}
          <span class="ned-image-text" style="--mask-image:url('{{ section.settings.mask_image | image_url: width: 1800 }}')">FUNK<br>MACHINE</span>
        {% else %}<span>FUNK<br>MACHINE</span>{% endif %}
      </h2>
      <div class="ned-funk-foot"><p>A culture-forward playground for ideas with rhythm, color, and motion.</p><a class="ned-btn" href="/pages/cases">VIEW THE WORK <span>↗</span></a></div>
    </div>
  {% endif %}

  {% if is_services %}
    <div class="ned-panel ned-page-hero"><div class="ned-eyebrow">[ SERVICES ]</div><h1>BIG IDEAS.<br><span class="ned-script">Built beautifully.</span></h1><p>From the first spark to the final launch, we create brand systems and experiences that look sharp, feel alive, and work hard.</p></div>
    <div class="ned-panel ned-service-grid ned-service-grid--{{ section.settings.service_layout }}">
      <article class="ned-service-card{% if section.settings.service_1_video != blank or section.settings.service_1_image != blank %} has-media{% endif %}">
        {% if section.settings.service_1_video != blank or section.settings.service_1_image != blank %}<div class="ned-service-media" aria-hidden="true">{% if section.settings.service_1_video != blank %}{{ section.settings.service_1_video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}{% else %}{{ section.settings.service_1_image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '750, 1200, 1600, 2000', sizes: '100vw', alt: '' }}{% endif %}</div><span class="ned-service-overlay" aria-hidden="true"></span>{% endif %}
        <b>01</b><h2>BRAND<br>STRATEGY</h2><p>Positioning, voice, naming, and the strategic foundation your next era needs.</p>
      </article>
      <article class="ned-service-card{% if section.settings.service_2_video != blank or section.settings.service_2_image != blank %} has-media{% endif %}">
        {% if section.settings.service_2_video != blank or section.settings.service_2_image != blank %}<div class="ned-service-media" aria-hidden="true">{% if section.settings.service_2_video != blank %}{{ section.settings.service_2_video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}{% else %}{{ section.settings.service_2_image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '750, 1200, 1600, 2000', sizes: '100vw', alt: '' }}{% endif %}</div><span class="ned-service-overlay" aria-hidden="true"></span>{% endif %}
        <b>02</b><h2>VISUAL<br>IDENTITY</h2><p>Logos, typography, art direction, and flexible systems with unmistakable personality.</p>
      </article>
      <article class="ned-service-card{% if section.settings.service_3_video != blank or section.settings.service_3_image != blank %} has-media{% endif %}">
        {% if section.settings.service_3_video != blank or section.settings.service_3_image != blank %}<div class="ned-service-media" aria-hidden="true">{% if section.settings.service_3_video != blank %}{{ section.settings.service_3_video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}{% else %}{{ section.settings.service_3_image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '750, 1200, 1600, 2000', sizes: '100vw', alt: '' }}{% endif %}</div><span class="ned-service-overlay" aria-hidden="true"></span>{% endif %}
        <b>03</b><h2>WEB +<br>DIGITAL</h2><p>Editorial websites, Shopify builds, and digital moments designed for conversion.</p>
      </article>
      <article class="ned-service-card{% if section.settings.service_4_video != blank or section.settings.service_4_image != blank %} has-media{% endif %}">
        {% if section.settings.service_4_video != blank or section.settings.service_4_image != blank %}<div class="ned-service-media" aria-hidden="true">{% if section.settings.service_4_video != blank %}{{ section.settings.service_4_video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}{% else %}{{ section.settings.service_4_image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '750, 1200, 1600, 2000', sizes: '100vw', alt: '' }}{% endif %}</div><span class="ned-service-overlay" aria-hidden="true"></span>{% endif %}
        <b>04</b><h2>CAMPAIGNS +<br>CONTENT</h2><p>Launch concepts, social systems, creative direction, and scroll-stopping assets.</p>
      </article>
    </div>
    {% render 'new-era-service-work', section: section %}
    <div class="ned-panel ned-process"><div><div class="ned-eyebrow">[ OUR PROCESS ]</div><h2>Good work has a <span class="ned-script">rhythm.</span></h2></div><ol><li><span>01</span>Discover</li><li><span>02</span>Define</li><li><span>03</span>Design</li><li><span>04</span>Deliver</li></ol></div>
    <div class="ned-panel ned-cta"><p>READY FOR SOMETHING NEW?</p><h2>LET’S MAKE<br><span class="ned-script">your next era.</span></h2><a class="ned-btn ned-btn--light" href="/pages/contact">BOOK YOUR PROJECT <span>↗</span></a></div>
  {% endif %}

  {% if is_contact %}
    <div class="ned-panel ned-contact">
      <div class="ned-contact-copy"><div class="ned-eyebrow">[ CONTACT ]</div><h1>LET’S MAKE<br><span class="ned-script">something iconic.</span></h1><p>Tell us what you’re building, what is not working, and where you want to go. We’ll reply within 48 hours.</p><div class="ned-contact-meta"><span>NEW ERA DESIGNS</span><a href="mailto:{{ shop.email }}">{{ shop.email }}</a><a href="https://www.instagram.com/new.era.designs/">@new.era.designs</a></div></div>
      <div class="ned-form-wrap">{% form 'contact', id: 'NedContact' %}{% if form.posted_successfully? %}<h3>MESSAGE RECEIVED.</h3><p>We’ll be in touch within 48 hours.</p>{% else %}{{ form.errors | default_errors }}<label>YOUR NAME<input name="contact[name]" required></label><label>EMAIL<input type="email" name="contact[email]" required></label><label>WHAT DO YOU NEED?<select name="contact[service]"><option>Brand strategy</option><option>Visual identity</option><option>Website + digital</option><option>Campaign + content</option><option>Something else</option></select></label><label>TELL US EVERYTHING<textarea name="contact[body]" rows="6" required></textarea></label><button class="ned-btn" type="submit">SEND INQUIRY <span>↗</span></button>{% endif %}{% endform %}</div>
    </div>
  {% endif %}
</section>

{% style %}
@font-face{font-display:swap;font-family:'NED Edwardian';font-style:normal;font-weight:400;src:url("{{ 'edwardianscriptitc.ttf' | file_url }}") format('truetype')}
@font-face{font-display:swap;font-family:'NED Funk Machine';font-style:normal;font-weight:400;src:url("{{ 'funkmachine.ttf' | file_url }}") format('truetype')}
{{ section.settings.heading_font | font_face: font_display: 'swap' }}
{{ section.settings.body_font | font_face: font_display: 'swap' }}
{% if is_home %}.shopify-section-group-header-group{display:none}{% endif %}
#NewEra-{{ section.id }}{--blue:{{ section.settings.accent_primary }};--blue-panel:{{ section.settings.accent_primary | color_modify: 'alpha', panel_alpha }};--red:{{ section.settings.accent_secondary }};--red-panel:{{ section.settings.accent_secondary | color_modify: 'alpha', panel_alpha }};--ink:{{ section.settings.text_color }};--paper:{{ section.settings.panel_color }};--paper-panel:{{ section.settings.panel_color | color_modify: 'alpha', panel_alpha }};--ned-navy:{{ section.settings.hero_background }};--ned-navy-panel:{{ section.settings.hero_background | color_modify: 'alpha', panel_alpha }};--ned-hero-text:{{ section.settings.hero_text }};--ned-hero-overlay:{{ section.settings.hero_background | color_modify: 'alpha', media_overlay_alpha }};--ned-media-overlay:{{ section.settings.media_overlay_color | color_modify: 'alpha', media_overlay_alpha }};--ned-right-bg:{{ section.settings.right_container_background | color_modify: 'alpha', right_container_alpha }};--ned-right-text:{{ section.settings.right_container_text }};--ned-heading-font:{{ section.settings.heading_font.family }},{{ section.settings.heading_font.fallback_families }};--ned-body-font:{{ section.settings.body_font.family }},{{ section.settings.body_font.fallback_families }};--ned-display-font:{% if section.settings.display_font_mode == 'uploaded' %}'NED Funk Machine','Arial Black',Arial,sans-serif{% else %}var(--ned-heading-font){% endif %};--ned-script-font:{% if section.settings.display_font_mode == 'uploaded' %}'NED Edwardian','Edwardian Script ITC','Bickham Script Pro','Snell Roundhand',cursive{% else %}var(--ned-heading-font){% endif %};--ned-gold:#fca311;--ned-soft:#f5f7fa;--ned-eyebrow-size:{{ section.settings.micro_label_size }}px;--ned-micro-size:{{ section.settings.micro_label_size | minus: 1 }}px;--ned-body-size:{{ section.settings.body_size }}px;--ned-panel-radius:{{ section.settings.panel_radius }}px;--ned-right-width:{{ section.settings.right_container_width }}%;--ned-right-padding:{{ section.settings.right_container_padding }}px;background-color:{{ section.settings.shell_background }};color:var(--ink);font-family:var(--ned-body-font);font-size:var(--ned-body-size);max-width:{{ section.settings.container_width }}px;margin:0 auto;overflow:hidden;position:relative;padding:{{ section.settings.outer_gutter }}px;isolation:isolate}
#NewEra-{{ section.id }} *{box-sizing:border-box} #NewEra-{{ section.id }} .ned-panel{position:relative;z-index:2;overflow:hidden;border:1px solid rgba(0,0,0,.22);border-radius:var(--ned-panel-radius);padding:clamp(32px,6vw,92px);margin-bottom:{{ section.settings.panel_gap }}px;background-color:var(--paper-panel);background-image:none!important;background-size:8px 8px!important}
#NewEra-{{ section.id }} h1,#NewEra-{{ section.id }} h2,#NewEra-{{ section.id }} h3,#NewEra-{{ section.id }} p{margin-top:0} #NewEra-{{ section.id }} h1,#NewEra-{{ section.id }} h2,#NewEra-{{ section.id }} h3{color:inherit;font-family:var(--ned-heading-font);font-weight:900;letter-spacing:-.065em;line-height:.82;text-transform:uppercase}
#NewEra-{{ section.id }} .ned-script{font-family:var(--ned-script-font);font-weight:400;text-transform:none;letter-spacing:-.025em;line-height:.72}
#NewEra-{{ section.id }} .ned-eyebrow,#NewEra-{{ section.id }} .ned-kicker{font:700 var(--ned-eyebrow-size)/1.2 Arial,sans-serif;letter-spacing:.14em;margin-bottom:34px}
#NewEra-{{ section.id }} .ned-btn{display:inline-flex;align-items:center;justify-content:space-between;gap:34px;background:var(--ink);color:white;text-decoration:none;border:0;border-radius:0;padding:16px 22px;font:800 12px/1 Arial,sans-serif;letter-spacing:.08em;cursor:pointer} #NewEra-{{ section.id }} .ned-btn span{animation:nedPageButtonBounce-{{ section.id }} 1.8s linear infinite;display:inline-block;transform-origin:center bottom}#NewEra-{{ section.id }} .ned-btn:hover span,#NewEra-{{ section.id }} .ned-btn:focus-visible span{animation-duration:.72s}#NewEra-{{ section.id }} .ned-btn--light{background:white;color:var(--ink)}@keyframes nedPageButtonBounce-{{ section.id }}{0%,12%,42%,100%{transform:translateY(0) scale(1)}15%{transform:translateY(2px) scale(1.12,.88)}24%{transform:translateY(-7px) scale(.96,1.04)}34%{transform:translateY(0) scale(1.05,.95)}}
#NewEra-{{ section.id }} .ned-orb{position:absolute;border-radius:50%;z-index:1;pointer-events:none;border:2px solid rgba(255,255,255,.65)} #NewEra-{{ section.id }} .ned-orb--1{width:180px;height:180px;background:var(--blue);top:7%;right:-50px} #NewEra-{{ section.id }} .ned-orb--2{width:90px;height:90px;background:var(--red);top:45%;left:-25px} #NewEra-{{ section.id }} .ned-orb--3{width:130px;height:130px;background:#f4e932;bottom:4%;right:7%}
/* HERO: full-viewport navy halftone stage with working navigation and conversion paths. */
#NewEra-{{ section.id }} .ned-hero{background-color:var(--ned-navy);background-image:none!important;border-color:#24406f;color:var(--ned-hero-text);display:flex;flex-direction:column;isolation:isolate;justify-content:space-between;min-height:max(780px,calc(100vh - 36px));padding:clamp(24px,3vw,42px)}
#NewEra-{{ section.id }} .ned-hero-media{inset:0;position:absolute;z-index:-2}#NewEra-{{ section.id }} .ned-hero-media img,#NewEra-{{ section.id }} .ned-hero-media video{height:100%;object-fit:cover;width:100%}
#NewEra-{{ section.id }} .ned-hero::before{background:var(--ned-hero-overlay);content:'';inset:0;pointer-events:none;position:absolute;z-index:-1}#NewEra-{{ section.id }} .ned-hero::after{background:url('https://cdn.shopify.com/s/files/1/0914/0138/8337/files/website_Background.svg?v=1784631913') center/cover;content:'';filter:grayscale(1) contrast(1.35);inset:0;opacity:.08;pointer-events:none;position:absolute;z-index:-1}
#NewEra-{{ section.id }} .ned-hero-nav{align-items:start;display:grid;font:900 clamp(11px,1.05vw,15px)/1 'Milo',Arial,sans-serif;grid-template-columns:repeat(5,minmax(0,1fr));letter-spacing:.06em;position:relative;text-transform:uppercase;z-index:3}
#NewEra-{{ section.id }} .ned-hero-nav>a{color:#fff;min-height:44px;text-decoration:none}
#NewEra-{{ section.id }} .ned-hero-nav>a:nth-child(2),#NewEra-{{ section.id }} .ned-hero-nav>a:nth-child(4){text-align:center}
#NewEra-{{ section.id }} .ned-hero-nav>a:last-child{text-align:right}
#NewEra-{{ section.id }} .ned-hero-brand{font-family:'Mathew Rohas','Arial Black',Arial,sans-serif;font-size:clamp(17px,2vw,28px)!important;letter-spacing:-.04em!important;line-height:.72!important;text-align:center}
#NewEra-{{ section.id }} .ned-hero-brand small{display:block;font-family:'Edwardian Script ITC','Bickham Script Pro','Snell Roundhand',cursive;font-size:.7em;font-weight:400;letter-spacing:0;margin-top:6px;text-transform:none}
#NewEra-{{ section.id }} .ned-hero-core{align-items:center;display:flex;flex:1;flex-direction:column;justify-content:center;margin:auto;max-width:1180px;padding:clamp(70px,9vh,120px) 0 50px;text-align:center;width:100%}
#NewEra-{{ section.id }} .ned-hero-star{height:34px;margin-bottom:clamp(28px,4vh,54px);position:relative;width:34px}
#NewEra-{{ section.id }} .ned-hero-star::before,#NewEra-{{ section.id }} .ned-hero-star::after{background:#fff;content:'';left:50%;position:absolute;top:50%;transform:translate(-50%,-50%)}
#NewEra-{{ section.id }} .ned-hero-star::before{height:34px;width:2px}
#NewEra-{{ section.id }} .ned-hero-star::after{height:2px;width:34px}
#NewEra-{{ section.id }} .ned-hero h1{align-items:center;color:#fff!important;display:flex;flex-direction:column;line-height:.72;margin:0;max-width:1180px;position:relative;width:100%}
#NewEra-{{ section.id }} .ned-hero-title-top{display:block;font-family:var(--ned-display-font);font-size:clamp(66px,10vw,{{ section.settings.title_size }}px);font-weight:700;letter-spacing:-.045em;line-height:.76;text-transform:uppercase}
#NewEra-{{ section.id }} .ned-hero-title-script{display:block;font-family:var(--ned-script-font);font-size:clamp(106px,16.5vw,{{ hero_script_size }}px);font-weight:400;letter-spacing:-.04em;line-height:.55;margin-top:clamp(-34px,-2.8vw,-18px);position:relative;text-transform:{% if section.settings.display_font_mode == 'uploaded' %}none{% else %}uppercase{% endif %};transform:{% if section.settings.display_font_mode == 'uploaded' %}rotate(-4deg){% else %}none{% endif %};z-index:2}
#NewEra-{{ section.id }} .ned-hero-core>p{font:500 clamp(16px,1.55vw,22px)/1.15 'Milo',Arial,sans-serif;margin:clamp(34px,5vh,58px) auto 28px;max-width:660px}
#NewEra-{{ section.id }} .ned-hero-cta{align-items:center;background:#d9d4ff;border:1px solid #fff;border-radius:0;color:var(--ink);display:inline-flex;font:900 12px/1 'Milo',Arial,sans-serif;gap:30px;justify-content:space-between;letter-spacing:.09em;min-height:56px;padding:0 24px;text-decoration:none}
#NewEra-{{ section.id }} .ned-hero-cta span{font-size:20px;font-weight:400}
