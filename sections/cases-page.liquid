    },
    {
      "type": "text",
      "id": "process_2",
      "label": "Process 2",
      "default": "Find where confusion starts and what decision needs support."
    },
    {
      "type": "text",
      "id": "process_3",
      "label": "Process 3",
      "default": "Prototype hierarchy, placement, materials, and visibility before fabrication."
    },
    {
      "type": "text",
      "id": "process_4",
