{% comment %}
  New Era Designs - Cases Page
  Editable case study section for spatial systems, wayfinding concepts,
  brand systems, campaign work, and optional 3D model viewers.
{% endcomment %}

{% liquid
  assign section_key = section.id | replace: '_', '' | downcase
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
%}

<section class="ned-cases ned-cases-{{ section_key }}">
  <div class="ned-cases-shell">
    <div class="ned-cases-hero">
      <div class="ned-cases-hero-copy">
        {% if section.settings.eyebrow != blank %}
          <span class="ned-cases-kicker">{{ section.settings.eyebrow }}</span>
        {% endif %}

        {% if section.settings.title != blank %}
          <h1>{{ section.settings.title }}</h1>
        {% endif %}

        {% if section.settings.intro != blank %}
          <div class="ned-cases-intro rte">{{ section.settings.intro }}</div>
        {% endif %}
      </div>

      <div class="ned-cases-manifesto">
        {% if section.settings.manifesto_label != blank %}
          <span>{{ section.settings.manifesto_label }}</span>
        {% endif %}

        {% if section.settings.manifesto_text != blank %}
          <p>{{ section.settings.manifesto_text }}</p>
        {% endif %}
      </div>
    </div>

    <div class="ned-cases-process" aria-label="Design process">
      <div>
        <span>01</span>
        <p>{{ section.settings.process_1 }}</p>
      </div>
      <div>
        <span>02</span>
        <p>{{ section.settings.process_2 }}</p>
      </div>
      <div>
        <span>03</span>
        <p>{{ section.settings.process_3 }}</p>
      </div>
      <div>
        <span>04</span>
        <p>{{ section.settings.process_4 }}</p>
      </div>
    </div>

    <div class="ned-cases-heading">
      <span>{{ section.settings.cases_label }}</span>
      <p>{{ section.settings.cases_subtitle }}</p>
    </div>

    <div class="ned-cases-grid">
      {% for block in section.blocks %}
        {% liquid
          assign case_key = block.id | replace: '_', '' | downcase
          assign model_source = block.settings.model_url | strip
          assign image_source = block.settings.image_url | strip
          assign model_url = ''
          assign image_url = ''

          if model_source contains '://'
            assign model_url = model_source
          elsif model_source != blank
            assign model_url = model_source | file_url
          endif

          if image_source contains '://'
            assign image_url = image_source
          elsif image_source != blank
            assign image_url = image_source | file_url
          endif
        %}

        <article class="ned-case-card ned-case-card--{{ block.settings.layout }}" {{ block.shopify_attributes }}>
          <div class="ned-case-media">
            {% if block.settings.show_model and model_url != blank %}
              <model-viewer
                id="ned-case-model-{{ section_key }}-{{ case_key }}"
                src="{{ model_url }}"
                alt="{{ block.settings.model_alt | escape }}"
                {% if image_url != blank %}poster="{{ image_url }}"{% endif %}
                data-auto-rotate="{{ block.settings.auto_rotate }}"
                auto-rotate-delay="500"
                rotation-per-second="{{ block.settings.rotation_speed }}deg"
                camera-controls
                touch-action="pan-y"
                shadow-intensity="{{ block.settings.shadow_intensity }}"
                exposure="{{ block.settings.exposure }}"
                environment-image="{{ block.settings.environment_image }}"
                interaction-prompt="none"
                camera-orbit="{{ block.settings.camera_orbit }}">
              </model-viewer>
              <span class="ned-case-media-label">{{ block.settings.model_label }}</span>
            {% elsif image_url != blank %}
              <img
                src="{{ image_url }}"
                alt="{{ block.settings.image_alt | escape }}"
                width="1200"
                height="900"
                loading="lazy"
                decoding="async"
                sizes="(max-width: 900px) 100vw, 50vw">
            {% else %}
              <div class="ned-case-placeholder">
                <span>{{ block.settings.placeholder_label }}</span>
              </div>
            {% endif %}
          </div>

          <div class="ned-case-content">
            <div class="ned-case-topline">
              <span>{{ block.settings.case_type }}</span>
              <span>{{ block.settings.case_year }}</span>
            </div>

            <h2>{{ block.settings.case_title }}</h2>

            {% if block.settings.case_summary != blank %}
              <p class="ned-case-summary">{{ block.settings.case_summary }}</p>
            {% endif %}

            {% if block.settings.thinking_text != blank %}
              <div class="ned-case-thinking">
                <span>{{ block.settings.thinking_label }}</span>
                <p>{{ block.settings.thinking_text }}</p>
              </div>
            {% endif %}

            <div class="ned-case-details">
              <div>
                <span>{{ block.settings.detail_1_label }}</span>
                <p>{{ block.settings.detail_1_text }}</p>
              </div>
              <div>
                <span>{{ block.settings.detail_2_label }}</span>
                <p>{{ block.settings.detail_2_text }}</p>
              </div>
            </div>
          </div>
        </article>
      {% endfor %}
    </div>

    <div class="ned-cases-stack">
      <div>
        <span>{{ section.settings.stack_1_label }}</span>
        <p>{{ section.settings.stack_1_text }}</p>
      </div>
      <div>
        <span>{{ section.settings.stack_2_label }}</span>
        <p>{{ section.settings.stack_2_text }}</p>
      </div>
      <div>
        <span>{{ section.settings.stack_3_label }}</span>
        <p>{{ section.settings.stack_3_text }}</p>
      </div>
    </div>
  </div>
</section>

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  .ned-cases-{{ section_key }} {
    --ned-navy: {{ section.settings.background_color }};
    --ned-black: {{ section.settings.deep_background_color }};
    --ned-gold: {{ section.settings.accent_color }};
    --ned-metal: {{ section.settings.secondary_accent_color }};
    --ned-cream: {{ section.settings.soft_color }};
    --ned-white: {{ section.settings.text_color }};
    --ned-muted: {{ section.settings.muted_text_color }};
    --ned-card: {{ section.settings.card_background_color | color_modify: 'alpha', 0.12 }};
    --ned-media-bg: {{ section.settings.media_background_color }};
    --ned-heading-font: {{ heading_font.family | json }}, {{ heading_font.fallback_families }};
    --ned-body-font: {{ body_font.family | json }}, {{ body_font.fallback_families }};

    background:
      radial-gradient(circle at 18% 0%, {{ section.settings.accent_color | color_modify: 'alpha', 0.18 }}, transparent 34%),
      linear-gradient(180deg, {{ section.settings.background_color | color_modify: 'alpha', 0.98 }}, {{ section.settings.deep_background_color }});
    color: var(--ned-white);
    font-family: var(--ned-body-font);
    padding: clamp(48px, 7vw, 72px) 20px clamp(64px, 8vw, 96px);
  }

  .ned-cases-{{ section_key }} * {
    box-sizing: border-box;
  }

  .ned-cases-shell {
    width: min(1220px, 100%);
    margin: 0 auto;
  }

  .ned-cases-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 410px);
    gap: 34px;
    align-items: stretch;
    border-bottom: 1px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.46 }};
    padding-bottom: 42px;
  }

  .ned-cases-kicker,
  .ned-cases-heading span,
  .ned-case-topline,
  .ned-case-thinking span,
  .ned-case-details span,
  .ned-cases-stack span,
  .ned-cases-process span,
  .ned-case-media-label,
  .ned-cases-manifesto span {
    color: var(--ned-metal);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.16em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .ned-cases-hero h1 {
    max-width: 850px;
    margin: 16px 0 0;
    color: var(--ned-white);
    font-family: var(--ned-heading-font);
    font-size: clamp(48px, 8vw, 112px);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.88;
    text-transform: uppercase;
  }

  .ned-cases-intro {
    max-width: 720px;
    margin-top: 26px;
    color: var(--ned-muted);
    font-size: 18px;
    line-height: 1.65;
  }

  .ned-cases-intro p {
    margin: 0;
  }

  .ned-cases-manifesto {
    display: grid;
    align-content: end;
    min-height: 280px;
    border: 1px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.42 }};
    background:
      linear-gradient(135deg, {{ section.settings.accent_color | color_modify: 'alpha', 0.14 }}, transparent 44%),
      {{ section.settings.card_background_color | color_modify: 'alpha', 0.10 }};
    padding: 26px;
  }

  .ned-cases-manifesto p {
    margin: 16px 0 0;
    color: var(--ned-white);
    font-family: var(--ned-heading-font);
    font-size: 23px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.15;
  }

  .ned-cases-process {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-bottom: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.12 }};
    margin: 0 0 46px;
  }

  .ned-cases-process div {
    min-height: 138px;
    border-right: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.12 }};
    padding: 22px 18px;
  }

  .ned-cases-process div:last-child {
    border-right: 0;
  }

  .ned-cases-process p {
    margin: 22px 0 0;
    color: var(--ned-white);
    font-size: 15px;
    font-weight: 800;
    line-height: 1.35;
  }

  .ned-cases-heading {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: end;
    margin-bottom: 22px;
  }

  .ned-cases-heading p {
    max-width: 500px;
    margin: 0;
    color: var(--ned-muted);
    font-size: 14px;
    line-height: 1.55;
    text-align: right;
  }

  .ned-cases-grid {
    display: grid;
    gap: 28px;
  }

  .ned-case-card {
    display: grid;
    grid-template-columns: minmax(360px, 0.95fr) minmax(0, 1.05fr);
    min-height: 560px;
    overflow: hidden;
    border: 1px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.3 }};
    background: var(--ned-card);
    box-shadow: 0 30px 90px {{ section.settings.deep_background_color | color_modify: 'alpha', 0.3 }};
  }

  .ned-case-card:nth-child(even) {
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
  }

  .ned-case-card:nth-child(even) .ned-case-media {
    order: 2;
  }

  .ned-case-card:nth-child(even) .ned-case-content {
    order: 1;
  }

  .ned-case-card--compact {
    grid-template-columns: minmax(300px, 0.78fr) minmax(0, 1.22fr);
    min-height: 460px;
  }

  .ned-case-media {
    position: relative;
    min-height: 520px;
    background:
      linear-gradient(135deg, {{ section.settings.accent_color | color_modify: 'alpha', 0.16 }}, transparent 46%),
      var(--ned-media-bg);
  }

  .ned-case-media model-viewer,
  .ned-case-media img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 520px;
  }

  .ned-case-media img {
    object-fit: cover;
  }

  .ned-case-media model-viewer {
    --progress-bar-color: var(--ned-gold);
    --progress-bar-height: 3px;
  }

  .ned-case-media-label {
    position: absolute;
    left: 18px;
    top: 18px;
    border-left: 3px solid var(--ned-gold);
    background: {{ section.settings.deep_background_color | color_modify: 'alpha', 0.78 }};
    color: var(--ned-white);
    padding: 8px 11px;
  }

  .ned-case-placeholder {
    display: grid;
    min-height: 520px;
    place-items: center;
    background:
      linear-gradient(135deg, {{ section.settings.accent_color | color_modify: 'alpha', 0.13 }}, transparent 42%),
      var(--ned-media-bg);
  }

  .ned-case-placeholder span {
    border: 1px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.5 }};
    color: var(--ned-metal);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.16em;
    padding: 13px 16px;
    text-transform: uppercase;
  }

  .ned-case-content {
    display: grid;
    align-content: center;
    padding: clamp(30px, 5vw, 64px);
  }

  .ned-case-topline {
    display: flex;
    gap: 16px;
    justify-content: space-between;
    margin-bottom: 22px;
  }

  .ned-case-content h2 {
    margin: 0;
    color: var(--ned-white);
    font-family: var(--ned-heading-font);
    font-size: clamp(34px, 5vw, 64px);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .ned-case-summary {
    margin: 22px 0 0;
    color: var(--ned-muted);
    font-size: 17px;
    line-height: 1.65;
  }

  .ned-case-thinking {
    border-left: 3px solid var(--ned-gold);
    margin-top: 30px;
    padding-left: 18px;
  }

  .ned-case-thinking p {
    margin: 10px 0 0;
    color: var(--ned-white);
    font-family: var(--ned-heading-font);
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.28;
  }

  .ned-case-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 34px;
  }

  .ned-case-details div {
    border-top: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.18 }};
    padding-top: 14px;
  }

  .ned-case-details p {
    margin: 8px 0 0;
    color: var(--ned-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .ned-cases-stack {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 34px;
    background: {{ section.settings.accent_color | color_modify: 'alpha', 0.32 }};
    border: 1px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.32 }};
  }

  .ned-cases-stack div {
    background: {{ section.settings.deep_background_color | color_modify: 'alpha', 0.88 }};
    padding: 24px;
  }

  .ned-cases-stack p {
    margin: 12px 0 0;
    color: var(--ned-muted);
    font-size: 15px;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .ned-cases-{{ section_key }} {
      padding: 48px 14px 64px;
    }

    .ned-cases-hero,
    .ned-case-card,
    .ned-case-card:nth-child(even),
    .ned-case-card--compact,
    .ned-cases-stack {
      grid-template-columns: 1fr;
    }

    .ned-case-card:nth-child(even) .ned-case-media,
    .ned-case-card:nth-child(even) .ned-case-content {
      order: initial;
    }

    .ned-cases-process {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ned-cases-process div:nth-child(2) {
      border-right: 0;
    }

    .ned-cases-heading {
      display: block;
    }

    .ned-cases-heading p {
      margin-top: 10px;
      text-align: left;
    }

    .ned-case-media,
    .ned-case-media model-viewer,
    .ned-case-media img,
    .ned-case-placeholder {
      min-height: 360px;
    }

    .ned-case-details {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .ned-cases-process {
      grid-template-columns: 1fr;
    }

    .ned-cases-process div,
    .ned-cases-process div:nth-child(2) {
      border-right: 0;
      border-bottom: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.12 }};
    }

    .ned-cases-process div:last-child {
      border-bottom: 0;
    }
  }
</style>

<script>
  (function() {
    function loadModelViewerScript() {
      if (customElements.get('model-viewer') || document.querySelector('script[data-ned-case-model-viewer-script]')) return;

      var script = document.createElement('script');
      script.type = 'module';
      script.src = 'https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js';
      script.setAttribute('data-ned-case-model-viewer-script', 'true');
      document.head.appendChild(script);
    }

    function initNedCases() {
      var section = document.querySelector('.ned-cases-{{ section_key }}');
      if (!section) return;

      loadModelViewerScript();

      section.querySelectorAll('model-viewer').forEach(function(model) {
        if (model.dataset.nedCaseReady === 'true') return;
        model.dataset.nedCaseReady = 'true';

        if (model.dataset.autoRotate === 'true') {
          model.setAttribute('auto-rotate', '');
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNedCases);
    } else {
      initNedCases();
    }

    document.addEventListener('shopify:section:load', initNedCases);
  })();
</script>

