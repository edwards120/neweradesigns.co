{% comment %}
  New Era Designs – Cases Page (Clean, Human + Metrics)
{% endcomment %}

{% liquid
  assign section_key = section.id | replace: '_', '' | downcase
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
%}

<section class="ned-cases ned-cases-{{ section_key }}">
  <div class="ned-cases-shell">
    <!-- Hero -->
    <div class="ned-cases-hero">
      <div class="ned-cases-hero-copy">
        {% if section.settings.eyebrow != blank %}
          <span class="ned-cases-kicker">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.title != blank %}
          <h1>{{ section.settings.title }}</h1>
        {% endif %}
        {% if section.settings.intro != blank %}
          <div class="ned-cases-intro rte">{{ section.settings.intro }}</div>
        {% endif %}
      </div>
      <div class="ned-cases-manifesto">
        {% if section.settings.manifesto_label != blank %}
          <span>{{ section.settings.manifesto_label }}</span>
        {% endif %}
        {% if section.settings.manifesto_text != blank %}
          <p>{{ section.settings.manifesto_text }}</p>
        {% endif %}
      </div>
    </div>

    <!-- Billboard -->
    {% if section.settings.show_billboard %}
      <div class="ned-cases-billboard" aria-label="{{ section.settings.billboard_alt | escape }}">
        <div class="ned-cases-billboard__face">
          {% if section.settings.billboard_image != blank %}
            {{ section.settings.billboard_image | image_url: width: 1800 | image_tag: widths: '720, 1080, 1440, 1800', sizes: '(max-width: 900px) 94vw, 1180px', loading: 'lazy', alt: section.settings.billboard_alt }}
          {% endif %}
          <div class="ned-cases-billboard__wash"></div>
          <span class="ned-cases-billboard__kicker">{{ section.settings.billboard_kicker }}</span>
          <div class="ned-cases-billboard__message">
            <strong>{{ section.settings.billboard_heading }}</strong>
            <em>{{ section.settings.billboard_script }}</em>
          </div>
          <p>{{ section.settings.billboard_caption }}</p>
          <span class="ned-cases-billboard__dimension" aria-hidden="true">← 48'-0\" / HIGH-VISIBILITY FACE →</span>
        </div>
        <div class="ned-cases-billboard__post ned-cases-billboard__post--left" aria-hidden="true"></div>
        <div class="ned-cases-billboard__post ned-cases-billboard__post--right" aria-hidden="true"></div>
      </div>
    {% endif %}

    <!-- Studio metrics – now at top -->
    <section class="ned-studio-metrics">
      <header>
        <span>{{ section.settings.metrics_kicker }}</span>
        <h2>{{ section.settings.metrics_heading }}</h2>
        <p>{{ section.settings.metrics_intro }}</p>
      </header>
      <div class="ned-studio-metrics__grid">
        <div class="ned-metric">
          <span class="ned-metric__number">{{ section.settings.metric_1_number }}</span>
          <span class="ned-metric__label">{{ section.settings.metric_1_label }}</span>
        </div>
        <div class="ned-metric">
          <span class="ned-metric__number">{{ section.settings.metric_2_number }}</span>
          <span class="ned-metric__label">{{ section.settings.metric_2_label }}</span>
        </div>
        <div class="ned-metric">
          <span class="ned-metric__number">{{ section.settings.metric_3_number }}</span>
          <span class="ned-metric__label">{{ section.settings.metric_3_label }}</span>
        </div>
        <div class="ned-metric">
          <span class="ned-metric__number">{{ section.settings.metric_4_number }}</span>
          <span class="ned-metric__label">{{ section.settings.metric_4_label }}</span>
        </div>
      </div>
    </section>

    <!-- Process steps -->
    <div class="ned-cases-process" aria-label="Design process">
      <div><span>01</span><p>{{ section.settings.process_1 }}</p></div>
      <div><span>02</span><p>{{ section.settings.process_2 }}</p></div>
      <div><span>03</span><p>{{ section.settings.process_3 }}</p></div>
      <div><span>04</span><p>{{ section.settings.process_4 }}</p></div>
    </div>

    <!-- Featured Work heading -->
    <div class="ned-cases-heading">
      <span>{{ section.settings.cases_label }}</span>
      <p>{{ section.settings.cases_subtitle }}</p>
    </div>

    <!-- Case grid -->
    <div class="ned-cases-grid">
      {% for block in section.blocks %}
        {% liquid
          assign case_key = block.id | replace: '_', '' | downcase
          assign model_source = block.settings.model_url | strip
          assign image_source = block.settings.image_url | strip
          assign model_url = ''
          assign image_url = ''

          if model_source contains '://'
            assign model_url = model_source
          elsif model_source != blank
            assign model_url = model_source | file_url
          endif

          if image_source contains '://'
            assign image_url = image_source
          elsif image_source != blank
            assign image_url = image_source | file_url
          endif
        %}

        {% assign rendered_summary = block.settings.case_summary | escape %}
        {% assign summary_highlight = block.settings.summary_highlight | strip | escape %}
        {% if summary_highlight != blank %}
          {% capture summary_mark %}<mark>{{ summary_highlight }}</mark>{% endcapture %}
          {% assign rendered_summary = rendered_summary | replace_first: summary_highlight, summary_mark %}
        {% endif %}

        {% assign rendered_thinking = block.settings.thinking_text | escape %}
        {% assign thinking_highlight = block.settings.thinking_highlight | strip | escape %}
        {% if thinking_highlight != blank %}
          {% capture thinking_mark %}<mark>{{ thinking_highlight }}</mark>{% endcapture %}
          {% assign rendered_thinking = rendered_thinking | replace_first: thinking_highlight, thinking_mark %}
        {% endif %}

        <article class="ned-case-card ned-case-card--{{ block.settings.layout }}" data-aos="case-card" {{ block.shopify_attributes }}>
          <div class="ned-case-media">
            {% if block.settings.show_model and model_url != blank %}
              <model-viewer
                id="ned-case-model-{{ section_key }}-{{ case_key }}"
                src="{{ model_url }}"
                alt="{{ block.settings.model_alt | escape }}"
                {% if image_url != blank %}poster="{{ image_url }}"{% endif %}
                data-auto-rotate="{{ block.settings.auto_rotate }}"
                auto-rotate-delay="500"
                rotation-per-second="{{ block.settings.rotation_speed }}deg"
                camera-controls
                touch-action="pan-y"
                shadow-intensity="{{ block.settings.shadow_intensity }}"
                exposure="{{ block.settings.exposure }}"
                environment-image="{{ block.settings.environment_image }}"
                interaction-prompt="none"
                camera-orbit="{{ block.settings.camera_orbit }}">
              </model-viewer>
              <span class="ned-case-media-label">{{ block.settings.model_label }}</span>
            {% elsif image_url != blank %}
              <img
                src="{{ image_url }}"
                alt="{{ block.settings.image_alt | escape }}"
                width="1200"
                height="900"
                loading="lazy"
                decoding="async"
                sizes="(max-width: 900px) 100vw, 50vw">
            {% else %}
              <div class="ned-case-placeholder">
                <span>{{ block.settings.placeholder_label }}</span>
              </div>
            {% endif %}
          </div>

          <div class="ned-case-content">
            <div class="ned-case-topline">
              <span>{{ block.settings.case_type }}</span>
              <span>{{ block.settings.case_year }}</span>
            </div>

            {% if block.settings.case_location != blank %}
              <span class="ned-case-location">{{ block.settings.case_location }}</span>
            {% endif %}

            <h2>{{ block.settings.case_title }}</h2>

            {% if block.settings.case_summary != blank %}
              <p class="ned-case-summary">{{ rendered_summary }}</p>
            {% endif %}

            {% if block.settings.thinking_text != blank %}
              <div class="ned-case-thinking">
                <span>{{ block.settings.thinking_label }}</span>
                <p>{{ rendered_thinking }}</p>
              </div>
            {% endif %}

            {% if block.settings.case_metric != blank %}
              <div class="ned-case-metric">
                <span>{{ block.settings.case_metric }}</span>
              </div>
            {% endif %}

            <div class="ned-case-details">
              <div>
                <span>{{ block.settings.detail_1_label }}</span>
                <p>{{ block.settings.detail_1_text }}</p>
              </div>
              <div>
                <span>{{ block.settings.detail_2_label }}</span>
                <p>{{ block.settings.detail_2_text }}</p>
              </div>
            </div>
          </div>
        </article>
      {% endfor %}
    </div>

    <!-- Bottom cards -->
    <div class="ned-cases-stack">
      <div><span>{{ section.settings.stack_1_label }}</span><p>{{ section.settings.stack_1_text }}</p></div>
      <div><span>{{ section.settings.stack_2_label }}</span><p>{{ section.settings.stack_2_text }}</p></div>
      <div><span>{{ section.settings.stack_3_label }}</span><p>{{ section.settings.stack_3_text }}</p></div>
    </div>
  </div>
</section>

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  @font-face {
    font-family: 'EdwardianScript';
    src: url('{{ 'edwardianscript.woff2' | asset_url }}') format('woff2');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  .ned-cases-{{ section_key }} {
    --ned-navy: {{ section.settings.background_color }};
    --ned-black: {{ section.settings.deep_background_color }};
    --ned-gold: {{ section.settings.accent_color }};
    --ned-metal: {{ section.settings.secondary_accent_color }};
    --ned-cream: {{ section.settings.soft_color }};
    --ned-white: {{ section.settings.text_color }};
    --ned-muted: {{ section.settings.muted_text_color }};
    --ned-card: {{ section.settings.card_background_color | color_modify: 'alpha', 0.12 }};
    --ned-media-bg: {{ section.settings.media_background_color }};
    --ned-heading-font: {{ heading_font.family | json }}, {{ heading_font.fallback_families }};
    --ned-body-font: {{ body_font.family | json }}, {{ body_font.fallback_families }};

    background: linear-gradient(180deg, var(--ned-navy), var(--ned-black));
    color: var(--ned-white);
    font-family: var(--ned-body-font);
    padding: clamp(40px, 6vw, 64px) 20px clamp(64px, 8vw, 96px);
  }

  .ned-cases-{{ section_key }} * { box-sizing: border-box; }
  .ned-cases-shell { width: min(1220px, 100%); margin: 0 auto; }

  /* Hero */
  .ned-cases-hero {
    display: grid;
    grid-template-columns: 1fr minmax(260px, 380px);
    gap: 34px;
    align-items: stretch;
    border-bottom: 1px solid rgba(198,150,46,0.35);
    padding-bottom: 44px;
  }

  .ned-cases-kicker,
  .ned-cases-heading span,
  .ned-case-topline,
  .ned-case-thinking span,
  .ned-case-details span,
  .ned-cases-stack span,
  .ned-cases-process span,
  .ned-case-media-label,
  .ned-cases-manifesto span,
  .ned-studio-metrics header > span,
  .ned-case-location {
    color: var(--ned-metal);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ned-cases-hero h1 {
    margin: 16px 0 0;
    color: var(--ned-white);
    font-family: var(--ned-heading-font);
    font-size: clamp(48px, 8vw, 112px);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 0.88;
    text-transform: uppercase;
  }

  .ned-cases-intro {
    max-width: 680px;
    margin-top: 24px;
    color: var(--ned-muted);
    font-size: 18px;
    line-height: 1.6;
  }

  .ned-cases-manifesto {
    display: grid;
    align-content: end;
    min-height: 260px;
    border: 1px solid rgba(198,150,46,0.3);
    background: linear-gradient(135deg, rgba(198,150,46,0.08), transparent 44%);
    padding: 26px;
  }

  .ned-cases-manifesto p {
    margin: 16px 0 0;
    color: var(--ned-white);
    font-family: Georgia, serif;
    font-size: 22px;
    font-style: italic;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  /* Billboard */
  .ned-cases-billboard {
    display: grid;
    grid-template-columns: 12% 1fr 12%;
    margin: clamp(44px, 8vw, 90px) auto clamp(36px, 6vw, 70px);
    max-width: 1120px;
    perspective: 1200px;
  }

  .ned-cases-billboard__face {
    aspect-ratio: 2.55 / 1;
    background: var(--ned-cream);
    border: 10px solid var(--ned-black);
    color: var(--ned-black);
    display: grid;
    grid-column: 1 / -1;
    grid-row: 1;
    overflow: hidden;
    padding: clamp(18px, 4vw, 50px);
    position: relative;
    transform: rotateX(1deg) rotateY(-1.4deg);
    transition: transform 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
  }

  .ned-cases-billboard:hover .ned-cases-billboard__face { transform: rotateX(0) rotateY(0) translateY(-4px); }
  .ned-cases-billboard__face img { height: 100%; inset: 0; object-fit: cover; opacity: .28; position: absolute; width: 100%; }
  .ned-cases-billboard__wash { background: linear-gradient(90deg, var(--ned-cream) 0 43%, transparent 82%); inset: 0; position: absolute; }
  .ned-cases-billboard__kicker { font-size: 10px; font-weight: 900; letter-spacing: .18em; position: relative; text-transform: uppercase; z-index: 2; }
  .ned-cases-billboard__message { align-self: center; display: grid; position: relative; width: min(820px, 92%); z-index: 2; }
  .ned-cases-billboard__message strong { font-family: var(--ned-heading-font); font-size: clamp(42px, 8vw, 112px); font-weight: 900; letter-spacing: -.055em; line-height: .76; text-transform: uppercase; }
  .ned-cases-billboard__message em {
    font-family: 'EdwardianScript', cursive;
    font-weight: normal;
    font-style: normal;
    font-size: clamp(64px, 12vw, 160px);
    line-height: 0.5;
    color: var(--ned-gold);
    grid-column: 1;
    grid-row: 1;
    align-self: end;
    justify-self: end;
    margin-top: -0.2em;
    margin-right: -0.3em;
    animation: revealScript 1.8s cubic-bezier(0.25,0.1,0.25,1) 0.5s forwards;
    clip-path: inset(0 0 0 100%);
  }

  @keyframes revealScript { to { clip-path: inset(0 0 0 0); } }

  .ned-cases-billboard__face p { align-self: end; font-size: 12px; font-weight: 800; line-height: 1.35; margin: 0; max-width: 42ch; position: relative; z-index: 2; }
  .ned-cases-billboard__dimension { bottom: 10px; font-size: 8px; font-weight: 900; letter-spacing: .12em; position: absolute; right: 14px; z-index: 2; }
  .ned-cases-billboard__post { background: var(--ned-black); grid-row: 2; height: clamp(70px, 10vw, 132px); justify-self: center; width: clamp(18px, 2vw, 28px); }
  .ned-cases-billboard__post--left { grid-column: 1; }
  .ned-cases-billboard__post--right { grid-column: 3; }

  /* Metrics */
  .ned-studio-metrics {
    display: grid;
    gap: clamp(34px, 8vw, 80px);
    grid-template-columns: minmax(220px, .7fr) minmax(0, 1.3fr);
    margin: 0 0 clamp(58px, 9vw, 100px);
    border-bottom: 1px solid rgba(198,150,46,0.3);
    padding-bottom: clamp(34px, 5vw, 56px);
  }

  .ned-studio-metrics h2 {
    color: var(--ned-white);
    font-family: var(--ned-heading-font);
    font-size: clamp(42px, 6vw, 72px);
    font-weight: 900;
    letter-spacing: -.035em;
    line-height: .88;
    margin: 18px 0 0;
    text-transform: uppercase;
  }

  .ned-studio-metrics header p {
    color: var(--ned-muted);
    font-size: 15px;
    line-height: 1.55;
    margin: 20px 0 0;
    max-width: 38ch;
  }

  .ned-studio-metrics__grid { display: grid; gap: 32px; grid-template-columns: repeat(2, 1fr); align-content: center; }
  .ned-metric { border-bottom: 1px solid rgba(198,150,46,0.26); padding-bottom: 14px; }
  .ned-metric__number { font-family: var(--ned-heading-font); font-size: clamp(48px, 6vw, 84px); font-weight: 900; line-height: 0.9; color: var(--ned-white); letter-spacing: -0.02em; }
  .ned-metric__label { font-size: 11px; font-weight: 900; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ned-metal); }

  /* Process */
  .ned-cases-process { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid rgba(255,255,255,0.1); margin: 0 0 46px; }
  .ned-cases-process div { min-height: 120px; border-right: 1px solid rgba(255,255,255,0.1); padding: 22px 18px; }
  .ned-cases-process div:last-child { border-right: 0; }
  .ned-cases-process p { margin: 18px 0 0; color: var(--ned-white); font-size: 15px; font-weight: 800; line-height: 1.35; }

  .ned-cases-heading { display: flex; justify-content: space-between; gap: 24px; align-items: end; margin-bottom: 22px; }
  .ned-cases-heading p { max-width: 500px; margin: 0; color: var(--ned-muted); font-size: 14px; line-height: 1.55; text-align: right; }

  /* Cards */
  .ned-cases-grid { display: grid; gap: 28px; }
  .ned-case-card { display: grid; grid-template-columns: minmax(360px, 0.95fr) minmax(0, 1.05fr); min-height: 540px; overflow: hidden; border: 1px solid rgba(198,150,46,0.22); background: var(--ned-card); box-shadow: 0 30px 90px rgba(5,7,13,0.3); }
  .ned-case-card:nth-child(even) { grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr); }
  .ned-case-card:nth-child(even) .ned-case-media { order: 2; }
  .ned-case-card:nth-child(even) .ned-case-content { order: 1; }
  .ned-case-card--compact { grid-template-columns: minmax(300px, 0.78fr) minmax(0, 1.22fr); min-height: 460px; }

  .ned-case-media { position: relative; min-height: 520px; background: linear-gradient(135deg, rgba(198,150,46,0.08), transparent 46%), var(--ned-media-bg); }
  .ned-case-media model-viewer,
  .ned-case-media img { display: block; width: 100%; height: 100%; min-height: 520px; }
  .ned-case-media img { object-fit: cover; }
  .ned-case-media model-viewer { --progress-bar-color: var(--ned-gold); --progress-bar-height: 3px; }
  .ned-case-media-label { position: absolute; left: 18px; top: 18px; border-left: 3px solid var(--ned-gold); background: rgba(5,7,13,0.78); color: var(--ned-white); padding: 8px 11px; }
  .ned-case-placeholder { display: grid; min-height: 520px; place-items: center; background: linear-gradient(135deg, rgba(198,150,46,0.06), transparent 42%), var(--ned-media-bg); }
  .ned-case-placeholder span { border: 1px solid rgba(198,150,46,0.5); color: var(--ned-metal); font-size: 12px; font-weight: 900; letter-spacing: 0.16em; padding: 13px 16px; text-transform: uppercase; }

  .ned-case-content { display: grid; align-content: center; padding: clamp(30px, 5vw, 64px); }
  .ned-case-topline { display: flex; gap: 16px; justify-content: space-between; margin-bottom: 6px; }
  .ned-case-location { margin-bottom: 10px; display: block; }
  .ned-case-content h2 { margin: 0; color: var(--ned-white); font-family: var(--ned-heading-font); font-size: clamp(34px, 5vw, 64px); font-weight: 900; letter-spacing: -0.015em; line-height: 0.95; text-transform: uppercase; }
  .ned-case-summary { margin: 18px 0 0; color: var(--ned-muted); font-size: 17px; line-height: 1.65; }
  .ned-case-summary mark { background: var(--ned-gold); color: var(--ned-black); font-weight: 900; padding: 0.02em 0.16em; }
  .ned-case-thinking { border-left: 3px solid var(--ned-gold); margin-top: 28px; padding-left: 18px; }
  .ned-case-thinking p { margin: 10px 0 0; color: var(--ned-white); font-family: var(--ned-heading-font); font-size: 20px; font-weight: 800; line-height: 1.28; }
  .ned-case-thinking mark { background: var(--ned-gold); color: var(--ned-black); }
  .ned-case-metric { margin-top: 20px; font-size: 28px; font-weight: 900; color: var(--ned-gold); font-family: var(--ned-heading-font); letter-spacing: -0.02em; }
  .ned-case-details { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-top: 32px; }
  .ned-case-details div { border-top: 1px solid rgba(255,255,255,0.18); padding-top: 14px; }
  .ned-case-details p { margin: 8px 0 0; color: var(--ned-muted); font-size: 14px; line-height: 1.5; }

  /* Bottom cards */
  .ned-cases-stack { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-top: 34px; background: rgba(198,150,46,0.22); border: 1px solid rgba(198,150,46,0.22); }
  .ned-cases-stack div { background: rgba(5,7,13,0.88); padding: 24px; }
  .ned-cases-stack p { margin: 12px 0 0; color: var(--ned-muted); font-size: 15px; line-height: 1.55; }

  /* Responsive */
  @media (max-width: 900px) {
    .ned-cases-{{ section_key }} { padding: 40px 14px 64px; }
    .ned-cases-hero, .ned-case-card, .ned-case-card:nth-child(even), .ned-case-card--compact, .ned-cases-stack, .ned-studio-metrics { grid-template-columns: 1fr; }
    .ned-cases-billboard__face { aspect-ratio: 1.55 / 1; border-width: 7px; }
    .ned-cases-billboard__wash { background: linear-gradient(90deg, var(--ned-cream) 0 64%, transparent 100%); }
    .ned-case-card:nth-child(even) .ned-case-media, .ned-case-card:nth-child(even) .ned-case-content { order: initial; }
    .ned-cases-process { grid-template-columns: repeat(2, 1fr); }
    .ned-cases-process div:nth-child(2) { border-right: 0; }
    .ned-cases-heading { display: block; }
    .ned-cases-heading p { margin-top: 10px; text-align: left; }
    .ned-case-media, .ned-case-media model-viewer, .ned-case-media img, .ned-case-placeholder { min-height: 360px; }
    .ned-case-details { grid-template-columns: 1fr; }
    .ned-studio-metrics__grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 560px) {
    .ned-cases-process { grid-template-columns: 1fr; }
    .ned-cases-process div, .ned-cases-process div:nth-child(2) { border-right: 0; border-bottom: 1px solid rgba(255,255,255,0.12); }
    .ned-cases-process div:last-child { border-bottom: 0; }
    .ned-cases-billboard { grid-template-columns: 18% 1fr 18%; }
    .ned-cases-billboard__face { aspect-ratio: .9 / 1; padding: 24px 18px; }
    .ned-cases-billboard__message em { margin-right: 0; }
    .ned-cases-billboard__dimension { display: none; }
    .ned-studio-metrics__grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ned-cases-billboard__face { transition: none; }
    .ned-cases-billboard__message em { animation: none; clip-path: inset(0 0 0 0); }
  }
</style>

<script>
  (function() {
    function loadModelViewerScript() {
      if (customElements.get('model-viewer') || document.querySelector('script[data-ned-case-model-viewer-script]')) return;
      var script = document.createElement('script');
      script.type = 'module';
      script.src = 'https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js';
      script.setAttribute('data-ned-case-model-viewer-script', 'true');
      document.head.appendChild(script);
    }

    function initNedCases() {
      var section = document.querySelector('.ned-cases-{{ section_key }}');
      if (!section) return;
      loadModelViewerScript();
      section.querySelectorAll('model-viewer').forEach(function(model) {
        if (model.dataset.nedCaseReady === 'true') return;
        model.dataset.nedCaseReady = 'true';
        if (model.dataset.autoRotate === 'true') model.setAttribute('auto-rotate', '');
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNedCases);
    } else {
      initNedCases();
    }
    document.addEventListener('shopify:section:load', initNedCases);
  })();
</script>

