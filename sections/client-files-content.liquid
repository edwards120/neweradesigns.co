<script>
  (function() {
    function loadModelViewerScript() {
      if (customElements.get('model-viewer') || document.querySelector('script[data-ned-model-viewer-script]')) return;

      var script = document.createElement('script');
      script.type = 'module';
      script.src = 'https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js';
      script.setAttribute('data-ned-model-viewer-script', 'true');
      document.head.appendChild(script);
    }

    function normalizePdfUrl(url) {
      if (!url) return '';
      if (url.indexOf('//') === 0) return window.location.protocol + url;
      return url;
    }

    function loadPdfJsScript(callback) {
      if (window.pdfjsLib) {
        callback();
        return;
      }

      var existingScript = document.querySelector('script[data-ned-pdfjs-script]');

      if (existingScript) {
        existingScript.addEventListener('load', callback, { once: true });
        return;
      }

      var script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
      script.setAttribute('data-ned-pdfjs-script', 'true');
      script.addEventListener('load', callback, { once: true });
      document.head.appendChild(script);
    }

    function renderPdfViewer(viewer) {
      if (viewer.dataset.nedPdfReady === 'true') return;
      viewer.dataset.nedPdfReady = 'true';

      var pdfUrl = normalizePdfUrl(viewer.dataset.pdfUrl || '');
      var label = viewer.dataset.pdfLabel || 'PDF preview';

      if (!pdfUrl) {
        viewer.innerHTML = '<div class="ned-pdf-error">PDF unavailable</div>';
        return;
      }

      loadPdfJsScript(function() {
        if (!window.pdfjsLib) {
          viewer.innerHTML = '<div class="ned-pdf-error">PDF viewer unavailable</div>';
          return;
        }

        window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

        var loadingTask = window.pdfjsLib.getDocument({
          url: pdfUrl,
          withCredentials: false
        });

        loadingTask.promise.then(function(pdf) {
          var pageLimit = Math.min(pdf.numPages, {{ section.settings.pdf_page_limit }});
          viewer.innerHTML = '';

          function renderPage(pageNumber) {
            return pdf.getPage(pageNumber).then(function(page) {
              var viewport = page.getViewport({ scale: 1 });
              var availableWidth = Math.max(viewer.clientWidth - 36, 260);
              var scale = availableWidth / viewport.width;
              var scaledViewport = page.getViewport({ scale: scale });
              var canvas = document.createElement('canvas');
              var context = canvas.getContext('2d');

              canvas.className = 'ned-pdf-page';
              canvas.setAttribute('aria-label', label + ' page ' + pageNumber);
              canvas.width = Math.floor(scaledViewport.width);
              canvas.height = Math.floor(scaledViewport.height);
              viewer.appendChild(canvas);

              return page.render({
                canvasContext: context,
                viewport: scaledViewport
              }).promise;
            });
          }

          var queue = Promise.resolve();
          for (var pageNumber = 1; pageNumber <= pageLimit; pageNumber += 1) {
            (function(currentPage) {
              queue = queue.then(function() {
                return renderPage(currentPage);
              });
            })(pageNumber);
          }
        }).catch(function() {
          viewer.innerHTML = '<div class="ned-pdf-error">PDF preview unavailable</div>';
        });
      });
    }

    function initNedClientPage() {
      var section = document.querySelector('.ned-client-page-{{ section_key }}');
      if (!section) return;

      loadModelViewerScript();

      section.querySelectorAll('[data-ned-pdf-viewer]').forEach(renderPdfViewer);

      section.querySelectorAll('[data-ned-model-viewer]').forEach(function(frame) {
        if (frame.dataset.nedReady === 'true') return;
        frame.dataset.nedReady = 'true';

        var model = frame.querySelector('model-viewer');
        var loading = frame.querySelector('.ned-model-loading');
        var rotateButton = frame.querySelector('[data-ned-action="rotate"]');
        var initialOrbit = model ? model.getAttribute('camera-orbit') || '0deg 75deg 70%' : '0deg 75deg 70%';
        var isRotating = model ? model.dataset.autoRotate === 'true' : false;

        if (!model) return;
        if (isRotating) model.setAttribute('auto-rotate', '');
        if (rotateButton && isRotating) rotateButton.classList.add('is-active');

        model.addEventListener('load', function() {
          if (loading) loading.style.display = 'none';
        });

        model.addEventListener('error', function() {
          if (loading) loading.textContent = 'Model unavailable';
        });

        frame.querySelectorAll('[data-ned-action]').forEach(function(button) {
          button.addEventListener('click', function() {
            var action = button.getAttribute('data-ned-action');
            var orbit = model.getCameraOrbit ? model.getCameraOrbit() : null;

            if (action === 'rotate') {
              isRotating = !isRotating;
              if (isRotating) {
                model.setAttribute('auto-rotate', '');
                button.classList.add('is-active');
              } else {
                model.removeAttribute('auto-rotate');
                button.classList.remove('is-active');
              }
            }

            if (action === 'zoom-in' && orbit) {
              model.cameraOrbit = orbit.theta + 'rad ' + orbit.phi + 'rad ' + (orbit.radius * 0.85) + 'm';
            }

            if (action === 'zoom-out' && orbit) {
              model.cameraOrbit = orbit.theta + 'rad ' + orbit.phi + 'rad ' + (orbit.radius * 1.15) + 'm';
            }

            if (action === 'reset') {
              model.cameraOrbit = initialOrbit;
              model.cameraTarget = 'auto auto auto';
              if (model.resetTurntableRotation) model.resetTurntableRotation();
            }
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNedClientPage);
    } else {
      initNedClientPage();
    }

    document.addEventListener('shopify:section:load', initNedClientPage);
  })();
</script>

