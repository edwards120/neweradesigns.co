{% comment %}
  New Era Designs - Client Files Page
  Combines confidential PDF previews with optional interactive 3D model viewers.
{% endcomment %}

{% liquid
  assign section_key = section.id | replace: '_', '' | downcase
  assign feature_video_source = section.settings.feature_video_url | strip
  assign feature_video_poster_source = section.settings.feature_video_poster_url | strip
  assign feature_video_url = ''
  assign feature_video_poster_url = ''
  assign feature_video_poster_url_escaped = ''
  assign feature_video_poster_attr = ''
  assign feature_video_controls_attr = ''
  assign feature_video_autoplay_attr = ''
  assign feature_video_loop_attr = ''

  if feature_video_source contains '://'
    assign feature_video_url = feature_video_source
  elsif feature_video_source != blank
    assign feature_video_url = feature_video_source | file_url
  endif

  if feature_video_poster_source contains '://'
    assign feature_video_poster_url = feature_video_poster_source
  elsif feature_video_poster_source != blank
    assign feature_video_poster_url = feature_video_poster_source | file_url
  endif

  if feature_video_poster_url != blank
    assign feature_video_poster_url_escaped = feature_video_poster_url | escape
    assign feature_video_poster_attr = 'poster="' | append: feature_video_poster_url_escaped | append: '"'
  endif

  if section.settings.feature_video_controls
    assign feature_video_controls_attr = 'controls'
  endif

  if section.settings.feature_video_autoplay
    assign feature_video_autoplay_attr = 'autoplay muted'
  endif

  if section.settings.feature_video_loop
    assign feature_video_loop_attr = 'loop'
  endif
%}
{% comment %}
  Keep the access gate active on the storefront, but disable it inside
  Shopify's theme editor so the editor preview is not redirected to a 404.
{% endcomment %}
{% unless request.design_mode %}
  <style>
    html.ned-client-locked body {
      visibility: hidden;
    }
  </style>

  <script>
    (function () {
      var COOKIE_NAME = 'ned_projects_access';
      var GATE_URL = '/pages/client-login';

      document.documentElement.classList.add('ned-client-locked');

      function getCookie(name) {
        var nameEQ = name + '=';
        var cookies = document.cookie.split(';');

        for (var i = 0; i < cookies.length; i++) {
          var cookie = cookies[i].trim();

          if (cookie.indexOf(nameEQ) === 0) {
            return decodeURIComponent(cookie.substring(nameEQ.length));
          }
        }

        return null;
      }

      if (getCookie(COOKIE_NAME) !== 'granted') {
        window.location.replace(GATE_URL);
        return;
      }

      document.documentElement.classList.remove('ned-client-locked');
    })();
  </script>
{% endunless %}

<section class="ned-client-page ned-client-page-{{ section_key }}">
  <div class="ned-client-shell">
    <header class="ned-client-header">
      <div>
        <span class="ned-client-kicker">{{ section.settings.brand_label }}</span>
        <span class="ned-client-subtitle">{{ section.settings.header_subtitle }}</span>
      </div>

      {% if section.settings.back_link != blank %}
        <a href="{{ section.settings.back_link }}" class="ned-client-back" aria-label="Back to gate">
          <span aria-hidden="true">&larr;</span>
          <span>{{ section.settings.back_label }}</span>
        </a>
      {% endif %}
    </header>

    <div class="ned-client-hero">
      <div class="ned-client-hero-copy">
        <span class="ned-client-eyebrow">{{ section.settings.eyebrow }}</span>
        <h1>{{ section.settings.title }}</h1>
        {% if section.settings.description != blank %}
          <p>{{ section.settings.description }}</p>
        {% endif %}
      </div>

      <div class="ned-client-hero-panel" aria-label="Project archive summary">
        {% if section.blocks.size > 0 %}
          <span>{{ section.blocks.size }}</span>
        {% else %}
          <span>3</span>
        {% endif %}
        <p>{{ section.settings.archive_label }}</p>
      </div>
    </div>

    <div class="ned-client-meta" aria-label="Project metadata">
      <span>Confidential</span>
      <span>{{ section.settings.brand_label }}</span>
      <span>{{ 'now' | date: '%Y' }}</span>
    </div>

    {% if section.settings.show_feature_video and feature_video_url != blank %}
      <div class="ned-feature-video">
        <div class="ned-feature-video-copy">
          {% if section.settings.feature_video_label != blank %}
            <span>{{ section.settings.feature_video_label }}</span>
          {% endif %}
          {% if section.settings.feature_video_heading != blank %}
            <h2>{{ section.settings.feature_video_heading }}</h2>
          {% endif %}
          {% if section.settings.feature_video_text != blank %}
            <p>{{ section.settings.feature_video_text }}</p>
          {% endif %}
        </div>

        <div class="ned-feature-video-frame">
          <video
            src="{{ feature_video_url | escape }}"
            {{ feature_video_poster_attr }}
            {{ feature_video_controls_attr }}
            {{ feature_video_autoplay_attr }}
            {{ feature_video_loop_attr }}
            playsinline
            preload="metadata"
            controlsList="nodownload">
          </video>
        </div>
      </div>
    {% endif %}

    <div class="ned-client-section-heading">
      <div>
        <span>{{ section.settings.section_title }}</span>
        <p>{{ section.settings.section_subtitle }}</p>
      </div>
    </div>

    <div class="ned-project-grid">
      {% for block in section.blocks %}
        {% liquid
          assign project_key = block.id | replace: '_', '' | downcase
          assign pdf_source = block.settings.pdf_url | strip
          assign model_source = block.settings.model_url | strip
          assign poster_source = block.settings.poster_url | strip
          assign process_video_source = block.settings.process_video_url | strip
          assign process_video_poster_source = block.settings.process_video_poster_url | strip
          assign pdf_url = ''
          assign model_url = ''
          assign poster_url = ''
          assign process_video_url = ''
          assign process_video_poster_url = ''

          if pdf_source contains '://'
            assign pdf_url = pdf_source
          elsif pdf_source != blank
            assign pdf_url = pdf_source | file_url
          endif

          if model_source contains '://'
            assign model_url = model_source
          elsif model_source != blank
            assign model_url = model_source | file_url
          endif

          if poster_source contains '://'
            assign poster_url = poster_source
          elsif poster_source != blank
            assign poster_url = poster_source | file_url
          endif

          if process_video_source contains '://'
            assign process_video_url = process_video_source
          elsif process_video_source != blank
            assign process_video_url = process_video_source | file_url
          endif

          if process_video_poster_source contains '://'
            assign process_video_poster_url = process_video_poster_source
          elsif process_video_poster_source != blank
            assign process_video_poster_url = process_video_poster_source | file_url
          endif
        %}

        <article class="ned-project-card" {{ block.shopify_attributes }}>
          <div class="ned-project-topline">
            <div class="ned-project-heading-copy">
              <span class="ned-project-number">0{{ forloop.index }}</span>
              <div class="ned-project-title-row">
                <h2>{{ block.settings.project_title }}</h2>
                <span class="ned-project-pill">{{ block.settings.project_type }}</span>
              </div>
              {% if block.settings.project_subtitle != blank %}
                <div class="ned-project-description">
                  <span class="ned-project-description-label">Project overview</span>
                  <p>{{ block.settings.project_subtitle | escape | newline_to_br }}</p>
                </div>
              {% endif %}
            </div>
          </div>

          {% if process_video_url != blank %}
            <div class="ned-process-video">
              <div class="ned-process-video-copy">
                <span>{{ block.settings.process_video_label }}</span>
                <h3>{{ block.settings.process_video_heading }}</h3>
              </div>
              <div class="ned-process-video-frame">
                <video
                  src="{{ process_video_url | escape }}"
                  {% if process_video_poster_url != blank %}poster="{{ process_video_poster_url | escape }}"{% endif %}
                  controls
                  playsinline
                  preload="metadata"
                  controlsList="nodownload">
                </video>
              </div>
            </div>
          {% endif %}

          {% if model_url != blank %}
            <div class="ned-model-frame" data-ned-model-viewer>
              {% if block.settings.model_label != blank %}
                <div class="ned-model-label">{{ block.settings.model_label }}</div>
              {% endif %}

              <div class="ned-model-loading">Loading 3D Model</div>

              <model-viewer
                id="ned-model-{{ section_key }}-{{ project_key }}"
                src="{{ model_url }}"
                poster="{{ poster_url }}"
                alt="{{ block.settings.model_alt | escape }}"
                data-auto-rotate="{{ block.settings.auto_rotate }}"
                auto-rotate-delay="500"
                rotation-per-second="{{ block.settings.rotation_speed }}deg"
                camera-controls
                touch-action="pan-y"
                shadow-intensity="{{ block.settings.shadow_intensity }}"
                shadow-softness="0.72"
                exposure="{{ block.settings.exposure }}"
                environment-image="{{ block.settings.environment_image }}"
                interaction-prompt="none"
                camera-orbit="{{ block.settings.camera_orbit }}"
                style="background-color: transparent;">
              </model-viewer>

              <div class="ned-model-controls" aria-label="3D model controls">
                <button type="button" class="ned-model-control" data-ned-action="rotate" aria-label="Toggle rotation" title="Toggle Auto-Rotate">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/></svg>
                </button>
                <button type="button" class="ned-model-control" data-ned-action="zoom-in" aria-label="Zoom in" title="Zoom In">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14zM12 10h-2v2H9v-2H7V9h2V7h1v2h2v1z"/></svg>
                </button>
                <button type="button" class="ned-model-control" data-ned-action="zoom-out" aria-label="Zoom out" title="Zoom Out">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14zM7 9h5v1H7z"/></svg>
                </button>
                <button type="button" class="ned-model-control" data-ned-action="reset" aria-label="Reset camera" title="Reset View">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/></svg>
                </button>
              </div>
            </div>
          {% endif %}

          {% if pdf_url != blank %}
            <div class="ned-pdf-panel">
              <div class="ned-pdf-bar">
                <span>{{ block.settings.pdf_label }}</span>
                <span class="ned-pdf-status">Preview Only</span>
              </div>

              <div
                class="ned-pdf-embed"
                data-ned-pdf-viewer
                data-pdf-url="{{ pdf_url | escape }}"
                data-pdf-label="{{ block.settings.project_title | escape }} PDF preview">
                <div class="ned-pdf-loading">Loading PDF preview</div>
              </div>
            </div>
          {% endif %}
        </article>
      {% endfor %}

      {% if section.blocks.size == 0 %}
        {% liquid
          assign fallback_rice_pdf = 'https://cdn.shopify.com/s/files/1/0914/0138/8337/files/00_2D_PROJECT_PROPSAL_Rice_Box.pdf?v=1779689421'
