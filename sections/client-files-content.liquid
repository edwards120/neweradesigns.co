            </div>
            <span class="ned-project-pill">PDF + 3D</span>
          </div>

          <div class="ned-model-frame" data-ned-model-viewer>
            <div class="ned-model-label">Interactive 3D Review</div>
            <div class="ned-model-loading">Loading 3D Model</div>
            <model-viewer
              id="ned-model-{{ section_key }}-fallback-rice"
              src="{{ fallback_rice_model }}"
              alt="Interactive Rice Box 3D model"
              data-auto-rotate="true"
              auto-rotate-delay="500"
              rotation-per-second="15deg"
              camera-controls
              touch-action="pan-y"
              shadow-intensity="1"
              shadow-softness="0.72"
              exposure="1"
              environment-image="neutral"
              interaction-prompt="none"
              camera-orbit="0deg 75deg 70%"
              style="background-color: transparent;">
            </model-viewer>

            <div class="ned-model-controls" aria-label="3D model controls">
              <button type="button" class="ned-model-control" data-ned-action="rotate" aria-label="Toggle rotation" title="Toggle Auto-Rotate">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/></svg>
