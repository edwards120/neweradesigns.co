              </button>
            </div>
          </div>

          <div class="ned-pdf-panel">
            <div class="ned-pdf-bar">
              <span>Design Presentation PDF</span>
              <span class="ned-pdf-status">Preview Only</span>
            </div>
            <div
              class="ned-pdf-embed"
              data-ned-pdf-viewer
              data-pdf-url="{{ fallback_rice_pdf | escape }}"
              data-pdf-label="Rice Box PDF preview">
              <div class="ned-pdf-loading">Loading PDF preview</div>
            </div>
          </div>
