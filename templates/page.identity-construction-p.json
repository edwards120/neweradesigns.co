        "ai_gen_block_fdb0f49_MHnwiT": {
          "type": "ai_gen_block_fdb0f49",
          "settings": {
            "background_image": "shopify://shop_images/logo_backgorund.svg",
            "background_opacity": 0,
            "background_color": "#ffffff",
            "content_width": 1400,
            "padding_top": 80,
            "padding_bottom": 80,
            "padding_horizontal": 40,
            "header_spacing": 40,
            "eyebrow": "Featured Story",
            "eyebrow_size": 12,
            "eyebrow_color": "#14213d",
            "heading": "The Art of Luxury Design",
            "heading_size": 48,
            "heading_color": "#fca311",
            "subheading": "<strong>New Era Designs</strong> builds the <em>infrastructure</em>. Identity Construction is the engineering phase where we take the approved creative direction and build the rigorous systems, rules, and assets that ensure your brand looks as expensive as the real estate it occupies",
            "subheading_size": 20,
            "subheading_color": "#666666",
            "body_text": "<p>In the world of high-end design, every detail matters. From the carefully curated color palettes to the precision of each element, luxury is found in the thoughtful execution of vision. This editorial explores the principles that define exceptional design and the stories behind the craft.</p>",
            "body_size": 20,
            "body_color": "#333333",
            "image_width": 100,
            "show_ball": true,
            "ball_size": 80,
            "ball_color": "#fca311",
