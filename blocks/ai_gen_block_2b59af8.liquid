{% doc %}
  @prompt
    Start a Project, create a project intake form for Design Projects, project type, timeline, budget range response time, next steps, have it be abatable to screen size and background image available 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-project-intake-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    min-height: 500px;
    overflow: hidden;
  }

  .ai-project-intake-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .ai-project-intake-bg-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-project-intake-bg-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
  }

  .ai-project-intake-bg-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-project-intake-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .ai-project-intake-container-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    max-width: {{ block.settings.form_max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-project-intake-form-wrapper-{{ ai_gen_id }} {
    background-color: {{ block.settings.form_background }};
    border-radius: {{ block.settings.form_border_radius }}px;
    padding: {{ block.settings.form_padding }}px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .ai-project-intake-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 30px;
  }

  .ai-project-intake-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 10px;
    font-weight: 600;
  }

  .ai-project-intake-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
  }

  .ai-project-intake-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-project-intake-field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-project-intake-label-{{ ai_gen_id }} {
    color: {{ block.settings.label_color }};
    font-size: 14px;
    font-weight: 500;
  }

  .ai-project-intake-required-{{ ai_gen_id }} {
    color: #D82C0D;
  }

  .ai-project-intake-input-{{ ai_gen_id }},
  .ai-project-intake-select-{{ ai_gen_id }},
  .ai-project-intake-textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 14px;
    background-color: {{ block.settings.input_background }};
    color: {{ block.settings.input_text_color }};
    transition: border-color 0.3s ease;
  }

  .ai-project-intake-input-{{ ai_gen_id }}:focus,
  .ai-project-intake-select-{{ ai_gen_id }}:focus,
  .ai-project-intake-textarea-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_color }};
  }

  .ai-project-intake-textarea-{{ ai_gen_id }} {
    min-height: 100px;
    resize: vertical;
  }

  .ai-project-intake-select-{{ ai_gen_id }} {
    cursor: pointer;
  }

  .ai-project-intake-row-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .ai-project-intake-button-{{ ai_gen_id }} {
    padding: 16px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
    margin-top: 10px;
  }

  .ai-project-intake-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-project-intake-success-{{ ai_gen_id }} {
    color: #008060;
    background-color: #e8f5f1;
    padding: 12px 16px;
    border-radius: 4px;
    margin-bottom: 20px;
    text-align: center;
  }

  .ai-project-intake-error-{{ ai_gen_id }} {
    color: #D82C0D;
    background-color: #fef3f2;
    padding: 12px 16px;
    border-radius: 4px;
    margin-bottom: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-project-intake-container-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 16px;
    }

    .ai-project-intake-form-wrapper-{{ ai_gen_id }} {
      padding: {{ block.settings.form_padding | times: 0.7 }}px;
    }

    .ai-project-intake-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-project-intake-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-project-intake-row-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
{% endstyle %}

<project-intake-form-{{ ai_gen_id }} class="ai-project-intake-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-project-intake-bg-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-project-intake-bg-placeholder-{{ ai_gen_id }}">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-project-intake-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-project-intake-container-{{ ai_gen_id }}">
    <div class="ai-project-intake-form-wrapper-{{ ai_gen_id }}">
      <div class="ai-project-intake-header-{{ ai_gen_id }}">
        <h2 class="ai-project-intake-title-{{ ai_gen_id }}">{{ block.settings.form_title }}</h2>
        {% if block.settings.form_subtitle != blank %}
          <p class="ai-project-intake-subtitle-{{ ai_gen_id }}">{{ block.settings.form_subtitle }}</p>
        {% endif %}
      </div>

      {%- form 'contact' -%}
        <input type="hidden" name="contact[form_type]" value="project_intake">

        <div class="ai-project-intake-form-{{ ai_gen_id }}">
          {%- if form.posted_successfully? -%}
            <div class="ai-project-intake-success-{{ ai_gen_id }}">
              {{ block.settings.success_message }}
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="ai-project-intake-error-{{ ai_gen_id }}">
              {{ form.errors.messages | first }}
            </div>
          {%- endif -%}

          <div class="ai-project-intake-row-{{ ai_gen_id }}">
            <div class="ai-project-intake-field-{{ ai_gen_id }}">
              <label class="ai-project-intake-label-{{ ai_gen_id }}" for="contact-name-{{ ai_gen_id }}">
                Name <span class="ai-project-intake-required-{{ ai_gen_id }}">*</span>
              </label>
              <input
                type="text"
                id="contact-name-{{ ai_gen_id }}"
                name="contact[name]"
                class="ai-project-intake-input-{{ ai_gen_id }}"
                required
                autocomplete="name"
              >
            </div>

            <div class="ai-project-intake-field-{{ ai_gen_id }}">
              <label class="ai-project-intake-label-{{ ai_gen_id }}" for="contact-email-{{ ai_gen_id }}">
                Email <span class="ai-project-intake-required-{{ ai_gen_id }}">*</span>
              </label>
              <input
                type="email"
                id="contact-email-{{ ai_gen_id }}"
                name="contact[email]"
                class="ai-project-intake-input-{{ ai_gen_id }}"
                required
                autocomplete="email"
              >
            </div>
          </div>

          <div class="ai-project-intake-row-{{ ai_gen_id }}">
            <div class="ai-project-intake-field-{{ ai_gen_id }}">
              <label class="ai-project-intake-label-{{ ai_gen_id }}" for="contact-phone-{{ ai_gen_id }}">
                Phone
              </label>
              <input
                type="tel"
                id="contact-phone-{{ ai_gen_id }}"
                name="contact[phone]"
                class="ai-project-intake-input-{{ ai_gen_id }}"
                autocomplete="tel"
              >
            </div>

            <div class="ai-project-intake-field-{{ ai_gen_id }}">
              <label class="ai-project-intake-label-{{ ai_gen_id }}" for="contact-company-{{ ai_gen_id }}">
                Company
              </label>
              <input
                type="text"
                id="contact-company-{{ ai_gen_id }}"
                name="contact[company]"
                class="ai-project-intake-input-{{ ai_gen_id }}"
                autocomplete="organization"
              >
            </div>
          </div>

          <div class="ai-project-intake-field-{{ ai_gen_id }}">
            <label class="ai-project-intake-label-{{ ai_gen_id }}" for="contact-project-type-{{ ai_gen_id }}">
              Project Type <span class="ai-project-intake-required-{{ ai_gen_id }}">*</span>
            </label>
            <select
              id="contact-project-type-{{ ai_gen_id }}"
              name="contact[project_type]"
              class="ai-project-intake-select-{{ ai_gen_id }}"
              required
            >
              <option value="">Select a project type</option>
              <option value="Branding & Identity">Branding & Identity</option>
              <option value="Web Design/UI+UX Design">Web Design/UI+UX Design</option>
              <option value="Graphic Design">Graphic Design</option>
               <option value="Channel Letter Signage">Channel Letter Signage</option>
              <option value="Print + Poster Design">Print + Poster Design</option>
              <option value="Packaging Design">Packaging Design</option>
              <option value="Marketing Materials">Marketing Materials</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="ai-project-intake-row-{{ ai_gen_id }}">
            <div class="ai-project-intake-field-{{ ai_gen_id }}">
              <label class="ai-project-intake-label-{{ ai_gen_id }}" for="contact-timeline-{{ ai_gen_id }}">
                Timeline <span class="ai-project-intake-required-{{ ai_gen_id }}">*</span>
              </label>
              <select
                id="contact-timeline-{{ ai_gen_id }}"
                name="contact[timeline]"
                class="ai-project-intake-select-{{ ai_gen_id }}"
                required
              >
                <option value="">Select a timeline</option>
                <option value="ASAP (1-2 weeks)">ASAP (1-2 weeks)</option>
                <option value="1 Month">1 Month</option>
                <option value="2-3 Months">2-3 Months</option>
                <option value="3-6 Months">3-6 Months</option>
                <option value="6+ Months">6+ Months</option>
                <option value="Flexible">Flexible</option>
              </select>
            </div>

            <div class="ai-project-intake-field-{{ ai_gen_id }}">
              <label class="ai-project-intake-label-{{ ai_gen_id }}" for="contact-budget-{{ ai_gen_id }}">
                Budget Range <span class="ai-project-intake-required-{{ ai_gen_id }}">*</span>
              </label>
              <select
                id="contact-budget-{{ ai_gen_id }}"
                name="contact[budget_range]"
                class="ai-project-intake-select-{{ ai_gen_id }}"
                required
              >
                <option value="">Select a budget range</option>
                <option value="Under $1,000">Under $1,000</option>
                <option value="$1,000 - $2,500">$1,000 - $2,500</option>
                <option value="$2,500 - $5,000">$2,500 - $5,000</option>
                <option value="$5,000 - $10,000">$5,000 - $10,000</option>
                <option value="$10,000 - $25,000">$10,000 - $25,000</option>
                <option value="$25,000+">$25,000+</option>
              </select>
            </div>
          </div>

          <div class="ai-project-intake-field-{{ ai_gen_id }}">
            <label class="ai-project-intake-label-{{ ai_gen_id }}" for="contact-response-time-{{ ai_gen_id }}">
              Preferred Response Time
            </label>
            <select
              id="contact-response-time-{{ ai_gen_id }}"
              name="contact[response_time]"
              class="ai-project-intake-select-{{ ai_gen_id }}"
            >
              <option value="">Select preferred response time</option>
              <option value="Within 24 hours">Within 24 hours</option>
              <option value="Within 2-3 days">Within 2-3 days</option>
              <option value="Within a week">Within a week</option>
              <option value="No rush">No rush</option>
            </select>
          </div>

          <div class="ai-project-intake-field-{{ ai_gen_id }}">
            <label class="ai-project-intake-label-{{ ai_gen_id }}" for="contact-description-{{ ai_gen_id }}">
              Project Description <span class="ai-project-intake-required-{{ ai_gen_id }}">*</span>
            </label>
            <textarea
              id="contact-description-{{ ai_gen_id }}"
              name="contact[body]"
              class="ai-project-intake-textarea-{{ ai_gen_id }}"
              required
              placeholder="Tell us about your project, goals, and any specific requirements..."
            ></textarea>
          </div>

          <div class="ai-project-intake-field-{{ ai_gen_id }}">
            <label class="ai-project-intake-label-{{ ai_gen_id }}" for="contact-next-steps-{{ ai_gen_id }}">
              Next Steps
            </label>
            <textarea
              id="contact-next-steps-{{ ai_gen_id }}"
              name="contact[next_steps]"
              class="ai-project-intake-textarea-{{ ai_gen_id }}"
              placeholder="What would you like to happen after submitting this form? (e.g., schedule a call, receive a quote, etc.)"
            ></textarea>
          </div>

          <button type="submit" class="ai-project-intake-button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</project-intake-form-{{ ai_gen_id }}>

<script>
  (function() {
    class ProjectIntakeForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.form = this.querySelector('form');
        if (this.form) {
          this.form.addEventListener('submit', this.handleSubmit.bind(this));
        }
      }

      handleSubmit(event) {
        const requiredFields = this.form.querySelectorAll('[required]');
        let isValid = true;

        requiredFields.forEach(field => {
          if (!field.value.trim()) {
            isValid = false;
            field.style.borderColor = '#D82C0D';
          } else {
            field.style.borderColor = '';
          }
        });

        if (!isValid) {
          event.preventDefault();
        }
      }
    }

    customElements.define('project-intake-form-{{ ai_gen_id }}', ProjectIntakeForm{{ ai_gen_id }});
  })();
</script>

{% schema %}
