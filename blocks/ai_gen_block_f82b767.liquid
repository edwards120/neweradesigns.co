{% doc %}
  @prompt
    Build a full-width interactive section with a “bouncing balls” animation (NOT floating/drifting).
    Visual style: minimalist, editorial, luxury. Balls must be flat solid colors only (no gradients, no glow, no shadows, no 3D).
    Colors (only these):
    • Gold #FCA311
    • Deep Navy #16213A
    • Royal Blue #1B2E9D
    • Obsidian #0A1821
    Background options:
    • Allow an optional background image upload (cover, centered).
    • Allow an optional plain white background mode.
    • Add an adjustable dark overlay slider (0–70%) to keep text readable on photos.
    Animation behavior:
    • Create 6–12 balls that bounce within the section boundaries, colliding with the edges and changing direction naturally.
    • Motion should be smooth and “physical” (gravity + bounce), not slow float.
    • On click/tap, the balls should “burst” outward slightly, then continue bouncing.
    • On desktop hover, balls slightly react (small nudge), but primary interaction is click/tap.
    Content layer:
    • Center text overlay:
    GLOWING GOLD HEADLINE(IMPORTANT): “LUXURY IN MOTION.”
    Optional subtext under it (body paragraphs)
    • Ensure balls stay behind text and never block readability.
    Responsive height:
    • Desktop section min-height: 520–680px with a slider setting.
    • Mobile section min-height: 520–760px with a separate slider setting.
    • Keep animation responsive and recalculated on resize/orientation change.
    Performance & accessibility:
    • Optimize for mobile performance (requestAnimationFrame).
    • Respect “prefers-reduced-motion” (show static balls).
    • Do not use heavy video backgrounds.
    Settings/controls in the block:
    • Ball count slider (6–12)
    • Ball size range (small/medium/large)
    • Bounce energy slider (calm → energetic)
    • Desktop height slider + mobile height slider
    • Background image selector• Overlay opacity slider
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bouncing-balls-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #ffffff;
  }

  {% if block.settings.background_image %}
    .ai-bouncing-balls-{{ ai_gen_id }}::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: url('{{ block.settings.background_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      z-index: 1;
    }

    .ai-bouncing-balls-{{ ai_gen_id }}::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
      z-index: 2;
    }
  {% endif %}

  .ai-bouncing-balls-canvas-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
  }

  .ai-bouncing-balls-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 40px 20px;
    text-align: center;
    pointer-events: none;
  }

  .ai-bouncing-balls-headline-{{ ai_gen_id }} {
    font-size: 48px;
    font-weight: 700;
    color: #FCA311;
    margin: 0 0 16px;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .ai-bouncing-balls-subtext-{{ ai_gen_id }} {
    font-size: 18px;
    color: #ffffff;
    max-width: 600px;
    line-height: 1.6;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  @media screen and (min-width: 750px) {
    .ai-bouncing-balls-{{ ai_gen_id }} {
      min-height: {{ block.settings.desktop_height }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-bouncing-balls-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_height }}px;
    }

    .ai-bouncing-balls-headline-{{ ai_gen_id }} {
      font-size: 32px;
    }

    .ai-bouncing-balls-subtext-{{ ai_gen_id }} {
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-bouncing-balls-canvas-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<bouncing-balls-{{ ai_gen_id }}
  class="ai-bouncing-balls-{{ ai_gen_id }}"
  data-ball-count="{{ block.settings.ball_count }}"
  data-ball-size="{{ block.settings.ball_size }}"
  data-bounce-energy="{{ block.settings.bounce_energy }}"
  {{ block.shopify_attributes }}
>
  <canvas class="ai-bouncing-balls-canvas-{{ ai_gen_id }}"></canvas>
  
  <div class="ai-bouncing-balls-content-{{ ai_gen_id }}">
    <h1 class="ai-bouncing-balls-headline-{{ ai_gen_id }}">
      {{ block.settings.headline }}
    </h1>
    {% if block.settings.subtext != blank %}
      <div class="ai-bouncing-balls-subtext-{{ ai_gen_id }}">
        {{ block.settings.subtext }}
      </div>
    {% endif %}
  </div>
</bouncing-balls-{{ ai_gen_id }}>

<script>
  (function() {
    class BouncingBalls{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.canvas = this.querySelector('.ai-bouncing-balls-canvas-{{ ai_gen_id }}');
        this.ctx = this.canvas.getContext('2d');
        this.balls = [];
        this.animationId = null;
        this.colors = ['#FCA311', '#16213A', '#1B2E9D', '#0A1821'];
        this.isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      }

      connectedCallback() {
        if (this.isReducedMotion) return;
        
        this.setupCanvas();
        this.initBalls();
        this.animate();
        this.setupEventListeners();
      }

      disconnectedCallback() {
        if (this.animationId) {
          cancelAnimationFrame(this.animationId);
        }
        window.removeEventListener('resize', this.handleResize);
      }

      setupCanvas() {
        const rect = this.getBoundingClientRect();
        this.canvas.width = rect.width;
        this.canvas.height = rect.height;
      }

      initBalls() {
        const ballCount = parseInt(this.dataset.ballCount);
        const ballSizeMap = {
          'small': { min: 20, max: 35 },
          'medium': { min: 35, max: 55 },
          'large': { min: 55, max: 80 }
        };
        const sizeRange = ballSizeMap[this.dataset.ballSize];
        const energyMultiplier = parseFloat(this.dataset.bounceEnergy);

        this.balls = [];
        for (let i = 0; i < ballCount; i++) {
          const radius = Math.random() * (sizeRange.max - sizeRange.min) + sizeRange.min;
          const x = Math.random() * (this.canvas.width - radius * 2) + radius;
          const y = Math.random() * (this.canvas.height - radius * 2) + radius;
          const vx = (Math.random() - 0.5) * 4 * energyMultiplier;
          const vy = (Math.random() - 0.5) * 4 * energyMultiplier;
          const color = this.colors[Math.floor(Math.random() * this.colors.length)];

          this.balls.push({ x, y, vx, vy, radius, color, gravity: 0.3 * energyMultiplier });
        }
      }

      animate() {
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

        this.balls.forEach(ball => {
          ball.vy += ball.gravity;

          ball.x += ball.vx;
          ball.y += ball.vy;

          if (ball.x - ball.radius <= 0 || ball.x + ball.radius >= this.canvas.width) {
            ball.vx *= -0.9;
            ball.x = ball.x - ball.radius <= 0 ? ball.radius : this.canvas.width - ball.radius;
          }

          if (ball.y - ball.radius <= 0 || ball.y + ball.radius >= this.canvas.height) {
            ball.vy *= -0.9;
            ball.y = ball.y - ball.radius <= 0 ? ball.radius : this.canvas.height - ball.radius;
          }

          this.ctx.beginPath();
          this.ctx.arc(ball.x, ball.y, ball.radius, 0, Math.PI * 2);
          this.ctx.fillStyle = ball.color;
          this.ctx.fill();
        });

        this.animationId = requestAnimationFrame(() => this.animate());
      }

      setupEventListeners() {
        this.handleResize = () => {
          this.setupCanvas();
          this.initBalls();
        };
        window.addEventListener('resize', this.handleResize);

        this.canvas.addEventListener('click', (e) => {
          const rect = this.canvas.getBoundingClientRect();
          const clickX = e.clientX - rect.left;
          const clickY = e.clientY - rect.top;

          this.balls.forEach(ball => {
            const dx = ball.x - clickX;
            const dy = ball.y - clickY;
            const distance = Math.sqrt(dx * dx + dy * dy);

            if (distance < ball.radius + 50) {
              const angle = Math.atan2(dy, dx);
              const force = 8;
              ball.vx += Math.cos(angle) * force;
              ball.vy += Math.sin(angle) * force;
            }
          });
        });

        this.canvas.addEventListener('mousemove', (e) => {
          const rect = this.canvas.getBoundingClientRect();
          const mouseX = e.clientX - rect.left;
          const mouseY = e.clientY - rect.top;

          this.balls.forEach(ball => {
            const dx = ball.x - mouseX;
            const dy = ball.y - mouseY;
            const distance = Math.sqrt(dx * dx + dy * dy);

            if (distance < ball.radius + 30) {
              const angle = Math.atan2(dy, dx);
              const force = 0.5;
              ball.vx += Math.cos(angle) * force;
              ball.vy += Math.sin(angle) * force;
            }
          });
        });
      }
    }

    customElements.define('bouncing-balls-{{ ai_gen_id }}', BouncingBalls{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Bouncing balls",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "LUXURY IN MOTION"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 40
    },
    {
      "type": "header",
      "content": "Ball animation"
    },
    {
      "type": "range",
      "id": "ball_count",
      "min": 6,
      "max": 12,
      "step": 1,
      "label": "Ball count",
      "default": 8
    },
    {
      "type": "select",
      "id": "ball_size",
      "label": "Ball size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "bounce_energy",
      "min": 0.5,
      "max": 2,
      "step": 0.5,
      "label": "Bounce energy",
      "default": 1
    },
    {
      "type": "header",
      "content": "Section height"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 520,
      "max": 680,
      "step": 20,
      "unit": "px",
      "label": "Desktop height",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 520,
      "max": 760,
      "step": 20,
      "unit": "px",
      "label": "Mobile height",
      "default": 640
    }
  ],
  "presets": [
    {
      "name": "Bouncing balls"
    }
  ]
}
{% endschema %}
