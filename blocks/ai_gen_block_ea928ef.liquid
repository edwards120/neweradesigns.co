{% doc %}
  @prompt
    create a campaign archive, high quality moving continuously
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-campaign-archive-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-campaign-archive-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
    padding: 0 20px;
  }

  .ai-campaign-archive-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px;
    font-weight: 300;
    letter-spacing: 0.5px;
  }

  .ai-campaign-archive-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    opacity: 0.8;
  }

  .ai-campaign-archive-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.item_gap }}px;
    will-change: transform;
  }

  .ai-campaign-archive-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.item_width }}px;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.card_background }};
    box-shadow: 0 4px 20px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-campaign-archive-item-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 1.5 }});
  }

  .ai-campaign-archive-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
  }

  .ai-campaign-archive-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-campaign-archive-item-{{ ai_gen_id }}:hover .ai-campaign-archive-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-campaign-archive-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-campaign-archive-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-campaign-archive-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-campaign-archive-campaign-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.campaign_title_size }}px;
    color: {{ block.settings.campaign_title_color }};
    margin: 0 0 8px;
    font-weight: 500;
    line-height: 1.3;
  }

  .ai-campaign-archive-campaign-date-{{ ai_gen_id }} {
    font-size: {{ block.settings.campaign_date_size }}px;
    color: {{ block.settings.campaign_date_color }};
    margin: 0 0 12px;
    opacity: 0.7;
  }

  .ai-campaign-archive-campaign-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.campaign_description_size }}px;
    color: {{ block.settings.campaign_description_color }};
    margin: 0;
    line-height: 1.6;
    opacity: 0.85;
  }

  .ai-campaign-archive-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .ai-campaign-archive-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
    font-size: 16px;
  }

  @media screen and (max-width: 749px) {
    .ai-campaign-archive-item-{{ ai_gen_id }} {
      width: {{ block.settings.item_width | times: 0.8 }}px;
    }

    .ai-campaign-archive-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-campaign-archive-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<campaign-archive-{{ ai_gen_id }}
  class="ai-campaign-archive-{{ ai_gen_id }}"
  data-speed="{{ block.settings.scroll_speed }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.show_header %}
    <div class="ai-campaign-archive-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-campaign-archive-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-campaign-archive-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  {% assign has_campaigns = false %}
  {% for i in (1..12) %}
    {% liquid
      assign campaign_enabled_key = 'campaign_' | append: i | append: '_enabled'
      assign campaign_enabled = block.settings[campaign_enabled_key]
      if campaign_enabled
        assign has_campaigns = true
        break
      endif
    %}
  {% endfor %}

  {% if has_campaigns %}
    <div class="ai-campaign-archive-track-{{ ai_gen_id }}">
      {% for i in (1..12) %}
        {% liquid
          assign campaign_enabled_key = 'campaign_' | append: i | append: '_enabled'
          assign campaign_image_key = 'campaign_' | append: i | append: '_image'
          assign campaign_title_key = 'campaign_' | append: i | append: '_title'
          assign campaign_date_key = 'campaign_' | append: i | append: '_date'
          assign campaign_description_key = 'campaign_' | append: i | append: '_description'
          assign campaign_link_key = 'campaign_' | append: i | append: '_link'

          assign campaign_enabled = block.settings[campaign_enabled_key]
          assign campaign_image = block.settings[campaign_image_key]
          assign campaign_title = block.settings[campaign_title_key]
          assign campaign_date = block.settings[campaign_date_key]
          assign campaign_description = block.settings[campaign_description_key]
          assign campaign_link = block.settings[campaign_link_key]
        %}

        {% if campaign_enabled %}
          <div class="ai-campaign-archive-item-{{ ai_gen_id }}">
            {% if campaign_link != blank %}
              <a href="{{ campaign_link }}" class="ai-campaign-archive-link-{{ ai_gen_id }}">
            {% endif %}

            <div class="ai-campaign-archive-image-wrapper-{{ ai_gen_id }}">
              {% if campaign_image %}
                <img
                  src="{{ campaign_image | image_url: width: 800 }}"
                  alt="{{ campaign_image.alt | escape }}"
                  loading="lazy"
                  width="{{ campaign_image.width }}"
                  height="{{ campaign_image.height }}"
                  class="ai-campaign-archive-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-campaign-archive-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-campaign-archive-content-{{ ai_gen_id }}">
              {% if campaign_title != blank %}
                <h3 class="ai-campaign-archive-campaign-title-{{ ai_gen_id }}">{{ campaign_title }}</h3>
              {% endif %}
              {% if campaign_date != blank %}
                <p class="ai-campaign-archive-campaign-date-{{ ai_gen_id }}">{{ campaign_date }}</p>
              {% endif %}
              {% if campaign_description != blank %}
                <p class="ai-campaign-archive-campaign-description-{{ ai_gen_id }}">{{ campaign_description }}</p>
              {% endif %}
            </div>

            {% if campaign_link != blank %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-campaign-archive-empty-state-{{ ai_gen_id }}">
      Enable and configure campaigns to display your archive
    </div>
  {% endif %}
</campaign-archive-{{ ai_gen_id }}>

<script>
  (function() {
    class CampaignArchive{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = null;
        this.items = [];
        this.animationId = null;
        this.position = 0;
        this.speed = 0;
        this.isPaused = false;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-campaign-archive-track-{{ ai_gen_id }}');
        if (!this.track) return;

        this.items = Array.from(this.track.children);
        if (this.items.length === 0) return;

        this.speed = parseFloat(this.dataset.speed) || 0.5;

        this.duplicateItems();
        this.setupEventListeners();
        this.startAnimation();
      }

      duplicateItems() {
        const fragment = document.createDocumentFragment();
        this.items.forEach(item => {
          const clone = item.cloneNode(true);
          fragment.appendChild(clone);
        });
        this.track.appendChild(fragment);

        const fragment2 = document.createDocumentFragment();
        this.items.forEach(item => {
          const clone = item.cloneNode(true);
          fragment2.appendChild(clone);
        });
        this.track.appendChild(fragment2);
      }

      setupEventListeners() {
        this.track.addEventListener('mouseenter', () => {
          this.isPaused = true;
        });

        this.track.addEventListener('mouseleave', () => {
          this.isPaused = false;
        });
      }

      startAnimation() {
        const animate = () => {
          if (!this.isPaused) {
            this.position -= this.speed;

            const firstItem = this.items[0];
            const itemWidth = firstItem.offsetWidth;
            const gap = parseFloat(getComputedStyle(this.track).gap) || 0;
            const totalWidth = (itemWidth + gap) * this.items.length;

            if (Math.abs(this.position) >= totalWidth) {
              this.position = 0;
            }

            this.track.style.transform = `translateX(${this.position}px)`;
          }

          this.animationId = requestAnimationFrame(animate);
        };

        this.animationId = requestAnimationFrame(animate);
      }

      disconnectedCallback() {
        if (this.animationId) {
          cancelAnimationFrame(this.animationId);
        }
      }
    }

    customElements.define('campaign-archive-{{ ai_gen_id }}', CampaignArchive{{ ai_gen_id }});
  })();
</script>

