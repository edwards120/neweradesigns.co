{% doc %}
  @prompt
    Create a new AI-generated theme block called "3D Model Viewer with CTA Button" that is an exact match to an existing 3D Model Viewer block with these specs, but adds a CTA button below the viewer:
    
    **3D Viewer settings to replicate:**
    - Uses `<model-viewer>` web component to display a GLB model
    - Model URL setting (text input, default: `https://cdn.shopify.com/3d/models/671178fd2179fd6a/Auraria_Wayfinding.glb`)
    - Poster image URL setting (optional text input)
    - Model alt text setting (default: `Interactive 3D model`)
    - Label/badge text setting (default: `New Era Designs`) — displayed as a small badge overlay on the viewer
    - Desktop width: 100% (range setting)
    - Desktop height: 500px (range setting)
    - Mobile height: 350px (range setting)
    - Corner radius: 8px (range setting)
    - Background color: #fdfdfd (color setting)
    - Shadow intensity: 0.3 (range setting)
    - Exposure: 0.5 (range setting)
    - Environment lighting: neutral (select: neutral, legacy, commerce)
    - Auto-rotate: true (checkbox)
    - Rotation speed: 3 deg/s (range setting)
    
    **New CTA Button to add below the viewer:**
    - Button label setting (text, default: `Shop Cases`)
    - Button URL setting (text, default: `/pages/cases`)
    - Button style: dark navy background (#14213d), white text (#ffffff), golden orange border (#fca311), uppercase, letter-spacing 1px, 4px border-radius, generous padding
    - Hover state: background becomes #fca311, text becomes #14213d
    - Button centered below the model viewer with 20px top margin
    - Button color settings: background color (default #14213d), text color (default #ffffff), hover background (default #fca311), hover text (default #14213d)
    - Button font size setting (range, default 14px)
    - Show/hide button toggle (checkbox, default true)
    
    Load model-viewer script from https://ajax.googleapis.com/ajaxlibs/model-viewer/3.3.0/model-viewer.min.js as a module if not already loaded., bring the button to the top just in right at the edge , center the button, Last thing make the 3d Model zoom in its too far away at the start
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-model-viewer-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-model-viewer-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.desktop_height }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, {{ block.settings.shadow_intensity }});
  }

  .ai-model-viewer-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: block;
  }

  .ai-model-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 16px;
    left: 16px;
    background-color: rgba(20, 33, 61, 0.9);
    color: #ffffff;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    z-index: 10;
    pointer-events: none;
  }

  .ai-model-cta-button-{{ ai_gen_id }} {
    position: absolute;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: 2px solid {{ block.settings.button_border_color }};
    padding: 14px 32px;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    border-radius: 4px;
    transition: all 0.3s ease;
    cursor: pointer;
    z-index: 10;
  }

  .ai-model-cta-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-model-viewer-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}px;
    }
  }
{% endstyle %}

<model-viewer-block-{{ ai_gen_id }}
  class="ai-model-viewer-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-model-viewer-wrapper-{{ ai_gen_id }}">
    {% if block.settings.badge_text != blank %}
      <div class="ai-model-badge-{{ ai_gen_id }}">
        {{ block.settings.badge_text }}
      </div>
    {% endif %}

    {% if block.settings.show_button %}
      <a
        href="{{ block.settings.button_url }}"
        class="ai-model-cta-button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_label }}
      </a>
    {% endif %}

    <model-viewer
      class="ai-model-viewer-{{ ai_gen_id }}"
      src="{{ block.settings.model_url }}"
      alt="{{ block.settings.model_alt }}"
      {% if block.settings.poster_url != blank %}
        poster="{{ block.settings.poster_url }}"
      {% endif %}
      shadow-intensity="{{ block.settings.shadow_intensity }}"
      camera-controls
      touch-action="pan-y"
      {% if block.settings.auto_rotate %}
        auto-rotate
        rotation-per-second="{{ block.settings.rotation_speed }}deg"
      {% endif %}
      exposure="{{ block.settings.exposure }}"
      environment-image="{{ block.settings.environment_lighting }}"
      field-of-view="{{ block.settings.field_of_view }}deg"
      min-field-of-view="{{ block.settings.min_field_of_view }}deg"
      max-field-of-view="{{ block.settings.max_field_of_view }}deg"
    >
    </model-viewer>
  </div>
</model-viewer-block-{{ ai_gen_id }}>

<script type="module">
  (function() {
    if (!customElements.get('model-viewer')) {
      const script = document.createElement('script');
      script.type = 'module';
      script.src = 'https://ajax.googleapis.com/ajax/libs/model-viewer/3.3.0/model-viewer.min.js';
      document.head.appendChild(script);
    }

    class ModelViewerBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const modelViewer = this.querySelector('model-viewer');
        if (modelViewer) {
          modelViewer.addEventListener('load', () => {
            console.log('3D model loaded successfully');
          });
          modelViewer.addEventListener('error', (event) => {
            console.error('Error loading 3D model:', event);
          });
        }
      }
    }

    customElements.define('model-viewer-block-{{ ai_gen_id }}', ModelViewerBlock{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
