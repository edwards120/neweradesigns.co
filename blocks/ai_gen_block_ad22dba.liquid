{% doc %}
  @prompt
    Can you create two body paragraph section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-text-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-two-column-text__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-two-column-text__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-two-column-text__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.paragraph_spacing }}px;
  }

  .ai-two-column-text__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    line-height: 1.2;
  }

  .ai-two-column-text__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: {{ block.settings.line_height }};
    margin: 0;
  }

  .ai-two-column-text__text-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px;
  }

  .ai-two-column-text__text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-two-column-text__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_column_gap }}px;
    }

    .ai-two-column-text-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding_top }}px {{ block.settings.mobile_padding_horizontal }}px {{ block.settings.mobile_padding_bottom }}px;
    }

    .ai-two-column-text__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-two-column-text__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }
  }
{% endstyle %}

<div class="ai-two-column-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-two-column-text__container-{{ ai_gen_id }}">
    <div class="ai-two-column-text__grid-{{ ai_gen_id }}">
      <div class="ai-two-column-text__column-{{ ai_gen_id }}">
        {% if block.settings.heading_left != blank %}
          <h2 class="ai-two-column-text__heading-{{ ai_gen_id }}">{{ block.settings.heading_left }}</h2>
        {% endif %}
        {% if block.settings.text_left != blank %}
          <div class="ai-two-column-text__text-{{ ai_gen_id }}">{{ block.settings.text_left }}</div>
        {% endif %}
      </div>

      <div class="ai-two-column-text__column-{{ ai_gen_id }}">
        {% if block.settings.heading_right != blank %}
          <h2 class="ai-two-column-text__heading-{{ ai_gen_id }}">{{ block.settings.heading_right }}</h2>
        {% endif %}
        {% if block.settings.text_right != blank %}
          <div class="ai-two-column-text__text-{{ ai_gen_id }}">{{ block.settings.text_right }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

