{% doc %}
  @prompt
    A magazine-style editorial layout, headers, text, images, luxury high-class, subtext, able to change color. one bouncy ball animation , can i be able to adjust image size, make sure its adjustable on all devices. Need a background image as well.  Also please add Icons and links!
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-editorial-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .ai-editorial-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: {{ block.settings.background_opacity | divided_by: 100.0 }};
  }

  .ai-editorial-background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
    opacity: 0.3;
  }

  .ai-editorial-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    max-width: {{ block.settings.content_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
  }

  .ai-editorial-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-editorial-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
    font-weight: 500;
  }

  .ai-editorial-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 20px;
    line-height: 1.2;
    font-weight: 300;
    letter-spacing: -0.5px;
  }

  .ai-editorial-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 32px;
    line-height: 1.6;
    font-weight: 400;
  }

  .ai-editorial-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    color: {{ block.settings.body_color }};
    line-height: 1.8;
    margin-bottom: 40px;
    font-weight: 300;
  }

  .ai-editorial-image-wrapper-{{ ai_gen_id }} {
    margin-bottom: 40px;
    overflow: hidden;
    border-radius: 2px;
  }

  .ai-editorial-image-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}%;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .ai-editorial-image-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}%;
    margin: 0 auto;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
  }

  .ai-editorial-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-editorial-icons-{{ ai_gen_id }} {
    display: flex;
    gap: 24px;
    align-items: center;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .ai-editorial-icon-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .ai-editorial-icon-item-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-editorial-icon-circle-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.icon_background }};
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid {{ block.settings.icon_border_color }};
  }

  .ai-editorial-icon-circle-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
    stroke: {{ block.settings.icon_color }};
  }

  .ai-editorial-icon-label-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.body_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-editorial-ball-{{ ai_gen_id }} {
    position: absolute;
    width: {{ block.settings.ball_size }}px;
    height: {{ block.settings.ball_size }}px;
    border-radius: 50%;
    background: {{ block.settings.ball_color }};
    top: {{ block.settings.ball_position_y }}%;
    left: {{ block.settings.ball_position_x }}%;
    transform: translate(-50%, -50%);
    z-index: 2;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .ai-editorial-ball-{{ ai_gen_id }}.bouncing {
    animation: ai-editorial-bounce-{{ ai_gen_id }} 2s ease-in-out infinite;
  }

  @keyframes ai-editorial-bounce-{{ ai_gen_id }} {
    0%, 100% {
      transform: translate(-50%, -50%) translateY(0);
    }
    50% {
      transform: translate(-50%, -50%) translateY(-30px);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-content-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.6 }}px {{ block.settings.padding_horizontal | times: 0.6 }}px {{ block.settings.padding_bottom | times: 0.6 }}px;
    }

    .ai-editorial-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
    }

    .ai-editorial-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
    }

    .ai-editorial-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size | times: 0.9 }}px;
    }

    .ai-editorial-image-{{ ai_gen_id }},
    .ai-editorial-image-placeholder-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-editorial-ball-{{ ai_gen_id }} {
      width: {{ block.settings.ball_size | times: 0.7 }}px;
      height: {{ block.settings.ball_size | times: 0.7 }}px;
    }

    .ai-editorial-icon-circle-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-editorial-icon-circle-{{ ai_gen_id }} svg {
      width: calc({{ block.settings.icon_size | times: 0.8 }}px * 0.5);
      height: calc({{ block.settings.icon_size | times: 0.8 }}px * 0.5);
    }
  }
{% endstyle %}

<editorial-block-{{ ai_gen_id }} class="ai-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-background-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-editorial-background-placeholder-{{ ai_gen_id }}">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  {% if block.settings.show_ball %}
    <div class="ai-editorial-ball-{{ ai_gen_id }} bouncing"></div>
  {% endif %}

  <div class="ai-editorial-content-{{ ai_gen_id }}">
    <div class="ai-editorial-header-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <div class="ai-editorial-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-editorial-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="ai-editorial-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}
    </div>

    {% if block.settings.body_text != blank %}
      <div class="ai-editorial-body-{{ ai_gen_id }}">{{ block.settings.body_text }}</div>
    {% endif %}

    {% if block.settings.image %}
      <div class="ai-editorial-image-wrapper-{{ ai_gen_id }}">
        <img
          src="{{ block.settings.image | image_url: width: 1600 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-editorial-image-{{ ai_gen_id }}"
        >
      </div>
    {% else %}
      <div class="ai-editorial-image-wrapper-{{ ai_gen_id }}">
        <div class="ai-editorial-image-placeholder-{{ ai_gen_id }}">
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_icons %}
      <div class="ai-editorial-icons-{{ ai_gen_id }}">
        {% if block.settings.icon_1_link != blank %}
          <a href="{{ block.settings.icon_1_link }}" class="ai-editorial-icon-item-{{ ai_gen_id }}">
            <div class="ai-editorial-icon-circle-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </div>
            {% if block.settings.icon_1_label != blank %}
              <span class="ai-editorial-icon-label-{{ ai_gen_id }}">{{ block.settings.icon_1_label }}</span>
            {% endif %}
          </a>
        {% endif %}

        {% if block.settings.icon_2_link != blank %}
          <a href="{{ block.settings.icon_2_link }}" class="ai-editorial-icon-item-{{ ai_gen_id }}">
            <div class="ai-editorial-icon-circle-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            {% if block.settings.icon_2_label != blank %}
              <span class="ai-editorial-icon-label-{{ ai_gen_id }}">{{ block.settings.icon_2_label }}</span>
            {% endif %}
          </a>
        {% endif %}

        {% if block.settings.icon_3_link != blank %}
          <a href="{{ block.settings.icon_3_link }}" class="ai-editorial-icon-item-{{ ai_gen_id }}">
            <div class="ai-editorial-icon-circle-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </div>
            {% if block.settings.icon_3_label != blank %}
              <span class="ai-editorial-icon-label-{{ ai_gen_id }}">{{ block.settings.icon_3_label }}</span>
            {% endif %}
          </a>
        {% endif %}

        {% if block.settings.icon_4_link != blank %}
          <a href="{{ block.settings.icon_4_link }}" class="ai-editorial-icon-item-{{ ai_gen_id }}">
            <div class="ai-editorial-icon-circle-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </div>
            {% if block.settings.icon_4_label != blank %}
              <span class="ai-editorial-icon-label-{{ ai_gen_id }}">{{ block.settings.icon_4_label }}</span>
            {% endif %}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</editorial-block-{{ ai_gen_id }}>

<script>
  (function() {
    class EditorialBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.ball = this.querySelector('.ai-editorial-ball-{{ ai_gen_id }}');
        if (this.ball) {
          this.setupBallAnimation();
        }
      }

      setupBallAnimation() {
        this.ball.addEventListener('mouseenter', () => {
          this.ball.style.animationPlayState = 'paused';
        });

        this.ball.addEventListener('mouseleave', () => {
          this.ball.style.animationPlayState = 'running';
        });
      }
    }

    customElements.define('editorial-block-{{ ai_gen_id }}', EditorialBlock{{ ai_gen_id }});
  })();
</script>

