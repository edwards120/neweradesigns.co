      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Spacing below heading",
      "default": 16
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
