{% doc %}
  @prompt
    images banner with a button at the bottom, useable for desktop and mobile version
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
.ai-image-banner-{{ ai_gen_id }} {
  display: block;
  position: relative;
  width: 100%;
  overflow: hidden;
  margin: 0 !important;
  padding: 0 !important;
}

.ai-image-banner-container-{{ ai_gen_id }} {
  position: relative;
  width: 100%;
  /* responsive height: never too small, scales with viewport, capped by slider */
  height: clamp(220px, 60vh, {{ block.settings.banner_height_desktop }}px);
  overflow: hidden;
  margin: 0 !important;
  padding: 0 !important;
}

.ai-image-banner-image-wrapper-{{ ai_gen_id }} {
  width: 100%;
  height: 100%;
  position: relative;
}

.ai-image-banner-image-{{ ai_gen_id }} {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block; /* prevents tiny baseline gaps */
}

/* overlay stays the same */
.ai-image-banner-overlay-{{ ai_gen_id }} {
  position: absolute;
  inset: 0;
  background-color: {{ block.settings.overlay_color }};
  opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
  pointer-events: none;
  z-index: 1;
}

/* ✅ IMPORTANT: make content a flex column so button can sit at bottom */
.ai-image-banner-content-{{ ai_gen_id }} {
  position: absolute;
  inset: 0;
  z-index: 2;

  display: flex;
  flex-direction: column;

  /* keep your alignment */
  text-align: {{ block.settings.text_alignment }};

  /* padding inside the banner */
  padding: {{ block.settings.content_padding }}px;
  box-sizing: border-box;
}

/* keep heading/text normal */
.ai-image-banner-heading-{{ ai_gen_id }} {
  color: {{ block.settings.heading_color }};
  font-size: {{ block.settings.heading_size }}px;
  margin: 0 0 {{ block.settings.text_spacing }}px;
  line-height: 1.2;
}

.ai-image-banner-text-{{ ai_gen_id }} {
  color: {{ block.settings.text_color }};
  font-size: {{ block.settings.text_size }}px;
  margin: 0;
  line-height: 1.5;
}

/* ✅ Push button to bottom */
.ai-image-banner-button-{{ ai_gen_id }} {
  display: inline-block;
  margin-top: auto; /* this pins it to bottom */
  align-self: center; /* centers button (change if you want left/right) */

  padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
  background-color: {{ block.settings.button_background }};
  color: {{ block.settings.button_text_color }};
  text-decoration: none;
  border-radius: {{ block.settings.button_border_radius }}px;
  font-size: {{ block.settings.button_font_size }}px;
  font-weight: 600;
  transition: all 0.3s ease;
  border: none;
  cursor: pointer;
}

.ai-image-banner-button-{{ ai_gen_id }}:hover {
  background-color: {{ block.settings.button_hover_background }};
  color: {{ block.settings.button_hover_text_color }};
}

/* mobile */
@media screen and (max-width: 1000px) {
  .ai-image-banner-container-{{ ai_gen_id }} {
    height: clamp(200px, 20vh, {{ block.settings.banner_height_mobile }}px);
  }

  .ai-image-banner-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size | times: 0.7 }}px;
  }

  .ai-image-banner-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size | times: 0.9 }}px;
  }

  .ai-image-banner-button-{{ ai_gen_id }} {
    font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
    padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
  }
}
{% endstyle %}

<image-banner-{{ ai_gen_id }} class="ai-image-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-banner-container-{{ ai_gen_id }}">
    <div class="ai-image-banner-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 2000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-image-banner-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-image-banner-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-image-banner-empty-state-{{ ai_gen_id }}">
            Next, add an image
          </div>
        </div>
      {% endif %}
    </div>

    {% if block.settings.show_overlay %}
      <div class="ai-image-banner-overlay-{{ ai_gen_id }}"></div>
    {% endif %}

    <div class="ai-image-banner-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-image-banner-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-image-banner-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-image-banner-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</image-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const button = this.querySelector('.ai-image-banner-button-{{ ai_gen_id }}');
        if (button && !button.getAttribute('aria-label')) {
          const buttonText = button.textContent.trim();
          button.setAttribute('aria-label', buttonText);
        }
      }
    }

    customElements.define('image-banner-{{ ai_gen_id }}', ImageBanner{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Image banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
