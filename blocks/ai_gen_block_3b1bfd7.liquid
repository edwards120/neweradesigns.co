{% doc %}
  @prompt
    Create a custom Liquid/CSS section block called "Continuous Moving Panels - Services". Requirements:
    
    1. SECTION HEADING:
    - Display "OUR SERVICES" as a large bold heading above the scrolling panels
    - Dark navy background (#0a0f1e), white or gold text (#d4af37)
    - Wrap "SERVICES" with a span using class "ned-highlight-circle" for animated circle highlight effect using CSS keyframe animation that draws an ellipse border around the word
    
    2. AUTO-SCROLLING PANEL STRIP:
    - 4 image panels in a horizontally scrolling marquee strip
    - Auto-scroll slow and smooth (JS-based speed 0.5px per frame, or CSS animation ~40s duration)
    - On hover: pause auto-scroll completely
    - Click-and-drag manual scrolling via JS (mousedown/mousemove/mouseup)
    - scroll-behavior: smooth
    - Panels: 450px wide, 560px tall
    
    3. PANEL CONTENT (4 blocks, each with image picker, title text, URL link in schema):
    - Panel 1: title "BRAND IDENTITY", link /pages/branding-identity
    - Panel 2: title "BRAND ARCHITECTURE + IDENTITY", link /pages/brand-architecture-creative-services
    - Panel 3: title "ENVIRONMENTAL & WAYFINDING DESIGN", link /pages/signage-luxury-design
    - Panel 4: title "MARKETING MATERIALS", link /pages/contact-1
    
    4. TEXT OVERLAYS on each panel:
    - Bold title overlay at BOTTOM of panel image
    - Semi-transparent dark background rgba(0,0,0,0.55) behind text
    - White or gold text, uppercase, bold
    - Apply class "ned-highlight" to key words for animated underline (draws in from left on hover)
    - Apply class "ned-highlight-circle" for animated ellipse circle border around title
    - CSS keyframes for both animations included in the block
    
    5. COLOR SCHEME: navy #0a0f1e, gold #d4af37, white #ffffff. Premium luxury aesthetic.
    
    6. SCHEMA: section title setting (default "OUR SERVICES"), 4 blocks each with image picker, title text, URL link, padding settings.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ned-services-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    overflow: hidden;
  }

  .ned-services-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
    padding: 0 20px;
  }

  .ned-services-title-{{ ai_gen_id }} {
    font-size: 48px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0;
  }

  .ned-highlight-circle {
    position: relative;
    display: inline-block;
    padding: 0 10px;
  }

  .ned-highlight-circle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 110%;
    height: 140%;
    border: 3px solid {{ block.settings.highlight_color }};
    border-radius: 50%;
    opacity: 0;
    animation: ned-circle-draw-{{ ai_gen_id }} 1.5s ease-out 0.5s forwards;
  }

  @keyframes ned-circle-draw-{{ ai_gen_id }} {
    0% {
      opacity: 0;
      stroke-dasharray: 0 1000;
      transform: translate(-50%, -50%) scale(0.8);
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      stroke-dasharray: 1000 0;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  .ned-services-marquee-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    cursor: grab;
    user-select: none;
  }

  .ned-services-marquee-{{ ai_gen_id }}:active {
    cursor: grabbing;
  }

  .ned-services-track-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    will-change: transform;
  }

  .ned-services-track-{{ ai_gen_id }}.paused {
    animation-play-state: paused;
  }

  .ned-services-panel-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.panel_width }}px;
    height: {{ block.settings.panel_height }}px;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 0;
  }

  .ned-services-panel-{{ ai_gen_id }} a {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    text-decoration: none;
  }

  .ned-services-panel-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .ned-services-panel-{{ ai_gen_id }} a:hover .ned-services-panel-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ned-services-panel-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: {{ block.settings.overlay_color }};
    padding: 30px 25px;
    z-index: 2;
  }

  .ned-services-panel-title-{{ ai_gen_id }} {
    font-size: 20px;
    font-weight: 700;
    color: {{ block.settings.panel_text_color }};
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin: 0;
    line-height: 1.3;
  }

  .ned-highlight {
    position: relative;
    display: inline-block;
  }

  .ned-highlight::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: {{ block.settings.highlight_color }};
    transition: width 0.6s ease;
  }

  .ned-services-panel-{{ ai_gen_id }} a:hover .ned-highlight::after {
    width: 100%;
  }

  .ned-services-panel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #1a1a2e;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ned-services-panel-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ned-services-title-{{ ai_gen_id }} {
      font-size: 32px;
    }

    .ned-services-panel-{{ ai_gen_id }} {
      width: 320px;
      height: 400px;
    }

    .ned-services-panel-title-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ned-services-panel-overlay-{{ ai_gen_id }} {
      padding: 20px 15px;
    }
  }
{% endstyle %}

