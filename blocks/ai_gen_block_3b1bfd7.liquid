<script>
  (function() {
    class ContinuousServicesMarquee{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.marquee = null;
        this.track = null;
        this.isDragging = false;
        this.startX = 0;
        this.scrollLeft = 0;
        this.animationId = null;
        this.currentPosition = 0;
        this.speed = 0.5;
        this.isPaused = false;
      }

      connectedCallback() {
        this.marquee = this.querySelector('[data-marquee]');
        this.track = this.querySelector('[data-track]');

        if (!this.marquee || !this.track) return;

        this.setupDragScroll();
        this.setupHoverPause();
        this.startAutoScroll();
      }

      disconnectedCallback() {
        if (this.animationId) {
          cancelAnimationFrame(this.animationId);
        }
      }

      setupDragScroll() {
        this.marquee.addEventListener('mousedown', (e) => {
          this.isDragging = true;
          this.startX = e.pageX;
          this.scrollLeft = this.currentPosition;
          this.isPaused = true;
          if (this.animationId) {
            cancelAnimationFrame(this.animationId);
          }
        });

        this.marquee.addEventListener('mousemove', (e) => {
          if (!this.isDragging) return;
          e.preventDefault();
          const x = e.pageX;
          const walk = (x - this.startX) * 2;
          this.currentPosition = this.scrollLeft - walk;
          this.track.style.transform = `translateX(${-this.currentPosition}px)`;
        });

        this.marquee.addEventListener('mouseup', () => {
          this.isDragging = false;
          this.isPaused = false;
          this.startAutoScroll();
        });

        this.marquee.addEventListener('mouseleave', () => {
          if (this.isDragging) {
            this.isDragging = false;
            this.isPaused = false;
            this.startAutoScroll();
          }
        });
      }

      setupHoverPause() {
        this.marquee.addEventListener('mouseenter', () => {
          if (!this.isDragging) {
            this.isPaused = true;
          }
        });

        this.marquee.addEventListener('mouseleave', () => {
          if (!this.isDragging) {
            this.isPaused = false;
          }
        });
      }

      startAutoScroll() {
        const animate = () => {
          if (!this.isPaused && !this.isDragging) {
            this.currentPosition += this.speed;

            const trackWidth = this.track.scrollWidth / 2;
            if (this.currentPosition >= trackWidth) {
              this.currentPosition = 0;
            }

            this.track.style.transform = `translateX(${-this.currentPosition}px)`;
          }

          this.animationId = requestAnimationFrame(animate);
        };

        animate();
      }
    }

    customElements.define('continuous-services-marquee-{{ ai_gen_id }}', ContinuousServicesMarquee{{ ai_gen_id }});
  })();
</script>

