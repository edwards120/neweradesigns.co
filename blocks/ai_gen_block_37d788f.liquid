{% doc %}
  @prompt
    Create an interactive section with tightly-spaced text where words are grouped closely together with minimal spacing between them. Use reduced letter-spacing and word-spacing for a compact, cohesive text appearance. Support the brand's two-color palette (orange and blue). No buttons or additional text elements needed.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tight-text-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-tight-text-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-tight-text-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    line-height: {{ block.settings.line_height }};
    color: {{ block.settings.text_color }};
    letter-spacing: -0.05em;
    word-spacing: -0.2em;
    text-align: {{ block.settings.text_alignment }};
    font-weight: {{ block.settings.font_weight }};
  }

  .ai-tight-text-word-{{ ai_gen_id }} {
    display: inline-block;
    transition: color 0.3s ease, transform 0.2s ease;
    cursor: default;
  }

  .ai-tight-text-word-{{ ai_gen_id }}:hover {
    color: {{ block.settings.hover_color }};
    transform: scale({{ block.settings.hover_scale }});
  }

  @media screen and (max-width: 749px) {
    .ai-tight-text-content-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.font_size }}px * 0.7);
    }
  }
{% endstyle %}

<tight-text-{{ ai_gen_id }}
  class="ai-tight-text-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-tight-text-container-{{ ai_gen_id }}">
    <div class="ai-tight-text-content-{{ ai_gen_id }}" data-text-content>
      {% if block.settings.text != blank %}
        {{ block.settings.text }}
      {% else %}
        <p>Add your tightly-spaced text here to see the compact typography effect</p>
      {% endif %}
    </div>
  </div>
</tight-text-{{ ai_gen_id }}>

<script>
  (function() {
    class TightText{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.textContent = this.querySelector('[data-text-content]');
        if (this.textContent) {
          this.wrapWords();
        }
      }

      wrapWords() {
        const originalHTML = this.textContent.innerHTML;
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = originalHTML;
        
        const textNodes = this.getTextNodes(tempDiv);
        
        textNodes.forEach(node => {
          const words = node.textContent.split(/(\s+)/);
          const fragment = document.createDocumentFragment();
          
          words.forEach(word => {
            if (word.trim()) {
              const span = document.createElement('span');
              span.className = 'ai-tight-text-word-{{ ai_gen_id }}';
              span.textContent = word;
              fragment.appendChild(span);
            } else if (word) {
              fragment.appendChild(document.createTextNode(word));
            }
          });
          
          node.parentNode.replaceChild(fragment, node);
        });
        
        this.textContent.innerHTML = tempDiv.innerHTML;
      }

      getTextNodes(element) {
        const textNodes = [];
        const walker = document.createTreeWalker(
          element,
          NodeFilter.SHOW_TEXT,
          null,
          false
        );
        
        let node;
        while (node = walker.nextNode()) {
          if (node.textContent.trim()) {
            textNodes.push(node);
          }
        }
        
        return textNodes;
      }
    }

    customElements.define('tight-text-{{ ai_gen_id }}', TightText{{ ai_gen_id }});
  })();
</script>

