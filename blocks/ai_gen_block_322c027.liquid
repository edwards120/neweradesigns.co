{% doc %}
  @prompt
    Create an interactive hero section with a dark luxury background (#16213A) and subtle abstract texture.
    
    Place 6–10 floating circular elements (“bouncing balls”) across the section.
    
    The circles should be smooth, soft-edged, and slightly glossy, using only these brand colors:
    – Gold #FCA311
    – Deep Navy #16213A
    – Royal Blue #1B2E9D
    – Obsidian Black #0A1821
    
    Interaction behavior:
    – When the user clicks or taps anywhere in the section, the circles gently bounce, drift, and reposition with natural easing.
    – On hover (desktop), circles subtly react and shift position.
    – Motion should feel refined, slow, and luxurious — not playful or cartoonish.
    
    Layout & tone:
    – Minimalist, editorial, high-fashion aesthetic
    – Circles should never overlap text
    – Background may include a very subtle grain, geometric lines, or Hermetic-inspired pattern at low opacity
    
    Include a centered headline above or below the motion area with clean typography:
    “INTERACTIVE DESIGN. LUXURY IN MOTION.”
    
    Ensure the section is fully responsive and optimized for mobile touch interaction., Just solild color balls, not floating, bouncing, allow me to change the size or the section and size of the balls. make them move continously , allow me to make the mobile height 150, Faster ball movement , No text
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-luxury-hero-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    min-height: {{ block.settings.section_height }}px;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-luxury-hero-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-luxury-hero-background-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(252, 163, 17, 0.02) 2px,
        rgba(252, 163, 17, 0.02) 4px
      ),
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 2px,
        rgba(27, 46, 157, 0.02) 2px,
        rgba(27, 46, 157, 0.02) 4px
      );
    opacity: {{ block.settings.texture_opacity | divided_by: 100.0 }};
  }

  .ai-luxury-hero-background-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: 
      radial-gradient(circle at 20% 30%, rgba(27, 46, 157, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(252, 163, 17, 0.1) 0%, transparent 50%);
    opacity: {{ block.settings.gradient_opacity | divided_by: 100.0 }};
  }

  .ai-luxury-hero-canvas-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .ai-luxury-hero-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_height }}px;
    }
  }
{% endstyle %}

<luxury-hero-{{ ai_gen_id }}
  class="ai-luxury-hero-{{ ai_gen_id }}"
  data-ball-count="{{ block.settings.ball_count }}"
  data-ball-size="{{ block.settings.ball_size }}"
  data-bounce-strength="{{ block.settings.bounce_strength }}"
  data-gravity="{{ block.settings.gravity }}"
  data-continuous-motion="{{ block.settings.continuous_motion }}"
  data-speed-multiplier="{{ block.settings.speed_multiplier }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-luxury-hero-background-{{ ai_gen_id }}"></div>
  
  <canvas class="ai-luxury-hero-canvas-{{ ai_gen_id }}"></canvas>
</luxury-hero-{{ ai_gen_id }}>

<script>
(function() {
  class LuxuryHero{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.canvas = this.querySelector('.ai-luxury-hero-canvas-{{ ai_gen_id }}');
      this.ctx = this.canvas.getContext('2d');
      this.balls = [];
      this.animationId = null;
      this.colors = ['#FCA311', '#16213A', '#1B2E9D', '#0A1821'];
      this.ballCount = parseInt(this.dataset.ballCount) || 8;
      this.ballSize = parseInt(this.dataset.ballSize) || 80;
      this.bounceStrength = parseFloat(this.dataset.bounceStrength) || 0.7;
      this.gravity = parseFloat(this.dataset.gravity) || 0.5;
      this.continuousMotion = this.dataset.continuousMotion === 'true';
      this.speedMultiplier = parseFloat(this.dataset.speedMultiplier) || 1;
    }

    connectedCallback() {
      this.setupCanvas();
      this.initBalls();
      this.setupEventListeners();
      this.animate();
      
      window.addEventListener('resize', () => this.handleResize());
    }

    disconnectedCallback() {
      if (this.animationId) {
        cancelAnimationFrame(this.animationId);
      }
      window.removeEventListener('resize', () => this.handleResize());
    }

    setupCanvas() {
      const rect = this.getBoundingClientRect();
      this.canvas.width = rect.width;
      this.canvas.height = rect.height;
    }

    handleResize() {
      this.setupCanvas();
      this.balls.forEach(ball => {
        ball.x = Math.min(ball.x, this.canvas.width - ball.radius);
        ball.y = Math.min(ball.y, this.canvas.height - ball.radius);
      });
    }

    initBalls() {
      for (let i = 0; i < this.ballCount; i++) {
        const x = Math.random() * (this.canvas.width - this.ballSize * 2) + this.ballSize;
        const y = Math.random() * (this.canvas.height - this.ballSize * 2) + this.ballSize;

        const baseSpeed = this.continuousMotion ? 3 : 2;
        const speed = baseSpeed * this.speedMultiplier;
        
        this.balls.push({
          x: x,
          y: y,
          vx: (Math.random() - 0.5) * speed,
          vy: (Math.random() - 0.5) * speed,
          radius: this.ballSize / 2,
          color: this.colors[i % this.colors.length]
        });
      }
    }

    setupEventListeners() {
      this.canvas.addEventListener('click', (e) => this.handleClick(e));
      this.canvas.addEventListener('touchstart', (e) => this.handleClick(e));
    }

    handleClick(e) {
      e.preventDefault();
      const rect = this.canvas.getBoundingClientRect();
      const clickX = e.clientX || (e.touches && e.touches[0].clientX);
      const clickY = e.clientY || (e.touches && e.touches[0].clientY);
      
      if (!clickX || !clickY) return;

      const x = clickX - rect.left;
      const y = clickY - rect.top;

      this.balls.forEach(ball => {
        const dx = ball.x - x;
        const dy = ball.y - y;
        const distance = Math.sqrt(dx * dx + dy * dy);
        
        if (distance < 200) {
          const angle = Math.atan2(dy, dx);
          const force = (200 - distance) / 200 * 15 * this.speedMultiplier;
          
          ball.vx += Math.cos(angle) * force;
          ball.vy += Math.sin(angle) * force;
        }
      });
    }

    animate() {
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

      this.balls.forEach(ball => {
        if (this.continuousMotion) {
          const minSpeed = 1 * this.speedMultiplier;
          const speed = Math.sqrt(ball.vx * ball.vx + ball.vy * ball.vy);
          if (speed < minSpeed) {
            const angle = Math.atan2(ball.vy, ball.vx);
            ball.vx = Math.cos(angle) * minSpeed;
            ball.vy = Math.sin(angle) * minSpeed;
          }
        } else {
          ball.vy += this.gravity;
        }

        ball.x += ball.vx;
        ball.y += ball.vy;

        if (ball.x - ball.radius < 0) {
          ball.x = ball.radius;
          ball.vx *= -this.bounceStrength;
        }
        if (ball.x + ball.radius > this.canvas.width) {
          ball.x = this.canvas.width - ball.radius;
          ball.vx *= -this.bounceStrength;
        }

        if (ball.y - ball.radius < 0) {
          ball.y = ball.radius;
          ball.vy *= -this.bounceStrength;
        }
        if (ball.y + ball.radius > this.canvas.height) {
          ball.y = this.canvas.height - ball.radius;
          ball.vy *= -this.bounceStrength;
          
          if (!this.continuousMotion && Math.abs(ball.vy) < 0.5) {
            ball.vy = 0;
          }
        }

        const friction = this.continuousMotion ? 0.999 : 0.995;
        ball.vx *= friction;
        ball.vy *= friction;

        this.drawBall(ball);
      });

      this.animationId = requestAnimationFrame(() => this.animate());
    }

    drawBall(ball) {
      this.ctx.beginPath();
      this.ctx.arc(ball.x, ball.y, ball.radius, 0, Math.PI * 2);
      this.ctx.fillStyle = ball.color;
      this.ctx.fill();
    }
  }

  customElements.define('luxury-hero-{{ ai_gen_id }}', LuxuryHero{{ ai_gen_id }});
})();
</script>

{% schema %}
{
  "name": "Luxury bouncing hero",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Section size"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 300,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Desktop height",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 150,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Mobile height",
      "default": 500
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#16213A"
    },
    {
      "type": "range",
      "id": "texture_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Texture opacity",
      "default": 50
    },
    {
      "type": "range",
      "id": "gradient_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Gradient overlay opacity",
      "default": 60
    },
    {
      "type": "header",
      "content": "Bouncing circles"
    },
    {
      "type": "range",
      "id": "ball_count",
      "min": 6,
      "max": 10,
      "step": 1,
      "label": "Number of circles",
      "default": 8
    },
    {
      "type": "range",
      "id": "ball_size",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Circle size",
      "default": 80
    },
    {
      "type": "range",
      "id": "speed_multiplier",
      "min": 0.5,
      "max": 3,
      "step": 0.5,
      "label": "Movement speed",
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "continuous_motion",
      "label": "Continuous motion",
      "info": "Keep circles moving continuously instead of settling",
      "default": true
