    {
      "type": "range",
      "id": "gravity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "Gravity strength",
      "default": 0.5
    },
    {
      "type": "range",
      "id": "bounce_strength",
      "min": 0.5,
      "max": 1,
      "step": 0.1,
      "label": "Bounce strength",
      "default": 0.7
    }
  ],
  "presets": [
    {
      "name": "Luxury bouncing hero"
    }
  ]
}
{% endschema %}
