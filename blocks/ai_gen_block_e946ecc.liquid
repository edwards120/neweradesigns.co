<script>
  (function() {
    class BouncyBalls{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.canvas = this.querySelector('.ai-bouncy-balls-canvas-{{ ai_gen_id }}');
        this.ctx = this.canvas.getContext('2d');
        this.balls = [];
        this.animationId = null;
        this.colors = [];
        this.prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      }

      connectedCallback() {
        if (this.prefersReducedMotion) return;

        this.setupCanvas();
        this.initBalls();
        this.animate();
        this.setupEventListeners();
      }

      disconnectedCallback() {
        if (this.animationId) {
          cancelAnimationFrame(this.animationId);
        }
        window.removeEventListener('resize', this.handleResize);
      }

      setupCanvas() {
        const rect = this.getBoundingClientRect();
        const ratio = window.devicePixelRatio || 1;
        this.canvas.width = rect.width * ratio;
        this.canvas.height = rect.height * ratio;
        this.canvas.style.width = rect.width + 'px';
        this.canvas.style.height = rect.height + 'px';
        this.ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
        this.canvasLogicalWidth = rect.width;
        this.canvasLogicalHeight = rect.height;
      }

      getResponsiveRadiusScale() {
        const width = this.canvasLogicalWidth || window.innerWidth;
        return Math.min(2.1, Math.max(0.55, width / 760));
      }

      getScaledRadius(baseRadius) {
        const scale = this.getResponsiveRadiusScale();
        const shortestSide = Math.min(this.canvasLogicalWidth || 1, this.canvasLogicalHeight || 1);
        const sideLimit = this.canvasLogicalWidth <= 749 ? 0.13 : 0.18;
        const maxRadiusForCanvas = Math.max(6, shortestSide * sideLimit);

        return Math.max(4, Math.min(baseRadius * scale, maxRadiusForCanvas));
      }

      initBalls() {
        this.balls = [];

        const ballCount = parseInt(this.dataset.ballCount, 10);
        const ballSizeOption = this.dataset.ballSize;
        const bounceIntensity = this.dataset.bounceIntensity;
        const c1 = this.dataset.color1 || '#FCA311';
        const c2 = this.dataset.color2 || '#1B2E9D';
        const c3 = this.dataset.color3 || '#ffe81c';
        const c4 = this.dataset.color4 || '#1B2E9D';

        this.primaryA = c1;
        this.primaryB = c3;
        this.colors = [c1, c2, c4].filter(Boolean);

        let gravity, damping;
        if (bounceIntensity === 'calm') {
          gravity = 0.15;
          damping = 0.7;
        } else if (bounceIntensity === 'moderate') {
          gravity = 0.25;
          damping = 0.75;
        } else {
          gravity = 0.35;
          damping = 0.8;
        }

        let minRadius = parseInt(this.dataset.radiusMin || '10', 10);
        let maxRadius = parseInt(this.dataset.radiusMax || '26', 10);

        if (maxRadius < minRadius) maxRadius = minRadius + 4;

        if (ballSizeOption === 'small') {
          maxRadius = Math.min(maxRadius, minRadius + 10);
        } else if (ballSizeOption === 'large') {
          minRadius = Math.max(10, minRadius);
          maxRadius = Math.max(maxRadius, minRadius + 18);
        }

        const gradientPercent = parseInt(this.dataset.gradientPercent || '20', 10) / 100;

        for (let i = 0; i < ballCount; i++) {
          const baseRadius = minRadius + Math.random() * (maxRadius - minRadius);
          const radius = this.getScaledRadius(baseRadius);

          this.balls.push({
            x: radius + Math.random() * Math.max(1, this.canvasLogicalWidth - radius * 2),
            y: radius + Math.random() * Math.max(1, this.canvasLogicalHeight - radius * 2),
            vx: (Math.random() - 0.5) * 3,
            vy: (Math.random() - 0.5) * 3,
            radius: radius,
            baseRadius: baseRadius,
            color: this.colors[Math.floor(Math.random() * this.colors.length)],
            gravity: gravity,
            damping: damping,
            isGradient: Math.random() < gradientPercent
          });
        }
      }

      animate() {
        this.ctx.clearRect(0, 0, this.canvasLogicalWidth, this.canvasLogicalHeight);

        this.balls.forEach(ball => {
          ball.vy += ball.gravity;
          ball.x += ball.vx;
          ball.y += ball.vy;

          if (ball.x - ball.radius < 0) {
            ball.x = ball.radius;
            ball.vx = Math.abs(ball.vx) * ball.damping;
          } else if (ball.x + ball.radius > this.canvasLogicalWidth) {
            ball.x = this.canvasLogicalWidth - ball.radius;
            ball.vx = -Math.abs(ball.vx) * ball.damping;
          }

          if (ball.y - ball.radius < 0) {
            ball.y = ball.radius;
            ball.vy = Math.abs(ball.vy) * ball.damping;
          } else if (ball.y + ball.radius > this.canvasLogicalHeight) {
            ball.y = this.canvasLogicalHeight - ball.radius;
            ball.vy = -Math.abs(ball.vy) * ball.damping;
          }

          this.ctx.globalAlpha = 1;

          this.ctx.beginPath();
          this.ctx.arc(ball.x, ball.y, ball.radius, 0, Math.PI * 2);

          if (ball.isGradient) {
            const primaryA = this.primaryA || '#FCA311';
            const primaryB = this.primaryB || '#ffe81c';
            const t = performance.now() * 0.001;
            const highlightX = ball.x + Math.cos(t * 0.5) * ball.radius * 0.35;
            const highlightY = ball.y + Math.sin(t * 0.5) * ball.radius * 0.35;
            const grad = this.ctx.createRadialGradient(
              highlightX,
              highlightY,
              ball.radius * 0.15,
              ball.x,
              ball.y,
              ball.radius
            );

            grad.addColorStop(0, primaryA);
            grad.addColorStop(0.5, primaryB);
            grad.addColorStop(1, primaryA);
            this.ctx.fillStyle = grad;
          } else {
            this.ctx.fillStyle = ball.color;
          }

          this.ctx.fill();
          this.ctx.globalAlpha = 1;
        });

        this.animationId = requestAnimationFrame(() => this.animate());
      }

      setupEventListeners() {
        this.handleResize = () => {
          const oldWidth = this.canvasLogicalWidth || 1;
          const oldHeight = this.canvasLogicalHeight || 1;
          this.setupCanvas();

          this.balls.forEach(ball => {
            ball.radius = this.getScaledRadius(ball.baseRadius || ball.radius);
            ball.x = Math.min(this.canvasLogicalWidth - ball.radius, Math.max(ball.radius, ball.x * (this.canvasLogicalWidth / oldWidth)));
            ball.y = Math.min(this.canvasLogicalHeight - ball.radius, Math.max(ball.radius, ball.y * (this.canvasLogicalHeight / oldHeight)));
          });
        };

        window.addEventListener('resize', this.handleResize);

        const kickBalls = (clientX, clientY) => {
          const rect = this.canvas.getBoundingClientRect();
          const clickX = clientX - rect.left;
          const clickY = clientY - rect.top;

          this.balls.forEach(ball => {
            const dx = ball.x - clickX;
            const dy = ball.y - clickY;
            const distance = Math.sqrt(dx * dx + dy * dy);

            if (distance < 150) {
              const angle = Math.atan2(dy, dx);
              const force = ((150 - distance) / 150) * 8;
              ball.vx += Math.cos(angle) * force;
              ball.vy += Math.sin(angle) * force;
            }
          });
        };

        this.canvas.addEventListener('pointerdown', (event) => {
          kickBalls(event.clientX, event.clientY);
        });
      }
    }

    if (!customElements.get('bouncy-balls-{{ ai_gen_id }}')) {
      customElements.define('bouncy-balls-{{ ai_gen_id }}', BouncyBalls{{ ai_gen_id }});
    }
  })();
</script>

<script>
  (function() {
    var highlights = document.querySelectorAll('.ned-highlight');
    if (!highlights.length) return;

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('ned-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });

    highlights.forEach(function(el) {
      observer.observe(el);
    });
  })();
</script>

