{% doc %}
  @prompt
    Adaptive no-crop Bouncy Balls section for a luxury brand.
    Keeps the original interactive balls and dotted flight path, removes all headline and service text, and replaces the flattened image with a responsive navy CSS halftone field.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bouncy-balls-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height:
      {% case block.settings.height_preset %}
        {% when 'hero' %} clamp(420px, 70vh, 720px)
        {% when 'banner' %} clamp(260px, 42vh, 420px)
        {% when 'compact' %} clamp(180px, 28vh, 320px)
        {% else %} {{ block.settings.desktop_height }}px
      {% endcase %};
    min-height: 150px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.background_color }};
    touch-action: pan-y;
  }

  #shopify-block-{{ block.id }},
  .shopify-section:has(.ai-bouncy-balls-{{ ai_gen_id }}) {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  {% if block.settings.white_mode %}
    .ai-bouncy-balls-{{ ai_gen_id }} {
      background-color: #FFFFFF;
    }
  {% endif %}

  .ai-bouncy-balls-{{ ai_gen_id }} {
    height: auto;
    min-height: 0;
    aspect-ratio: 246.47 / 94.65;
    background-color: #0C1D43;
    background-image:
      radial-gradient(circle, rgba(255, 255, 255, 0.24) 0 0.62px, transparent 0.78px),
      radial-gradient(circle, rgba(255, 255, 255, 0.10) 0 0.38px, transparent 0.55px);
    background-size: 5.86px 5.86px, 5.86px 5.86px;
    background-position: 0 0, 2.93px 2.93px;
    background-repeat: repeat;
  }

  .ai-bouncy-balls-route-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .ai-bouncy-balls-overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    pointer-events: none;
    z-index: 1;
  }

  .ai-bouncy-balls-canvas-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
    z-index: 1;
    pointer-events: auto;
    touch-action: pan-y;
  }

  .ai-bouncy-balls-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 40px 20px;
    pointer-events: none;
    max-width: 900px;
  }

  .ai-bouncy-balls-headline-{{ ai_gen_id }} {
    font-family: "Helvetica Neue", "Arial Narrow", Arial, sans-serif;
    font-weight: 300;
    font-size: clamp(34px, 5.2vw, 60px);
    line-height: 1.05;
    margin: 0 0 14px;
    color: {{ block.settings.text_color }};
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .ai-bouncy-balls-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    line-height: 1.5;
    margin: 0 0 24px;
    color: {{ block.settings.text_color }};
    opacity: 0.9;
  }

  .ai-bouncy-balls-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 10px 22px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
    border: 1px solid {{ block.settings.button_bg_color }};
    border-radius: 6px;
    transition: background-color 0.2s ease, color 0.2s ease;
    pointer-events: auto;
  }

  .ai-bouncy-balls-button-{{ ai_gen_id }}:hover {
    background-color: transparent;
    color: {{ block.settings.button_bg_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-bouncy-balls-{{ ai_gen_id }} {
      height: auto;
      min-height: {{ block.settings.mobile_height }}px;
      max-height: none;
    }

    .ai-bouncy-balls-{{ ai_gen_id }} {
      min-height: 0;
      aspect-ratio: 246.47 / 94.65;
    }

    .ai-bouncy-balls-headline-{{ ai_gen_id }} {
      font-size: clamp(30px, 9vw, 38px);
      line-height: 1.05;
    }

    .ai-bouncy-balls-subtext-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtext_size }}px * 0.85);
    }

    .ai-bouncy-balls-content-{{ ai_gen_id }} {
      padding: 30px 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-bouncy-balls-canvas-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<bouncy-balls-{{ ai_gen_id }}
  class="ai-bouncy-balls-{{ ai_gen_id }}"
  data-gradient-percent="{{ block.settings.gradient_percent }}"
  data-ball-count="{{ block.settings.ball_count }}"
  data-ball-size="{{ block.settings.ball_size }}"
  data-bounce-intensity="{{ block.settings.bounce_intensity }}"
  data-radius-min="{{ block.settings.ball_radius_min }}"
  data-radius-max="{{ block.settings.ball_radius_max }}"
  data-color-1="{{ block.settings.ball_color_1 }}"
  data-color-2="{{ block.settings.ball_color_2 }}"
  data-color-3="{{ block.settings.ball_color_3 }}"
  data-color-4="{{ block.settings.ball_color_4 }}"
  {{ block.shopify_attributes }}
