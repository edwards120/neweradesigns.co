{% doc %}
  @prompt
    A magazine-style editorial layout, headers, text, images, luxury high-class, subtext, able to change color. one boucy ball animation , can i be able to adjust image size, make sure its adjustable on all devices with a backgound image
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-layout-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-editorial-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .ai-editorial-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: {{ block.settings.background_opacity | divided_by: 100.0 }};
  }

  .ai-editorial-background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
    opacity: 0.3;
  }

  .ai-editorial-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    max-width: {{ block.settings.content_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
  }

  .ai-editorial-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-editorial-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-editorial-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 400;
    margin-bottom: 12px;
  }

  .ai-editorial-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    font-weight: 300;
    line-height: 1.2;
    margin: 0 0 16px;
    letter-spacing: -0.5px;
  }

  .ai-editorial-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    font-weight: 400;
    line-height: 1.6;
    margin: 0;
  }

  .ai-editorial-body-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_text_size }}px;
    color: {{ block.settings.body_text_color }};
    line-height: 1.8;
    margin-bottom: {{ block.settings.text_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-editorial-image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    margin-bottom: {{ block.settings.image_spacing }}px;
  }

  .ai-editorial-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.image_width }}%;
    margin: 0 auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-editorial-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-editorial-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    padding-bottom: 75%;
    background-color: #f4f4f4;
    position: relative;
  }

  .ai-editorial-image-placeholder-{{ ai_gen_id }} svg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60%;
    height: 60%;
  }

  .ai-editorial-ball-{{ ai_gen_id }} {
    position: absolute;
    width: {{ block.settings.ball_size }}px;
    height: {{ block.settings.ball_size }}px;
    background: {{ block.settings.ball_color }};
    border-radius: 50%;
    top: {{ block.settings.ball_start_y }}%;
    left: {{ block.settings.ball_start_x }}%;
    z-index: 2;
  }

  @media screen and (min-width: 750px) {
    .ai-editorial-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-content-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.6 }}px {{ block.settings.padding_horizontal | times: 0.6 }}px {{ block.settings.padding_bottom | times: 0.6 }}px;
    }

    .ai-editorial-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-editorial-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }

    .ai-editorial-body-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_text_size | times: 0.9 }}px;
    }

    .ai-editorial-image-wrapper-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-editorial-ball-{{ ai_gen_id }} {
      width: {{ block.settings.ball_size | times: 0.7 }}px;
      height: {{ block.settings.ball_size | times: 0.7 }}px;
    }
  }
{% endstyle %}

<magazine-editorial-{{ ai_gen_id }}
  class="ai-editorial-layout-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-editorial-background-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-editorial-background-placeholder-{{ ai_gen_id }}">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-editorial-content-{{ ai_gen_id }}">
    {% if block.settings.show_header %}
      <div class="ai-editorial-header-{{ ai_gen_id }}">
        {% if block.settings.eyebrow != blank %}
          <div class="ai-editorial-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</div>
        {% endif %}
        {% if block.settings.heading != blank %}
          <h2 class="ai-editorial-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <div class="ai-editorial-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-editorial-grid-{{ ai_gen_id }}">
      {% if block.settings.show_image_1 %}
        <div class="ai-editorial-image-container-{{ ai_gen_id }}">
          <div class="ai-editorial-image-wrapper-{{ ai_gen_id }}">
            {% if block.settings.image_1 %}
              <img
                src="{{ block.settings.image_1 | image_url: width: 1200 }}"
                alt="{{ block.settings.image_1.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.image_1.width }}"
                height="{{ block.settings.image_1.height }}"
                class="ai-editorial-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-editorial-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.body_text != blank %}
        <div class="ai-editorial-body-text-{{ ai_gen_id }}">
          {{ block.settings.body_text }}
        </div>
      {% endif %}

      {% if block.settings.show_image_2 %}
        <div class="ai-editorial-image-container-{{ ai_gen_id }}">
          <div class="ai-editorial-image-wrapper-{{ ai_gen_id }}">
            {% if block.settings.image_2 %}
              <img
                src="{{ block.settings.image_2 | image_url: width: 1200 }}"
                alt="{{ block.settings.image_2.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.image_2.width }}"
                height="{{ block.settings.image_2.height }}"
                class="ai-editorial-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-editorial-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  {% if block.settings.show_ball %}
    <div
      class="ai-editorial-ball-{{ ai_gen_id }}"
      data-ball
    ></div>
  {% endif %}
</magazine-editorial-{{ ai_gen_id }}>

<script>
  (function() {
    class MagazineEditorial{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.ball = this.querySelector('[data-ball]');
        this.container = this;
      }

      connectedCallback() {
        if (this.ball) {
          this.initBallAnimation();
        }
      }

      initBallAnimation() {
        const containerRect = this.container.getBoundingClientRect();
        const ballSize = parseFloat(getComputedStyle(this.ball).width);
        
        let x = parseFloat(this.ball.style.left) || {{ block.settings.ball_start_x }};
        let y = parseFloat(this.ball.style.top) || {{ block.settings.ball_start_y }};
        let vx = {{ block.settings.ball_speed }};
        let vy = {{ block.settings.ball_speed }};
        
        const gravity = 0.3;
        const damping = 0.85;
        const minSpeed = 1;

        const animate = () => {
          vy += gravity;
          x += vx;
          y += vy;

          const maxX = 100 - (ballSize / containerRect.width * 100);
          const maxY = 100 - (ballSize / containerRect.height * 100);

          if (x <= 0 || x >= maxX) {
            vx = -vx * damping;
            x = x <= 0 ? 0 : maxX;
            if (Math.abs(vx) < minSpeed) vx = vx > 0 ? minSpeed : -minSpeed;
          }

          if (y <= 0 || y >= maxY) {
            vy = -vy * damping;
            y = y <= 0 ? 0 : maxY;
            if (Math.abs(vy) < minSpeed) vy = vy > 0 ? minSpeed : -minSpeed;
          }

          this.ball.style.left = x + '%';
          this.ball.style.top = y + '%';

          requestAnimationFrame(animate);
        };

        animate();
      }
    }

    customElements.define('magazine-editorial-{{ ai_gen_id }}', MagazineEditorial{{ ai_gen_id }});
  })();
</script>

