{% doc %}
  @prompt
    Create an interactive halftone text section.
    The halftone dots should be small, high-quality, and closely grouped so the text is easy to read (for example: “NEW ERA” or “JOIN THE NEW ERA”).
    When the user moves their cursor or touches the screen, the halftones should gently react within a small radius (about 2–10).
    After interaction, the dots should slowly float back to their original position, with a soft zero-gravity feel.
    Keep the design minimal, balanced, and elegant — no large gaps, no aggressive movement.
    The section must be fully responsive, editable text, and smooth on all devices.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-halftone-text-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-halftone-text-container-{{ ai_gen_id }} {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    position: relative;
    display: flex;
    justify-content: center;
  }

  .ai-halftone-text-canvas-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    display: block;
    touch-action: none;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-halftone-text-{{ ai_gen_id }} {
      padding: 0;
      margin: 0;
    }
  }
{% endstyle %}

<halftone-text-{{ ai_gen_id }}
  class="ai-halftone-text-{{ ai_gen_id }}"
  data-text="{{ block.settings.text }}"
  data-font-size="{{ block.settings.font_size }}"
  data-dot-size="{{ block.settings.dot_size }}"
  data-dot-spacing="{{ block.settings.dot_spacing }}"
  data-dot-color="{{ block.settings.dot_color }}"
  data-interaction-radius="{{ block.settings.interaction_radius }}"
  data-displacement-strength="{{ block.settings.displacement_strength }}"
  data-return-speed="{{ block.settings.return_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-halftone-text-container-{{ ai_gen_id }}">
    <canvas class="ai-halftone-text-canvas-{{ ai_gen_id }}"></canvas>
  </div>
</halftone-text-{{ ai_gen_id }}>

<script>
(function() {
  class HalftoneText{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.canvas = this.querySelector('.ai-halftone-text-canvas-{{ ai_gen_id }}');
      this.ctx = this.canvas.getContext('2d');
      this.dots = [];
      this.mouse = { x: -1000, y: -1000 };
      this.animationId = null;
      this.resizeTimeout = null;
    }

    connectedCallback() {
      this.text = this.dataset.text || 'NEW ERA';
      this.fontSize = parseInt(this.dataset.fontSize) || 120;
      this.dotSize = parseFloat(this.dataset.dotSize) || 3;
      this.dotSpacing = parseFloat(this.dataset.dotSpacing) || 5;
      this.dotColor = this.dataset.dotColor || '#000000';
      this.interactionRadius = parseFloat(this.dataset.interactionRadius) || 50;
      this.displacementStrength = parseFloat(this.dataset.displacementStrength) || 8;
      this.returnSpeed = parseFloat(this.dataset.returnSpeed) / 100 || 0.08;

      this.init();
      this.setupEventListeners();
      this.animate();
    }

    disconnectedCallback() {
      if (this.animationId) {
        cancelAnimationFrame(this.animationId);
      }
      window.removeEventListener('resize', this.handleResize);
      this.canvas.removeEventListener('mousemove', this.handleMouseMove);
      this.canvas.removeEventListener('touchmove', this.handleTouchMove);
      this.canvas.removeEventListener('mouseleave', this.handleMouseLeave);
      this.canvas.removeEventListener('touchend', this.handleTouchEnd);
    }

    init() {
      this.setCanvasSize();
      this.createHalftoneDots();
    }

    setCanvasSize() {
      const dpr = window.devicePixelRatio || 1;
      const tempCanvas = document.createElement('canvas');
      const tempCtx = tempCanvas.getContext('2d');

      const containerWidth = this.clientWidth || window.innerWidth;
      const responsiveFontSize = Math.min(this.fontSize, containerWidth * 0.22);

      tempCtx.font = `bold ${responsiveFontSize}px ${getComputedStyle(document.body).fontFamily}`;
      const metrics = tempCtx.measureText(this.text);
      const textWidth = Math.ceil(metrics.width);
      const textHeight = Math.ceil(responsiveFontSize * 1.2);

      this.canvas.width = Math.max(1, textWidth * dpr);
      this.canvas.height = Math.max(1, textHeight * dpr);
      this.canvas.style.width = textWidth + 'px';
      this.canvas.style.height = textHeight + 'px';

      this.ctx.setTransform(1, 0, 0, 1, 0, 0);
      this.ctx.scale(dpr, dpr);

      this.canvasWidth = textWidth;
      this.canvasHeight = textHeight;
      this.renderFontSize = responsiveFontSize;
    }

    createHalftoneDots() {
      this.dots = [];

      const tempCanvas = document.createElement('canvas');
      tempCanvas.width = this.canvasWidth;
      tempCanvas.height = this.canvasHeight;
      const tempCtx = tempCanvas.getContext('2d');

      tempCtx.clearRect(0, 0, this.canvasWidth, this.canvasHeight);
      tempCtx.fillStyle = '#000000';
      tempCtx.font = `bold ${this.renderFontSize}px ${getComputedStyle(document.body).fontFamily}`;
      tempCtx.textBaseline = 'top';
      tempCtx.fillText(this.text, 0, 0);

      const imageData = tempCtx.getImageData(0, 0, this.canvasWidth, this.canvasHeight);
      const data = imageData.data;

      for (let y = 0; y < this.canvasHeight; y += this.dotSpacing) {
        for (let x = 0; x < this.canvasWidth; x += this.dotSpacing) {
          const index = (Math.floor(y) * this.canvasWidth + Math.floor(x)) * 4;
          const alpha = data[index + 3];

          if (alpha > 128) {
            this.dots.push({
              x: x,
              y: y,
              originalX: x,
              originalY: y,
              vx: 0,
              vy: 0,
              size: this.dotSize
            });
          }
        }
      }
    }

    setupEventListeners() {
      this.handleResize = () => {
        clearTimeout(this.resizeTimeout);
        this.resizeTimeout = setTimeout(() => {
          this.init();
        }, 250);
      };

      this.handleMouseMove = (e) => {
        const rect = this.canvas.getBoundingClientRect();
        this.mouse.x = e.clientX - rect.left;
        this.mouse.y = e.clientY - rect.top;
      };

      this.handleTouchMove = (e) => {
        e.preventDefault();
        const rect = this.canvas.getBoundingClientRect();
        const touch = e.touches[0];
        this.mouse.x = touch.clientX - rect.left;
        this.mouse.y = touch.clientY - rect.top;
      };

      this.handleMouseLeave = () => {
        this.mouse.x = -1000;
        this.mouse.y = -1000;
      };

      this.handleTouchEnd = () => {
        this.mouse.x = -1000;
        this.mouse.y = -1000;
      };

      window.addEventListener('resize', this.handleResize);
      this.canvas.addEventListener('mousemove', this.handleMouseMove);
      this.canvas.addEventListener('touchmove', this.handleTouchMove, { passive: false });
      this.canvas.addEventListener('mouseleave', this.handleMouseLeave);
      this.canvas.addEventListener('touchend', this.handleTouchEnd);
    }

    animate() {
      this.ctx.clearRect(0, 0, this.canvasWidth, this.canvasHeight);

      this.dots.forEach(dot => {
        const dx = this.mouse.x - dot.x;
        const dy = this.mouse.y - dot.y;
        const distance = Math.sqrt(dx * dx + dy * dy);

        if (distance < this.interactionRadius) {
          const force = (this.interactionRadius - distance) / this.interactionRadius;
          const angle = Math.atan2(dy, dx);
          const pushX = -Math.cos(angle) * force * this.displacementStrength;
          const pushY = -Math.sin(angle) * force * this.displacementStrength;

          dot.vx += pushX * 0.1;
          dot.vy += pushY * 0.1;
        }

        const returnX = (dot.originalX - dot.x) * this.returnSpeed;
        const returnY = (dot.originalY - dot.y) * this.returnSpeed;
        dot.vx += returnX;
        dot.vy += returnY;

        dot.vx *= 0.92;
        dot.vy *= 0.92;

        dot.x += dot.vx;
        dot.y += dot.vy;

        this.ctx.fillStyle = this.dotColor;
        this.ctx.beginPath();
        this.ctx.arc(dot.x, dot.y, dot.size / 2, 0, Math.PI * 2);
        this.ctx.fill();
      });

      this.animationId = requestAnimationFrame(() => this.animate());
    }
  }

  if (!customElements.get('halftone-text-{{ ai_gen_id }}')) {
    customElements.define('halftone-text-{{ ai_gen_id }}', HalftoneText{{ ai_gen_id }});
  }
})();
</script>

{% schema %}
{
  "name": "Halftone text",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "NEW ERA"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Font size",
      "default": 120
    },
    {
      "type": "header",
      "content": "Halftone dots"
    },
    {
      "type": "range",
      "id": "dot_size",
      "min": 1,
      "max": 8,
      "step": 0.5,
      "unit": "px",
      "label": "Dot size",
      "default": 3
    },
    {
      "type": "range",
      "id": "dot_spacing",
      "min": 3,
      "max": 10,
      "step": 0.5,
      "unit": "px",
      "label": "Dot spacing",
      "default": 5
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#14213d"
    },
    {
      "type": "header",
      "content": "Interaction"
    },
    {
      "type": "range",
      "id": "interaction_radius",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Interaction radius",
      "default": 50
    },
    {
      "type": "range",
      "id": "displacement_strength",
      "min": 2,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Displacement strength",
      "default": 8
    },
    {
      "type": "range",
      "id": "return_speed",
      "min": 1,
      "max": 20,
      "step": 1,
      "label": "Return speed",
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 400,
      "max": 1400,
      "step": 100,
      "unit": "px",
      "label": "Maximum width",
      "default": 1000
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Halftone text"
    }
  ]
}
