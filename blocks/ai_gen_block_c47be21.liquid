{
  "name": "Interactive halftones",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Height",
      "default": 500
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Halftone dots"
    },
    {
      "type": "range",
      "id": "dot_size",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "px",
      "label": "Dot size",
      "default": 4
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 8,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Dot spacing",
      "default": 12
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary dot color",
      "default": "#FCA311"
    },
    {
      "type": "color",
      "id": "secondary_color",
      "label": "Secondary dot color",
      "default": "#14213D"
    },
    {
      "type": "header",
      "content": "Interaction"
    },
    {
      "type": "range",
      "id": "interaction_radius",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Interaction radius",
      "default": 50
    },
    {
      "type": "range",
      "id": "return_speed",
      "min": 0,
      "max": 0.5,
      "step": 0.1,
      "label": "Return speed",
      "default": 0.1
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Interactive halftones"
    }
  ]
}
{% endschema %}
