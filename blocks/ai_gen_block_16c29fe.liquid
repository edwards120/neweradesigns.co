{% doc %}
  @prompt
    Write a four-step design process for a luxury signage project, focusing on Site Analysis, Conceptual Sketching, Material Selection, and Final Production.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-design-process-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-design-process-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-design-process-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-design-process-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    font-weight: 300;
    letter-spacing: 1px;
  }

  .ai-design-process-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-design-process-steps-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: {{ block.settings.step_gap }}px;
    margin-top: {{ block.settings.steps_top_margin }}px;
  }

  .ai-design-process-step-{{ ai_gen_id }} {
    background-color: {{ block.settings.step_background }};
    padding: {{ block.settings.step_padding }}px;
    border-radius: {{ block.settings.step_border_radius }}px;
    border: {{ block.settings.step_border_width }}px solid {{ block.settings.step_border_color }};
    position: relative;
    overflow: hidden;
  }

  .ai-design-process-step-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.number_size }}px;
    font-weight: 300;
    color: {{ block.settings.accent_color }};
    margin: 0 0 12px;
    line-height: 1;
  }

  .ai-design-process-step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_title_size }}px;
    color: {{ block.settings.step_title_color }};
    margin: 0 0 12px;
    font-weight: 400;
  }

  .ai-design-process-step-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_description_size }}px;
    color: {{ block.settings.step_description_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-design-process-step-accent-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background-color: {{ block.settings.accent_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-design-process-steps-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-design-process-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-design-process-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }
  }
{% endstyle %}

<design-process-{{ ai_gen_id }} class="ai-design-process-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-design-process-container-{{ ai_gen_id }}">
    {% if block.settings.show_header %}
      <div class="ai-design-process-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-design-process-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <div class="ai-design-process-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-design-process-steps-{{ ai_gen_id }}">
      <div class="ai-design-process-step-{{ ai_gen_id }}">
        <div class="ai-design-process-step-accent-{{ ai_gen_id }}"></div>
        <div class="ai-design-process-step-number-{{ ai_gen_id }}">01</div>
        <h3 class="ai-design-process-step-title-{{ ai_gen_id }}">{{ block.settings.step_1_title }}</h3>
        <div class="ai-design-process-step-description-{{ ai_gen_id }}">{{ block.settings.step_1_description }}</div>
      </div>

      <div class="ai-design-process-step-{{ ai_gen_id }}">
        <div class="ai-design-process-step-accent-{{ ai_gen_id }}"></div>
        <div class="ai-design-process-step-number-{{ ai_gen_id }}">02</div>
        <h3 class="ai-design-process-step-title-{{ ai_gen_id }}">{{ block.settings.step_2_title }}</h3>
        <div class="ai-design-process-step-description-{{ ai_gen_id }}">{{ block.settings.step_2_description }}</div>
      </div>

      <div class="ai-design-process-step-{{ ai_gen_id }}">
        <div class="ai-design-process-step-accent-{{ ai_gen_id }}"></div>
        <div class="ai-design-process-step-number-{{ ai_gen_id }}">03</div>
        <h3 class="ai-design-process-step-title-{{ ai_gen_id }}">{{ block.settings.step_3_title }}</h3>
        <div class="ai-design-process-step-description-{{ ai_gen_id }}">{{ block.settings.step_3_description }}</div>
      </div>

      <div class="ai-design-process-step-{{ ai_gen_id }}">
        <div class="ai-design-process-step-accent-{{ ai_gen_id }}"></div>
        <div class="ai-design-process-step-number-{{ ai_gen_id }}">04</div>
        <h3 class="ai-design-process-step-title-{{ ai_gen_id }}">{{ block.settings.step_4_title }}</h3>
        <div class="ai-design-process-step-description-{{ ai_gen_id }}">{{ block.settings.step_4_description }}</div>
      </div>
    </div>
  </div>
</design-process-{{ ai_gen_id }}>

<script>
  (function() {
    class DesignProcess{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('design-process-{{ ai_gen_id }}', DesignProcess{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Design process",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show header",
      "default": true
    },
    {
      "type": "inline_richtext",
