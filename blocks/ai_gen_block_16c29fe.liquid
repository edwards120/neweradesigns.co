      "type": "inline_richtext",
      "id": "step_1_title",
      "label": "Title",
      "default": "Site Analysis"
    },
    {
      "type": "richtext",
      "id": "step_1_description",
      "label": "Description",
      "default": "<p>We evaluate your space, architecture, and brand identity to understand the environment and context for your signage.</p>"
    },
    {
      "type": "header",
      "content": "Step 2"
    },
    {
      "type": "inline_richtext",
      "id": "step_2_title",
      "label": "Title",
      "default": "Conceptual Sketching"
    },
    {
      "type": "richtext",
      "id": "step_2_description",
      "label": "Description",
      "default": "<p>Our designers create initial sketches and renderings that capture your vision and align with your brand aesthetic.</p>"
    },
    {
      "type": "header",
      "content": "Step 3"
    },
    {
      "type": "inline_richtext",
