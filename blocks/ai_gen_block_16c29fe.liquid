    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle",
      "default": "#242833"
    },
    {
      "type": "color",
      "id": "step_background",
      "label": "Step background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "step_title_color",
      "label": "Step title",
      "default": "#14213d"
    },
    {
      "type": "color",
      "id": "step_description_color",
