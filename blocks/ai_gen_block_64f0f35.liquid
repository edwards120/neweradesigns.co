{% doc %}
  @prompt
    An interactive vertical timeline that highlights as the user scrolls, can you add background image and remove whitespace 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 0;
    position: relative;
    background-color: {{ block.settings.background_color }};
    {% if block.settings.background_image %}
      background-image: url('{{ block.settings.background_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% endif %}
  }

  .ai-timeline-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-timeline-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    position: relative;
    padding: 60px 20px;
  }

  .ai-timeline-line-{{ ai_gen_id }} {
    position: absolute;
    left: {{ block.settings.line_position }}px;
    top: 60px;
    bottom: 60px;
    width: {{ block.settings.line_width }}px;
    background-color: {{ block.settings.line_color }};
    z-index: 1;
  }

  .ai-timeline-progress-{{ ai_gen_id }} {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 0%;
    background-color: {{ block.settings.active_line_color }};
    transition: height 0.3s ease-out;
  }

  .ai-timeline-items-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
  }

  .ai-timeline-item-{{ ai_gen_id }} {
    position: relative;
    padding-left: calc({{ block.settings.line_position }}px + {{ block.settings.line_width }}px + 40px);
    margin-bottom: 60px;
    opacity: 0.4;
    transition: opacity 0.5s ease;
  }

  .ai-timeline-item-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-timeline-dot-{{ ai_gen_id }} {
    position: absolute;
    left: calc({{ block.settings.line_position }}px - {{ block.settings.dot_size | divided_by: 2 }}px + {{ block.settings.line_width | divided_by: 2 }}px);
    top: 0;
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: {{ block.settings.dot_border_width }}px solid {{ block.settings.dot_border_color }};
    transition: all 0.5s ease;
    z-index: 3;
  }

  .ai-timeline-item-{{ ai_gen_id }}.active .ai-timeline-dot-{{ ai_gen_id }} {
    background-color: {{ block.settings.active_dot_color }};
    transform: scale(1.3);
    box-shadow: 0 0 0 {{ block.settings.dot_glow_size }}px {{ block.settings.active_dot_color }}33;
  }

  .ai-timeline-content-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    padding: {{ block.settings.card_padding }}px;
    border-radius: {{ block.settings.card_radius }}px;
    border-left: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
  }

  .ai-timeline-item-{{ ai_gen_id }}.active .ai-timeline-content-{{ ai_gen_id }} {
    border-left-color: {{ block.settings.active_card_border_color }};
  }

  .ai-timeline-date-{{ ai_gen_id }} {
    font-size: {{ block.settings.date_size }}px;
    color: {{ block.settings.date_color }};
    margin-bottom: 8px;
    font-weight: 600;
  }

  .ai-timeline-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px 0;
    font-weight: 700;
  }

  .ai-timeline-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-timeline-container-{{ ai_gen_id }} {
      padding: 40px 20px;
    }

    .ai-timeline-line-{{ ai_gen_id }} {
      left: calc({{ block.settings.line_position | times: 0.5 }}px);
      top: 40px;
      bottom: 40px;
    }

    .ai-timeline-item-{{ ai_gen_id }} {
      padding-left: calc({{ block.settings.line_position | times: 0.5 }}px + {{ block.settings.line_width }}px + 30px);
    }

    .ai-timeline-dot-{{ ai_gen_id }} {
      left: calc({{ block.settings.line_position | times: 0.5 }}px - {{ block.settings.dot_size | divided_by: 2 }}px + {{ block.settings.line_width | divided_by: 2 }}px);
    }

    .ai-timeline-content-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<scroll-timeline-{{ ai_gen_id }} class="ai-timeline-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.background_image %}
    <div class="ai-timeline-overlay-{{ ai_gen_id }}"></div>
  {% endif %}
  
  <div class="ai-timeline-container-{{ ai_gen_id }}">
    <div class="ai-timeline-line-{{ ai_gen_id }}">
      <div class="ai-timeline-progress-{{ ai_gen_id }}"></div>
    </div>

    <div class="ai-timeline-items-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign date_key = 'item_' | append: i | append: '_date'
          assign title_key = 'item_' | append: i | append: '_title'
          assign description_key = 'item_' | append: i | append: '_description'
          assign enabled_key = 'item_' | append: i | append: '_enabled'

          assign item_date = block.settings[date_key]
          assign item_title = block.settings[title_key]
          assign item_description = block.settings[description_key]
          assign item_enabled = block.settings[enabled_key]
        %}

        {% if item_enabled %}
          <div class="ai-timeline-item-{{ ai_gen_id }}" data-timeline-item>
            <div class="ai-timeline-dot-{{ ai_gen_id }}"></div>
            <div class="ai-timeline-content-{{ ai_gen_id }}">
              {% if item_date != blank %}
                <div class="ai-timeline-date-{{ ai_gen_id }}">{{ item_date }}</div>
              {% endif %}
              {% if item_title != blank %}
                <h3 class="ai-timeline-title-{{ ai_gen_id }}">{{ item_title }}</h3>
              {% endif %}
              {% if item_description != blank %}
                <div class="ai-timeline-description-{{ ai_gen_id }}">{{ item_description }}</div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</scroll-timeline-{{ ai_gen_id }}>

<script>
  (function() {
    class ScrollTimeline{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.items = [];
        this.progressBar = null;
        this.timelineLine = null;
      }

      connectedCallback() {
        this.items = Array.from(this.querySelectorAll('[data-timeline-item]'));
        this.progressBar = this.querySelector('.ai-timeline-progress-{{ ai_gen_id }}');
        this.timelineLine = this.querySelector('.ai-timeline-line-{{ ai_gen_id }}');
        
        if (this.items.length > 0) {
          this.setupScrollListener();
          this.updateTimeline();
        }
      }

      setupScrollListener() {
        let ticking = false;
        
        window.addEventListener('scroll', () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              this.updateTimeline();
              ticking = false;
            });
            ticking = true;
          }
        });
      }

      updateTimeline() {
        const windowHeight = window.innerHeight;
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const timelineTop = this.timelineLine.getBoundingClientRect().top + scrollTop;
        const timelineHeight = this.timelineLine.offsetHeight;
        
        let activeIndex = -1;
        let maxProgress = 0;

        this.items.forEach((item, index) => {
          const itemTop = item.getBoundingClientRect().top + scrollTop;
          const itemMiddle = itemTop + (item.offsetHeight / 2);
          const viewportMiddle = scrollTop + (windowHeight / 2);

          if (viewportMiddle >= itemMiddle) {
            activeIndex = index;
            item.classList.add('active');
            
            const itemRelativePosition = itemTop - timelineTop;
            const progress = ((itemRelativePosition / timelineHeight) * 100);
            maxProgress = Math.min(Math.max(progress, 0), 100);
          } else {
            item.classList.remove('active');
          }
        });

        if (this.progressBar) {
          this.progressBar.style.height = maxProgress + '%';
        }
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.updateTimeline);
      }
    }

    customElements.define('scroll-timeline-{{ ai_gen_id }}', ScrollTimeline{{ ai_gen_id }});
  })();
</script>

