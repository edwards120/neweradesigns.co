{% doc %}
  @prompt
    Create an interactive bouncing-balls section that feels calm and luxurious, not playful.
    Must include:
    Background image upload + overlay opacity slider
    White background mode and black background mode toggles
    Bouncing circles that collide with edges and bounce continuously (not drifting)
    Click/tap adds a subtle impulse to nearby balls
    Ball style:
    Flat solid fill only, no gradients, no shadows
    Colors only: #FCA311, #FFFFFF, #0A1821
    Settings:
    Height: desktop 150px, mobile 150px (responsive, allow up to 320px)
    Ball count 6–12
    Size range min/max sliders
    Bounce intensity: calm/moderate/energetic
    Output should contain only the animated balls + background (no typography).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bouncing-balls-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    height: {{ block.settings.height_mobile }}px;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .ai-bouncing-balls-{{ ai_gen_id }} {
      height: {{ block.settings.height_desktop }}px;
    }
  }

  .ai-bouncing-balls-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-bouncing-balls-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-bouncing-balls-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    {% if block.settings.background_mode == 'white' %}
      background-color: rgba(255, 255, 255, {{ block.settings.overlay_opacity }});
    {% else %}
      background-color: rgba(10, 24, 33, {{ block.settings.overlay_opacity }});
    {% endif %}
  }

  .ai-bouncing-balls-canvas-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    cursor: pointer;
  }
{% endstyle %}

<bouncing-balls-{{ ai_gen_id }}
  class="ai-bouncing-balls-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-ball-count="{{ block.settings.ball_count }}"
  data-min-size="{{ block.settings.ball_size_min }}"
  data-max-size="{{ block.settings.ball_size_max }}"
  data-bounce-intensity="{{ block.settings.bounce_intensity }}"
>
  <div class="ai-bouncing-balls-background-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% endif %}
  </div>

  <div class="ai-bouncing-balls-overlay-{{ ai_gen_id }}"></div>

  <canvas class="ai-bouncing-balls-canvas-{{ ai_gen_id }}"></canvas>
</bouncing-balls-{{ ai_gen_id }}>

<script>
  (function() {
    class BouncingBalls{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.canvas = null;
        this.ctx = null;
        this.balls = [];
        this.animationId = null;
        this.colors = ['#FCA311', '#FFFFFF', '#0A1821'];
      }

      connectedCallback() {
        this.canvas = this.querySelector('.ai-bouncing-balls-canvas-{{ ai_gen_id }}');
        this.ctx = this.canvas.getContext('2d');
        
        this.setupCanvas();
        this.initBalls();
        this.animate();
        
        window.addEventListener('resize', () => this.handleResize());
        this.canvas.addEventListener('click', (e) => this.handleClick(e));
        this.canvas.addEventListener('touchstart', (e) => this.handleTouch(e));
      }

      disconnectedCallback() {
        if (this.animationId) {
          cancelAnimationFrame(this.animationId);
        }
        window.removeEventListener('resize', () => this.handleResize());
      }

      setupCanvas() {
        const rect = this.getBoundingClientRect();
        this.canvas.width = rect.width;
        this.canvas.height = rect.height;
      }

      handleResize() {
        this.setupCanvas();
      }

      initBalls() {
        const ballCount = parseInt(this.dataset.ballCount);
        const minSize = parseInt(this.dataset.minSize);
        const maxSize = parseInt(this.dataset.maxSize);
        const intensity = this.dataset.bounceIntensity;
        
        let speedMultiplier = 1;
        if (intensity === 'calm') {
          speedMultiplier = 0.5;
        } else if (intensity === 'energetic') {
          speedMultiplier = 1.5;
        }

        this.balls = [];
        
        for (let i = 0; i < ballCount; i++) {
          const size = minSize + Math.random() * (maxSize - minSize);
          const x = size + Math.random() * (this.canvas.width - size * 2);
          const y = size + Math.random() * (this.canvas.height - size * 2);
          const vx = (Math.random() - 0.5) * 2 * speedMultiplier;
          const vy = (Math.random() - 0.5) * 2 * speedMultiplier;
          const color = this.colors[Math.floor(Math.random() * this.colors.length)];
          
          this.balls.push({ x, y, vx, vy, size, color });
        }
      }

      handleClick(e) {
        const rect = this.canvas.getBoundingClientRect();
        const clickX = e.clientX - rect.left;
        const clickY = e.clientY - rect.top;
        
        this.balls.forEach(ball => {
          const dx = ball.x - clickX;
          const dy = ball.y - clickY;
          const distance = Math.sqrt(dx * dx + dy * dy);
          
          if (distance < 150) {
            const angle = Math.atan2(dy, dx);
            const force = (150 - distance) / 150 * 0.5;
            ball.vx += Math.cos(angle) * force;
            ball.vy += Math.sin(angle) * force;
          }
        });
      }

      handleTouch(e) {
        e.preventDefault();
        const rect = this.canvas.getBoundingClientRect();
        const touch = e.touches[0];
        const clickX = touch.clientX - rect.left;
        const clickY = touch.clientY - rect.top;
        
        this.balls.forEach(ball => {
          const dx = ball.x - clickX;
          const dy = ball.y - clickY;
          const distance = Math.sqrt(dx * dx + dy * dy);
          
          if (distance < 150) {
            const angle = Math.atan2(dy, dx);
            const force = (150 - distance) / 150 * 0.5;
            ball.vx += Math.cos(angle) * force;
            ball.vy += Math.sin(angle) * force;
          }
        });
      }

      updateBalls() {
        this.balls.forEach(ball => {
          ball.x += ball.vx;
          ball.y += ball.vy;

          if (ball.x - ball.size <= 0) {
            ball.x = ball.size;
            ball.vx = Math.abs(ball.vx);
          } else if (ball.x + ball.size >= this.canvas.width) {
            ball.x = this.canvas.width - ball.size;
            ball.vx = -Math.abs(ball.vx);
          }

          if (ball.y - ball.size <= 0) {
            ball.y = ball.size;
            ball.vy = Math.abs(ball.vy);
          } else if (ball.y + ball.size >= this.canvas.height) {
            ball.y = this.canvas.height - ball.size;
            ball.vy = -Math.abs(ball.vy);
          }
        });
      }

      drawBalls() {
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
        
        this.balls.forEach(ball => {
          this.ctx.beginPath();
          this.ctx.arc(ball.x, ball.y, ball.size, 0, Math.PI * 2);
          this.ctx.fillStyle = ball.color;
          this.ctx.fill();
        });
      }

      animate() {
        this.updateBalls();
        this.drawBalls();
        this.animationId = requestAnimationFrame(() => this.animate());
      }
    }

    customElements.define('bouncing-balls-{{ ai_gen_id }}', BouncingBalls{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Bouncing balls",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "radio",
      "id": "background_mode",
      "label": "Background mode",
      "options": [
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "black",
          "label": "Black"
        }
      ],
      "default": "white"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "Overlay opacity",
      "default": 0.5
    },
    {
      "type": "header",
      "content": "Dimensions"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 150,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Desktop height",
      "default": 150
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 150,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Mobile height",
      "default": 150
    },
    {
      "type": "header",
      "content": "Ball settings"
    },
    {
      "type": "range",
      "id": "ball_count",
      "min": 6,
      "max": 12,
      "step": 1,
      "label": "Ball count",
      "default": 8
    },
    {
      "type": "range",
      "id": "ball_size_min",
      "min": 10,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Minimum size",
      "default": 12
    },
    {
      "type": "range",
      "id": "ball_size_max",
      "min": 30,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Maximum size",
      "default": 40
    },
    {
      "type": "select",
      "id": "bounce_intensity",
      "label": "Bounce intensity",
      "options": [
        {
          "value": "calm",
          "label": "Calm"
        },
        {
          "value": "moderate",
          "label": "Moderate"
        },
        {
          "value": "energetic",
          "label": "Energetic"
        }
      ],
      "default": "moderate"
    }
  ],
  "presets": [
    {
      "name": "Bouncing balls"
    }
  ]
}
{% endschema %}
