{% doc %}
  @prompt
    modern and sleek carousel for products, can you have the images too
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-carousel__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-product-carousel__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 32px;
  }

  .ai-product-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 8px;
    font-weight: 600;
  }

  .ai-product-carousel__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-product-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-product-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 4px;
  }

  .ai-product-carousel__track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-product-carousel__card-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - {{ block.settings.gap }}px * ({{ block.settings.products_per_row }} - 1)) / {{ block.settings.products_per_row }});
    min-width: 250px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
  }

  .ai-product-carousel__card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 50.0 }});
  }

  .ai-product-carousel__image-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
  }

  .ai-product-carousel__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_ratio }}%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-product-carousel__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-product-carousel__card-{{ ai_gen_id }}:hover .ai-product-carousel__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-product-carousel__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-product-carousel__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-carousel__badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    z-index: 1;
  }

  .ai-product-carousel__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-product-carousel__vendor-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.vendor_color }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }

  .ai-product-carousel__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    font-weight: 500;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-decoration: none;
  }

  .ai-product-carousel__product-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-product-carousel__product-title-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.heading_color }};
  }

  .ai-product-carousel__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-product-carousel__compare-price-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    font-size: {{ block.settings.price_size | minus: 2 }}px;
  }

  .ai-product-carousel__nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    background-color: {{ block.settings.nav_background }};
    color: {{ block.settings.nav_icon_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    z-index: 2;
  }

  .ai-product-carousel__nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_hover_background }};
    transform: translateY(-50%) scale(1.1);
  }

  .ai-product-carousel__nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-product-carousel__nav-{{ ai_gen_id }}:disabled:hover {
    transform: translateY(-50%) scale(1);
  }

  .ai-product-carousel__nav--prev-{{ ai_gen_id }} {
    left: -24px;
  }

  .ai-product-carousel__nav--next-{{ ai_gen_id }} {
    right: -24px;
  }

  .ai-product-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
  }

  .ai-product-carousel__dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .ai-product-carousel__dot-{{ ai_gen_id }}.active {
    opacity: 1;
    width: 24px;
    border-radius: 4px;
  }

  .ai-product-carousel__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-product-carousel__empty-state-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    margin-bottom: 16px;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-product-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.gap }}px * ({{ block.settings.products_per_row_tablet }} - 1)) / {{ block.settings.products_per_row_tablet }});
    }

    .ai-product-carousel__nav-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }

    .ai-product-carousel__nav--prev-{{ ai_gen_id }} {
      left: -20px;
    }

    .ai-product-carousel__nav--next-{{ ai_gen_id }} {
      right: -20px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.gap }}px * ({{ block.settings.products_per_row_mobile }} - 1)) / {{ block.settings.products_per_row_mobile }});
    }

    .ai-product-carousel__nav-{{ ai_gen_id }} {
      display: none;
    }

    .ai-product-carousel__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<product-carousel-{{ ai_gen_id }} class="ai-product-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-product-carousel__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-product-carousel__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-product-carousel__subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.collection != blank %}
      <div class="ai-product-carousel__wrapper-{{ ai_gen_id }}">
        {% if block.settings.show_navigation %}
          <button class="ai-product-carousel__nav-{{ ai_gen_id }} ai-product-carousel__nav--prev-{{ ai_gen_id }}" aria-label="Previous products">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
        {% endif %}

        <div class="ai-product-carousel__track-{{ ai_gen_id }}">
          {% for product in block.settings.collection.products limit: block.settings.products_limit %}
            <div class="ai-product-carousel__card-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-product-carousel__image-link-{{ ai_gen_id }}">
                <div class="ai-product-carousel__image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 800 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      class="ai-product-carousel__image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="800"
                      height="800"
                    >
                  {% else %}
                    <div class="ai-product-carousel__image-placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}

                  {% if block.settings.show_badge %}
                    {% if product.compare_at_price > product.price %}
                      <span class="ai-product-carousel__badge-{{ ai_gen_id }}">Sale</span>
                    {% elsif product.available == false %}
                      <span class="ai-product-carousel__badge-{{ ai_gen_id }}">Sold out</span>
                    {% endif %}
                  {% endif %}
                </div>
              </a>

              <div class="ai-product-carousel__content-{{ ai_gen_id }}">
                {% if block.settings.show_vendor and product.vendor != blank %}
                  <div class="ai-product-carousel__vendor-{{ ai_gen_id }}">{{ product.vendor }}</div>
                {% endif %}

                <h3 class="ai-product-carousel__product-title-{{ ai_gen_id }}">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>

                {% if block.settings.show_price %}
                  <div class="ai-product-carousel__price-{{ ai_gen_id }}">
                    <span>{{ product.price | money }}</span>
                    {% if product.compare_at_price > product.price %}
                      <span class="ai-product-carousel__compare-price-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

        {% if block.settings.show_navigation %}
          <button class="ai-product-carousel__nav-{{ ai_gen_id }} ai-product-carousel__nav--next-{{ ai_gen_id }}" aria-label="Next products">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        {% endif %}
      </div>

      {% if block.settings.show_dots %}
        <div class="ai-product-carousel__dots-{{ ai_gen_id }}"></div>
      {% endif %}
    {% else %}
      <div class="ai-product-carousel__empty-state-{{ ai_gen_id }}">
        {{ 'product-1' | placeholder_svg_tag }}
        <p>Select a collection to display products</p>
      </div>
    {% endif %}
  </div>
</product-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('.ai-product-carousel__track-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-product-carousel__nav--prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-product-carousel__nav--next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-product-carousel__dots-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.ai-product-carousel__card-{{ ai_gen_id }}');
        this.currentIndex = 0;
      }

      connectedCallback() {
        if (!this.track) return;

        this.setupNavigation();
        this.setupDots();
        this.updateButtons();

        this.track.addEventListener('scroll', () => {
          this.updateCurrentIndex();
          this.updateButtons();
          this.updateDots();
        });

        window.addEventListener('resize', () => {
          this.updateButtons();
        });
      }

      setupNavigation() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.scrollPrev());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.scrollNext());
        }
      }

      setupDots() {
        if (!this.dotsContainer || this.cards.length === 0) return;

        const visibleCards = this.getVisibleCardsCount();
        const totalDots = Math.ceil(this.cards.length / visibleCards);

        for (let i = 0; i < totalDots; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-product-carousel__dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          if (i === 0) dot.classList.add('active');

          dot.addEventListener('click', () => {
            this.scrollToIndex(i * visibleCards);
          });

          this.dotsContainer.appendChild(dot);
        }
      }

      getVisibleCardsCount() {
        const width = window.innerWidth;
        if (width <= 749) return {{ block.settings.products_per_row_mobile }};
        if (width <= 989) return {{ block.settings.products_per_row_tablet }};
        return {{ block.settings.products_per_row }};
      }

      scrollPrev() {
        const cardWidth = this.cards[0].offsetWidth;
        const gap = {{ block.settings.gap }};
        const scrollAmount = cardWidth + gap;
        this.track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      }

      scrollNext() {
        const cardWidth = this.cards[0].offsetWidth;
        const gap = {{ block.settings.gap }};
        const scrollAmount = cardWidth + gap;
        this.track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      }

      scrollToIndex(index) {
        const cardWidth = this.cards[0].offsetWidth;
        const gap = {{ block.settings.gap }};
        const scrollAmount = (cardWidth + gap) * index;
        this.track.scrollTo({ left: scrollAmount, behavior: 'smooth' });
      }

      updateCurrentIndex() {
        const cardWidth = this.cards[0].offsetWidth;
        const gap = {{ block.settings.gap }};
        this.currentIndex = Math.round(this.track.scrollLeft / (cardWidth + gap));
      }

      updateButtons() {
        if (!this.prevButton || !this.nextButton) return;

        const isAtStart = this.track.scrollLeft <= 0;
        const isAtEnd = this.track.scrollLeft + this.track.offsetWidth >= this.track.scrollWidth - 1;

        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd;
      }

      updateDots() {
        if (!this.dotsContainer) return;

        const dots = this.dotsContainer.querySelectorAll('.ai-product-carousel__dot-{{ ai_gen_id }}');
        const visibleCards = this.getVisibleCardsCount();
        const activeDotIndex = Math.floor(this.currentIndex / visibleCards);

        dots.forEach((dot, index) => {
          if (index === activeDotIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('product-carousel-{{ ai_gen_id }}', ProductCarousel{{ ai_gen_id }});
  })();
</script>

