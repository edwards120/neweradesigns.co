      "default": "<p>Add your video description here</p>"
    },
    {
      "type": "text",
      "id": "body_custom_font",
      "label": "Custom font URL",
      "info": "Upload font to Files, copy link, and paste here. Leave blank to use font picker below."
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Fallback font",
