<div class="ned-panel ned-portfolio" id="ServiceWork-{{ section.id }}">
  <header class="ned-portfolio-head">
    <div class="ned-portfolio-rail">
      <span>SERVICES IN THE REAL WORLD</span>
      <span>SELECTED APPLICATIONS / 01</span>
    </div>
    <div class="ned-portfolio-intro">
      <h2>PHYSICAL PROOF <span>+ SYSTEM STUDIES</span></h2>
      <p>Whole project images placed beside the strategic and production thinking that turns a service into something people can use.</p>
    </div>
  </header>

  <div class="ned-portfolio-list">
    {% for block in section.blocks %}
      {% if block.type == 'portfolio_item' %}
        {% liquid
          assign project_link = block.settings.project_link | default: '/pages/cases'
          assign project_alt = block.settings.image_alt | default: block.settings.title
        %}
        <article class="ned-project ned-service-project{% if block.settings.image != blank %} has-background{% endif %}" {{ block.shopify_attributes }}>
          <a class="ned-project-link" href="{{ project_link }}" aria-label="View {{ block.settings.title | escape }}">
            <div class="ned-project-stage"{% if block.settings.image != blank %} style="--service-work-image:url('{{ block.settings.image | image_url: width: 2200 }}')"{% endif %}>
              <span class="ned-project-word" aria-hidden="true">{{ block.settings.title }}</span>
              {% if block.settings.image == blank %}
                <div class="ned-project-media"><div class="ned-sign-placeholder" aria-hidden="true"><span></span><i></i><i></i></div></div>
              {% endif %}
              <div class="ned-crosshair ned-crosshair--a" aria-hidden="true"></div>
              <div class="ned-crosshair ned-crosshair--b" aria-hidden="true"></div>
              <div class="ned-dimension" aria-hidden="true"><span>{{ block.settings.annotation }}</span></div>
            </div>

            <div class="ned-project-copy">
              <div class="ned-project-index">APPLICATION / {% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</div>
              <p class="ned-project-meta"><span>{{ block.settings.classification }}</span>{{ block.settings.discipline }}</p>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.description }}</p>
              <span class="ned-project-cta">VIEW PROJECT <b aria-hidden="true">↗</b></span>
            </div>
          </a>
        </article>
      {% endif %}
    {% endfor %}
  </div>

  <footer class="ned-portfolio-foot">
    <span>DOCUMENTED / MODELED / PRODUCTION-AWARE</span>
    <a href="/pages/cases">VIEW ALL CASES <b aria-hidden="true">↗</b></a>
  </footer>
</div>
{% style %}
#ServiceWork-{{ section.id }} .ned-service-project .ned-project-stage{background-color:var(--ned-editorial-cream);background-position:center;background-repeat:no-repeat;background-size:cover}
#ServiceWork-{{ section.id }} .ned-service-project.has-background .ned-project-stage{background-image:linear-gradient(135deg,rgba(239,238,232,.18),rgba(239,238,232,.48)),var(--service-work-image)}
#ServiceWork-{{ section.id }} .ned-service-project.has-background .ned-project-word{mix-blend-mode:multiply;opacity:.92}
#ServiceWork-{{ section.id }} .ned-service-project .ned-project-index::after{content:none;display:none}
{% endstyle %}
